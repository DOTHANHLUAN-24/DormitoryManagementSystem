@{
    ViewData["Title"] = "Thêm phụ phí mới";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12 col-md-9 col-lg-6 mx-auto">
            
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none small text-muted">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách phụ phí
                </a>
            </div>

            <div class="card card-form-custom border-0 shadow-sm">
                <div class="card-header-custom py-4 px-4 text-center text-md-start">
                    <h3 class="fw-bold text-dark-navy mb-1">
                        <i class="fas fa-plus-circle me-2" style="color: #5c51d6;"></i>Thêm Phụ Phí Mới
                    </h3>
                    <p class="text-muted small mb-0">Cấu hình các khoản phí phát sinh, phí dịch vụ bổ sung hoặc chế tài phạt áp dụng trong KTX.</p>
                </div>
                
                <div class="card-body p-4 border-top border-light-subtle">
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark-navy">Tên khoản phụ thu / chi phí <span class="text-danger">*</span></label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fas fa-coins" style="font-size:0.85rem;"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" placeholder="Ví dụ: Phí cấp lại chìa khóa phòng, Phí phạt..." required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-semibold small text-dark-navy">Phân loại chi phí</label>
                                <select class="form-select input-custom">
                                    <option>Phạt vi phạm</option>
                                    <option>Dịch vụ phát sinh</option>
                                    <option>Tiêu thụ điện thêm</option>
                                    <option>Đền bù tài sản</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-semibold small text-dark-navy">Mức giá thu (đ) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control input-custom fw-bold text-primary-custom" placeholder="Ví dụ: 50,000" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark-navy">Phạm vi áp dụng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control input-custom" placeholder="Ví dụ: Tất cả các tòa, Toàn bộ khu nam, Sinh viên vi phạm..." required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-dark-navy">Mô tả / Ghi chú quy định thu</label>
                            <textarea class="form-control input-custom" rows="3" placeholder="Ghi chú rõ căn cứ thu hoặc quy trình bồi hoàn vật tư (nếu có)..."></textarea>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-refresh-light px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-purple-gradient px-4">Tạo phụ phí</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    body { background-color: #f4f7f6; font-family: 'Segoe UI', system-ui, sans-serif; }
    .text-dark-navy { color: #3b3f5c; }
    .text-primary-custom { color: #4361ee; }
    .card-form-custom { border-radius: 16px; background: white; box-shadow: 0 4px 25px rgba(0,0,0,0.04)!important; }
    .input-custom, .input-group-custom .form-control { border: 1px solid #e0e6ed; padding: 10px 14px; font-size: 14px; background-color: #f9fbfd; border-radius: 10px; }
    .input-group-custom .form-control { border-top-left-radius: 0!important; border-bottom-left-radius: 0!important; }
    .input-group-custom .input-group-text { border: 1px solid #e0e6ed; background-color: #f9fbfd; border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
    .form-select.input-custom { padding-right: 36px; background-color: #f9fbfd; }
    .input-custom:focus, .input-group-custom .form-control:focus { border-color: #5c51d6; box-shadow: none; background-color: #fff; }
    .btn-purple-gradient { background: linear-gradient(135deg, #5c51d6, #4a3ec7); color: white; border: none; font-weight: 500; padding: 10px 24px; border-radius: 10px; font-size: 0.9rem; }
    .btn-refresh-light { background-color: #ebedf2; color: #3b3f5c; border: none; border-radius: 10px; padding: 10px 24px; font-weight: 500; font-size: 0.9rem; }
    .btn-refresh-light:hover { background-color: #e0e4ec; }
</style>