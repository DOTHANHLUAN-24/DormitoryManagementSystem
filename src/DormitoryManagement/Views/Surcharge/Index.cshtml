@using Common
@{
    ViewData["Title"] = "Danh sách phụ phí kèm theo";

    // Đồng bộ phân quyền từ Sidebar của bạn
    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("ManagementStaff") || User.IsInRole("ManagerStaff") || User.IsInRole("Manager");
    var isAdminOrManager = isAdmin || isManager;

    // --- MOCK DATA CÁC LOẠI PHỤ PHÍ KÝ TÚC XÁ THỰC TẾ ---
    var mockSurcharges = new List<dynamic>
    {
        new { Code = "SUR001", Name = "Phí phạt quá hạn đóng tiền phòng", Type = "Phạt vi phạm", Price = "150,000 đ", AppliedTo = "Tất cả các tòa", Status = "Đang áp dụng" },
        new { Code = "SUR002", Name = "Phí cấp lại thẻ nội trú đánh mất", Type = "Dịch vụ phát sinh", Price = "50,000 đ", AppliedTo = "Sinh viên yêu cầu", Status = "Đang áp dụng" },
        new { Code = "SUR003", Name = "Sử dụng tủ lạnh riêng trong phòng (Tháng)", Type = "Tiêu thụ điện thêm", Price = "100,000 đ", AppliedTo = "Phòng đăng ký bổ sung", Status = "Đang áp dụng" },
        new { Code = "SUR004", Name = "Phí đền bù hư hỏng bóng đèn tuýp", Type = "Đền bù tài sản", Price = "45,000 đ", AppliedTo = "Phòng gây hư hỏng", Status = "Đang áp dụng" },
        new { Code = "SUR005", Name = "Phí vệ sinh phòng không đạt yêu cầu", Type = "Phạt vi phạm", Price = "200,000 đ", AppliedTo = "Phòng vi phạm nội quy", Status = "Tạm ngưng" }
    };
}

<div class="container-fluid px-4 py-4 main-content-custom">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark-navy">
                <i class="fas fa-coins me-2" style="color: #3b3f5c;"></i>Phụ phí kèm theo
            </h1>
            <p class="text-muted small mb-0">Quản lý các khoản phụ thu phát sinh, phí dịch vụ cộng thêm, đền bù vật tư và các chế tài tài chính tại KTX.</p>
        </div>
        
        @if (isAdminOrManager)
        {
            <a asp-controller="Surcharge" asp-action="Create" class="btn btn-purple-gradient shadow-sm">
                <i class="fas fa-plus me-2"></i> Thêm phụ phí mới
            </a>
        }
    </div>

    <div class="card card-filter-custom mb-4 border-0">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text border-end-0 bg-white text-muted py-1 px-2" style="font-size: 0.85rem;">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 py-1.5" style="font-size: 0.85rem;" placeholder="Tìm tên phụ phí, mã khoản thu...">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text border-end-0 bg-white text-muted py-1 px-2" style="font-size: 0.85rem;">
                            <i class="fas fa-filter"></i>
                        </span>
                        <select class="form-select border-start-0 py-1.5 text-muted-select" style="font-size: 0.85rem;">
                            <option value="">-- Tất cả phân loại --</option>
                            <option>Phạt vi phạm</option>
                            <option>Dịch vụ phát sinh</option>
                            <option>Tiêu thụ điện thêm</option>
                            <option>Đền bù tài sản</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text border-end-0 bg-white text-muted py-1 px-2" style="font-size: 0.85rem;">
                            <i class="fas fa-history"></i>
                        </span>
                        <select class="form-select border-start-0 py-1.5 text-muted-select" style="font-size: 0.85rem;">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option>Đang áp dụng</option>
                            <option>Tạm ngưng</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="button" class="btn btn-search-primary flex-grow-1 py-1.5" style="font-size: 0.85rem;">
                        <i class="fas fa-search me-1.5"></i>Tìm kiếm
                    </button>
                    <button type="button" class="btn btn-refresh-light py-1.5" style="width: 38px;" title="Làm mới">
                        <i class="fas fa-sync-alt" style="font-size: 0.85rem;"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card card-table-custom border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead>
                    <tr>
                        <th>MÃ PHỤ PHÍ</th>
                        <th>TÊN KHOẢN PHỤ THU</th>
                        <th>PHÂN LOẠI CHI PHÍ</th>
                        <th>MỨC GIÁ THU</th>
                        <th>PHẠM VI ÁP DỤNG</th>
                        <th>TRẠNG THÁI</th>
                        @if (isAdminOrManager)
                        {
                            <th class="text-center">THAO TÁC</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in mockSurcharges)
                    {
                        <tr>
                            <td><span class="badge-code-custom">@item.Code</span></td>
                            
                            <td class="fw-semibold text-dark-navy">@item.Name</td>
                            
                            <td><span class="badge-info-box">@item.Type</span></td>
                            
                            <td class="fw-bold text-primary-custom">@item.Price</td>
                            
                            <td class="text-secondary small">@item.AppliedTo</td>
                            
                            <td>
                                @if (item.Status == "Đang áp dụng")
                                {
                                    <span class="status-pill-custom p-success">
                                        <i class="fas fa-check-circle me-1"></i> Đang áp dụng
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill-custom p-cancelled">
                                        <i class="fas fa-minus-circle me-1"></i> Tạm ngưng
                                    </span>
                                }
                            </td>

                            @if (isAdminOrManager)
                            {
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="Surcharge" asp-action="Edit" asp-route-id="@item.Code" class="btn-action-custom btn-action-edit" title="Chỉnh sửa">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <button class="btn-action-custom btn-action-delete" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa mục phụ phí này?')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-top border-light-subtle d-flex justify-content-center py-3">
            <nav aria-label="Surcharge pagination">
                <ul class="pagination pagination-modern mb-0">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Trước</a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .text-dark-navy { color: #3b3f5c; }
    .text-primary-custom { color: #4361ee; }

    /* Nút kích hoạt Gradient */
    .btn-purple-gradient {
        background: linear-gradient(135deg, #5c51d6, #4a3ec7);
        color: white;
        border: none;
        font-weight: 500;
        padding: 9px 20px;
        border-radius: 10px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }
    .btn-purple-gradient:hover {
        color: white;
        opacity: 0.95;
        box-shadow: 0 4px 12px rgba(92, 81, 214, 0.2);
    }

    /* Khối Filters tìm kiếm mẫu gọn */
    .card-filter-custom, .card-table-custom {
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        background: white;
    }
    .input-group-custom .form-control, 
    .input-group-custom .form-select {
        border: 1px solid #e0e6ed;
        background-color: #f9fbfd;
    }
    .input-group-custom .form-control:focus,
    .input-group-custom .form-select:focus {
        box-shadow: none;
        border-color: #5c51d6;
        background-color: #fff;
    }
    .input-group-custom .input-group-text {
        border: 1px solid #e0e6ed;
        background-color: #f9fbfd;
    }
    .text-muted-select { color: #888ea8; }

    /* Nút lệnh */
    .btn-search-primary {
        background-color: #4361ee;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 500;
    }
    .btn-search-primary:hover { background-color: #304aca; color: white; }
    .btn-refresh-light {
        background-color: #ebedf2;
        color: #3b3f5c;
        border: none;
        border-radius: 10px;
    }
    .btn-refresh-light:hover { background-color: #e0e4ec; }

    /* Định dạng bảng */
    .table thead th {
        background-color: #f9fbfd;
        color: #515365;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 14px 12px;
        border-bottom: 1px solid #ebedf2;
    }
    .table tbody td {
        padding: 14px 12px;
        font-size: 13.5px;
        border-bottom: 1px solid #f1f2f3;
    }

    /* Nhãn định danh con */
    .badge-code-custom {
        background-color: #f1f2f3;
        color: #3b3f5c;
        font-weight: 700;
        font-size: 11px;
        padding: 5px 9px;
        border-radius: 6px;
    }
    .badge-info-box {
        border: 1px solid #e0e6ed;
        color: #0e1726;
        font-weight: 600;
        padding: 3px 7px;
        border-radius: 6px;
        font-size: 11.5px;
        background-color: #fff;
    }

    /* Trạng thái viên thuốc bo tròn */
    .status-pill-custom {
        display: inline-flex;
        align-items: center;
        padding: 5px 14px;
        font-size: 12.5px;
        font-weight: 600;
        border-radius: 50px;
    }
    .p-success { background-color: #e8fbf4; color: #1abc9c; }
    .p-cancelled { background-color: #fff2f2; color: #e7515a; }

    /* Nút công cụ sửa xóa */
    .btn-action-custom {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        transition: all 0.15s ease;
    }
    .btn-action-edit { background-color: #fff5e6; color: #e2a03f; }
    .btn-action-edit:hover { background-color: #e2a03f; color: white; }
    .btn-action-delete { background-color: #fff2f2; color: #e7515a; }
    .btn-action-delete:hover { background-color: #e7515a; color: white; }

    /* Thanh phân trang căn giữa */
    .pagination-modern {
        display: flex;
        gap: 4px;
    }
    .pagination-modern .page-link {
        border: 1px solid #e0e6ed;
        color: #3b3f5c;
        padding: 5px 12px;
        font-size: 12.5px;
        font-weight: 500;
        border-radius: 8px !important;
        background-color: #ffffff;
        transition: all 0.2s ease;
    }
    .pagination-modern .page-item:hover .page-link {
        background-color: #f4f7f6;
        color: #4361ee;
        border-color: #4361ee;
    }
    .pagination-modern .page-item.active .page-link {
        background-color: #4361ee;
        border-color: #4361ee;
        color: white;
        font-weight: 600;
    }
    .pagination-modern .page-item.disabled .page-link {
        background-color: #f9fbfd;
        color: #888ea8;
        border-color: #e0e6ed;
        cursor: not-allowed;
    }
</style>