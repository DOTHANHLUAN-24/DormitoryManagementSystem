@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses.Vehicles
@model PagedResult<VehicleResponseDto>

@{
    ViewData["Title"] = "Phương tiện tạm ngưng";
}

@section Styles {
    <style>
        .tieu-de-trang {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(135deg, #ea580c, #dc2626);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-custom-header {
            padding: 8px 16px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            border: none;
        }

        .thanh-tim-kiem {
            background: #fff;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: none;
        }

        .input-custom {
            height: 46px;
            border-radius: 12px !important;
            border: 1px solid #e2e8f0 !important;
            font-size: 14px;
            color: #1e293b;
            background-color: #f8fafc;
            width: 100%;
            transition: all 0.2s;
        }

        .input-custom:focus {
            border-color: #4f46e5 !important;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important;
            background-color: #fff;
        }

        .khung-tim-kiem {
            position: relative;
        }

        .khung-tim-kiem i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 10;
        }

        .khung-tim-kiem input {
            padding-left: 40px;
        }

        .btn-search {
            height: 46px;
            border-radius: 12px;
            background: #4f46e5;
            color: white;
            border: none;
            font-weight: 600;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
        }

        .card-custom {
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: none;
            overflow: hidden;
        }

        .badge-code-custom {
            background: #f8fafc;
            color: #1e293b;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #e2e8f0;
        }

        .badge-username {
            background: #eef2ff;
            color: #4f46e5;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #e0e7ff;
        }

        .trang-thai-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }

        .tam-ngung {
            background: #fef2f2;
            color: #ef4444;
        }

        /* NÚT HÀNH ĐỘNG VỚI CHỮ MỜ */
        .nut-hanh-dong {
            height: 34px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border: none;
            transition: all 0.3s;
            text-decoration: none !important;
        }

        .nut-kich-hoat {
            background: #f0fdf4;
            color: #15803d;
        }

        .hover-label {
            max-width: 0;
            opacity: 0;
            white-space: nowrap;
            transition: all 0.3s ease;
            font-size: 12px;
            font-weight: 600;
            overflow: hidden;
        }

        .nut-hanh-dong:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .nut-hanh-dong:hover .hover-label {
            max-width: 40px;
            opacity: 0.7;
            margin-left: 6px;
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid p-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-pause-circle me-2"></i>Phương tiện tạm ngưng</h1>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-sync-action btn-sync-secondary text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách chính
            </a>
        </div>
    </header>

    <!-- Quick filter tabs -->
    <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-2 rounded-3" style="border: 1px solid #e8edf5;">
        <a href="@Url.Action("Suspended", new { search = ViewBag.Search })" 
           class="btn btn-sm px-3 py-2 fw-semibold @(string.IsNullOrEmpty(ViewBag.TypeFilter) ? "btn-primary active text-white" : "btn-light text-secondary")" style="border-radius: 8px;">
            <i class="fas fa-list me-1"></i> Tất cả
        </a>
        <a href="@Url.Action("Suspended", new { type = "Xe máy", search = ViewBag.Search })" 
           class="btn btn-sm px-3 py-2 fw-semibold @(ViewBag.TypeFilter == "Xe máy" ? "btn-info active text-white" : "btn-light text-secondary")" style="border-radius: 8px;">
            <i class="fas fa-motorcycle me-1"></i> Xe máy
        </a>
        <a href="@Url.Action("Suspended", new { type = "Xe máy điện", search = ViewBag.Search })" 
           class="btn btn-sm px-3 py-2 fw-semibold @(ViewBag.TypeFilter == "Xe máy điện" ? "btn-success active text-white" : "btn-light text-secondary")" style="border-radius: 8px;">
            <i class="fas fa-bolt me-1"></i> Xe máy điện
        </a>
        <a href="@Url.Action("Suspended", new { type = "Xe đạp điện", search = ViewBag.Search })" 
           class="btn btn-sm px-3 py-2 fw-semibold @(ViewBag.TypeFilter == "Xe đạp điện" ? "btn-warning active text-dark" : "btn-light text-secondary")" style="border-radius: 8px;">
            <i class="fas fa-bicycle me-1"></i> Xe đạp điện
        </a>
        <a href="@Url.Action("Suspended", new { type = "Xe đạp", search = ViewBag.Search })" 
           class="btn btn-sm px-3 py-2 fw-semibold @(ViewBag.TypeFilter == "Xe đạp" ? "btn-secondary active text-white" : "btn-light text-secondary")" style="border-radius: 8px;">
            <i class="fas fa-biking me-1"></i> Xe đạp
        </a>
        <a href="@Url.Action("Suspended", new { type = "Ô tô", search = ViewBag.Search })" 
           class="btn btn-sm px-3 py-2 fw-semibold @(ViewBag.TypeFilter == "Ô tô" ? "btn-danger active text-white" : "btn-light text-secondary")" style="border-radius: 8px;">
            <i class="fas fa-car me-1"></i> Ô tô
        </a>
    </div>

    <form method="get" class="thanh-tim-kiem-sync" asp-action="Suspended">
        <input type="hidden" name="type" value="@ViewBag.TypeFilter" />
        <div class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="khung-tim-kiem-sync">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="input-sync" placeholder="Tìm biển số hoặc tên/mã định danh chủ xe...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-search-sync">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
    </form>

    <div class="card card-custom mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">STT</th>
                        <th class="py-3">Biển số</th>
                        <th class="py-3">Loại xe</th>
                        <th class="py-3">Chủ sở hữu</th>
                        <th class="py-3">Mã định danh</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="text-end pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">@(stt++)</td>
                                <td><span class="badge-code-custom">@item.LicensePlate</span></td>
                                <td>
                                    <div class="fw-bold text-dark">@item.VehicleType</div>
                                </td>
                                <td>@item.OwnerFullName</td>
                                <td><span class="badge-username">@item.OwnerCode</span></td>
                                <td>
                                    <span class="trang-thai-badge tam-ngung">Tạm ngưng</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" onclick="toggleStatus('@item.Id', false)"
                                                class="nut-hanh-dong nut-kich-hoat"
                                                data-bs-toggle="tooltip" data-bs-placement="top" title="Khôi phục trạng thái hoạt động">
                                            <i class="fas fa-play"></i> <span class="hover-label ms-1">Khôi phục</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-1"></i> Không có phương tiện nào đang bị tạm ngưng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        function toggleStatus(id, isActive) {
            Swal.fire({
                title: 'Khôi phục phương tiện?',
                text: 'Kích hoạt lại quyền gửi xe cho phương tiện này. Phương tiện sẽ xuất hiện lại trong danh sách hoạt động.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Vehicle/ToggleStatus/' + id,
                        type: 'POST',
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã khôi phục',
                                    text: data.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('Thất bại', data.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
