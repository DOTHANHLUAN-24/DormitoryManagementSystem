@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses.Vehicles
@model PagedResult<VehicleResponseDto>

@{
    ViewData["Title"] = "Quản lý phương tiện";
}

@section Styles {
    <style>
        .tieu-de-trang {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(135deg, #1e293b, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-custom-header {
            padding: 8px 16px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            border: none;
        }

        .btn-add {
            background: #4f46e5;
            color: white !important;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .btn-add:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3);
        }

        .thanh-tim-kiem {
            background: #fff;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: none;
        }

        .input-custom {
            height: 46px;
            border-radius: 12px !important;
            border: 1px solid #e2e8f0 !important;
            font-size: 14px;
            color: #1e293b;
            background-color: #f8fafc;
            width: 100%;
            transition: all 0.2s;
        }

        .input-custom:focus {
            border-color: #4f46e5 !important;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important;
            background-color: #fff;
        }

        .khung-tim-kiem {
            position: relative;
        }

        .khung-tim-kiem i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 10;
        }

        .khung-tim-kiem input {
            padding-left: 40px;
        }

        .btn-search {
            height: 46px;
            border-radius: 12px;
            background: #4f46e5;
            color: white;
            border: none;
            font-weight: 600;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
        }

        .btn-search:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
            color: white;
        }

        .card-custom {
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: none;
            overflow: hidden;
        }

        .badge-code-custom {
            background: #f8fafc;
            color: #1e293b;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #e2e8f0;
        }

        .badge-username {
            background: #eef2ff;
            color: #4f46e5;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #e0e7ff;
        }

        .trang-thai-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }

        .dang-hoat-dong {
            background: #ecfdf5;
            color: #10b981;
        }

        .tam-ngung {
            background: #fef2f2;
            color: #ef4444;
        }

        /* NÚT HÀNH ĐỘNG VỚI CHỮ MỜ */
        .nut-hanh-dong {
            height: 34px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border: none;
            transition: all 0.3s;
            text-decoration: none !important;
        }

        .nut-sua {
            background: #eff6ff;
            color: #3b82f6;
        }

        .nut-xoa {
            background: #fef2f2;
            color: #ef4444;
        }

        .nut-trang-thai {
            background: #fff7ed;
            color: #f59e0b;
        }

        .nut-kich-hoat {
            background: #f0fdf4;
            color: #15803d;
        }

        .hover-label {
            max-width: 0;
            opacity: 0;
            white-space: nowrap;
            transition: all 0.3s ease;
            font-size: 12px;
            font-weight: 600;
            overflow: hidden;
        }

        .nut-hanh-dong:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .nut-hanh-dong:hover .hover-label {
            max-width: 40px;
            opacity: 0.7;
            margin-left: 6px;
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid p-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-motorcycle me-2"></i>Quản lý phương tiện</h1>
        <a asp-action="Create" class="btn-custom-header btn-add text-decoration-none">
            <i class="fas fa-plus"></i> Đăng ký xe mới
        </a>
    </header>

    <form method="get" class="thanh-tim-kiem" asp-action="Index">
        <div class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="khung-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="input-custom" placeholder="Tìm biển số hoặc tên/mã định danh chủ xe...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select input-custom">
                    <option value="">-- Tất cả loại xe --</option>
                    <option value="Xe máy" selected="@(ViewBag.TypeFilter == "Xe máy")">Xe máy</option>
                    <option value="Xe máy điện" selected="@(ViewBag.TypeFilter == "Xe máy điện")">Xe máy điện</option>
                    <option value="Xe đạp điện" selected="@(ViewBag.TypeFilter == "Xe đạp điện")">Xe đạp điện</option>
                    <option value="Xe đạp" selected="@(ViewBag.TypeFilter == "Xe đạp")">Xe đạp</option>
                    <option value="Ô tô" selected="@(ViewBag.TypeFilter == "Ô tô")">Ô tô</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-search">
                    <i class="fas fa-filter"></i> Lọc dữ liệu
                </button>
            </div>
        </div>
    </form>

    <div class="card card-custom mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">STT</th>
                        <th class="py-3">Biển số</th>
                        <th class="py-3">Loại xe</th>
                        <th class="py-3">Chủ sở hữu</th>
                        <th class="py-3">Mã định danh</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="text-end pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">@(stt++)</td>
                                <td><span class="badge-code-custom">@item.LicensePlate</span></td>
                                <td>
                                    <div class="fw-bold text-dark">@item.VehicleType</div>
                                </td>
                                <td>@item.OwnerFullName</td>
                                <td><span class="badge-username">@item.OwnerCode</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="trang-thai-badge dang-hoat-dong">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="trang-thai-badge tam-ngung">Tạm ngưng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="nut-hanh-dong nut-sua"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                        <button type="button" onclick="toggleStatus('@item.Id', @(item.IsActive ? "true" : "false"))"
                                                class="nut-hanh-dong @(item.IsActive ? "nut-trang-thai" : "nut-kich-hoat")"
                                                data-bs-toggle="tooltip" data-bs-placement="top" title="@(item.IsActive ? "Tạm ngưng" : "Kích hoạt")">
                                            <i class="fas @(item.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>

                                        <button type="button" onclick="deleteVehicle('@item.Id', '@item.LicensePlate')"
                                                class="nut-hanh-dong nut-xoa" data-bs-toggle="tooltip" data-bs-placement="top"
                                                title="Xóa phương tiện">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-1"></i> Không tìm thấy phương tiện nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        function toggleStatus(id, isActive) {
            const title = isActive ? 'Tạm ngưng phương tiện?' : 'Kích hoạt lại phương tiện?';
            const text = isActive ? 'Xe này tạm thời sẽ không được phép ra vào bãi xe.' : 'Kích hoạt lại quyền gửi xe cho phương tiện này.';
            
            Swal.fire({
                title: title,
                text: text,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: isActive ? '#f59e0b' : '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Vehicle/ToggleStatus/' + id,
                        type: 'POST',
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: data.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('Thất bại', data.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                        }
                    });
                }
            });
        }

        function deleteVehicle(id, licensePlate) {
            Swal.fire({
                title: 'Xóa phương tiện?',
                html: "Thông tin xe <b>" + licensePlate + "</b> sẽ bị xóa khỏi hệ thống.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-trash me-1"></i> Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Vehicle/Delete/' + id,
                        type: 'POST',
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã xóa',
                                    text: data.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('Thất bại', data.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
