@{
    ViewData["Title"] = "Đăng ký phương tiện";
}

@section Styles {
    <style>
        .tieu-de-trang {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(135deg, #1e293b, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-custom-header {
            padding: 8px 16px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn-header-back {
            background: white;
            color: #64748b !important;
            border: 1px solid #e2e8f0;
        }

        .btn-header-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.05);
            color: #1e293b !important;
            background: #f8fafc;
        }

        .card-custom {
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: none;
            overflow: hidden;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px dashed #f1f5f9;
        }

        .section-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .section-icon.green {
            background: #ecfdf5;
            color: #10b981;
        }

        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .input-custom {
            height: 46px;
            border-radius: 12px !important;
            border: 1px solid #e2e8f0;
            font-size: 14px;
            color: #1e293b;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .input-custom:focus {
            border-color: #4f46e5 !important;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important;
            background-color: #fff;
        }

        .btn-action {
            height: 46px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 24px;
            transition: all 0.2s;
            border: none;
        }

        .btn-save {
            background: #4f46e5;
            color: white !important;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3);
            background: #4338ca;
        }

        .btn-cancel {
            background: #fff;
            color: #ef4444 !important;
            border: 1px solid #fee2e2;
            background: #fef2f2;
        }

        .btn-cancel:hover {
            background: #fee2e2;
            transform: translateY(-2px);
        }
    </style>
}

<div class="container-fluid p-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-motorcycle me-2"></i>Đăng ký phương tiện mới</h1>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </header>

    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card card-custom">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div class="row g-5">
                            <!-- CỘT TRÁI: THÔNG TIN CHỦ XE -->
                            <div class="col-md-6 border-end-md pe-md-4">
                                <div class="section-title">
                                    <div class="section-icon"><i class="fas fa-user"></i></div>
                                    Thông tin chủ sở hữu
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Chủ sở hữu (Sinh viên/Nhân viên) <span
                                        class="text-danger">*</span></label>
                                        <select name="OwnerId" class="form-select input-custom select2" required>
                                            <option value="">-- Tìm kiếm người dùng --</option>
                                            @* Dữ liệu sẽ được load từ ViewBag *@
                                        </select>
                                        <small class="text-muted mt-2 d-block">Nhập MSSV hoặc Tên để tìm kiếm nhanh.</small>
                                    </div>

                                    <div class="p-3 bg-light rounded-3 small text-muted border">
                                        <i class="fas fa-info-circle me-1"></i> <strong>Lưu ý:</strong> Một người dùng có
                                        thể đăng ký nhiều phương tiện nhưng phải tuân thủ nội quy bãi xe.
                                    </div>
                                </div>

                                <!-- CỘT PHẢI: CHI TIẾT XE -->
                                <div class="col-md-6 ps-md-4">
                                    <div class="section-title">
                                        <div class="section-icon green"><i class="fas fa-info"></i></div>
                                        Chi tiết phương tiện
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label">Loại phương tiện <span
                                                class="text-danger">*</span></label>
                                                <select name="VehicleType" class="form-select input-custom" required>
                                                    <option value="Xe máy">Xe máy</option>
                                                    <option value="Xe đạp điện">Xe đạp điện</option>
                                                    <option value="Xe đạp">Xe đạp</option>
                                                    <option value="Ô tô">Ô tô</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-4">
                                                <label class="form-label">Biển số xe <span class="text-danger">*</span></label>
                                                <input name="LicensePlate" class="form-control input-custom"
                                                       placeholder="29A-123.45" required />
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label">Ghi chú thêm</label>
                                            <textarea name="Note" class="form-control input-custom" rows="2"
                                                      style="height: auto;" placeholder="Mô tả đặc điểm nhận dạng xe..."></textarea>
                                        </div>
                                    </div>
                                </div>

                                <!-- NÚT ĐIỀU KHIỂN DƯỚI FORM -->
                                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                                    <a asp-action="Index" class="btn-action btn-cancel text-decoration-none">
                                        <i class="fas fa-times"></i> Hủy bỏ
                                    </a>
                                    <button type="submit" class="btn-action btn-save">
                                        <i class="fas fa-check"></i> Tạo đăng ký
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                $(document).ready(function () {
                    $('.select2').select2({
                        theme: 'bootstrap-5',
                        placeholder: 'Nhập MSSV hoặc Tên để tìm kiếm...',
                        allowClear: true,
                        minimumInputLength: 1, // Đổi thành 1 để dễ test, gõ 1 chữ là hiện luôn
                        width: '100%',
                        ajax: {
                            url: '@Url.Action("SearchUsers", "Vehicle")',
                            dataType: 'json',
                            delay: 250,
                            data: function (params) {
                                return {
                                    q: params.term
                                };
                            },
                            processResults: function (data) {
                                return {
                                    results: data.items
                                };
                            },
                            cache: true
                        },
                        language: {
                            inputTooShort: function () { return "Vui lòng nhập từ 1 ký tự..."; },
                            noResults: function () { return "Không tìm thấy người dùng nào"; },
                            searching: function () { return "Đang tìm kiếm..."; }
                        }
                    });
                });
            </script>
        }
