@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Hướng dẫn sử dụng hệ thống";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold">
            <i class="fas fa-book-open me-2 text-primary"></i>
            Hướng dẫn sử dụng hệ thống KTX
        </h3>
        <p class="text-muted">
            Làm theo các bước dưới đây để bắt đầu sử dụng hệ thống.
        </p>
    </div>

    <!-- STEP 1 -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white fw-semibold">
            🔐 Bước 1: Đăng ký / Đăng nhập / Quên mật khẩu
        </div>

        <div class="card-body">

            <!-- REGISTER -->
            <div class="mb-5">
                <h5 class="text-primary">
                    <i class="fas fa-user-plus me-2"></i>Đăng ký tài khoản
                </h5>

                <p>
                    Nếu bạn là người dùng mới, hãy tạo tài khoản để truy cập hệ thống.
                </p>

                <ul>
                    <li>Nhấn vào <b>Đăng ký</b></li>
                    <li>Nhập thông tin cá nhân</li>
                    <li>Xác nhận đăng ký</li>
                </ul>

                <div class="row g-3">
                    <div class="col-md-6">
                        <img src="https://picsum.photos/600/350?random=11"
                             class="img-fluid rounded shadow-sm">
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <span class="text-muted">
                            📸 Giao diện đăng ký (demo)
                        </span>
                    </div>
                </div>
            </div>

            <hr />

            <!-- LOGIN -->
            <div class="mb-5">
                <h5 class="text-success">
                    <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                </h5>

                <p>
                    Sau khi có tài khoản, bạn đăng nhập để sử dụng hệ thống.
                </p>

                <ul>
                    <li>Nhập Email hoặc Username</li>
                    <li>Nhập mật khẩu</li>
                    <li>Nhấn <b>Đăng nhập</b></li>
                </ul>

                <div class="row g-3">
                    <div class="col-md-6">
                        <img src="https://picsum.photos/600/350?random=22"
                             class="img-fluid rounded shadow-sm">
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <span class="text-muted">
                            📸 Giao diện đăng nhập (demo)
                        </span>
                    </div>
                </div>
            </div>

            <hr />

            <!-- FORGOT PASSWORD -->
            <div>
                <h5 class="text-danger">
                    <i class="fas fa-key me-2"></i>Quên mật khẩu
                </h5>

                <p>
                    Nếu quên mật khẩu, bạn có thể khôi phục dễ dàng:
                </p>

                <ul>
                    <li>Chọn <b>Quên mật khẩu</b></li>
                    <li>Nhập email đã đăng ký</li>
                    <li>Nhận link reset qua email</li>
                </ul>

                <div class="row g-3">
                    <div class="col-md-6">
                        <img src="https://picsum.photos/600/350?random=33"
                             class="img-fluid rounded shadow-sm">
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <span class="text-muted">
                            📸 Giao diện khôi phục mật khẩu (demo)
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>