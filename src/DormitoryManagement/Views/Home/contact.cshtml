<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Liên hệ - Dormitory System</title>

  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: #f5f7fb;
    }

    .contact-card {
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      padding: 30px;
      background: white;
    }

    .title {
      font-weight: bold;
      margin-bottom: 20px;
    }

    .info-box {
      background: #0d6efd;
      color: white;
      padding: 20px;
      border-radius: 15px;
    }
  </style>
</head>

<body>

<div class="container py-5">
  <div class="text-center mb-4">
    <h2>📞 Liên hệ hệ thống ký túc xá</h2>
    <p>Gửi phản hồi hoặc yêu cầu hỗ trợ cho ban quản lý</p>
  </div>

  <div class="row g-4">

    <!-- FORM -->
    <div class="col-md-7">
      <div class="contact-card">

        <h4 class="title">Gửi thông tin liên hệ</h4>

        <form>
          <div class="mb-3">
            <label class="form-label">Họ và tên</label>
            <input type="text" class="form-control" placeholder="Nhập họ tên">
          </div>

          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" placeholder="Nhập email">
          </div>

          <div class="mb-3">
            <label class="form-label">Nội dung</label>
            <textarea class="form-control" rows="5" placeholder="Nhập nội dung cần hỗ trợ..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-100">
            📩 Gửi liên hệ
          </button>
        </form>

      </div>
    </div>

    <!-- INFO -->
    <div class="col-md-5">
      <div class="info-box">

        <h4>🏢 Thông tin hệ thống</h4>
        <p>Hệ thống quản lý ký túc xá</p>

        <hr>

        <p>📧 Email: support@dormitory.com</p>
        <p>📞 Hotline: 0123 456 789</p>
        <p>📍 Địa chỉ: phố Viên, Đông Ngạc, Bắc Từ Liêm, Hà Nội</p>

        <hr>

        <p>⏰ Giờ làm việc: 8:00 - 17:00</p>

      </div>
    </div>

  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
