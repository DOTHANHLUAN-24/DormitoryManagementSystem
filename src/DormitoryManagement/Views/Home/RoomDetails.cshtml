@using DormitoryManagement.Domain.Enums
@model DormitoryManagement.Application.Dtos.Responses.Rooms.RoomDetailResponse

@{
    ViewData["Title"] = "Chi tiết phòng " + Model.RoomNumber;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isStudent = User.IsInRole("Student");
    var statusEnum = Enum.TryParse<RoomStatus>(Model.Status.ToString(), out var res) ? res : RoomStatus.Available;

    // Pick mockup image depending on capacity
    string imageUrl = Model.MaxOccupants switch
    {
        2 => "https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=1200&q=80",
        4 => "https://images.unsplash.com/photo-1598928506311-c55ded91a20c?auto=format&fit=crop&w=1200&q=80",
        6 => "https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=1200&q=80",
        8 => "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80",
        _ => "https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=1200&q=80"
    };
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        .detail-container {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            min-height: 100vh;
            padding-bottom: 4rem;
        }

        .btn-back-custom {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #475569;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 10px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
            margin-bottom: 1.5rem;
        }

        .btn-back-custom:hover {
            background: #f1f5f9;
            color: #0f172a;
            transform: translateX(-4px);
        }

        /* Detail Card Layout */
        .detail-hero {
            position: relative;
            height: 400px;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            margin-bottom: 2rem;
        }

        .detail-hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .detail-hero-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(15, 23, 42, 0.85) 0%, rgba(15, 23, 42, 0.4) 60%, rgba(15, 23, 42, 0) 100%);
            padding: 3rem 2rem 2rem 2rem;
            color: #ffffff;
        }

        .detail-title {
            font-size: 2.25rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }

        .detail-subtitle-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .detail-badge-status {
            font-size: 0.8rem;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 30px;
        }

        /* Content Blocks */
        .info-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 1.75rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
            margin-bottom: 2rem;
        }

        .card-heading {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 1.25rem;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-heading i {
            color: #4f46e5;
        }

        .room-specs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
        }

        .spec-item {
            background: #f8fafc;
            border-radius: 12px;
            padding: 1rem;
            border: 1px solid #f1f5f9;
        }

        .spec-label {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
        }

        .spec-value {
            font-size: 1.1rem;
            color: #1e293b;
            font-weight: 700;
        }

        /* Bed Grid */
        .bed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
        }

        .bed-box {
            border-radius: 14px;
            padding: 1rem;
            text-align: center;
            border: 1.5px solid #e2e8f0;
            transition: all 0.2s ease;
            position: relative;
        }

        .bed-box i {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
        }

        .bed-box.occupied {
            background: #fef2f2;
            border-color: #fca5a5;
            color: #dc2626;
        }

        .bed-box.empty {
            background: #ecfdf5;
            border-color: #a7f3d0;
            color: #059669;
        }

        .bed-box.occupied:hover {
            box-shadow: 0 4px 10px rgba(220, 38, 38, 0.08);
        }

        .bed-box.empty:hover {
            box-shadow: 0 4px 10px rgba(5, 150, 105, 0.08);
        }

        .bed-number {
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }

        .bed-status-txt {
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* Assets Table */
        .asset-table th {
            font-weight: 700;
            color: #475569;
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            font-size: 0.88rem;
        }

        .asset-table td {
            font-size: 0.9rem;
            color: #1e293b;
            padding: 12px 8px;
        }

        /* Action Buttons */
        .action-panel {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.03);
        }

        .action-desc {
            max-width: 60%;
        }

        .action-desc h5 {
            font-weight: 700;
            margin-bottom: 0.25rem;
            color: #0f172a;
        }

        .action-btn-group {
            display: flex;
            gap: 12px;
        }

        .btn-action-primary {
            height: 48px;
            padding: 0 24px;
            border-radius: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
            transition: all 0.2s ease;
        }

        .btn-action-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
            color: white;
        }

        .btn-action-secondary {
            height: 48px;
            padding: 0 20px;
            border-radius: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            color: #475569;
            transition: all 0.2s ease;
        }

        .btn-action-secondary:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #1e293b;
        }

        .input-custom {
            height: 48px;
            border-radius: 12px !important;
            border: 1.5px solid #e2e8f0 !important;
            font-size: 0.95rem;
            font-weight: 500;
            color: #334155;
        }
    </style>
}

<div class="detail-container container-fluid p-4">
    <!-- Back button -->
    <a asp-action="Rooms" class="btn-back-custom">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách phòng
    </a>

    <!-- Hero Section -->
    <div class="detail-hero">
        <img src="@imageUrl" alt="Phòng @Model.RoomNumber" class="detail-hero-img" onerror="this.onerror=null; this.src='/images/room-placeholder.svg';" />
        <div class="detail-hero-overlay">
            <div class="detail-subtitle-tags mb-2">
                <span class="detail-badge-status @(statusEnum switch {
                    RoomStatus.Available => "status-available",
                    RoomStatus.Full => "status-full",
                    RoomStatus.Maintenance => "status-maintenance",
                    RoomStatus.Reserved => "status-reserved",
                    _ => "status-available"
                })">
                    @(statusEnum switch {
                        RoomStatus.Available => "Còn trống",
                        RoomStatus.Full => "Đã đầy",
                        RoomStatus.Maintenance => "Bảo trì",
                        RoomStatus.Reserved => "Đã đặt trước",
                        _ => Model.Status
                    })
                </span>
                <span class="badge bg-white bg-opacity-20 text-white backdrop-blur px-3 py-2" style="border-radius: 30px;"><i class="fas fa-building me-1"></i>Tòa @Model.BlockName</span>
                <span class="badge bg-white bg-opacity-20 text-white backdrop-blur px-3 py-2" style="border-radius: 30px;"><i class="fas fa-layer-group me-1"></i>Tầng @Model.Floor</span>
            </div>
            <h1 class="detail-title">Phòng @Model.RoomNumber - @Model.RoomTypeName</h1>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Specs, Beds, Assets -->
        <div class="col-lg-8">
            <!-- Specifications -->
            <div class="info-card">
                <h4 class="card-heading"><i class="fas fa-info-circle"></i> Thông tin tổng quan</h4>
                <div class="room-specs-grid">
                    <div class="spec-item">
                        <div class="spec-label">Giá thuê</div>
                        <div class="spec-value text-indigo" style="color: #4f46e5;">@Model.BasePrice.ToString("N0") đ <span class="fs-6 text-muted fw-normal">/ tháng</span></div>
                    </div>
                    <div class="spec-item">
                        <div class="spec-label">Sức chứa tối đa</div>
                        <div class="spec-value">@Model.MaxOccupants sinh viên</div>
                    </div>
                    <div class="spec-item">
                        <div class="spec-label">Tòa nhà</div>
                        <div class="spec-value">Tòa @Model.BlockName</div>
                    </div>
                    <div class="spec-item">
                        <div class="spec-label">Vị trí</div>
                        <div class="spec-value">Tầng @Model.Floor</div>
                    </div>
                </div>
                <div class="mt-4">
                    <h6 class="fw-bold text-secondary">Mô tả loại phòng:</h6>
                    <p class="text-muted" style="line-height: 1.6; font-size: 0.95rem;">
                        @(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "Phòng thiết kế thông minh, tối ưu diện tích và luồng gió tự nhiên, cung cấp môi trường sinh hoạt học tập tiện nghi, năng động và an toàn nhất cho sinh viên.")
                    </p>
                </div>
            </div>

            <!-- Beds List -->
            <div class="info-card">
                <h4 class="card-heading"><i class="fas fa-bed"></i> Sơ đồ giường trong phòng</h4>
                <div class="bed-grid">
                    @if (Model.Beds != null && Model.Beds.Any())
                    {
                        foreach (var bed in Model.Beds)
                        {
                            <div class="bed-box @(bed.IsOccupied ? "occupied" : "empty")">
                                <i class="fas fa-bed"></i>
                                <div class="bed-number">Giường @bed.BedNumber</div>
                                <div class="bed-status-txt">@(bed.IsOccupied ? "Đã có sinh viên" : "Giường trống")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-3 w-100">Không tìm thấy thông tin giường của phòng này.</div>
                    }
                </div>
            </div>

            <!-- Assets List -->
            <div class="info-card">
                <h4 class="card-heading"><i class="fas fa-couch"></i> Trang thiết bị vật tư kèm theo</h4>
                <div class="table-responsive">
                    <table class="table table-hover asset-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã vật tư</th>
                                <th>Tên tài sản</th>
                                <th>Trạng thái</th>
                                <th>Mô tả</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Assets != null && Model.Assets.Any())
                            {
                                foreach (var asset in Model.Assets)
                                {
                                    <tr>
                                        <td class="fw-bold" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;">@asset.AssetCode</td>
                                        <td>@asset.AssetName</td>
                                        <td>
                                            <span class="badge @(asset.Status == "Good" || asset.Status == "Active" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")" style="font-size: 0.75rem; font-weight: 600; padding: 4px 8px;">
                                                @(asset.Status switch {
                                                    "Good" => "Hoạt động tốt",
                                                    "Active" => "Sẵn sàng",
                                                    "Broken" => "Hỏng hóc",
                                                    _ => asset.Status
                                                })
                                            </span>
                                        </td>
                                        <td class="text-muted small">@(!string.IsNullOrEmpty(asset.Description) ? asset.Description : "Trang bị kèm phòng")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Phòng hiện tại chưa có danh sách trang thiết bị bổ sung.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Quick Action Box & Sidebar Details -->
        <div class="col-lg-4">
            <!-- Sidebar Booking / Status Action -->
            <div class="info-card">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-bolt text-warning me-2"></i>Thao tác nhanh</h5>
                <div class="mb-4 text-center">
                    <div class="text-muted small mb-1">Đơn giá áp dụng</div>
                    <div class="fs-3 fw-extrabold text-indigo" style="color: #4f46e5; font-weight: 800;">@Model.BasePrice.ToString("N0")đ <span class="fs-6 text-muted fw-normal">/ tháng</span></div>
                </div>

                <div class="d-flex flex-column gap-2">
                    @if (statusEnum == RoomStatus.Available)
                    {
                        <button type="button" class="btn btn-action-primary w-100 justify-content-center" onclick="onBookRoom('@Model.Id', '@Model.RoomNumber', '@Model.BasePrice.ToString("N0")')">
                            <i class="fas fa-check-circle"></i> Đăng ký thuê phòng ngay
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-action-primary w-100 justify-content-center disabled" disabled>
                            Hết chỗ thuê
                        </button>
                    }

                    <button type="button" class="btn btn-action-secondary w-100 justify-content-center" onclick="onUnderDevelopment('Báo cáo sự cố phòng')">
                        <i class="fas fa-exclamation-triangle"></i> Báo hỏng thiết bị
                    </button>
                    <button type="button" class="btn btn-action-secondary w-100 justify-content-center" onclick="onUnderDevelopment('Liên hệ quản lý')">
                        <i class="fas fa-envelope"></i> Gửi thắc mắc / Khiếu nại
                    </button>
                </div>
            </div>

            <!-- Notes card -->
            <div class="info-card bg-light border-0">
                <h6 class="fw-bold text-secondary mb-2"><i class="fas fa-shield-alt text-primary me-2"></i>Cam kết KTX</h6>
                <ul class="text-muted small ps-3 mb-0" style="line-height: 1.7;">
                    <li>An ninh giám sát 24/7.</li>
                    <li>Điện nước tính theo giá nhà nước quy định.</li>
                    <li>Sửa chữa hỏng hóc miễn phí (đối với hao mòn tự nhiên).</li>
                    <li>Môi trường sống văn minh, lành mạnh.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đặt Phòng Dành Cho Sinh Viên -->
@if (isAuthenticated && isStudent)
{
    <div class="modal fade" id="bookRoomModal" tabindex="-1" aria-labelledby="bookRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border-bottom: none;">
                    <h5 class="modal-title fw-bold" id="bookRoomModalLabel"><i class="fas fa-file-signature me-2"></i> Đăng Ký Đặt Phòng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="bookingForm" onsubmit="submitBooking(event)">
                        <input type="hidden" id="bookRoomId" name="RoomId" />
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Phòng đăng ký</label>
                            <input type="text" class="form-control input-custom bg-light" id="bookRoomNumber" readonly style="font-weight: 600;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Đơn giá thuê</label>
                            <input type="text" class="form-control input-custom bg-light" id="bookRoomPrice" readonly style="font-weight: 600; color: #4f46e5;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Ngày dự kiến nhận phòng <span class="text-danger">*</span></label>
                            <input type="date" class="form-control input-custom" id="bookStartDate" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Ghi chú / Yêu cầu thêm</label>
                            <textarea class="form-control" id="bookNotes" rows="3" style="border-radius: 12px; border: 1.5px solid #e2e8f0; font-size: 0.95rem; font-weight: 500;" placeholder="VD: Muốn ở giường tầng dưới..."></textarea>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="button" class="btn btn-secondary w-50" data-bs-dismiss="modal" style="height: 48px; border-radius: 12px; font-weight: 600;">Hủy bỏ</button>
                            <button type="submit" class="btn btn-indigo text-white w-50" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border: none; height: 48px; border-radius: 12px; font-weight: 600;">
                                Gửi yêu cầu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function onBookRoom(id, roomNumber, price) {
            const isAuthenticated = @(isAuthenticated ? "true" : "false");
            const isStudent = @(isStudent ? "true" : "false");

            if (!isAuthenticated) {
                Swal.fire({
                    title: 'Yêu cầu đăng nhập!',
                    text: 'Bạn cần đăng nhập với tài khoản Sinh viên để đăng ký đặt phòng.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#6366f1',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: '<i class="fas fa-sign-in-alt me-1"></i> Đăng nhập ngay',
                    cancelButtonText: 'Đóng',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Account/Login';
                    }
                });
            } else if (!isStudent) {
                Swal.fire({
                    title: 'Hạn chế chức năng',
                    text: 'Hệ thống chỉ hỗ trợ Sinh viên thực hiện đặt phòng. Bạn đang đăng nhập với tài khoản không có quyền Sinh viên.',
                    icon: 'info',
                    confirmButtonColor: '#4f46e5',
                    confirmButtonText: 'Đã hiểu'
                });
            } else {
                // Open student booking modal
                $('#bookRoomId').val(id);
                $('#bookRoomNumber').val('Phòng ' + roomNumber);
                $('#bookRoomPrice').val(price + ' đ / tháng');
                $('#bookStartDate').val(new Date().toISOString().split('T')[0]);
                const myModal = new bootstrap.Modal(document.getElementById('bookRoomModal'));
                myModal.show();
            }
        }

        function submitBooking(event) {
            event.preventDefault();
            
            // Close modal
            const modalEl = document.getElementById('bookRoomModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            // Simulate booking request success
            Swal.fire({
                title: 'Đang gửi yêu cầu...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            setTimeout(() => {
                Swal.fire({
                    title: 'Thành công!',
                    text: 'Gửi yêu cầu đặt phòng thành công. Ban quản lý KTX sẽ xét duyệt và liên hệ lại với bạn trong thời gian sớm nhất.',
                    icon: 'success',
                    confirmButtonColor: '#4f46e5',
                    confirmButtonText: 'Đồng ý'
                });
            }, 1200);
        }

        function onUnderDevelopment(featureName) {
            Swal.fire({
                title: 'Tính năng đang được phát triển',
                text: 'Chức năng "' + featureName + '" hiện đang trong quá trình xây dựng và hoàn thiện. Vui lòng quay lại sau.',
                icon: 'info',
                confirmButtonColor: '#6366f1',
                confirmButtonText: 'Đóng'
            });
        }
    </script>
}
