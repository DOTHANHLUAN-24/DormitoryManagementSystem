@using DormitoryManagement.Domain.Enums
@using DormitoryManagement.Application.Dtos.Requests.Rooms
@model DormitoryManagement.Domain.Common.PagedResult<DormitoryManagement.Application.Dtos.Responses.Rooms.RoomResponse>

@{
    ViewData["Title"] = "Danh sách phòng KTX";
    var filter = ViewBag.Filter as RoomFilterRequest ?? new RoomFilterRequest();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isStudent = User.IsInRole("Student");
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        .rooms-container {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            min-height: 100vh;
            padding-bottom: 3rem;
        }

        /* Hero Banner Section */
        .hero-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-radius: 24px;
            padding: 3.5rem 2rem;
            color: #ffffff;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.3);
        }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(99, 102, 241, 0) 70%);
            pointer-events: none;
        }

        .hero-title {
            font-weight: 800;
            font-size: 2.25rem;
            background: linear-gradient(to right, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.75rem;
        }

        .hero-subtitle {
            color: #94a3b8;
            font-size: 1.1rem;
            max-width: 600px;
            font-weight: 400;
        }

        /* Search and Filter Panel */
        .filter-panel {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            margin-bottom: 2.5rem;
        }

        .filter-title {
            font-weight: 700;
            font-size: 1.1rem;
            color: #1e293b;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .input-custom {
            height: 48px;
            border-radius: 12px !important;
            border: 1.5px solid #e2e8f0 !important;
            font-size: 0.95rem;
            font-weight: 500;
            color: #334155;
            transition: all 0.2s ease-in-out;
        }

        .input-custom:focus {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1) !important;
        }

        .search-wrapper {
            position: relative;
        }

        .search-wrapper i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
            z-index: 10;
        }

        .search-wrapper input {
            padding-left: 46px;
        }

        .btn-action-filter {
            height: 48px;
            border-radius: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-search-apply {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #ffffff;
            border: none;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
        }

        .btn-search-apply:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
            color: #ffffff;
        }

        .btn-search-reset {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .btn-search-reset:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

        /* Room Cards Styling */
        .room-grid {
            margin-top: 1rem;
        }

        .room-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
            position: relative;
        }

        .room-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.03);
            border-color: #cbd5e1;
        }

        .room-image-wrapper {
            position: relative;
            height: 220px;
            overflow: hidden;
        }

        .room-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .room-card:hover .room-image {
            transform: scale(1.08);
        }

        /* Badges */
        .badge-popular {
            position: absolute;
            top: 16px;
            right: 16px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            color: #1e293b;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 30px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .badge-status {
            position: absolute;
            top: 16px;
            left: 16px;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 30px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            z-index: 10;
        }

        .status-available {
            background: #ecfdf5;
            color: #059669;
        }

        .status-full {
            background: #fff7ed;
            color: #d97706;
        }

        .status-maintenance {
            background: #fef2f2;
            color: #dc2626;
        }

        .status-reserved {
            background: #f5f3ff;
            color: #7c3aed;
        }

        /* Card Content */
        .room-info {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .room-meta-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 0.75rem;
        }

        .meta-tag {
            background: #f1f5f9;
            color: #475569;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 8px;
        }

        .room-card-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.5rem;
            line-height: 1.3;
        }

        .room-price-container {
            margin-bottom: 0.75rem;
        }

        .room-price-value {
            font-size: 1.4rem;
            font-weight: 800;
            color: #4f46e5;
        }

        .room-price-unit {
            font-size: 0.85rem;
            color: #64748b;
            font-weight: 500;
        }

        .room-description {
            font-size: 0.88rem;
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 1.5rem;
            /* Clamp description to 2 lines */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 2.6rem;
        }

        /* Buttons block */
        .card-button-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: auto;
        }

        .btn-card-action {
            height: 42px;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .btn-card-detail {
            border: 1.5px solid #e2e8f0;
            background: #ffffff;
            color: #475569;
        }

        .btn-card-detail:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #1e293b;
        }

        .btn-card-book {
            background: #0f172a;
            color: #ffffff;
            border: none;
        }

        .btn-card-book:hover {
            background: #1e293b;
            color: #ffffff;
        }

        /* Pagination style */
        .pagination-container {
            margin-top: 3rem;
        }

        .page-link-custom {
            width: 40px;
            height: 40px;
            border-radius: 10px !important;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #475569;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
            margin: 0 4px;
        }

        .page-link-custom:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        .page-item.active .page-link-custom {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #ffffff;
            border: none;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
        }
    </style>
}

<div class="rooms-container container-fluid p-4">
    <!-- Hero Banner -->
    <div class="hero-banner">
        <h1 class="hero-title">Tìm Kiếm Phòng KTX Hoàn Hảo</h1>
        <p class="hero-subtitle">Khám phá các loại phòng hiện đại, đầy đủ tiện nghi với chi phí hợp lý. Đăng ký phòng trực tuyến dễ dàng và tiện lợi ngay hôm nay.</p>
    </div>

    <!-- Filter and Search Box -->
    <div class="filter-panel">
        <h5 class="filter-title"><i class="fas fa-filter text-indigo"></i> Bộ lọc tìm kiếm</h5>
        <form method="get" asp-action="Rooms" id="filterForm">
            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <div class="search-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control input-custom" placeholder="Số phòng (VD: P101, P102)...">
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <select name="BlockId" class="form-select input-custom">
                        <option value="">Tất cả tòa nhà</option>
                        @if (ViewBag.Blocks != null)
                        {
                            foreach (var block in (IEnumerable<SelectListItem>)ViewBag.Blocks)
                            {
                                <option value="@block.Value" selected="@block.Selected">@block.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <select name="RoomTypeId" class="form-select input-custom">
                        <option value="">Tất cả loại phòng</option>
                        @if (ViewBag.RoomTypes != null)
                        {
                            foreach (var rt in (IEnumerable<SelectListItem>)ViewBag.RoomTypes)
                            {
                                <option value="@rt.Value" selected="@rt.Selected">@rt.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <input type="number" name="MinPrice" value="@filter.MinPrice" class="form-control input-custom" placeholder="Giá từ (đ)...">
                        <span class="input-group-text bg-transparent border-0 text-muted align-self-center px-2">~</span>
                        <input type="number" name="MaxPrice" value="@filter.MaxPrice" class="form-control input-custom" placeholder="Đến (đ)...">
                    </div>
                </div>

                <div class="col-lg-2 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-action-filter btn-search-apply flex-grow-1">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                    <a asp-action="Rooms" class="btn btn-action-filter btn-search-reset" title="Làm mới">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Room Cards Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 room-grid">
        @if (Model.Items != null && Model.Items.Any())
        {
            foreach (var item in Model.Items)
            {
                var statusEnum = Enum.TryParse<RoomStatus>(item.Status.ToString(), out var res) ? res : RoomStatus.Available;

                // Pick mockup image depending on capacity
                string imageUrl = item.MaxOccupants switch
                {
                    2 => "https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=600&q=80",
                    4 => "https://images.unsplash.com/photo-1598928506311-c55ded91a20c?auto=format&fit=crop&w=600&q=80",
                    6 => "https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=600&q=80",
                    8 => "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80",
                    _ => "https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=600&q=80"
                };

                <div class="col">
                    <div class="room-card">
                        <!-- Badges -->
                        @if (statusEnum == RoomStatus.Available && item.BasePrice > 1000000)
                        {
                            <div class="badge-popular">
                                <i class="fas fa-fire text-danger"></i> Phổ biến
                            </div>
                        }

                        <div class="badge-status @(statusEnum switch {
                            RoomStatus.Available => "status-available",
                            RoomStatus.Full => "status-full",
                            RoomStatus.Maintenance => "status-maintenance",
                            RoomStatus.Reserved => "status-reserved",
                            _ => "status-available"
                        })">
                            @(statusEnum switch {
                                RoomStatus.Available => "Còn trống",
                                RoomStatus.Full => "Đã đầy",
                                RoomStatus.Maintenance => "Bảo trì",
                                RoomStatus.Reserved => "Đã đặt trước",
                                _ => item.Status
                            })
                        </div>

                        <!-- Image -->
                        <div class="room-image-wrapper">
                            <img src="@imageUrl" alt="Phòng @item.RoomNumber" class="room-image" onerror="this.onerror=null; this.src='/images/room-placeholder.svg';" />
                        </div>

                        <!-- Content -->
                        <div class="room-info">
                            <div class="room-meta-tags">
                                <span class="meta-tag"><i class="fas fa-building me-1"></i>Tòa @item.BlockName</span>
                                <span class="meta-tag"><i class="fas fa-layer-group me-1"></i>Tầng @item.Floor</span>
                                <span class="meta-tag"><i class="fas fa-user-friends me-1"></i>Tối đa @item.MaxOccupants người</span>
                            </div>

                            <h3 class="room-card-title">Phòng @item.RoomNumber - @item.RoomTypeName</h3>

                            <div class="room-price-container">
                                <span class="room-price-value">@item.BasePrice.ToString("N0") đ</span>
                                <span class="room-price-unit">/ tháng</span>
                            </div>

                            <p class="room-description">@(!string.IsNullOrEmpty(item.Description) ? item.Description : "Không có mô tả chi tiết.")</p>

                            <!-- Actions -->
                            <div class="card-button-group">
                                <a asp-action="RoomDetails" asp-route-id="@item.Id" class="btn btn-card-detail btn-card-action">
                                    Chi tiết
                                </a>
                                @if (statusEnum == RoomStatus.Available)
                                {
                                    <button type="button" class="btn btn-card-book btn-card-action" onclick="onBookRoom('@item.Id', '@item.RoomNumber', '@item.BasePrice.ToString("N0")')">
                                        Đặt phòng
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-card-book btn-card-action disabled" disabled>
                                        Hết phòng
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center">
                <div class="text-muted fs-4"><i class="fas fa-search-minus fa-2x mb-3"></i></div>
                <h5 class="text-muted fw-bold">Không tìm thấy phòng phù hợp với bộ lọc</h5>
                <p class="text-muted small">Hãy thử tìm số phòng khác hoặc làm mới bộ lọc.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    <div class="card border-0 shadow-sm mt-5" style="border-radius: 16px; overflow: hidden;">
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

<!-- Modal Đặt Phòng Dành Cho Sinh Viên -->
@if (isAuthenticated && isStudent)
{
    <div class="modal fade" id="bookRoomModal" tabindex="-1" aria-labelledby="bookRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border-bottom: none;">
                    <h5 class="modal-title fw-bold" id="bookRoomModalLabel"><i class="fas fa-file-signature me-2"></i> Đăng Ký Đặt Phòng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="bookingForm" onsubmit="submitBooking(event)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="bookRoomId" name="RoomId" />
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Phòng đăng ký</label>
                            <input type="text" class="form-control input-custom bg-light" id="bookRoomNumber" readonly style="font-weight: 600;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Chọn giường <span class="text-danger">*</span></label>
                            <select class="form-select input-custom" id="bookBedId" required>
                                <option value="">-- Đang tải danh sách giường... --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Đơn giá thuê</label>
                            <input type="text" class="form-control input-custom bg-light" id="bookRoomPrice" readonly style="font-weight: 600; color: #4f46e5;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Ngày dự kiến nhận phòng <span class="text-danger">*</span></label>
                            <input type="date" class="form-control input-custom" id="bookStartDate" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Ghi chú / Yêu cầu thêm</label>
                            <textarea class="form-control" id="bookNotes" rows="3" style="border-radius: 12px; border: 1.5px solid #e2e8f0; font-size: 0.95rem; font-weight: 500;" placeholder="VD: Muốn ở giường tầng dưới..."></textarea>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="button" class="btn btn-secondary w-50" data-bs-dismiss="modal" style="height: 48px; border-radius: 12px; font-weight: 600;">Hủy bỏ</button>
                            <button type="submit" class="btn btn-indigo text-white w-50" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border: none; height: 48px; border-radius: 12px; font-weight: 600;">
                                Gửi yêu cầu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function onBookRoom(id, roomNumber, price) {
            const isAuthenticated = @(isAuthenticated ? "true" : "false");
            const isStudent = @(isStudent ? "true" : "false");

            if (!isAuthenticated) {
                Swal.fire({
                    title: 'Yêu cầu đăng nhập!',
                    text: 'Bạn cần đăng nhập với tài khoản Sinh viên để đăng ký đặt phòng.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#6366f1',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: '<i class="fas fa-sign-in-alt me-1"></i> Đăng nhập ngay',
                    cancelButtonText: 'Đóng',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Account/Login';
                    }
                });
            } else if (!isStudent) {
                Swal.fire({
                    title: 'Hạn chế chức năng',
                    text: 'Hệ thống chỉ hỗ trợ Sinh viên thực hiện đặt phòng. Bạn đang đăng nhập với tài khoản không có quyền Sinh viên.',
                    icon: 'info',
                    confirmButtonColor: '#4f46e5',
                    confirmButtonText: 'Đã hiểu'
                });
            } else {
                const bedSelect = $('#bookBedId');
                bedSelect.empty().append('<option value="">-- Đang tải danh sách giường... --</option>').prop('disabled', true);

                // Open student booking modal
                $('#bookRoomId').val(id);
                $('#bookRoomNumber').val('Phòng ' + roomNumber);
                $('#bookRoomPrice').val(price + ' đ / tháng');
                $('#bookStartDate').val(new Date().toISOString().split('T')[0]);
                const myModal = new bootstrap.Modal(document.getElementById('bookRoomModal'));
                myModal.show();

                // Fetch available beds
                $.ajax({
                    url: '/Rooms/' + id + '/AvailableBeds',
                    type: 'GET',
                    success: function (beds) {
                        bedSelect.empty().prop('disabled', false);
                        if (beds && beds.length > 0) {
                            bedSelect.append('<option value="">-- Chọn giường trống --</option>');
                            beds.forEach(function (bed) {
                                bedSelect.append('<option value="' + bed.id + '">Giường ' + bed.bedNumber + '</option>');
                            });
                        } else {
                            bedSelect.append('<option value="">-- Không còn giường trống --</option>');
                            bedSelect.prop('disabled', true);
                        }
                    },
                    error: function () {
                        bedSelect.empty().append('<option value="">-- Lỗi tải danh sách giường --</option>').prop('disabled', true);
                    }
                });
            }
        }

        function submitBooking(event) {
            event.preventDefault();
            
            const bedId = $('#bookBedId').val();
            const startDate = $('#bookStartDate').val();
            const notes = $('#bookNotes').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!bedId) {
                Swal.fire({
                    title: 'Lỗi!',
                    text: 'Vui lòng chọn giường trống.',
                    icon: 'error',
                    confirmButtonColor: '#4f46e5'
                });
                return;
            }

            // Close the bootstrap modal first
            const modalEl = document.getElementById('bookRoomModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            Swal.fire({
                title: 'Đang gửi yêu cầu...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/Contract/Register',
                type: 'POST',
                data: {
                    bedId: bedId,
                    startDate: startDate,
                    notes: notes,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#4f46e5',
                            confirmButtonText: 'Đồng ý'
                        }).then(() => {
                            window.location.href = '/Contract/MyContracts';
                        });
                    } else {
                        Swal.fire({
                            title: 'Thất bại!',
                            text: res.message,
                            icon: 'error',
                            confirmButtonColor: '#4f46e5',
                            confirmButtonText: 'Đóng'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        title: 'Lỗi hệ thống!',
                        text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                        icon: 'error',
                        confirmButtonColor: '#4f46e5',
                        confirmButtonText: 'Đóng'
                    });
                }
            });
        }
    </script>
}
