@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4">

    <!-- ================= ADMIN + MANAGER ================= -->
    @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff"))
    {
        <h4 class="mb-4">📊 Dashboard Quản lý</h4>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6>Phòng</h6>
                        <h3 class="text-primary">120</h3>
                        <small class="text-muted">80 đã thuê / 40 trống</small>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6>Doanh thu dịch vụ</h6>
                        <h3 class="text-success">45,000,000đ</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6>Doanh thu phòng</h6>
                        <h3 class="text-danger">120,000,000đ</h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="card mt-4 shadow-sm">
            <div class="card-body">
                <h6>Top phòng doanh thu cao</h6>
                <table class="table mt-3">
                    <thead>
                        <tr>
                            <th>Phòng</th>
                            <th>Sinh viên</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>A101</td>
                            <td>4</td>
                            <td>12,000,000đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ================= TECHNICAL ================= -->
    @if (User.IsInRole("TechnicalStaff"))
    {
        <h4 class="mb-4">🛠️ Dashboard Kỹ thuật</h4>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card"><div class="card-body text-success">Hoàn thành: 32</div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body text-warning">Đang xử lý: 12</div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body text-danger">Không xử lý: 5</div></div>
            </div>
        </div>
    }

    <!-- ================= STUDENT ================= -->
    @if (User.IsInRole("Student"))
    {
        <h4 class="mb-4">💰 Chi phí của bạn</h4>

        <div class="card shadow-sm">
            <div class="card-body">
                <canvas id="studentChart"></canvas>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @if (User.IsInRole("Student"))
    {
        <script>
            new Chart(document.getElementById('studentChart'), {
                type: 'bar',
                data: {
                    labels: ['T1', 'T2', 'T3', 'T4'],
                    datasets: [
                        { label: 'Phòng', data: [1200, 1200, 1200, 1200], backgroundColor: '#4e73df' },
                        { label: 'Điện', data: [200, 250, 180, 300], backgroundColor: '#f6c23e' },
                        { label: 'Nước', data: [100, 120, 90, 110], backgroundColor: '#1cc88a' }
                    ]
                }
            });
        </script>
    }
}