@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4">

    <!-- ================= GUEST (UNAUTHENTICATED) ================= -->
    @if (!User.Identity!.IsAuthenticated)
    {
        <div class="guest-hero text-center py-5 px-4 mb-5 rounded-4 shadow-sm text-white"
            style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
            <h1 class="display-4 fw-bold mb-3">Chào Mừng Đến Với KTX DMS</h1>
            <p class="lead mb-4 mx-auto" style="max-width: 600px;">Hệ thống quản lý ký túc xá thông minh, tiện lợi và hiện
                đại. Trải nghiệm không gian sống lý tưởng cùng các dịch vụ tiện ích hàng đầu.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/Rooms" class="btn btn-light btn-lg px-4 py-2 fw-semibold text-primary"
                    style="border-radius: 12px; transition: all 0.3s;">
                    <i class="fa-solid fa-door-open me-2"></i>Xem danh sách phòng
                </a>
                <a href="/Account/Login" class="btn btn-outline-light btn-lg px-4 py-2 fw-semibold"
                    style="border-radius: 12px; transition: all 0.3s;">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng nhập ngay
                </a>
            </div>
        </div>

        <!-- Thống kê nhanh -->
        <div class="row text-center mb-5 g-4">
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm py-4 h-100 rounded-4" style="transition: transform 0.2s;">
                    <h2 class="fw-bold text-primary mb-1">5+</h2>
                    <p class="text-muted mb-0 fw-medium">Tòa nhà lớn</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm py-4 h-100 rounded-4" style="transition: transform 0.2s;">
                    <h2 class="fw-bold text-success mb-1">500+</h2>
                    <p class="text-muted mb-0 fw-medium">Phòng ở tiện nghi</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm py-4 h-100 rounded-4" style="transition: transform 0.2s;">
                    <h2 class="fw-bold text-info mb-1">2000+</h2>
                    <p class="text-muted mb-0 fw-medium">Sinh viên nội trú</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm py-4 h-100 rounded-4" style="transition: transform 0.2s;">
                    <h2 class="fw-bold text-warning mb-1">99%</h2>
                    <p class="text-muted mb-0 fw-medium">Độ hài lòng</p>
                </div>
            </div>
        </div>

        <!-- Khối hành động nhanh -->
        <h3 class="fw-bold mb-4 text-dark text-center">Tiện Ích Và Dịch Vụ Nổi Bật</h3>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-4 text-center cursor-pointer quick-card"
                    onclick="location.href='/Rooms'">
                    <div class="icon-box mx-auto mb-3 bg-light text-primary rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 60px; height: 60px; font-size: 24px;">
                        <i class="fa-solid fa-hotel"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Xem Phòng KTX</h5>
                    <p class="text-muted small mb-0">Tìm kiếm phòng trống, phòng dịch vụ chất lượng cao theo nhu cầu của
                        bạn.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-4 text-center cursor-pointer quick-card"
                    onclick="location.href='/Regulation'">
                    <div class="icon-box mx-auto mb-3 bg-light text-success rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 60px; height: 60px; font-size: 24px;">
                        <i class="fa-solid fa-gavel"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Nội Quy KTX</h5>
                    <p class="text-muted small mb-0">Xem các quy định nội quy, tiêu chuẩn sinh hoạt tại ký túc xá.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-4 text-center cursor-pointer quick-card"
                    onclick="promptStudentService()">
                    <div class="icon-box mx-auto mb-3 bg-light text-info rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 60px; height: 60px; font-size: 24px;">
                        <i class="fa-solid fa-hand-holding-hand"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Dịch Vụ Cá Nhân</h5>
                    <p class="text-muted small mb-0">Đăng ký dịch vụ giặt là, ăn uống, internet và gửi phản hồi kỹ thuật.
                    </p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-4 text-center cursor-pointer quick-card"
                    onclick="promptContactForm()">
                    <div class="icon-box mx-auto mb-3 bg-light text-warning rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 60px; height: 60px; font-size: 24px;">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Gửi Phản Hồi</h5>
                    <p class="text-muted small mb-0">Liên hệ với ban quản lý để được hỗ trợ giải đáp nhanh chóng.</p>
                </div>
            </div>
        </div>

        <style>
            .quick-card {
                cursor: pointer;
                transition: all 0.3s ease;
                border: 1px solid #f1f5f9 !important;
            }

            .quick-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
                border-color: #3b82f6 !important;
            }
        </style>
    }

    <!-- ================= ADMIN + MANAGER ================= -->
    @if (User.Identity!.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("ManagementStaff") || User.IsInRole("ManagerStaff") || User.IsInRole("Manager")))
    {
        <!-- Header -->
        <div class="welcome-header mb-4 p-4 rounded-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3"
             style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%);">
            <div>
                <h2 class="fw-bold mb-1">Xin chào, Quản trị viên!</h2>
                <p class="mb-0 text-white-50">Chào mừng bạn quay lại hệ thống quản lý KTX DMS.</p>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark px-3 py-2 rounded-3">
                    <i class="fa-solid fa-clock me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-4 mb-4">
            <!-- Sinh viên -->
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden card-kpi"
                     style="border-left: 5px solid #3b82f6 !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small uppercase fw-bold">Tổng Sinh Viên</span>
                            <h3 class="fw-extrabold text-dark mt-1 mb-0">@ViewBag.TotalStudents</h3>
                        </div>
                        <div class="kpi-icon bg-blue-light text-primary rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 50px; height: 50px; font-size: 20px;">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                    </div>
                    <div class="small text-muted border-top pt-2">
                        <i class="fa-solid fa-bed me-1 text-primary"></i> Lấp đầy giường: <strong>@ViewBag.OccupancyRate%</strong>
                    </div>
                </div>
            </div>

            <!-- Phòng ở -->
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden card-kpi"
                     style="border-left: 5px solid #10b981 !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small uppercase fw-bold">Quản Lý Phòng</span>
                            <h3 class="fw-extrabold text-dark mt-1 mb-0">@ViewBag.TotalRooms</h3>
                        </div>
                        <div class="kpi-icon bg-green-light text-success rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 50px; height: 50px; font-size: 20px;">
                            <i class="fa-solid fa-hotel"></i>
                        </div>
                    </div>
                    <div class="small text-muted border-top pt-2">
                        <span class="badge bg-success-soft text-success me-1">@ViewBag.RoomStatusAvailable Trống</span>
                        <span class="badge bg-danger-soft text-danger me-1">@ViewBag.RoomStatusFull Đầy</span>
                        <span class="badge bg-warning-soft text-warning">@ViewBag.RoomStatusMaintenance B.trì</span>
                    </div>
                </div>
            </div>

            <!-- Hợp đồng -->
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden card-kpi"
                     style="border-left: 5px solid #6366f1 !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small uppercase fw-bold">Hợp Đồng</span>
                            <h3 class="fw-extrabold text-dark mt-1 mb-0">@ViewBag.ActiveContractsCount</h3>
                        </div>
                        <div class="kpi-icon bg-indigo-light text-indigo rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 50px; height: 50px; font-size: 20px; color: #6366f1; background-color: #e0e7ff;">
                            <i class="fa-solid fa-file-signature"></i>
                        </div>
                    </div>
                    <div class="small text-muted border-top pt-2">
                        <i class="fa-solid fa-circle-exclamation me-1 text-warning"></i> Chờ duyệt: <strong>@ViewBag.PendingContractsCount</strong>
                    </div>
                </div>
            </div>

            <!-- Tài chính / Sự cố -->
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden card-kpi"
                     style="border-left: 5px solid #f59e0b !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small uppercase fw-bold">Cần Lưu Ý</span>
                            <h3 class="fw-extrabold text-dark mt-1 mb-0">@(ViewBag.OpenMaintenanceCount + ViewBag.InProgressMaintenanceCount)</h3>
                        </div>
                        <div class="kpi-icon bg-orange-light text-warning rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 50px; height: 50px; font-size: 20px;">
                            <i class="fa-solid fa-bell"></i>
                        </div>
                    </div>
                    <div class="small text-muted border-top pt-2">
                        <i class="fa-solid fa-circle-exclamation me-1 text-danger"></i> Vi phạm mới: <strong>@ViewBag.NewViolationsCount</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Center -->
        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-bolt me-2 text-warning"></i>Thao Tác Nhanh</h5>
        <div class="row g-3 mb-4 text-center">
            <div class="col-6 col-md-3 col-lg-2">
                <a href="/Contract" class="card border-0 shadow-sm p-3 rounded-3 text-decoration-none action-item">
                    <div class="action-icon mx-auto mb-2 bg-indigo-light text-indigo rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 18px; color: #6366f1; background-color: #e0e7ff;">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <span class="small fw-semibold text-dark">Duyệt hợp đồng</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a href="/Invoice/Create" class="card border-0 shadow-sm p-3 rounded-3 text-decoration-none action-item">
                    <div class="action-icon mx-auto mb-2 bg-green-light text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 18px;">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                    <span class="small fw-semibold text-dark">Tạo hóa đơn</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a href="/Utility" class="card border-0 shadow-sm p-3 rounded-3 text-decoration-none action-item">
                    <div class="action-icon mx-auto mb-2 bg-orange-light text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 18px;">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span class="small fw-semibold text-dark">Nhập số điện nước</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a href="/Room/Create" class="card border-0 shadow-sm p-3 rounded-3 text-decoration-none action-item">
                    <div class="action-icon mx-auto mb-2 bg-blue-light text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 18px;">
                        <i class="fa-solid fa-plus"></i>
                    </div>
                    <span class="small fw-semibold text-dark">Thêm phòng mới</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a href="/Violation" class="card border-0 shadow-sm p-3 rounded-3 text-decoration-none action-item">
                    <div class="action-icon mx-auto mb-2 bg-danger-soft text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 18px;">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                    <span class="small fw-semibold text-dark">Ghi nhận vi phạm</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a href="/Statistic" class="card border-0 shadow-sm p-3 rounded-3 text-decoration-none action-item">
                    <div class="action-icon mx-auto mb-2 bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-size: 18px; background-color: #64748b !important;">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <span class="small fw-semibold text-dark">Xem báo cáo</span>
                </a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Column 1: Biểu đồ doanh thu -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                        <i class="fa-solid fa-chart-column me-2 text-primary"></i>Tóm tắt doanh thu dịch vụ & phòng (6 tháng gần nhất)
                    </h5>
                    <div class="chart-container" style="position: relative; height: 320px;">
                        <canvas id="adminRevenueChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Column 2: Danh sách việc cần làm -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                            <i class="fa-solid fa-list-check me-2 text-danger"></i>Công Việc Cần Làm
                        </h5>
                        
                        <div class="d-grid gap-3">
                            <!-- Hợp đồng chờ duyệt -->
                            <a href="/Contract" class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 text-decoration-none item-todo">
                                <div class="d-flex align-items-center">
                                    <div class="bg-indigo-light text-indigo rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; color: #6366f1; background-color: #e0e7ff;">
                                        <i class="fa-solid fa-file-contract"></i>
                                    </div>
                                    <span class="text-dark fw-semibold small">Hợp đồng chờ duyệt</span>
                                </div>
                                <span class="badge bg-indigo rounded-pill font-bold" style="background-color: #6366f1;">@ViewBag.PendingContractsCount</span>
                            </a>

                            <!-- Sự cố bảo trì -->
                            <a href="/MaintenanceRequest" class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 text-decoration-none item-todo">
                                <div class="d-flex align-items-center">
                                    <div class="bg-orange-light text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        <i class="fa-solid fa-screwdriver-wrench"></i>
                                    </div>
                                    <span class="text-dark fw-semibold small">Sự cố đang chờ</span>
                                </div>
                                <span class="badge bg-warning text-dark rounded-pill font-bold">@ViewBag.OpenMaintenanceCount</span>
                            </a>

                            <!-- Vi phạm -->
                            <a href="/Violation" class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 text-decoration-none item-todo">
                                <div class="d-flex align-items-center">
                                    <div class="bg-danger-soft text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                    </div>
                                    <span class="text-dark fw-semibold small">Vi phạm mới</span>
                                </div>
                                <span class="badge bg-danger rounded-pill font-bold">@ViewBag.NewViolationsCount</span>
                            </a>

                            <!-- Hóa đơn chưa thanh toán -->
                            <a href="/Invoice" class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 text-decoration-none item-todo">
                                <div class="d-flex align-items-center">
                                    <div class="bg-red-light text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; background-color: #fef2f2; color: #ef4444;">
                                        <i class="fa-solid fa-receipt"></i>
                                    </div>
                                    <span class="text-dark fw-semibold small">Hóa đơn chưa thanh toán</span>
                                </div>
                                <span class="badge bg-danger rounded-pill font-bold">@ViewBag.UnpaidInvoicesCount</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <style>
            .bg-blue-light { background-color: #eff6ff; color: #3b82f6; }
            .bg-green-light { background-color: #ecfdf5; color: #10b981; }
            .bg-orange-light { background-color: #fffbeb; color: #f59e0b; }
            .badge-soft-success { background-color: #d1fae5; color: #065f46; }
            .badge-soft-danger { background-color: #fee2e2; color: #991b1b; }
            .bg-danger-soft { background-color: #fef2f2; color: #ef4444; }
            
            .card-kpi {
                transition: all 0.3s ease;
            }
            .card-kpi:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
            }
            
            .action-item {
                transition: all 0.3s ease;
                border: 1px solid #f1f5f9 !important;
            }
            .action-item:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 16px rgba(0,0,0,0.06) !important;
                border-color: #3b82f6 !important;
            }
            
            .item-todo {
                transition: all 0.2s ease;
                border: 1px solid #f1f5f9 !important;
            }
            .item-todo:hover {
                background-color: #f8fafc !important;
                border-color: #cbd5e1 !important;
                padding-left: 1.25rem !important;
            }
        </style>
    }

    <!-- ================= TECHNICAL ================= -->
    @if (User.Identity!.IsAuthenticated && User.IsInRole("TechnicalStaff"))
    {
        <!-- Header -->
        <div class="welcome-header mb-4 p-4 rounded-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3"
             style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
            <div>
                <h2 class="fw-bold mb-1">Xin chào, Nhân viên Kỹ thuật!</h2>
                <p class="mb-0 text-white-50">Chào mừng bạn quay lại hệ thống quản lý KTX DMS.</p>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark px-3 py-2 rounded-3">
                    <i class="fa-solid fa-screwdriver-wrench me-1"></i> Đội Kỹ thuật
                </span>
            </div>
        </div>

        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-list-check me-2 text-primary"></i>Danh sách Công việc Bảo trì</h5>
        <div class="row g-4 mb-4">
            <!-- Yêu cầu mới -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center card-kpi" style="border-top: 5px solid #ef4444 !important;">
                    <div class="icon-box mx-auto mb-3 bg-danger-soft text-danger rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 55px; height: 55px; font-size: 22px;">
                        <i class="fa-solid fa-envelope-open-text"></i>
                    </div>
                    <span class="text-muted small fw-bold">YÊU CẦU MỚI CHỜ TIẾP NHẬN</span>
                    <h2 class="fw-extrabold text-danger mt-2 mb-0">@ViewBag.OpenMaintenanceCount</h2>
                    <a href="/MaintenanceRequest" class="btn btn-outline-danger btn-sm mt-3 w-100 rounded-pill small">Xem danh sách</a>
                </div>
            </div>

            <!-- Đang sửa chữa -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center card-kpi" style="border-top: 5px solid #f59e0b !important;">
                    <div class="icon-box mx-auto mb-3 bg-orange-light text-warning rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 55px; height: 55px; font-size: 22px;">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                    <span class="text-muted small fw-bold">ĐANG TIẾN HÀNH SỬA CHỮA</span>
                    <h2 class="fw-extrabold text-warning mt-2 mb-0">@ViewBag.InProgressMaintenanceCount</h2>
                    <a href="/MaintenanceRequest" class="btn btn-outline-warning btn-sm mt-3 w-100 rounded-pill small">Xem tiến trình</a>
                </div>
            </div>

            <!-- Đã hoàn thành -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center card-kpi" style="border-top: 5px solid #10b981 !important;">
                    <div class="icon-box mx-auto mb-3 bg-green-light text-success rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 55px; height: 55px; font-size: 22px;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <span class="text-muted small fw-bold">ĐÃ XỬ LÝ (RESOLVED / CLOSED)</span>
                    <h2 class="fw-extrabold text-success mt-2 mb-0">@(ViewBag.ResolvedMaintenanceCount + ViewBag.ClosedMaintenanceCount)</h2>
                    <a href="/MaintenanceRequest" class="btn btn-outline-success btn-sm mt-3 w-100 rounded-pill small">Lịch sử sửa chữa</a>
                </div>
            </div>
        </div>
    }

    <!-- ================= STUDENT ================= -->
    @if (User.Identity!.IsAuthenticated && User.IsInRole("Student"))
    {
        <div class="student-dashboard">
            <!-- HEADER CHÀO MỪNG -->
            <div class="welcome-header mb-4 p-4 rounded-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3"
                 style="background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);">
                <div>
                    <h2 class="fw-bold mb-1">Xin chào, @ViewBag.StudentName!</h2>
                    <p class="mb-0 text-white-50">Chào mừng bạn quay lại hệ thống quản lý KTX DMS.</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-white text-indigo font-bold px-3 py-2 rounded-3">
                        <i class="fa-solid fa-calendar me-1"></i> Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")
                    </span>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- THÔNG TIN PHÒNG Ở -->
                <div class="col-xl-7 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                            <i class="fa-solid fa-hotel me-2 text-primary"></i>Thông tin phòng ở hiện tại
                        </h5>
                        
                        @if (ViewBag.HasActiveContract == true)
                        {
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded-3">
                                        <small class="text-muted d-block mb-1">Phòng & Tòa</small>
                                        <span class="fw-bold text-primary fs-5">@ViewBag.RoomName</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded-3">
                                        <small class="text-muted d-block mb-1">Vị trí giường</small>
                                        <span class="fw-bold text-dark fs-5">Giường @ViewBag.BedNumber</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded-3">
                                        <small class="text-muted d-block mb-1">Loại phòng</small>
                                        <span class="fw-semibold text-secondary">@ViewBag.RoomType</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded-3">
                                        <small class="text-muted d-block mb-1">Đơn giá phòng</small>
                                        <span class="fw-bold text-success">@string.Format("{0:N0} đ/tháng", ViewBag.RoomPrice)</span>
                                    </div>
                                </div>
                                
                                <div class="col-12 mt-3 pt-3 border-top">
                                    <div class="d-flex flex-wrap justify-content-between text-muted small mb-2">
                                        <span>Mã hợp đồng: <strong>@ViewBag.ContractCode</strong></span>
                                        <span>Thời hạn: <strong>@ViewBag.StartDate - @ViewBag.EndDate</strong></span>
                                    </div>
                                </div>

                                <div class="col-12 mt-2">
                                    <h6 class="fw-bold text-dark mb-2 small"><i class="fa-solid fa-users me-1 text-info"></i> Bạn cùng phòng (@(ViewBag.Roommates?.Count ?? 0)):</h6>
                                    @if (ViewBag.Roommates != null && ViewBag.Roommates.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var roommate in ViewBag.Roommates)
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-1"><i class="fa-regular fa-user me-1 text-secondary"></i>@roommate</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Phòng chưa có sinh viên khác ở cùng.</span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 my-auto">
                                <div class="icon-box mx-auto mb-3 bg-light text-warning rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 70px; height: 70px; font-size: 30px;">
                                    <i class="fa-solid fa-house-chimney-user"></i>
                                </div>
                                <h6 class="fw-bold text-dark">Chưa có phòng ở đang hoạt động</h6>
                                <p class="text-muted small mb-4">Bạn chưa đăng ký phòng ở hoặc hợp đồng đang chờ duyệt.</p>
                                <a href="/Rooms" class="btn btn-primary px-4 fw-semibold" style="border-radius: 10px;">
                                    <i class="fa-solid fa-door-open me-2"></i>Đăng ký đặt phòng ngay
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- TÌNH HÌNH TÀI CHÍNH -->
                <div class="col-xl-5 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                                <i class="fa-solid fa-wallet me-2 text-success"></i>Tình hình tài chính
                            </h5>
                            
                            <div class="text-center py-3">
                                <small class="text-muted d-block uppercase tracking-wider mb-1">Cần thanh toán hiện tại</small>
                                <h2 class="fw-extrabold text-danger mb-2">@string.Format("{0:N0} đ", ViewBag.UnpaidAmount ?? 0)</h2>
                                <span class="badge bg-danger-soft text-danger px-3 py-2 rounded-pill font-semibold small">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> @(ViewBag.UnpaidCount ?? 0) hóa đơn chưa thanh toán
                                </span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <div class="d-grid gap-2">
                                <a href="/Payment" class="btn btn-success py-2.5 fw-bold" style="border-radius: 12px; box-shadow: 0 4px 12px rgba(25, 135, 84, 0.2);">
                                    <i class="fa-solid fa-credit-card me-2"></i>Xem và thanh toán hóa đơn
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PHẦN VI PHẠM KỶ LUẬT -->
            <div class="row g-4 mb-4">
                <!-- Thống kê vi phạm -->
                <div class="col-xl-4 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4" style="border-left: 5px solid #ef4444 !important;">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                            <i class="fa-solid fa-triangle-exclamation me-2 text-danger"></i>Tình trạng kỷ luật
                        </h5>

                        @{
                            var violations = ViewBag.Violations as List<DormitoryManagement.Application.Dtos.Requests.ViolationResponseDto>;
                            var pendingCount = (int)(ViewBag.PendingViolationsCount ?? 0);
                            var totalFine = (decimal)(ViewBag.TotalFineAmount ?? 0m);
                        }

                        @if (violations == null || !violations.Any())
                        {
                            <div class="text-center py-4">
                                <div class="icon-box mx-auto mb-3 bg-light text-success rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 70px; height: 70px; font-size: 28px;">
                                    <i class="fa-solid fa-shield-check"></i>
                                </div>
                                <h6 class="fw-bold text-success">Chưa có vi phạm nào!</h6>
                                <p class="text-muted small mb-0">Bạn đang chấp hành tốt nội quy ký túc xá.</p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center mb-4">
                                <span class="badge rounded-pill px-3 py-2 fs-6 @(pendingCount > 0 ? "bg-danger" : "bg-success")">
                                    <i class="fa-solid @(pendingCount > 0 ? "fa-circle-exclamation" : "fa-circle-check") me-1"></i>
                                    @if (pendingCount > 0) { <text>@pendingCount vi phạm chưa xử lý</text> }
                                    else { <text>Đã xử lý tất cả</text> }
                                </span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded-3 text-center">
                                        <small class="text-muted d-block mb-1">Tổng biên bản</small>
                                        <span class="fw-bold text-dark fs-4">@violations.Count</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 rounded-3 text-center @(totalFine > 0 ? "bg-danger-soft" : "bg-light")">
                                        <small class="text-muted d-block mb-1">Tiền phạt còn lại</small>
                                        <span class="fw-bold @(totalFine > 0 ? "text-danger" : "text-success") fs-6">
                                            @string.Format("{0:N0} đ", totalFine)
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <a href="/Violation" class="btn btn-outline-danger w-100 fw-semibold" style="border-radius: 10px;">
                                <i class="fa-solid fa-list me-2"></i>Xem chi tiết biên bản vi phạm
                            </a>
                        }
                    </div>
                </div>

                <!-- Danh sách vi phạm gần nhất -->
                <div class="col-xl-8 col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                            <i class="fa-solid fa-clipboard-list me-2 text-warning"></i>Lịch sử vi phạm (gần nhất)
                        </h5>

                        @if (violations == null || !violations.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa-solid fa-shield-halved fa-3x mb-3 opacity-25"></i>
                                <p class="mb-0">Không có lịch sử vi phạm nào.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 small">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-3 py-2">Ngày vi phạm</th>
                                            <th class="py-2">Nội dung</th>
                                            <th class="py-2">Mức độ</th>
                                            <th class="py-2">Tiền phạt</th>
                                            <th class="py-2">Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in violations.Take(5))
                                        {
                                            <tr>
                                                <td class="ps-3 text-muted">@v.Date.ToString("dd/MM/yyyy")</td>
                                                <td style="max-width: 200px;" class="text-truncate" title="@v.Content">@v.Content</td>
                                                <td>
                                                    <span class="badge rounded-pill px-2 py-1
                                                        @(v.Severity == "Nhẹ" ? "bg-success-subtle text-success" :
                                                          v.Severity == "Trung bình" ? "bg-warning-subtle text-warning" :
                                                          v.Severity == "Nghiêm trọng" ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")">
                                                        @v.Severity
                                                    </span>
                                                </td>
                                                <td class="fw-semibold text-danger">@string.Format("{0:N0} đ", v.FineAmount)</td>
                                                <td>
                                                    @if (v.Status == "Đã xử lý")
                                                    {
                                                        <span class="badge bg-success-subtle text-success">
                                                            <i class="fa-solid fa-check me-1"></i>Đã xử lý
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger">
                                                            <i class="fa-solid fa-clock me-1"></i>Chưa xử lý
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (violations.Count > 5)
                            {
                                <div class="text-center mt-3">
                                    <a href="/Violation" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        <i class="fa-solid fa-angles-right me-1"></i>Xem tất cả @violations.Count biên bản
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- BIỂU ĐỒ CHI PHÍ -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                    <i class="fa-solid fa-chart-column me-2 text-indigo"></i>Biến động chi phí sinh hoạt (4 tháng gần nhất)
                </h5>
                <div class="chart-container" style="position: relative; height: 350px;">
                    <canvas id="studentChart"></canvas>
                </div>
            </div>
        </div>

        <style>
            .bg-danger-soft {
                background-color: #fef2f2;
                color: #ef4444;
            }
            .text-indigo {
                color: #4f46e5 !important;
            }
            .fw-extrabold {
                font-weight: 800;
            }
        </style>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @if (User.Identity!.IsAuthenticated && User.IsInRole("Student"))
    {
        <script>
            var months = @Html.Raw(Json.Serialize(ViewBag.ChartMonths ?? new List<string>()));
            var roomFees = @Html.Raw(Json.Serialize(ViewBag.RoomFees ?? new List<decimal>()));
            var electricityFees = @Html.Raw(Json.Serialize(ViewBag.ElectricityFees ?? new List<decimal>()));
            var waterFees = @Html.Raw(Json.Serialize(ViewBag.WaterFees ?? new List<decimal>()));

            new Chart(document.getElementById('studentChart'), {
                type: 'bar',
                data: {
                    labels: months.length > 0 ? months : ['Chưa có dữ liệu'],
                    datasets: [
                        { label: 'Tiền phòng', data: roomFees.length > 0 ? roomFees : [0], backgroundColor: '#4f46e5', borderRadius: 6 },
                        { label: 'Tiền điện', data: electricityFees.length > 0 ? electricityFees : [0], backgroundColor: '#f59e0b', borderRadius: 6 },
                        { label: 'Tiền nước', data: waterFees.length > 0 ? waterFees : [0], backgroundColor: '#06b6d4', borderRadius: 6 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                    }
                                    return label;
                                }
                            }
                        }
                    }
                }
            });
        </script>
    }

    @if (User.Identity!.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("ManagementStaff") || User.IsInRole("ManagerStaff") || User.IsInRole("Manager")))
    {
        <script>
            var revLabels = @Html.Raw(Json.Serialize(ViewBag.RevenueLabels ?? new string[] {}));
            var revPaid = @Html.Raw(Json.Serialize(ViewBag.RevenuePaid ?? new decimal[] {}));
            var revUnpaid = @Html.Raw(Json.Serialize(ViewBag.RevenueUnpaid ?? new decimal[] {}));

            new Chart(document.getElementById('adminRevenueChart'), {
                type: 'bar',
                data: {
                    labels: revLabels.length > 0 ? revLabels : ['Chưa có dữ liệu'],
                    datasets: [
                        { 
                            label: 'Doanh thu đã thu (Trđ)', 
                            data: revPaid.length > 0 ? revPaid : [0], 
                            backgroundColor: '#10b981', 
                            borderRadius: 6 
                        },
                        { 
                            label: 'Còn nợ / Chưa đóng (Trđ)', 
                            data: revUnpaid.length > 0 ? revUnpaid : [0], 
                            backgroundColor: '#f59e0b', 
                            borderRadius: 6 
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' Trđ';
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += context.parsed.y.toLocaleString('vi-VN') + ' Triệu VNĐ';
                                    }
                                    return label;
                                }
                            }
                        }
                    }
                }
            });
        </script>
    }

    @if (!User.Identity!.IsAuthenticated)
    {
        <script>
            function promptStudentService() {
                Swal.fire({
                    title: 'Yêu cầu đăng nhập',
                    text: 'Bạn cần đăng nhập bằng tài khoản Sinh viên để truy cập các dịch vụ cá nhân.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#4f46e5',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: '<i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        location.href = '/Account/Login';
                    }
                });
            }

            function promptContactForm() {
                Swal.fire({
                    title: 'Gửi phản hồi / Liên hệ',
                    html: `
                                <div style="text-align: left;">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Họ và tên</label>
                                        <input type="text" id="contact-name" class="form-control" placeholder="Nhập họ và tên...">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Email / SĐT</label>
                                        <input type="text" id="contact-info" class="form-control" placeholder="Nhập email hoặc số điện thoại...">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Nội dung liên hệ</label>
                                        <textarea id="contact-msg" class="form-control" rows="3" placeholder="Nhập nội dung cần hỗ trợ..."></textarea>
                                    </div>
                                </div>
                            `,
                    showCancelButton: true,
                    confirmButtonColor: '#4f46e5',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Gửi thông tin',
                    cancelButtonText: 'Hủy',
                    preConfirm: () => {
                        const name = document.getElementById('contact-name').value;
                        const info = document.getElementById('contact-info').value;
                        const msg = document.getElementById('contact-msg').value;
                        if (!name || !info || !msg) {
                            Swal.showValidationMessage('Vui lòng điền đầy đủ các thông tin!');
                        }
                        return { name, info, msg };
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Đã gửi phản hồi!',
                            text: 'Cảm ơn bạn đã liên hệ. Ban quản lý KTX sẽ phản hồi lại sớm nhất.',
                            confirmButtonColor: '#4f46e5'
                        });
                    }
                });
            }
        </script>
    }
}