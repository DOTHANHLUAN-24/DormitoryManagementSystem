@{
    ViewData["Title"] = "Trang chủ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách phòng Ký túc xá</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Tùy chỉnh hiệu ứng mượt mà */
        .room-card:hover .room-overlay {
            opacity: 1;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800">

    <!-- NAVIGATION BAR -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <span class="text-2xl font-bold text-indigo-600 tracking-tighter">KTX-PRO</span>
                </div>

                <!-- Main Menu -->
                <div class="hidden md:flex space-x-8 items-center">
                    <a href="#" class="text-indigo-600 font-semibold border-b-2 border-indigo-600 py-1">Trang chủ</a>

                    <!-- Sub-menu (Dropdown) -->
                    <div class="relative group">
                        <button class="flex items-center hover:text-indigo-600 transition py-1">
                            Khu vực <i class="fas fa-chevron-down ml-1 text-xs"></i>
                        </button>
                        <!-- Dropdown content -->
                        <div class="absolute left-0 mt-2 w-48 bg-white border border-gray-100 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300">
                            <a href="#" class="block px-4 py-2 hover:bg-indigo-50 hover:text-indigo-600">Tòa Nhà A (Nam)</a>
                            <a href="#" class="block px-4 py-2 hover:bg-indigo-50 hover:text-indigo-600">Tòa Nhà B (Nữ)</a>
                            <a href="#" class="block px-4 py-2 hover:bg-indigo-50 hover:text-indigo-600">Khu VIP</a>
                        </div>
                    </div>

                    <a href="#" class="hover:text-indigo-600 transition">Dịch vụ</a>
                    <a href="#" class="hover:text-indigo-600 transition">Liên hệ</a>
                </div>

                <!-- User Actions -->
                <div class="flex items-center space-x-4">
                    <button class="text-gray-500 hover:text-indigo-600"><i class="fas fa-search"></i></button>
                    <button class="bg-indigo-600 text-white px-5 py-2 rounded-full text-sm font-medium hover:bg-indigo-700 transition">Đăng nhập</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="max-w-7xl mx-auto px-4 py-10">

        <!-- Header Section -->
        <div class="mb-10 flex justify-between items-end">
            <div>
                <h2 class="text-3xl font-bold text-gray-900">Danh sách phòng trống</h2>
                <p class="text-gray-500 mt-2">Tìm kiếm không gian sống lý tưởng cho thời sinh viên của bạn.</p>
            </div>
            <div class="flex space-x-2">
                <select class="border rounded-lg px-4 py-2 bg-white outline-none focus:ring-2 focus:ring-indigo-300">
                    <option>Sắp xếp: Mới nhất</option>
                    <option>Giá: Thấp đến Cao</option>
                </select>
            </div>
        </div>

        <!-- ROOM LIST GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            <!-- Room Card Item 1 -->
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300 overflow-hidden group">
                <!-- Image Container -->
                <div class="relative overflow-hidden aspect-video">
                    <img src="https://images.unsplash.com/photo-1555854817-5b2247a8175f?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80"
                         alt="Phòng KTX"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">

                    <!-- Hover Overlay with Details Button -->
                    <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <button class="bg-white text-gray-900 px-6 py-2 rounded-full font-semibold flex items-center hover:bg-indigo-600 hover:text-white transition transform translate-y-4 group-hover:translate-y-0 duration-300">
                            <i class="fas fa-eye mr-2"></i> Xem chi tiết
                        </button>
                    </div>

                    <!-- Badge -->
                    <span class="absolute top-3 left-3 bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase">Còn trống</span>
                </div>

                <!-- Room Content -->
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-xl font-bold text-gray-900">Phòng Standard - Tòa A</h3>
                        <span class="text-indigo-600 font-bold">1.2tr <small class="text-gray-400 font-normal">/tháng</small></span>
                    </div>
                    <p class="text-gray-500 text-sm mb-4 line-clamp-2">
                        Phòng đầy đủ tiện nghi, giường tầng, bàn học riêng biệt, ban công thoáng mát và có điều hòa nhiệt độ.
                    </p>

                    <div class="flex items-center text-gray-400 text-xs mb-6 space-x-4">
                        <span><i class="fas fa-user-friends mr-1"></i> 4 Người</span>
                        <span><i class="fas fa-expand-arrows-alt mr-1"></i> 25m²</span>
                        <span><i class="fas fa-wifi mr-1"></i> Miễn phí</span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex space-x-3">
                        <button class="flex-1 bg-indigo-600 text-white py-2.5 rounded-lg font-semibold hover:bg-indigo-700 transition">
                            Thuê phòng ngay
                        </button>
                        <button class="w-12 border border-gray-200 text-gray-400 rounded-lg hover:text-red-500 hover:border-red-200 transition">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Copy các Card khác tương tự bên dưới... -->
            <!-- Room Card Item 2 (Sample) -->
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300 overflow-hidden group">
                <div class="relative overflow-hidden aspect-video">
                    <img src="https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80"
                         alt="Phòng KTX"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                    <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <button class="bg-white text-gray-900 px-6 py-2 rounded-full font-semibold flex items-center hover:bg-indigo-600 hover:text-white transition transform translate-y-4 group-hover:translate-y-0 duration-300">
                            <i class="fas fa-eye mr-2"></i> Xem chi tiết
                        </button>
                    </div>
                    <span class="absolute top-3 left-3 bg-blue-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase">Phòng VIP</span>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-xl font-bold text-gray-900">Phòng Studio - Tòa B</h3>
                        <span class="text-indigo-600 font-bold">2.5tr <small class="text-gray-400 font-normal">/tháng</small></span>
                    </div>
                    <p class="text-gray-500 text-sm mb-4 line-clamp-2">
                        Dành cho những ai thích sự riêng tư, đầy đủ bếp nhỏ, vệ sinh khép kín và trang thiết bị hiện đại.
                    </p>
                    <div class="flex items-center text-gray-400 text-xs mb-6 space-x-4">
                        <span><i class="fas fa-user mr-1"></i> 2 Người</span>
                        <span><i class="fas fa-expand-arrows-alt mr-1"></i> 35m²</span>
                        <span><i class="fas fa-wind mr-1"></i> Điều hòa</span>
                    </div>
                    <div class="flex space-x-3">
                        <button class="flex-1 bg-indigo-600 text-white py-2.5 rounded-lg font-semibold hover:bg-indigo-700 transition">
                            Thuê phòng ngay
                        </button>
                        <button class="w-12 border border-gray-200 text-gray-400 rounded-lg hover:text-red-500 hover:border-red-200 transition">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Room Card Item 3 (Sample) -->
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300 overflow-hidden group">
                <div class="relative overflow-hidden aspect-video">
                    <img src="https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80"
                         alt="Phòng KTX"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                    <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <button class="bg-white text-gray-900 px-6 py-2 rounded-full font-semibold flex items-center hover:bg-indigo-600 hover:text-white transition transform translate-y-4 group-hover:translate-y-0 duration-300">
                            <i class="fas fa-eye mr-2"></i> Xem chi tiết
                        </button>
                    </div>
                    <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase">Sắp hết</span>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-xl font-bold text-gray-900">Phòng Tập Thể - Tòa C</h3>
                        <span class="text-indigo-600 font-bold">800k <small class="text-gray-400 font-normal">/tháng</small></span>
                    </div>
                    <p class="text-gray-500 text-sm mb-4 line-clamp-2">
                        Tiết kiệm chi phí tối đa, môi trường hòa đồng, an ninh 24/7 và gần trạm xe buýt.
                    </p>
                    <div class="flex items-center text-gray-400 text-xs mb-6 space-x-4">
                        <span><i class="fas fa-user-friends mr-1"></i> 8 Người</span>
                        <span><i class="fas fa-expand-arrows-alt mr-1"></i> 45m²</span>
                        <span><i class="fas fa-shield-alt mr-1"></i> An ninh</span>
                    </div>
                    <div class="flex space-x-3">
                        <button class="flex-1 bg-indigo-600 text-white py-2.5 rounded-lg font-semibold hover:bg-indigo-700 transition">
                            Thuê phòng ngay
                        </button>
                        <button class="w-12 border border-gray-200 text-gray-400 rounded-lg hover:text-red-500 hover:border-red-200 transition">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>