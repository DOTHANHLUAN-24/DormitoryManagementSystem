<div class="sidebar p-2">

    <!-- BRAND -->
    <div class="text-center text-white fw-bold mb-3">
        <i class="fas fa-building"></i>
        <span class="text">KTX System</span>
    </div>

    <!-- BẢNG ĐIỀU KHIỂN -->
    <a asp-controller="Home" asp-action="Index">
        <i class="fas fa-tachometer-alt"></i>
        <span class="text">Bảng điều khiển</span>
    </a>

    <!-- ================= QUẢN LÝ NGƯỜI DÙNG ================= -->
    @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff"))
    {
        <a data-bs-toggle="collapse" href="#userMenu" class="menu-toggle">
            <i class="fas fa-users"></i>
            <span class="text">Người dùng</span>
        </a>
        <!-- Trong phần NGƯỜI DÙNG của _Sidebar.cshtml -->
        <div class="collapse submenu" id="userMenu">
            <a asp-controller="User" asp-action="Index">
                <i class="fas fa-list me-2"></i> Danh sách
            </a>
            <a asp-controller="User" asp-action="Create">
                <i class="fas fa-user-plus me-2"></i> Thêm
            </a>
            <a asp-controller="User" asp-action="BannedList">
                <i class="fas fa-user-slash me-2"></i> Bị ban
            </a>
            <a asp-controller="User" asp-action="RecycleBin">
                <i class="fas fa-trash-alt me-2"></i> Thùng rác
            </a>
        </div>
    }

    <!-- ================= CƠ SỞ HẠ TẦNG ================= -->
    <a data-bs-toggle="collapse" href="#infraMenu" class="menu-toggle">
        <i class="fas fa-city"></i>
        <span class="text">Cơ sở hạ tầng</span>
    </a>
    <div class="collapse submenu" id="infraMenu">
        @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff"))
        {
            <a asp-controller="Block" asp-action="Index">
                <i class="fas fa-building me-2"></i> Tòa nhà
            </a>
        }
        
        <!-- Sinh viên / Khách vãng lai có thể xem danh sách & loại phòng -->
        <a asp-controller="RoomType" asp-action="Index">
            <i class="fas fa-tags me-2"></i> Bảng giá Loại phòng
        </a>
        <a asp-controller="Room" asp-action="Index">
            <i class="fas fa-door-open me-2"></i> Danh sách Phòng
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff"))
        {
            <a asp-controller="Bed" asp-action="Index">
                <i class="fas fa-bed me-2"></i> Quản lý Giường
            </a>
            <a asp-controller="Asset" asp-action="Index">
                <i class="fas fa-box me-2"></i> Quản lý Tài sản
            </a>
        }
    </div>

    <!-- ================= DỊCH VỤ & TIỆN ÍCH ================= -->
    <a data-bs-toggle="collapse" href="#utilityMenu" class="menu-toggle">
        <i class="fas fa-plug"></i>
        <span class="text">Dịch vụ & Điện nước</span>
    </a>
    <div class="collapse submenu" id="utilityMenu">
        <!-- Khách vãng lai cũng xem được giá dịch vụ -->
        <a asp-controller="Utility" asp-action="Index">
            <i class="fas fa-list-ul me-2"></i> Bảng giá dịch vụ
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="UtilityUsage" asp-action="Index">
                <i class="fas fa-tachometer-alt me-2"></i> @(User.IsInRole("Student") ? "Chỉ số điện nước phòng" : "Ghi chỉ số")
            </a>
        }
    </div>

    <!-- ================= HỢP ĐỒNG THUÊ ================= -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a data-bs-toggle="collapse" href="#contractMenu" class="menu-toggle">
            <i class="fas fa-file-contract"></i>
            <span class="text">Hợp đồng</span>
        </a>
        <div class="collapse submenu" id="contractMenu">
            <a asp-controller="Contract" asp-action="Index">
                <i class="fas fa-list me-2"></i> @(User.IsInRole("Student") ? "Hợp đồng của tôi" : "Danh sách")
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff"))
            {
                <a asp-controller="Contract" asp-action="Pending">
                    <i class="fas fa-clock me-2"></i> Chờ duyệt
                </a>
            }
        </div>
    }

    <!-- ================= TÀI CHÍNH ================= -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a data-bs-toggle="collapse" href="#financeMenu" class="menu-toggle">
            <i class="fas fa-file-invoice-dollar"></i>
            <span class="text">Tài chính</span>
        </a>
        <div class="collapse submenu" id="financeMenu">
            <a asp-controller="Invoice" asp-action="Index">
                <i class="fas fa-file-invoice me-2"></i> Hóa đơn
            </a>
            <a asp-controller="Payment" asp-action="Index">
                <i class="fas fa-credit-card me-2"></i> Lịch sử Thanh toán
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff") || User.IsInRole("TechnicalStaff"))
            {
                <a asp-controller="Surcharge" asp-action="Index">
                    <i class="fas fa-plus-circle me-2"></i> Phụ phí
                </a>
            }
        </div>
    }

    <!-- ================= VẬN HÀNH & AN NINH ================= -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a data-bs-toggle="collapse" href="#operationMenu" class="menu-toggle">
            <i class="fas fa-shield-alt"></i>
            <span class="text">Vận hành & An ninh</span>
        </a>
        <div class="collapse submenu" id="operationMenu">
            <a asp-controller="MaintenanceRequest" asp-action="Index">
                <i class="fas fa-tools me-2"></i> Yêu cầu Sửa chữa
            </a>
            <a asp-controller="Vehicle" asp-action="Index">
                <i class="fas fa-motorcycle me-2"></i> Phương tiện
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff") || User.IsInRole("TechnicalStaff"))
            {
                <a asp-controller="Violation" asp-action="Index">
                    <i class="fas fa-exclamation-triangle me-2"></i> Vi phạm kỷ luật
                </a>
            }
        </div>
    }

    <!-- ================= KHÁC ================= -->
    <a asp-controller="Notification" asp-action="Index">
        <i class="fas fa-bell"></i>
        <span class="text">Thông báo</span>
    </a>

    <a asp-controller="Regulations" asp-action="Index">
        <i class="fas fa-book-open"></i>
        <span class="text">Nội quy KTX</span>
    </a>

    @if (User.IsInRole("Student") || User.IsInRole("ManagementStaff"))
    {
        <a asp-controller="Attendance" asp-action="Index">
            <i class="fas fa-check-circle"></i>
            <span class="text">Điểm danh</span>
        </a>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff") || User.IsInRole("TechnicalStaff"))
    {
        <a asp-controller="Report" asp-action="Index">
            <i class="fas fa-chart-line"></i>
            <span class="text">Báo cáo thống kê</span>
        </a>
    }

</div>