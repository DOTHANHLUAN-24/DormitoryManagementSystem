@using Common
@inject DormitoryManagement.Application.Services.Interfaces.IContractService ContractService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // ── ROLES ──────────────────────────────────────────────────────────────
    var isAdmin        = User.IsInRole("Admin");
    var isManager      = User.IsInRole("ManagementStaff");
    var isStaff        = User.IsInRole("TechnicalStaff");
    var isStudent      = User.IsInRole("Student");
    var isAdminOrManager  = isAdmin || isManager;
    var isAdminOrStaff    = isAdmin || isStaff;
    var isAuthenticated   = User.Identity?.IsAuthenticated == true;

    // ── PENDING CONTRACTS BADGE ────────────────────────────────────────────
    int pendingContractsCount = 0;
    if (isAuthenticated && isAdminOrManager)
    {
        pendingContractsCount = await ContractService.GetPendingCountAsync();
    }
}

<div class="sidebar p-2">

    <!-- BRAND -->
    <div class="brand">
        <i class="fas fa-building"></i>
        <span class="text">KTX System</span>
    </div>

    @* =====================================================================
       SECTION: TỔNG QUAN & BÁO CÁO  (Admin / Manager)
       ===================================================================== *@
    @if (isAuthenticated && isAdminOrManager)
    {
        <div class="sidebar-section-title">Tổng quan &amp; Báo cáo</div>
        <a asp-controller="Home" asp-action="Index"
           class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
            <i class="fas fa-tachometer-alt"></i>
            <span class="text">Bảng điều khiển</span>
        </a>
        <a asp-controller="Statistic" asp-action="Index"
           class="@(currentController == "Statistic" ? "active" : "")">
            <i class="fas fa-chart-line"></i>
            <span class="text">Báo cáo thống kê</span>
        </a>
        <a asp-controller="Home" asp-action="Guide"
           class="@(currentController == "Home" && currentAction == "Guide" ? "active" : "")">
            <i class="fas fa-book-reader"></i>
            <span class="text">Hướng dẫn sử dụng</span>
        </a>
    }

    @* =====================================================================
       SECTION: DỊCH VỤ CÁ NHÂN  (Student)
       ===================================================================== *@
    @if (isAuthenticated && isStudent)
    {
        <div class="sidebar-section-title">Dịch vụ cá nhân</div>
        <a asp-controller="Home" asp-action="Index"
           class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
            <i class="fas fa-tachometer-alt"></i>
            <span class="text">Bảng điều khiển</span>
        </a>
        <a asp-controller="Home" asp-action="Services"
           class="@(currentController == "Home" && currentAction == "Services" ? "active" : "")">
            <i class="fas fa-concierge-bell"></i>
            <span class="text">Dịch vụ cá nhân</span>
        </a>
        <a asp-controller="Contract" asp-action="MyContracts"
           class="@(currentController == "Contract" && currentAction == "MyContracts" ? "active" : "")">
            <i class="fas fa-file-contract"></i>
            <span class="text">Hợp đồng của tôi</span>
        </a>
        <a asp-controller="Visitor" asp-action="Request"
           class="@(currentController == "Visitor" && (currentAction == "Request" || currentAction == "CreateRequest") ? "active" : "")">
            <i class="fas fa-address-book"></i>
            <span class="text">Đăng ký khách thăm</span>
        </a>
        <a asp-controller="MaintenanceRequest" asp-action="MyRequests"
           class="@(currentController == "MaintenanceRequest" && (currentAction == "MyRequests" || currentAction == "Create") ? "active" : "")">
            <i class="fas fa-tools"></i>
            <span class="text">Báo cáo sửa chữa</span>
        </a>
        @* Đăng ký dịch vụ tiện ích (điện, nước, wifi…) *@
        <a asp-controller="UtilityServiceRequest" asp-action="MyRequests"
           class="@(currentController == "UtilityServiceRequest" ? "active" : "")">
            <i class="fas fa-plug"></i>
            <span class="text">Đăng ký dịch vụ</span>
        </a>
    }

    @* =====================================================================
       SECTION: CÔNG VIỆC BẢO TRÌ  (TechnicalStaff)
       ===================================================================== *@
    @if (isAuthenticated && isStaff && !isAdmin && !isManager)
    {
        <div class="sidebar-section-title">Công việc bảo trì</div>
        <a asp-controller="Home" asp-action="Index"
           class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
            <i class="fas fa-tachometer-alt"></i>
            <span class="text">Bảng điều khiển</span>
        </a>
        <a asp-controller="MaintenanceRequest" asp-action="Index"
           class="@(currentController == "MaintenanceRequest" && currentAction == "Index" ? "active" : "")">
            <i class="fas fa-toolbox"></i>
            <span class="text">Quản lý sửa chữa</span>
        </a>
    }

    @* =====================================================================
       SECTION: TRA CỨU CÔNG KHAI  (Guest – chưa đăng nhập)
       ===================================================================== *@
    @if (!isAuthenticated)
    {
        <div class="sidebar-section-title">Tra cứu công khai</div>
        <a asp-controller="Home" asp-action="Rooms"
           class="@(currentController == "Home" && (currentAction == "Rooms" || currentAction == "RoomDetails") ? "active" : "")">
            <i class="fas fa-door-closed"></i>
            <span class="text">Xem phòng KTX</span>
        </a>
        <a asp-controller="RoomType" asp-action="List"
           class="@(currentController == "RoomType" && currentAction == "List" ? "active" : "")">
            <i class="fas fa-tags"></i>
            <span class="text">Loại phòng &amp; Giá cả</span>
        </a>
        <a asp-controller="Asset" asp-action="Catalog"
           class="@(currentController == "Asset" && currentAction == "Catalog" ? "active" : "")">
            <i class="fas fa-couch"></i>
            <span class="text">Danh mục thiết bị</span>
        </a>
        <a asp-controller="Regulation" asp-action="Index"
           class="@((currentController == "Regulation" || currentController == "Regulations") && currentAction == "Index" ? "active" : "")">
            <i class="fas fa-book-open"></i>
            <span class="text">Nội quy KTX</span>
        </a>
        <a asp-controller="Home" asp-action="Guide"
           class="@(currentController == "Home" && currentAction == "Guide" ? "active" : "")">
            <i class="fas fa-book-reader"></i>
            <span class="text">Hướng dẫn sử dụng</span>
        </a>
    }

    @* =====================================================================
       SECTION: QUẢN LÝ DÂN CƯ  (Admin / Manager)
       ===================================================================== *@
    @if (isAuthenticated && isAdminOrManager)
    {
        <div class="sidebar-section-title">Quản lý dân cư</div>

        @* ── Người dùng ── *@
        var isUserGroup = currentController == "User";
        <a data-bs-toggle="collapse" href="#userMenu" class="menu-toggle @(isUserGroup ? "active" : "collapsed")">
            <i class="fas fa-users"></i>
            <span class="text">Quản lý người dùng</span>
        </a>
        <div class="collapse submenu @(isUserGroup ? "show" : "")" id="userMenu">
            <a asp-controller="User" asp-action="Index"
               class="@(isUserGroup && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-list me-2"></i> Danh sách người dùng
            </a>
            <a asp-controller="User" asp-action="Create"
               class="@(isUserGroup && currentAction == "Create" ? "active" : "")">
                <i class="fas fa-user-plus me-2"></i> Thêm người dùng
            </a>
            <a asp-controller="User" asp-action="BannedList"
               class="@(isUserGroup && currentAction == "BannedList" ? "active" : "")">
                <i class="fas fa-user-slash me-2"></i> Danh sách bị khóa
            </a>
            @if (isAdmin)
            {
                <a asp-controller="User" asp-action="RecycleBin"
                   class="@(isUserGroup && currentAction == "RecycleBin" ? "active" : "")">
                    <i class="fas fa-trash-alt me-2"></i> Thùng rác người dùng
                </a>
            }
        </div>

        @* ── Hợp đồng ── *@
        var isContractGroup = currentController == "Contract";
        <a data-bs-toggle="collapse" href="#contractMenu"
           class="menu-toggle @(isContractGroup ? "active" : "collapsed") d-flex align-items-center">
            <i class="fas fa-file-contract"></i>
            <span class="text">Quản lý hợp đồng</span>
            @if (pendingContractsCount > 0)
            {
                <span class="badge bg-danger ms-auto rounded-pill"
                      style="font-size: 0.75rem; padding: 4px 8px;">@pendingContractsCount</span>
            }
        </a>
        <div class="collapse submenu @(isContractGroup ? "show" : "")" id="contractMenu">
            <a asp-controller="Contract" asp-action="Index"
               class="@(isContractGroup && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-list me-2"></i> Danh sách hợp đồng
            </a>
            <a asp-controller="Contract" asp-action="Pending"
               class="@(isContractGroup && currentAction == "Pending" ? "active" : "") d-flex align-items-center justify-content-between">
                <span><i class="fas fa-clock me-2"></i> Hợp đồng chờ duyệt</span>
                @if (pendingContractsCount > 0)
                {
                    <span class="badge bg-danger rounded-pill"
                          style="font-size: 0.7rem; padding: 3px 6px;">@pendingContractsCount</span>
                }
            </a>
            <a asp-controller="Contract" asp-action="Create"
               class="@(isContractGroup && currentAction == "Create" ? "active" : "")">
                <i class="fas fa-plus me-2"></i> Tạo hợp đồng thủ công
            </a>
        </div>

        @* ── Khách đến thăm ── *@
        var isVisitorGroup = currentController == "Visitor";
        <a data-bs-toggle="collapse" href="#visitorMenu" class="menu-toggle @(isVisitorGroup ? "active" : "collapsed")">
            <i class="fas fa-address-book"></i>
            <span class="text">Khách đến thăm</span>
        </a>
        <div class="collapse submenu @(isVisitorGroup ? "show" : "")" id="visitorMenu">
            <a asp-controller="Visitor" asp-action="Index"
               class="@(isVisitorGroup && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-list me-2"></i> Danh sách khách đến
            </a>
            <a asp-controller="Visitor" asp-action="Create"
               class="@(isVisitorGroup && currentAction == "Create" ? "active" : "")">
                <i class="fas fa-plus me-2"></i> Ghi nhận khách mới
            </a>
        </div>

    }

    @* =====================================================================
       SECTION: CƠ SỞ VẬT CHẤT & DỊCH VỤ  (Admin / Manager)
       ===================================================================== *@
    @if (isAuthenticated && isAdminOrManager)
    {
        <div class="sidebar-section-title">Cơ sở vật chất &amp; Dịch vụ</div>

        @* ── Cơ sở vật chất ── *@
        var isBlockGroup  = currentController == "Block";
        var isRoomGroup   = currentController == "Room" || currentController == "RoomType";
        var isAssetGroup  = currentController == "Asset";
        var isInfraGroup  = isBlockGroup || isRoomGroup || isAssetGroup;

        <a data-bs-toggle="collapse" href="#infraMenu" class="menu-toggle @(isInfraGroup ? "active" : "collapsed")">
            <i class="fas fa-city"></i>
            <span class="text">Cơ sở vật chất</span>
        </a>
        <div class="collapse submenu @(isInfraGroup ? "show" : "")" id="infraMenu">

            @* Cấp 2 – Tòa nhà *@
            <a data-bs-toggle="collapse" href="#blockMenu"
               class="submenu-toggle-l2 @(isBlockGroup ? "active" : "collapsed")">
                <span><i class="fas fa-building me-2"></i> Quản lý tòa nhà</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
            </a>
            <div class="collapse submenu-l3 @(isBlockGroup ? "show" : "")" id="blockMenu">
                <a asp-controller="Block" asp-action="Index"
                   class="@(isBlockGroup && currentAction == "Index" ? "active" : "")">
                    Danh sách tòa nhà
                </a>
                <a asp-controller="Block" asp-action="SuspendedList"
                   class="@(isBlockGroup && currentAction == "SuspendedList" ? "active" : "")">
                    Tòa nhà tạm ngưng
                </a>
                <a asp-controller="Block" asp-action="RecycleBin"
                   class="@(isBlockGroup && currentAction == "RecycleBin" ? "active" : "")">
                    Tòa nhà đã xóa
                </a>
            </div>

            @* Cấp 2 – Phòng *@
            <a data-bs-toggle="collapse" href="#roomMenu"
               class="submenu-toggle-l2 @(isRoomGroup ? "active" : "collapsed")">
                <span><i class="fas fa-door-open me-2"></i> Quản lý phòng</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
            </a>
            <div class="collapse submenu-l3 @(isRoomGroup ? "show" : "")" id="roomMenu">
                <a asp-controller="Room" asp-action="Index"
                   class="@(currentController == "Room" && currentAction == "Index" ? "active" : "")">
                    Danh sách phòng
                </a>
                <a asp-controller="RoomType" asp-action="Index"
                   class="@(currentController == "RoomType" ? "active" : "")">
                    Loại phòng
                </a>
                <a asp-controller="Room" asp-action="RecycleBin"
                   class="@(currentController == "Room" && currentAction == "RecycleBin" ? "active" : "")">
                    Phòng đã xóa
                </a>
            </div>

            @* Cấp 2 – Vật tư & Thiết bị *@
            <a data-bs-toggle="collapse" href="#assetMenu"
               class="submenu-toggle-l2 @(isAssetGroup ? "active" : "collapsed")">
                <span><i class="fas fa-box me-2"></i> Vật tư &amp; Thiết bị</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
            </a>
            <div class="collapse submenu-l3 @(isAssetGroup ? "show" : "")" id="assetMenu">
                <a asp-controller="Asset" asp-action="Index"
                   class="@(isAssetGroup && currentAction == "Index" ? "active" : "")">
                    Danh sách tài sản
                </a>
                <a asp-controller="Asset" asp-action="RecycleBin"
                   class="@(isAssetGroup && currentAction == "RecycleBin" ? "active" : "")">
                    Thùng rác tài sản
                </a>
                <a asp-controller="Asset" asp-action="Catalog"
                   class="@(isAssetGroup && currentAction == "Catalog" ? "active" : "")">
                    Danh mục công khai
                </a>
            </div>
        </div>

        @* ── Dịch vụ KTX ── *@
        var isServiceGroup = currentController == "Utility" || currentController == "UtilityServiceRequest";
        <a data-bs-toggle="collapse" href="#serviceMenu" class="menu-toggle @(isServiceGroup ? "active" : "collapsed")">
            <i class="fas fa-plug"></i>
            <span class="text">Dịch vụ KTX</span>
        </a>
        <div class="collapse submenu @(isServiceGroup ? "show" : "")" id="serviceMenu">
            <a asp-controller="Utility" asp-action="Index"
               class="@(currentController == "Utility" && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-list-ul me-2"></i> Danh sách dịch vụ
            </a>
            <a asp-controller="Utility" asp-action="Trash"
               class="@(currentController == "Utility" && currentAction == "Trash" ? "active" : "")">
                <i class="fas fa-trash-alt me-2"></i> Thùng rác dịch vụ
            </a>
            <a asp-controller="Utility" asp-action="Requests"
               class="@(currentController == "Utility" && currentAction == "Requests" ? "active" : "")">
                <i class="fas fa-clipboard-check me-2"></i> Duyệt đăng ký dịch vụ
            </a>
            <a asp-controller="UtilityServiceRequest" asp-action="Index"
               class="@(currentController == "UtilityServiceRequest" && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-clipboard-list me-2"></i> Tất cả yêu cầu dịch vụ
            </a>
        </div>

        @* ── Phụ phí kèm theo ── *@
        var isSurchargeGroup = currentController == "Surcharge";
        <a data-bs-toggle="collapse" href="#surchargeMenu" class="menu-toggle @(isSurchargeGroup ? "active" : "collapsed")">
            <i class="fas fa-coins"></i>
            <span class="text">Phụ phí kèm theo</span>
        </a>
        <div class="collapse submenu @(isSurchargeGroup ? "show" : "")" id="surchargeMenu">
            <a asp-controller="Surcharge" asp-action="Index"
               class="@(isSurchargeGroup && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-list me-2"></i> Danh sách phụ phí
            </a>
            <a asp-controller="Surcharge" asp-action="Create"
               class="@(isSurchargeGroup && currentAction == "Create" ? "active" : "")">
                <i class="fas fa-plus me-2"></i> Thêm phụ phí mới
            </a>
            @if (isSurchargeGroup && currentAction == "Edit")
            {
                <a asp-controller="Surcharge" asp-action="Edit" class="active">
                    <i class="fas fa-edit me-2"></i> Cập nhật phụ phí
                </a>
            }
        </div>
    }

    @* =====================================================================
       SECTION: VẬN HÀNH & AN NINH  (Admin / Manager)
       ===================================================================== *@
    @if (isAuthenticated && isAdminOrManager)
    {
        <div class="sidebar-section-title">Vận hành &amp; An ninh</div>

        var isVehicleGroup    = currentController.Equals("Vehicle", StringComparison.OrdinalIgnoreCase);
        var isViolationGroup  = currentController.Equals("Violation", StringComparison.OrdinalIgnoreCase);
        var isMaintenanceGroup = currentController.Equals("MaintenanceRequest", StringComparison.OrdinalIgnoreCase);
        var isRegulationGroup = currentController == "Regulation" || currentController == "Regulations";
        var isOperationGroup  = isViolationGroup || isVehicleGroup;

        @* ── Vi phạm & Phương tiện ── *@
        <a data-bs-toggle="collapse" href="#operationMenu" role="button"
           aria-expanded="@(isOperationGroup ? "true" : "false")" aria-controls="operationMenu"
           class="menu-toggle @(isOperationGroup ? "active" : "collapsed")">
            <i class="fas fa-shield-alt"></i>
            <span class="text">Vi phạm &amp; Phương tiện</span>
        </a>
        <div class="collapse submenu @(isOperationGroup ? "show" : "")" id="operationMenu">
            <a asp-controller="Violation" asp-action="Index"
               class="@(isViolationGroup && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="fas fa-exclamation-triangle me-2 text-danger"></i> Danh sách vi phạm
            </a>
            <a asp-controller="Violation" asp-action="Create"
               class="@(isViolationGroup && currentAction.Equals("Create", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="fas fa-plus me-2"></i> Lập biên bản mới
            </a>

            @* Cấp 2 – Phương tiện *@
            <a data-bs-toggle="collapse" href="#vehicleSubMenu"
               class="submenu-toggle-l2 @(isVehicleGroup ? "active" : "collapsed")">
                <span><i class="fas fa-motorcycle me-2"></i> Quản lý phương tiện</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
            </a>
            <div class="collapse submenu-l3 @(isVehicleGroup ? "show" : "")" id="vehicleSubMenu">
                <a asp-controller="Vehicle" asp-action="Index"
                   class="@(isVehicleGroup && (currentAction == "Index" || currentAction == "Edit") ? "active" : "")">
                    Danh sách xe
                </a>
                <a asp-controller="Vehicle" asp-action="Create"
                   class="@(isVehicleGroup && currentAction == "Create" ? "active" : "")">
                    Đăng ký xe mới
                </a>
            </div>
        </div>

        @* ── Bảo trì & Sửa chữa ── *@
        <a asp-controller="MaintenanceRequest" asp-action="Index"
           class="@(isMaintenanceGroup ? "active" : "")">
            <i class="fas fa-toolbox"></i>
            <span class="text">Bảo trì &amp; Sửa chữa</span>
        </a>

        @* ── Nội quy KTX ── *@
        <a data-bs-toggle="collapse" href="#regulationMenu"
           class="menu-toggle @(isRegulationGroup ? "active" : "collapsed")">
            <i class="fas fa-book-open"></i>
            <span class="text">Nội quy KTX</span>
        </a>
        <div class="collapse submenu @(isRegulationGroup ? "show" : "")" id="regulationMenu">
            <a asp-controller="Regulation" asp-action="Index"
               class="@(isRegulationGroup && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-file-alt me-2"></i> Xem nội quy KTX
            </a>
            <a asp-controller="Regulation" asp-action="Edit"
               class="@(isRegulationGroup && currentAction == "Edit" ? "active" : "")">
                <i class="fas fa-edit me-2"></i> Chỉnh sửa nội quy
            </a>
        </div>
    }

    @* =====================================================================
       SECTION: TÀI CHÍNH & THANH TOÁN  (Admin / Manager / Student)
       ===================================================================== *@
    @if (isAuthenticated && (isAdminOrManager || isStudent))
    {
        <div class="sidebar-section-title">Tài chính &amp; Thanh toán</div>
        <a asp-controller="Payment" asp-action="Index"
           class="@(currentController == "Payment" ? "active" : "")">
            <i class="fas fa-file-invoice-dollar"></i>
            <span class="text">Hóa đơn &amp; Thanh toán</span>
        </a>
    }

    @* =====================================================================
       SECTION: TRA CỨU & THÔNG TIN  (Student / TechnicalStaff)
       ===================================================================== *@
    @if (isAuthenticated && !isAdminOrManager)
    {
        <div class="sidebar-section-title">Tra cứu &amp; Thông tin</div>

        @if (isStudent)
        {
            <a asp-controller="Home" asp-action="Rooms"
               class="@(currentController == "Home" && (currentAction == "Rooms" || currentAction == "RoomDetails") ? "active" : "")">
                <i class="fas fa-door-closed"></i>
                <span class="text">Xem phòng KTX</span>
            </a>
            <a asp-controller="RoomType" asp-action="List"
               class="@(currentController == "RoomType" && currentAction == "List" ? "active" : "")">
                <i class="fas fa-tags"></i>
                <span class="text">Loại phòng &amp; Giá cả</span>
            </a>
            <a asp-controller="Asset" asp-action="Catalog"
               class="@(currentController == "Asset" && currentAction == "Catalog" ? "active" : "")">
                <i class="fas fa-couch"></i>
                <span class="text">Danh mục thiết bị</span>
            </a>
            <a asp-controller="Surcharge" asp-action="Index"
               class="@(currentController == "Surcharge" && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-coins"></i>
                <span class="text">Danh sách phụ phí</span>
            </a>
        }

        <a asp-controller="Regulation" asp-action="Index"
           class="@((currentController == "Regulation" || currentController == "Regulations") && currentAction == "Index" ? "active" : "")">
            <i class="fas fa-book-open"></i>
            <span class="text">Nội quy KTX</span>
        </a>
        <a asp-controller="Home" asp-action="Guide"
           class="@(currentController == "Home" && currentAction == "Guide" ? "active" : "")">
            <i class="fas fa-book-reader"></i>
            <span class="text">Hướng dẫn sử dụng</span>
        </a>
    }

</div>