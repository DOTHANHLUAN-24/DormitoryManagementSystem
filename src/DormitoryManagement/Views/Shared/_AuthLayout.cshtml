<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        :root {
            --auth-bg: linear-gradient(135deg, #091e21 0%, #0f3034 100%);
            --card-bg: rgba(255, 255, 255, 0.95);
            --primary-teal: #006b73;
            --primary-teal-dark: #004d54;
        }

        body.auth-body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: var(--auth-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto;
            position: relative;
            overflow-x: hidden;
        }

        /* Hiệu ứng bong bóng trang trí background động, nổi bật và nghệ thuật */
        .bg-bubbles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-bubbles li {
            position: absolute;
            list-style: none;
            display: block;
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.22) 0%, rgba(13, 148, 136, 0.03) 100%);
            bottom: -160px;
            border-radius: 50%;
            box-shadow: 0 4px 15px rgba(20, 184, 166, 0.15), inset 0 0 10px rgba(255, 255, 255, 0.15);
            animation: bubble 20s infinite linear;
            backdrop-filter: blur(1px);
        }

        /* Tối ưu hóa chuyển động, tốc độ và kích thước để bong bóng nổi bật hơn */
        .bg-bubbles li:nth-child(1) {
            left: 10%;
            width: 50px;
            height: 50px;
            animation-duration: 10s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.28) 0%, rgba(13, 148, 136, 0.06) 100%);
        }

        .bg-bubbles li:nth-child(2) {
            left: 20%;
            width: 90px;
            height: 90px;
            animation-delay: 2s;
            animation-duration: 15s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.22) 0%, rgba(13, 148, 136, 0.04) 100%);
        }

        .bg-bubbles li:nth-child(3) {
            left: 25%;
            width: 60px;
            height: 60px;
            animation-delay: 4s;
            animation-duration: 22s;
        }

        .bg-bubbles li:nth-child(4) {
            left: 40%;
            width: 75px;
            height: 75px;
            animation-duration: 19s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.32) 0%, rgba(13, 148, 136, 0.08) 100%);
            box-shadow: 0 4px 20px rgba(20, 184, 166, 0.2), inset 0 0 15px rgba(255, 255, 255, 0.2);
        }

        .bg-bubbles li:nth-child(5) {
            left: 70%;
            width: 50px;
            height: 50px;
            animation-delay: 1s;
            animation-duration: 16s;
        }

        .bg-bubbles li:nth-child(6) {
            left: 80%;
            width: 130px;
            height: 130px;
            animation-delay: 3s;
            animation-duration: 25s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.18) 0%, rgba(13, 148, 136, 0.03) 100%);
        }

        .bg-bubbles li:nth-child(7) {
            left: 32%;
            width: 150px;
            height: 150px;
            animation-delay: 6s;
            animation-duration: 28s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.2) 0%, rgba(13, 148, 136, 0.03) 100%);
        }

        .bg-bubbles li:nth-child(8) {
            left: 55%;
            width: 55px;
            height: 55px;
            animation-delay: 10s;
            animation-duration: 30s;
        }

        .bg-bubbles li:nth-child(9) {
            left: 90%;
            width: 70px;
            height: 70px;
            animation-delay: 2s;
            animation-duration: 14s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.28) 0%, rgba(13, 148, 136, 0.06) 100%);
        }

        .bg-bubbles li:nth-child(10) {
            left: 85%;
            width: 110px;
            height: 110px;
            animation-delay: 5s;
            animation-duration: 21s;
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.22) 0%, rgba(13, 148, 136, 0.03) 100%);
        }

        @@keyframes bubble {
            0% {
                transform: translateY(0) rotate(0deg);
                opacity: 0.15;
                border-radius: 50%;
            }

            15% {
                opacity: 1;
            }

            90% {
                opacity: 1;
            }

            100% {
                transform: translateY(-1100px) rotate(360deg);
                opacity: 0;
                border-radius: 50%;
            }
        }

        .auth-content {
            position: relative;
            z-index: 2;
            width: 100%;
            padding: 20px;
        }

        .auth-footer {
            position: absolute;
            bottom: 15px;
            width: 100%;
            text-align: center;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.8rem;
            z-index: 2;
        }

        .hover-teal {
            transition: all 0.3s ease;
        }
        .hover-teal:hover {
            color: var(--primary-teal) !important;
            text-decoration: underline !important;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>

<body class="auth-body">
    <!-- Background Bubbles -->
    <ul class="bg-bubbles">
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
    </ul>

    <!-- Main Auth Content -->
    <div class="auth-content">
        @RenderBody()
    </div>

    <!-- Footer Copyright -->
    <div class="auth-footer">
        &copy; @DateTime.Now.Year - KTX System (DMS). Developed with Premium Aesthetics.
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function onUnderDevelopment(featureName) {
            Swal.fire({
                title: 'Tính năng đang được phát triển',
                text: 'Chức năng "' + featureName + '" hiện đang trong quá trình xây dựng và hoàn thiện. Vui lòng quay lại sau.',
                icon: 'info',
                confirmButtonColor: '#006b73',
                confirmButtonText: 'Đóng'
            });
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>

</html>
