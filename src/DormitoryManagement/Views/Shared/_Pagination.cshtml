@using DormitoryManagement.Domain.Common
@using Microsoft.AspNetCore.Routing
@model BasePagedResult

@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // Sao chép các tham số query hiện có để giữ bộ lọc khi chuyển trang
    var routeValues = new RouteValueDictionary();
    foreach (var key in ViewContext.HttpContext.Request.Query.Keys)
    {
        routeValues[key] = ViewContext.HttpContext.Request.Query[key].ToString();
    }

    // Helper tạo link phân trang kèm tham số
    string GetPageUrl(int pageNum)
    {
        var dict = new RouteValueDictionary(routeValues);
        dict["page"] = pageNum;
        return Url.Action(action, controller, dict) ?? "#";
    }
}

<nav class="mt-4">
    <ul class="pagination pagination-sm justify-content-center">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link shadow-none" href="@GetPageUrl(Model.PageNumber - 1)">
                <i class="fas fa-chevron-left"></i>
            </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link shadow-none" href="@GetPageUrl(i)">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link shadow-none" href="@GetPageUrl(Model.PageNumber + 1)">
                <i class="fas fa-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>