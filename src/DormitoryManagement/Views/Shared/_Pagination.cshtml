@using DormitoryManagement.Domain.Common
@using Microsoft.AspNetCore.Routing
@model BasePagedResult

@if (Model != null && Model.TotalPages > 1)
{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // Sao chép các tham số query hiện có để giữ bộ lọc khi chuyển trang
    var routeValues = new RouteValueDictionary();
    foreach (var key in ViewContext.HttpContext.Request.Query.Keys)
    {
        if (key.Equals("page", StringComparison.OrdinalIgnoreCase) || key.Equals("PageNumber", StringComparison.OrdinalIgnoreCase))
        {
            continue;
        }
        routeValues[key] = ViewContext.HttpContext.Request.Query[key].ToString();
    }

    // Helper tạo link phân trang kèm tham số
    string GetPageUrl(int pageNum)
    {
        var dict = new RouteValueDictionary(routeValues);
        dict["page"] = pageNum;
        dict["PageNumber"] = pageNum;
        return Url.Action(action, controller, dict) ?? "#";
    }

    // Xác định tên hiển thị phù hợp cho loại đối tượng dựa trên controller/action
    string entityName = "bản ghi";
    if (controller != null)
    {
        entityName = controller.ToLower() switch
        {
            "contract" => "hợp đồng",
            "room" => "phòng",
            "roomtype" => "loại phòng",
            "user" => "tài khoản",
            "block" => "tòa nhà",
            "asset" => "tài sản",
            "utility" => "chỉ số điện nước",
            "violation" => "vi phạm",
            "invoice" => "hóa đơn",
            _ => "bản ghi"
        };
    }

    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid #f1f5f9 !important;">
        <span class="text-muted small">
            Hiển thị trang <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong> (Tổng cộng <strong>@Model.TotalCount</strong> @entityName)
        </span>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link shadow-none" href="@GetPageUrl(Model.PageNumber - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                        <a class="page-link shadow-none" href="@GetPageUrl(i)">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link shadow-none" href="@GetPageUrl(Model.PageNumber + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}