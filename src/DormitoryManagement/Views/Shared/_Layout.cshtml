<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- SIDEBAR -->
    <partial name="_Sidebar" />

    <!-- MAIN -->
    <div class="main" id="main">

        <!-- TOPBAR -->
        <div class="topbar d-flex justify-content-between align-items-center sticky-top" style="z-index: 1030;">

            <!-- Toggle button -->
            <button class="btn btn-light" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Avatar dropdown -->
            <div class="dropdown">
                <div class="d-flex align-items-center gap-2" data-bs-toggle="dropdown" style="cursor:pointer;">

                    <!-- Avatar -->
                    <div class="avatar">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            @if (User.IsInRole("A"))
                            {
                                <i class="fas fa-user-shield text-danger" title="Quản trị viên"></i>
                            }
                            else if (User.IsInRole("ManagementStaff"))
                            {
                                <i class="fas fa-user-tie text-primary" title="Quản lý KTX"></i>
                            }
                            else if (User.IsInRole("TechnicalStaff"))
                            {
                                <i class="fas fa-user-cog text-warning" title="Nhân viên kỹ thuật"></i>
                            }
                            else
                            {
                                <i class="fas fa-user-graduate text-success" title="Sinh viên"></i>
                            }
                        }
                        else
                        {
                            <i class="fas fa-user-plus"></i>
                        }
                    </div>

                    <!-- Username HIỂN THỊ NGOÀI -->
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <span class="fw-semibold">@User.Identity.Name</span>
                    }
                    else
                    {
                        <span class="text-light">Khách</span>
                    }
                </div>

                <!-- DROPDOWN -->
                <ul class="dropdown-menu dropdown-menu-end">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="dropdown-header">
                            👋 Xin chào, @User.Identity.Name
                        </li>

                        <li>
                            <a class="dropdown-item" asp-controller="User" asp-action="Profile">
                                <i class="fas fa-id-card me-2"></i> Hồ sơ cá nhân
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="onUnderDevelopment('Đổi mật khẩu')">
                                <i class="fas fa-key me-2"></i> Đổi mật khẩu
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-2"></i> Đăng ký
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="p-4">
            <div id="global-breadcrumb-wrapper">
                <partial name="_Breadcrumbs" />
            </div>
            @RenderBody()
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function onUnderDevelopment(featureName) {
            Swal.fire({
                title: 'Tính năng đang được phát triển',
                text: 'Chức năng "' + featureName + '" hiện đang trong quá trình xây dựng và hoàn thiện. Vui lòng quay lại sau.',
                icon: 'info',
                confirmButtonColor: '#6366f1',
                confirmButtonText: 'Đóng'
            });
        }

        function toggleSidebar() {
            const sidebar = document.querySelector(".sidebar");
            const main = document.getElementById("main");

            sidebar.classList.toggle("collapsed");
            main.classList.toggle("collapsed");

            // Đóng hết submenu khi thu gọn
            if (sidebar.classList.contains("collapsed")) {
                document.querySelectorAll('.submenu').forEach(el => {
                    el.classList.remove('show');
                });
            }
        }
    </script>

    @RenderSection("Scripts", required: false)

    <script>
        $(document).ready(function () {
            // Di chuyển breadcrumb xuống dưới header/tiêu đề trang nếu có
            const $breadcrumb = $('#global-breadcrumb-wrapper');
            if ($breadcrumb.length) {
                let $header = $('header').first();
                if (!$header.length) {
                    const $title = $('.tieu-de-trang, h1, h2, h3, h4').filter(function() {
                        return $(this).closest('.card, .table, .table-responsive, .modal, .dropdown-menu, .dropdown').length === 0;
                    }).first();
                    if ($title.length) {
                        $header = $title.closest('.row, [class*="mb-"], [class*="pb-"]');
                        if (!$header.length) {
                            $header = $title.parent();
                        }
                    }
                }
                if ($header.length) {
                    $breadcrumb.detach().insertAfter($header);
                }
            }

            var successMsg = @Html.Raw(Json.Serialize(TempData["Success"]));
            var errorMsg = @Html.Raw(Json.Serialize(TempData["Error"]));

            if (successMsg) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: successMsg,
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true
                });
            }

            if (errorMsg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: errorMsg,
                    confirmButtonColor: '#ef4444'
                });
            }

            // Hiển thị lỗi validation ModelState chi tiết nếu có
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            var errors = string.Join("<br/>", ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Select(e => "• " + e.ErrorMessage.Replace("'", "\\'").Replace("\"", "\\\"")));
            <text>
                        Swal.fire({
                            icon: 'error',
                        title: 'Lỗi nhập liệu!',
                        html: '@Html.Raw(errors)',
                        confirmButtonColor: '#ef4444'
                        });
            </text>
        }

            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));
        });
    </script>
</body>

</html>