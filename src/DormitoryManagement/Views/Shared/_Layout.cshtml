<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/_Layout.css" />

    <style>
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <partial name="_Sidebar" />

    <!-- MAIN -->
    <div class="main" id="main">

        <!-- TOPBAR -->
        <div class="topbar d-flex justify-content-between align-items-center">

            <!-- Toggle button -->
            <button class="btn btn-light" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Avatar dropdown -->
            <div class="dropdown">
                <div class="d-flex align-items-center gap-2"
                     data-bs-toggle="dropdown"
                     style="cursor:pointer;">

                    <!-- Avatar -->
                    <div class="avatar">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <i class="fas fa-user-check"></i>
                        }
                        else
                        {
                            <i class="fas fa-user-plus"></i>
                        }
                    </div>

                    <!-- Username HIỂN THỊ NGOÀI -->
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <span class="fw-semibold">@User.Identity.Name</span>
                    }
                    else
                    {
                        <span class="text-light">Khách</span>
                    }
                </div>

                <!-- DROPDOWN -->
                <ul class="dropdown-menu dropdown-menu-end">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="dropdown-header">
                            👋 Xin chào, @User.Identity.Name
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-user me-2"></i> Hồ sơ
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-key me-2"></i> Đổi mật khẩu
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-user-plus me-2"></i> Đăng ký
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="p-4">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector(".sidebar");
            const main = document.getElementById("main");

            sidebar.classList.toggle("collapsed");
            main.classList.toggle("collapsed");

            // Đóng hết submenu khi thu gọn
            if (sidebar.classList.contains("collapsed")) {
                document.querySelectorAll('.submenu').forEach(el => {
                    el.classList.remove('show');
                });
            }
        }
    </script>

    @RenderSection("Scripts", required: false)

    <script>
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));
    </script>
</body>
</html>