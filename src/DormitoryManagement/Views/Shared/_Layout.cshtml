<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/_Layout.css" />
    @RenderSection("Styles", required: false)
    <style>
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <partial name="_Sidebar" />

    <!-- MAIN -->
    <div class="main" id="main">

        <!-- TOPBAR -->
        <div class="topbar d-flex justify-content-between align-items-center sticky-top" style="z-index: 1030;">

            <!-- Toggle button -->
            <button class="btn btn-light" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Avatar dropdown -->
            <div class="dropdown">
                <div class="d-flex align-items-center gap-2"
                     data-bs-toggle="dropdown"
                     style="cursor:pointer;">

                    <!-- Avatar -->
                    <div class="avatar">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <i class="fas fa-user-shield text-danger" title="Quản trị viên"></i>
                            }
                            else if (User.IsInRole("ManagementStaff"))
                            {
                                <i class="fas fa-user-tie text-primary" title="Quản lý KTX"></i>
                            }
                            else if (User.IsInRole("TechnicalStaff"))
                            {
                                <i class="fas fa-user-cog text-warning" title="Nhân viên kỹ thuật"></i>
                            }
                            else
                            {
                                <i class="fas fa-user-graduate text-success" title="Sinh viên"></i>
                            }
                        }
                        else
                        {
                            <i class="fas fa-user-plus"></i>
                        }
                    </div>

                    <!-- Username HIỂN THỊ NGOÀI -->
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <span class="fw-semibold">@User.Identity.Name</span>
                    }
                    else
                    {
                        <span class="text-light">Khách</span>
                    }
                </div>

                <!-- DROPDOWN -->
                <ul class="dropdown-menu dropdown-menu-end">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="dropdown-header">
                            👋 Xin chào, @User.Identity.Name
                        </li>

                        <li>
                            <a class="dropdown-item" asp-controller="User" asp-action="Profile">
                                <i class="fas fa-id-card me-2"></i> Hồ sơ cá nhân
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-key me-2"></i> Đổi mật khẩu
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-2"></i> Đăng ký
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="p-4">
            @* Di chuyển Alert vào đây để nó hiển thị trong vùng nội dung chính *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector(".sidebar");
            const main = document.getElementById("main");

            sidebar.classList.toggle("collapsed");
            main.classList.toggle("collapsed");

            // Đóng hết submenu khi thu gọn
            if (sidebar.classList.contains("collapsed")) {
                document.querySelectorAll('.submenu').forEach(el => {
                    el.classList.remove('show');
                });
            }
        }
    </script>

    @RenderSection("Scripts", required: false)

    <script>
        // Tự động ẩn thông báo sau 5 giây
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 5000);
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));
    </script>
</body>
</html>