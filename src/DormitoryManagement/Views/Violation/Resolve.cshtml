@model DormitoryManagement.Application.Dtos.Requests.ViolationResponseDto

@{
    ViewData["Title"] = "Xử lý biên bản vi phạm";

    string severityClass = Model.Severity == "Trung bình" ? "s-medium"
                         : Model.Severity == "Nghiêm trọng" ? "s-high"
                         : Model.Severity == "Cảnh cáo" ? "s-warning"
                         : "s-low";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #ef4444); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; border: none; }
        .btn-header-back { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-header-back:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); color: #1e293b !important; background: #f8fafc; }
        .btn-details { background: #f8fafc; color: #475569 !important; border: 1px solid #e2e8f0; }
        .btn-details:hover { background: #e0e7ff; color: #4f46e5 !important; transform: translateY(-2px); }

        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: none; overflow: hidden; }

        .violation-summary-card {
            border-radius: 20px;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            color: white;
            padding: 28px;
        }
        .violation-id-badge {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 10px;
            padding: 6px 14px;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            font-size: 15px;
            display: inline-block;
            margin-bottom: 16px;
        }
        .info-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .info-row:last-child { border-bottom: none; }
        .info-row-label { font-size: 12px; color: rgba(255,255,255,0.55); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .info-row-value { font-size: 14px; font-weight: 700; color: #fff; text-align: right; max-width: 55%; word-break: break-word; }

        .severity-pill { font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 20px; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px; }
        .s-low { background-color: #ecfdf5; color: #10b981; }
        .s-medium { background-color: #fff7ed; color: #f97316; }
        .s-high { background-color: #fef2f2; color: #ef4444; }
        .s-warning { background-color: #fffbeb; color: #d97706; }

        .section-title { font-size: 16px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px dashed #f1f5f9; }
        .section-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; }
        .section-icon-red { background: #fef2f2; color: #ef4444; }

        .form-label { font-weight: 600; color: #475569; font-size: 13px; margin-bottom: 6px; }
        .input-custom { border-radius: 12px !important; border: 1px solid #e2e8f0; font-size: 14px; color: #1e293b; background-color: #f8fafc; transition: all 0.2s; }
        .input-custom:focus { border-color: #ef4444 !important; box-shadow: 0 0 0 4px rgba(239,68,68,0.1) !important; background-color: #fff; }

        .resolve-note-box { background: #fef2f2; border: 1px solid #fecaca; border-radius: 16px; padding: 16px 20px; margin-bottom: 20px; }
        .resolve-note-box .icon { font-size: 20px; margin-right: 10px; }

        .btn-action { height: 48px; border-radius: 12px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 28px; transition: all 0.2s; border: none; }
        .btn-resolve { background: linear-gradient(135deg, #ef4444, #dc2626); color: white !important; box-shadow: 0 4px 12px rgba(239,68,68,0.3); }
        .btn-resolve:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(239,68,68,0.4); }
        .btn-cancel { background: #fff; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-cancel:hover { background: #f8fafc; transform: translateY(-2px); }

        .warning-banner { background: #fffbeb; border: 1px solid #fde68a; border-radius: 14px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 14px; }
        .warning-banner i { font-size: 20px; color: #f59e0b; margin-top: 2px; flex-shrink: 0; }
        .warning-banner p { margin: 0; font-size: 13px; color: #92400e; line-height: 1.5; }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <!-- HEADER -->
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-gavel me-2"></i>Xử lý biên bản vi phạm</h1>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-custom-header btn-details text-decoration-none">
                <i class="fas fa-eye"></i> Xem chi tiết
            </a>
            <a asp-action="Index" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </header>

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: TÓM TẮT BIÊN BẢN -->
        <div class="col-xl-4 col-lg-5">
            <div class="violation-summary-card h-100">
                <div class="text-center mb-4">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(239,68,68,0.15); border: 2px solid rgba(239,68,68,0.4); display: flex; align-items: center; justify-content: center; font-size: 32px; margin: 0 auto 16px; color: #fca5a5;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="violation-id-badge">VIO-@Model.Id.ToString().Substring(0, 8).ToUpper()</div>
                    <p class="text-white-50 small mb-0">Ngày lập: @Model.Date.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div class="info-row">
                    <span class="info-row-label">Mã số SV</span>
                    <span class="info-row-value" style="font-family: monospace;">@Model.StudentId</span>
                </div>
                <div class="info-row">
                    <span class="info-row-label">Phòng ở</span>
                    <span class="info-row-value">@Model.Room</span>
                </div>
                <div class="info-row">
                    <span class="info-row-label">Mức độ</span>
                    <span class="severity-pill @severityClass">@Model.Severity</span>
                </div>
                <div class="info-row">
                    <span class="info-row-label">Tiền phạt</span>
                    <span class="info-row-value" style="color: #fca5a5;">@Model.FineAmount.ToString("N0") đ</span>
                </div>
                <div class="info-row">
                    <span class="info-row-label">Trạng thái</span>
                    <span class="badge" style="background: rgba(251,191,36,0.2); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); padding: 5px 12px; border-radius: 20px; font-size: 12px;">
                        <i class="fas fa-clock me-1"></i>Chưa xử lý
                    </span>
                </div>

                <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.1);">
                    <p class="text-white-50 small mb-0"><i class="fas fa-file-alt me-2"></i>Nội dung vi phạm:</p>
                    <p class="text-white mt-2 small" style="line-height: 1.6;">@Model.Content</p>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM XỬ LÝ -->
        <div class="col-xl-8 col-lg-7">
            <div class="card card-custom h-100">
                <div class="card-body p-4 p-md-5">

                    <div class="warning-banner">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <p><strong>Lưu ý khi xử lý vi phạm:</strong> Thao tác này sẽ đánh dấu biên bản vi phạm là <strong>"Đã xử lý"</strong> và không thể hoàn tác. Hãy đảm bảo bạn đã xác nhận các biện pháp xử lý trước khi xác nhận.</p>
                        </div>
                    </div>

                    <form asp-action="Resolve" asp-route-id="@Model.Id" method="post" id="resolveForm">
                        @Html.AntiForgeryToken()

                        <div class="section-title">
                            <div class="section-icon section-icon-red"><i class="fas fa-check-double"></i></div>
                            Ghi nhận kết quả xử lý
                        </div>

                        <!-- Thông tin tóm tắt nhanh -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div style="background: #f8fafc; border-radius: 12px; padding: 14px 16px; border: 1px solid #f1f5f9;">
                                    <span style="font-size: 12px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">MÃ SINH VIÊN</span>
                                    <span style="font-size: 15px; font-weight: 700; color: #1e293b; font-family: monospace;">@Model.StudentId</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div style="background: #f8fafc; border-radius: 12px; padding: 14px 16px; border: 1px solid #f1f5f9;">
                                    <span style="font-size: 12px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">TIỀN PHẠT</span>
                                    <span style="font-size: 15px; font-weight: 700; color: #ef4444;">@Model.FineAmount.ToString("N0") VNĐ</span>
                                </div>
                            </div>
                        </div>

                        <!-- Biện pháp xử lý -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="fas fa-pen-alt me-1 text-danger"></i>
                                Biện pháp & Kết quả xử lý <span class="text-danger">*</span>
                            </label>
                            <textarea id="resolveNote" name="resolveNote" class="form-control input-custom"
                                      rows="5"
                                      placeholder="Mô tả biện pháp xử lý đã áp dụng, kết quả và các yêu cầu thực hiện (nếu có)...&#10;Ví dụ: Sinh viên đã được mời lên gặp ban quản lý, ký cam kết không tái phạm và nộp phạt theo quy định." required></textarea>
                            <span id="resolveNoteError" class="text-danger small mt-1 d-none"></span>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted small"><i class="fas fa-info-circle me-1"></i>Tối thiểu 10 ký tự</span>
                                <span class="text-muted small"><span id="charCount">0</span> ký tự</span>
                            </div>
                        </div>

                        <!-- Checkbox xác nhận -->
                        <div class="mb-4 p-3" style="background: #f8fafc; border-radius: 14px; border: 1px solid #e2e8f0;">
                            <div class="form-check d-flex align-items-start gap-2">
                                <input class="form-check-input mt-1" type="checkbox" id="confirmCheck" required style="width: 18px; height: 18px; border-radius: 4px; cursor: pointer;">
                                <label class="form-check-label small text-secondary" for="confirmCheck" style="cursor: pointer; line-height: 1.6;">
                                    Tôi xác nhận đã kiểm tra đầy đủ thông tin và <strong>biên bản vi phạm này đã được giải quyết xong</strong>. Trạng thái sẽ được cập nhật thành <strong>"Đã xử lý"</strong>.
                                </label>
                            </div>
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-end gap-3">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-action btn-cancel text-decoration-none">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn-action btn-resolve" id="btnSubmit" disabled>
                                <i class="fas fa-check-double"></i> Xác nhận đã xử lý
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const noteInput = document.getElementById('resolveNote');
        const confirmCheck = document.getElementById('confirmCheck');
        const btnSubmit = document.getElementById('btnSubmit');
        const charCount = document.getElementById('charCount');
        const errorSpan = document.getElementById('resolveNoteError');

        function updateSubmitBtn() {
            const hasNote = noteInput.value.trim().length >= 10;
            const isConfirmed = confirmCheck.checked;
            btnSubmit.disabled = !(hasNote && isConfirmed);
        }

        noteInput.addEventListener('input', function () {
            const len = this.value.trim().length;
            charCount.textContent = len;
            if (len < 10 && len > 0) {
                errorSpan.textContent = 'Ghi chú cần ít nhất 10 ký tự.';
                errorSpan.classList.remove('d-none');
                this.style.borderColor = '#ef4444';
            } else {
                errorSpan.classList.add('d-none');
                this.style.borderColor = '';
            }
            updateSubmitBtn();
        });

        confirmCheck.addEventListener('change', updateSubmitBtn);

        document.getElementById('resolveForm').addEventListener('submit', function (e) {
            if (noteInput.value.trim().length < 10) {
                e.preventDefault();
                errorSpan.textContent = 'Vui lòng nhập ghi chú xử lý (ít nhất 10 ký tự).';
                errorSpan.classList.remove('d-none');
                noteInput.focus();
                return false;
            }

            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';
        });
    </script>
}
