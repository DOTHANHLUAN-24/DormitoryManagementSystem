@model DormitoryManagement.Application.Dtos.Requests.ViolationRequestDto

@{
    ViewData["Title"] = "Chỉnh Sửa Biên Bản Vi Phạm - KTX System";
    Layout = "_Layout";
    
    // Đọc ID từ đường dẫn URL (Ví dụ: /Violation/Edit/abc-xyz)
    var routeId = Context.Request.RouteValues["id"];
}

@section Styles {
    <style>
        /* Đồng bộ CSS core từ hệ thống */
        .tieu-de-trang { font-size: 28px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Nút quay lại tinh tế */
        .nut-quay-lai { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 13px; transition: all 0.2s; color: #64748b; border: 1px solid #e2e8f0; background: #fff; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
        .nut-quay-lai:hover { background: #f8fafc; color: #1e293b; transform: translateX(-2px); }

        /* Form control cao cấp */
        .khung-nhap-lieu { background: #fff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); border: none; max-width: 850px; }
        .form-label-custom { font-size: 13px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
        
        .input-group-custom { border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; transition: all 0.3s ease; background: #f8fafc; }
        .input-group-custom:focus-within { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); background: #fff; }
        .input-group-custom .input-group-text { background: transparent; border: none; color: #94a3b8; padding-left: 16px; }
        .input-group-custom .form-control, .input-group-custom .form-select { border: none; background: transparent; padding: 11px 16px 11px 10px; font-size: 14px; color: #1e293b; }
        .input-group-custom .form-control:focus, .input-group-custom .form-select:focus { box-shadow: none; background: transparent; }

        /* Custom trường tùy chọn Radio */
        .khung-radio-group { background: #f8fafc; padding: 12px 16px; border-radius: 10px; border: 1px solid #e2e8f0; }
        .form-check-input:checked[value="Chưa xử lý"] { background-color: #f97316; border-color: #f97316; }
        .form-check-input:checked[value="Đã xử lý"] { background-color: #10b981; border-color: #10b981; }

        /* Hệ thống nút hành động */
        .nut-luu { padding: 11px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.3s; background: #10b981; color: #fff; border: none; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); display: inline-flex; align-items: center; gap: 8px; }
        .nut-luu:hover { background: #059669; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(16, 185, 129, 0.3); }
        .nut-huy { padding: 11px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.2s; color: #64748b; background: #f1f5f9; border: none; text-decoration: none; }
        .nut-huy:hover { background: #e2e8f0; color: #1e293b; }
    </style>
}

<div class="container-fluid py-2">
    <!-- TIÊU ĐỀ TRANG & ĐIỀU HƯỚNG -->
    <div class="mb-4">
        <div class="d-flex mb-2">
            <a href="/Violation/Index" class="nut-quay-lai shadow-sm">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
        <h1 class="tieu-de-trang mb-1">Cập Nhật Biên Bản Vi Phạm</h1>
        <p class="text-muted small mb-0">Chỉnh sửa thông tin chi tiết hoặc thay đổi tiến độ xử lý kỷ luật sinh viên.</p>
    </div>

    <!-- FORM NHẬP LIỆU CẤU TRÚC ĐỒNG BỘ -->
    <div class="card khung-nhap-lieu">
        <div class="card-body p-4 p-md-5">
            <form id="formEditViolation" action="/Violation/Edit/@routeId" method="post">
                @Html.AntiForgeryToken()

                <!-- Truyền ID ẩn để Controller nhận biết bản ghi cần sửa -->
                <input type="hidden" name="id" value="@routeId" />

                <div class="row g-4">
                    <!-- Mã Sinh Viên -->
                    <div class="col-12 col-md-6">
                        <label class="form-label form-label-custom">Mã số sinh viên <span class="text-danger">*</span></label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                            <input type="text" name="StudentId" class="form-control" value="@(Model?.StudentId)" placeholder="Ví dụ: SV202601" required />
                        </div>
                    </div>

                    <!-- Phòng ở -->
                    <div class="col-12 col-md-6">
                        <label class="form-label form-label-custom">Phòng ở hiện tại <span class="text-danger">*</span></label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fas fa-door-open"></i></span>
                            <input type="text" name="Room" class="form-control" value="@(Model?.Room)" placeholder="Ví dụ: P.302-A1" required />
                        </div>
                    </div>

                    <!-- Mức độ vi phạm -->
                    <div class="col-12 col-md-6">
                        <label class="form-label form-label-custom">Mức độ nghiêm trọng <span class="text-danger">*</span></label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fas fa-exclamation-triangle"></i></span>
                            <select name="Severity" class="form-select" required>
                                <option value="Nhẹ" selected="@(Model?.Severity == "Nhẹ")">Nhẹ (Nhắc nhở nội bộ)</option>
                                <option value="Cảnh cáo" selected="@(Model?.Severity == "Cảnh cáo")">Cảnh cáo bằng biên bản</option>
                                <option value="Nghiêm trọng" selected="@(Model?.Severity == "Nghiêm trọng")">Nghiêm trọng (Chuyển nhà trường kỷ luật)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Ngày lập biên bản -->
                    <div class="col-12 col-md-6">
                        <label class="form-label form-label-custom">Ngày xảy ra / Ngày lập <span class="text-danger">*</span></label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            @{
                                string formattedDate = "";
                                if (Model?.Date != null)
                                {
                                    if (Model.Date is DateTime dt) { formattedDate = dt.ToString("yyyy-MM-dd"); }
                                    else { formattedDate = Model.Date.ToString(); }
                                }
                            }
                            <input type="date" name="Date" class="form-control" value="@formattedDate" required />
                        </div>
                    </div>

                    <!-- Nội dung vi phạm -->
                    <div class="col-12">
                        <label class="form-label form-label-custom">Mô tả nội dung vi phạm <span class="text-danger">*</span></label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text align-items-start pt-3"><i class="fas fa-pen-nib"></i></span>
                            <textarea name="Content" class="form-control" rows="4" placeholder="Mô tả chi tiết diễn biến hành vi..." required>@(Model?.Content)</textarea>
                        </div>
                    </div>

                    <!-- Trạng thái xử lý -->
                    <div class="col-12">
                        <label class="form-label form-label-custom">Cập nhật trạng thái xử lý</label>
                        <div class="khung-radio-group">
                            <div class="form-check form-check-inline me-4">
                                <input class="form-check-input" type="radio" name="Status" value="Chưa xử lý" id="status1" checked="@(Model?.Status == "Chưa xử lý" || Model?.Status == null)">
                                <label class="form-check-label text-warning fw-semibold small" for="status1">
                                    <i class="fas fa-clock me-1"></i> Chưa xử lý (Chờ duyệt)
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Status" value="Đã xử lý" id="status2" checked="@(Model?.Status == "Đã xử lý")">
                                <label class="form-check-label text-success fw-semibold small" for="status2">
                                    <i class="fas fa-check-circle me-1"></i> Đã xử lý giải quyết xong
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="my-4" style="border-top: 1px dashed #e2e8f0;"></div>

                <!-- NÚT HÀNH ĐỘNG ĐỒNG BỘ BÊN PHẢI -->
                <div class="d-flex justify-content-end gap-3">
                    <a href="/Violation/Index" class="nut-huy">Hủy bỏ</a>
                    <button type="submit" class="nut-luu shadow-sm">
                        <i class="fas fa-check-circle"></i> Cập nhật biên bản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Tích hợp SweetAlert2 tạo hiệu ứng thông báo khi chỉnh sửa thành công
        document.getElementById('formEditViolation').addEventListener('submit', function(e) {
            e.preventDefault(); 
            
            Swal.fire({
                title: 'Đang cập nhật...',
                html: 'Hệ thống đang đồng bộ dữ liệu sửa đổi.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            setTimeout(() => {
                Swal.fire({
                    icon: 'success',
                    title: 'Cập nhật thành công!',
                    text: 'Thông tin biên bản vi phạm đã được chỉnh sửa trên hệ thống.',
                    confirmButtonColor: '#4f46e5',
                    confirmButtonText: 'OK'
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.submit();
                    }
                });
            }, 800);
        });
    </script>
}