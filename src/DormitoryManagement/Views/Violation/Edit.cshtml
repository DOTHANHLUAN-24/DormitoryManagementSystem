@model DormitoryManagement.Application.Dtos.Requests.ViolationRequestDto

@{
    ViewData["Title"] = "Chỉnh Sửa Biên Bản Vi Phạm - KTX System";
    Layout = "_Layout";
    
    // Đọc ID từ đường dẫn URL (Ví dụ: /Violation/Edit/abc-xyz)
    var routeId = Context.Request.RouteValues["id"];
}

<div class="container-fluid p-0">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="mb-4">
        <a href="/Violation/Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h3 class="text-dark fw-bold mb-1">Cập Nhật Biên Bản Vi Phạm</h3>
        <p class="text-muted small mb-0">Chỉnh sửa thông tin hoặc cập nhật tiến độ xử lý kỷ luật.</p>
    </div>

    <!-- FORM CẬP NHẬT -->
    <div class="card border-0 shadow-sm" style="max-width: 800px;">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@routeId" method="post">
                @Html.AntiForgeryToken()

                <!-- Truyền ID ẩn để Controller nhận biết bản ghi cần sửa -->
                <input type="hidden" name="id" value="@routeId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="row g-3">
                    <!-- Mã Sinh Viên -->
                    <div class="col-12 col-md-6">
                        <label asp-for="StudentId" class="form-label fw-semibold text-secondary small">Mã số sinh viên <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-id-card text-muted"></i></span>
                            <input asp-for="StudentId" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="StudentId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Phòng ở -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Room" class="form-label fw-semibold text-secondary small">Phòng ở hiện tại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-door-open text-muted"></i></span>
                            <input asp-for="Room" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="Room" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Mức độ vi phạm -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Severity" class="form-label fw-semibold text-secondary small">Mức độ nghiêm trọng <span class="text-danger">*</span></label>
                        <select asp-for="Severity" class="form-select bg-light">
                            <option value="Nhẹ">Nhẹ (Nhắc nhở)</option>
                            <option value="Cảnh cáo">Cảnh cáo biên bản</option>
                            <option value="Nghiêm trọng">Nghiêm trọng (Kỷ luật nặng)</option>
                        </select>
                        <span asp-validation-for="Severity" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Ngày lập biên bản -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Date" class="form-label fw-semibold text-secondary small">Ngày vi phạm / Ngày lập <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-calendar-alt text-muted"></i></span>
                            <input asp-for="Date" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="Date" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Nội dung vi phạm -->
                    <div class="col-12">
                        <label asp-for="Content" class="form-label fw-semibold text-secondary small">Mô tả nội dung vi phạm <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Content" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Trạng thái xử lý -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small">Cập nhật trạng thái xử lý</label>
                        <div class="mt-1">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="Status" value="Chưa xử lý" id="status1">
                                <label class="form-check-label text-warning fw-medium" for="status1">Chưa xử lý</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="Status" value="Đã xử lý" id="status2">
                                <label class="form-check-label text-success fw-medium" for="status2">Đã xử lý xong</label>
                            </div>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <!-- NÚT HÀNH ĐỘNG -->
                <div class="d-flex justify-content-end gap-2">
                    <a href="/Violation/Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="fas fa-check-circle me-1"></i> Cập nhật biên bản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}