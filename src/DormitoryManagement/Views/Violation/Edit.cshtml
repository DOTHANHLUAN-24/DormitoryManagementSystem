@{
    ViewData["Title"] = "Cập nhật thông tin vi phạm";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12 col-md-9 col-lg-6 mx-auto">
            
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none small text-muted"><i class="fas fa-arrow-left me-1"></i> Quay lại danh sách</a>
            </div>

            <div class="card card-form-custom border-0 shadow-sm">
                <div class="card-header-custom py-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="fw-bold text-dark-navy mb-1"><i class="fas fa-pencil-alt me-2" style="color: #e2a03f;"></i>Xử Lý Vi Phạm</h3>
                            <p class="text-muted small mb-0">Cập nhật tiến trình giải quyết và trạng thái biên bản lỗi.</p>
                        </div>
                        <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold" style="font-size:0.75rem; border-radius:6px;">MÃ: VIO001</span>
                    </div>
                </div>
                
                <div class="card-body p-4 border-top border-light-subtle">
                    <form asp-action="Edit" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark-navy">Họ tên sinh viên vi phạm</label>
                            <input type="text" class="form-control input-custom bg-light-disabled" value="Nguyễn Thành Long" readonly />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-semibold small text-dark-navy">Phòng ở</label>
                                <input type="text" class="form-control input-custom bg-light-disabled" value="P.302-A1" readonly />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-semibold small text-dark-navy">Trạng thái xử lý</label>
                                <select class="form-select input-custom select-status-highlight">
                                    <option value="Chờ xử lý" selected>⏳ Chờ xử lý</option>
                                    <option value="Đã xử lý">✅ Đã xử lý</option>
                                    <option value="Đã hủy">❌ Đã hủy</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark-navy">Nội dung lỗi vi phạm</label>
                            <textarea class="form-control input-custom bg-light-disabled" rows="2" readonly>Sử dụng bếp từ công suất lớn trong phòng ở ký túc xá.</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-dark-navy">Biện pháp xử lý / Quyết định kỷ luật <span class="text-danger">*</span></label>
                            <textarea class="form-control input-custom" rows="3" placeholder="Ghi chú hình thức phạt tiền, tịch thu thiết bị hoặc hạ điểm rèn luyện..." required>Tịch thu thiết bị công suất lớn, yêu cầu viết bản cam kết và phạt hành chính 200.000đ theo nội quy.</textarea>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-refresh-light px-4">Quay lại</a>
                            <button type="submit" class="btn btn-warning-custom px-4 text-white">Cập nhật thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    body { background-color: #f4f7f6; font-family: 'Segoe UI', system-ui, sans-serif; }
    .text-dark-navy { color: #3b3f5c; }
    .card-form-custom { border-radius: 16px; background: white; box-shadow: 0 4px 25px rgba(0,0,0,0.04)!important; }
    .input-custom { border: 1px solid #e0e6ed; padding: 10px 14px; font-size: 14px; background-color: #f9fbfd; border-radius: 10px; }
    .bg-light-disabled { background-color: #f1f2f3!important; color: #64748b; cursor: not-allowed; }
    .input-custom:focus { border-color: #e2a03f; box-shadow: none; background-color: #fff; }
    .select-status-highlight { font-weight: 600; color: #4361ee; }
    .btn-warning-custom { background-color: #e2a03f; color: white; border: none; font-weight: 500; padding: 10px 24px; border-radius: 10px; font-size: 0.9rem; }
    .btn-warning-custom:hover { background-color: #cc8b32; color: white; }
    .btn-refresh-light { background-color: #ebedf2; color: #3b3f5c; border: none; border-radius: 10px; padding: 10px 24px; font-weight: 500; font-size: 0.9rem; }
    .btn-refresh-light:hover { background-color: #e0e4ec; }
</style>