@using DormitoryManagement.Application.Dtos.Requests.Violations
@model ViolationRequestDto

@{
    ViewData["Title"] = "Lập biên bản mới";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; }
        .btn-header-back { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-header-back:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); color: #1e293b !important; background: #f8fafc; }
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; overflow: hidden; }
        .section-title { font-size: 16px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px dashed #f1f5f9; }
        .section-icon { width: 38px; height: 38px; border-radius: 10px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; font-size: 16px; }
        .form-label { font-weight: 600; color: #475569; font-size: 13px; margin-bottom: 6px; }
        .input-custom { height: 46px; border-radius: 12px !important; border: 1px solid #e2e8f0; font-size: 14px; color: #1e293b; background-color: #f8fafc; transition: all 0.2s; }
        .input-custom:focus { border-color: #4f46e5 !important; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important; background-color: #fff; }
        textarea.input-custom { height: auto; }
        .btn-action { height: 46px; border-radius: 12px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 24px; transition: all 0.2s; border: none; }
        .btn-save { background: #4f46e5; color: white !important; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); background: #4338ca; }
        .btn-cancel { background: #fff; color: #ef4444 !important; border: 1px solid #fee2e2; background: #fef2f2; }
        .btn-cancel:hover { background: #fee2e2; transform: translateY(-2px); }
    </style>
}

<div class="container-fluid">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-plus-circle me-2"></i>Lập biên bản vi phạm mới</h1>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </header>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card card-custom">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <!-- Summary Validation Errors -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small border-0 shadow-sm"></div>

                        <div class="section-title">
                            <div class="section-icon"><i class="fas fa-file-invoice"></i></div>
                            Thông tin biên bản vi phạm
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="StudentId" class="form-label">Mã số sinh viên (MSSV) <span class="text-danger">*</span></label>
                                <input asp-for="StudentId" class="form-control input-custom" placeholder="Ví dụ: SV202601" required />
                                <span asp-validation-for="StudentId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Room" class="form-label">Phòng ở (Dự phòng) <span class="text-danger">*</span></label>
                                <input asp-for="Room" class="form-control input-custom" placeholder="Ví dụ: P101" required />
                                <span asp-validation-for="Room" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Severity" class="form-label">Mức độ vi phạm <span class="text-danger">*</span></label>
                                <select asp-for="Severity" class="form-select input-custom" required>
                                    <option value="">-- Chọn mức độ --</option>
                                    <option value="Nhẹ">Nhẹ (Phạt 50.000đ)</option>
                                    <option value="Trung bình">Trung bình (Phạt 100.000đ)</option>
                                    <option value="Nghiêm trọng">Nghiêm trọng (Phạt 200.000đ)</option>
                                    <option value="Cảnh cáo">Cảnh cáo (Phạt 300.000đ)</option>
                                </select>
                                <span asp-validation-for="Severity" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Date" class="form-label">Ngày lập biên bản <span class="text-danger">*</span></label>
                                <input asp-for="Date" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control input-custom" required />
                                <span asp-validation-for="Date" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Status" class="form-label">Trạng thái xử lý <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select input-custom" required>
                                    <option value="Chưa xử lý">⏳ Chưa xử lý</option>
                                    <option value="Đã xử lý">✅ Đã xử lý</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Content" class="form-label">Nội dung lỗi vi phạm <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control input-custom" rows="4" placeholder="Mô tả cụ thể lỗi vi phạm nội quy..." required></textarea>
                            <span asp-validation-for="Content" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn-action btn-cancel text-decoration-none">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn-action btn-save">
                                <i class="fas fa-check"></i> Lưu biên bản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}