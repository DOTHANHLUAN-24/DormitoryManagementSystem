@model dynamic

@{
    ViewData["Title"] = "Lập Biên Bản Vi Phạm - KTX System";
    Layout = "_Layout";
}

<div class="container-fluid p-0">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="mb-4">
        <a href="/Violation/Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h3 class="text-dark fw-bold mb-1">Lập Biên Bản Vi Phạm Mới</h3>
        <p class="text-muted small mb-0">Ghi nhận hành vi vi phạm nội quy kí túc xá của sinh viên.</p>
    </div>

    <!-- FORM NHẬP LIỆU -->
    <div class="card border-0 shadow-sm" style="max-width: 800px;">
        <div class="card-body p-4">
            <form action="/Violation/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Mã Sinh Viên -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Mã số sinh viên <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-id-card text-muted"></i></span>
                            <input type="text" name="StudentId" class="form-control" placeholder="Ví dụ: SV202601" required />
                        </div>
                    </div>

                    <!-- Phòng ở -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Phòng ở hiện tại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-door-open text-muted"></i></span>
                            <input type="text" name="Room" class="form-control" placeholder="Ví dụ: P.302-A1" required />
                        </div>
                    </div>

                    <!-- Mức độ vi phạm -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Mức độ nghiêm trọng <span class="text-danger">*</span></label>
                        <select name="Severity" class="form-select bg-light" required>
                            <option value="">-- Chọn mức độ --</option>
                            <option value="Nhẹ">Nhẹ (Nhắc nhở)</option>
                            <option value="Cảnh cáo">Cảnh cáo biên bản</option>
                            <option value="Nghiêm trọng">Nghiêm trọng (Kỷ luật nặng)</option>
                        </select>
                    </div>

                    <!-- Ngày lập biên bản -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Ngày vi phạm / Ngày lập <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-calendar-alt text-muted"></i></span>
                            <input type="date" name="Date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <!-- Nội dung vi phạm -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small">Mô tả nội dung vi phạm <span class="text-danger">*</span></label>
                        <textarea name="Content" class="form-control" rows="4" placeholder="Mô tả chi tiết hành vi vi phạm..." required></textarea>
                    </div>

                    <!-- Trạng thái xử lý -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small">Trạng thái xử lý ban đầu</label>
                        <div class="mt-1">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Status" value="Chưa xử lý" id="status1" checked>
                                <label class="form-check-label text-warning fw-medium" for="status1">Chưa xử lý</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Status" value="Đã xử lý" id="status2">
                                <label class="form-check-label text-success fw-medium" for="status2">Đã xử lý xong</label>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <!-- NÚT HÀNH ĐỘNG -->
                <div class="d-flex justify-content-end gap-2">
                    <a href="/Violation/Index" class="btn btn-light border px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger px-4 shadow-sm">
                        <i class="fas fa-save me-1"></i> Lưu biên bản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>