@model DormitoryManagement.Application.Dtos.Requests.ViolationResponseDto
@{
    ViewData["Title"] = "Chi tiết biên bản vi phạm";



    // Phân loại style hiển thị theo mức độ

    string severityClass = "s-low";

    if (Model.Severity == "Trung bình")

    {

        severityClass = "s-medium";

    }

    else if (Model.Severity == "Nghiêm trọng")

    {

        severityClass = "s-high";

    }

    else if (Model.Severity == "Cảnh cáo")

    {

        severityClass = "s-warning";

    }
}

@section Styles {
    <style>
        .tieu-de-trang {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(135deg, #1e293b, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-custom-header {
            padding: 8px 16px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            border: none;
        }

        .btn-header-back {
            background: white;
            color: #64748b !important;
            border: 1px solid #e2e8f0;
        }

        .btn-header-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.05);
            color: #1e293b !important;
            background: #f8fafc;
        }

        .btn-edit {
            background: #4f46e5;
            color: white !important;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3);
            background: #4338ca;
        }

        .card-custom {
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: none;
            padding: 24px;
            overflow: hidden;
        }

        .avatar-box {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px auto;
            font-size: 45px;
            border: 4px solid #fff;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s;
        }

        .avatar-box:hover {
            transform: scale(1.05);
        }

        .avatar-violation {
            color: #f59e0b;
            background: #fffbeb;
        }

        .badge-soft {
            padding: 6px 16px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.5px;
        }

        .s-low {
            background-color: #ecfdf5;
            color: #10b981;
        }

        .s-medium {
            background-color: #fff7ed;
            color: #f97316;
        }

        .s-high {
            background-color: #fef2f2;
            color: #ef4444;
        }

        .s-warning {
            background-color: #fffbeb;
            color: #d97706;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px dashed #f1f5f9;
        }

        .section-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .info-group {
            background: #f8fafc;
            border-radius: 16px;
            padding: 16px 20px;
            height: 100%;
            border: 1px solid #f1f5f9;
        }

        .info-label {
            font-size: 13px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }

        .info-value {
            font-size: 15px;
            color: #1e293b;
            font-weight: 700;
            word-break: break-word;
        }

        .status-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-active {
            background: #ecfdf5;
            color: #10b981;
        }

        .status-inactive {
            background: #fff7ed;
            color: #f97316;
        }
    </style>
}

<div class="container-fluid">
    <!-- HEADER -->
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-info-circle me-2"></i>Chi tiết biên bản vi phạm</h1>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom-header btn-edit text-decoration-none">
                <i class="fas fa-edit"></i> Chỉnh sửa vi phạm
            </a>
        </div>
    </header>

    <div class="row g-4">
        <!-- CỘT TRÁI: TÓM TẮT BIÊN BẢN -->
        <div class="col-xl-4 col-lg-5">
            <div class="card card-custom h-100 text-center">
                <div class="mb-4">
                    <div class="avatar-box avatar-violation">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">VIO-@Model.Id.ToString().Substring(0, 5).ToUpper()</h4>
                    <p class="text-muted small mb-3 font-monospace">Ngày lập: @Model.Date.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <div class="d-flex flex-column align-items-center gap-2">
                        <!-- Mức độ vi phạm -->
                        <span class="badge-soft @severityClass">
                            <i class="fas fa-exclamation-circle"></i> Mức độ: @Model.Severity
                        </span>

                        <!-- Số tiền phạt -->
                        <span class="badge bg-light text-dark border px-3 py-2 fw-bold rounded-pill"
                            style="font-size: 13px;">
                            💸 Phạt: @Model.FineAmount.ToString("N0") VNĐ
                        </span>

                        <!-- Trạng thái xử lý -->
                        @if (Model.Status == "Đã xử lý")

                        {
                            <span class="status-badge status-active">
                                <i class="fas fa-check-circle"></i> Đã xử lý
                            </span>
                        }

                        else

                        {
                            <span class="status-badge status-inactive">
                                <i class="fas fa-clock"></i> Chưa xử lý
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: THÔNG TIN CHI TIẾT -->
        <div class="col-xl-8 col-lg-7">
            <div class="card card-custom h-100">
                <div class="section-title">
                    <div class="section-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                    Thông tin biên bản lỗi
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-group">
                            <span class="info-label">Mã số sinh viên vi phạm (MSSV)</span>
                            <span class="info-value">@Model.StudentId</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-group">
                            <span class="info-label">Phòng ở</span>
                            <span class="info-value">@Model.Room</span>
                        </div>
                    </div>

                    <div class="col-md-12 col-12">
                        <div class="info-group" style="min-height: 140px;">
                            <span class="info-label">Nội dung lỗi vi phạm</span>
                            <span class="info-value text-secondary" style="font-weight: 500; line-height: 1.6;">
                                @Model.Content
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
