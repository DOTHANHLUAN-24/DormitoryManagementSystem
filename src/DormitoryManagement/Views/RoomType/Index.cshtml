@using DormitoryManagement.Domain.Common
@model PagedResult<DormitoryManagement.Domain.Entities.RoomType>

@{
    ViewData["Title"] = "Quản lý Loại phòng";
}

<div class="container-fluid">
    @* Tiêu đề và nút chức năng *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-primary fw-bold">
            <i class="fas fa-layer-group me-2"></i> Quản lý Loại phòng
        </h4>
        <div>
            @* Sau này bạn có thể làm thêm trang RecycleBin cho RoomType *@
            <a asp-action="Create" class="btn btn-primary btn-sm ms-2">
                <i class="fas fa-plus me-1"></i> Thêm loại phòng
            </a>
        </div>
    </div>

    @* Thanh tìm kiếm *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" placeholder="Tìm theo tên loại phòng...">
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    @* Bảng danh sách *@
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3" style="width: 20%">Tên loại phòng</th>
                        <th style="width: 15%">Giá cơ bản</th>
                        <th style="width: 15%">Sức chứa</th>
                        <th style="width: 25%">Mô tả</th>
                        <th style="width: 10%">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 15%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="fw-bold text-dark">@item.TypeName</span>
                                </td>
                                <td>
                                    <span class="text-primary fw-semibold">@item.BasePrice.ToString("N0") đ</span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3">
                                        <i class="fas fa-users me-1"></i> @item.MaxOccupants Người
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">
                                        @item.Description
                                    </small>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Ngừng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button onclick="deleteRoomType('@item.Id', '@item.TypeName')" class="btn btn-sm btn-light text-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open d-block mb-2 fa-2x"></i>
                                Không tìm thấy loại phòng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        function deleteRoomType(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn có chắc muốn xóa loại phòng "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/RoomType/Delete/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            location.reload();
                        },
                        error: function () {
                            Swal.fire('Lỗi!', 'Không thể xóa loại phòng này (có thể đang có phòng thuộc loại này).', 'error');
                        }
                    });
                }
            })
        }
    </script>
}