@using DormitoryManagement.Domain.Enums
@using DormitoryManagement.Domain.Entities
@model DormitoryManagement.Domain.Entities.RoomType

@{
    ViewData["Title"] = "Chi tiết loại phòng " + Model.TypeName;
    Layout = "_Layout";
    
    // Tìm các phòng thuộc loại này đang có sinh viên cư trú
    var occupiedRooms = Model.Rooms
        .Where(r => r.Beds.Any(b => b.Status == BedStatus.Occupied))
        .ToList();
    var hasOccupiedRooms = occupiedRooms.Any();
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }

        .details-container {
            padding: 2rem 0;
        }

        .page-header-gradient {
            background: linear-gradient(135deg, #1e293b 0%, #4f46e5 100%);
            border-radius: 24px;
            padding: 2.5rem;
            color: white;
            box-shadow: 0 10px 35px rgba(79, 70, 229, 0.1);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .page-header-gradient::before {
            content: '';
            position: absolute;
            top: -20%;
            right: -10%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            filter: blur(50px);
        }

        .card-custom {
            background: white;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
            transition: all 0.3s ease;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .card-custom:hover {
            box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.08);
        }

        .info-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            margin-bottom: 0.25rem;
        }

        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1e293b;
        }

        .warning-alert {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 16px;
            color: #b45309;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .warning-icon {
            font-size: 1.25rem;
            color: #d97706;
            margin-top: 2px;
        }

        .room-badge {
            background-color: #f1f5f9;
            color: #334155;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            border: 1px solid #cbd5e1;
            display: inline-block;
            margin: 2px;
            text-decoration: none;
            transition: all 0.2s;
        }

        .room-badge:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }
    </style>
}

<div class="container details-container">
    <!-- Header -->
    <div class="page-header-gradient">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="mb-0 fw-extrabold text-white" style="font-size: 2.2rem; letter-spacing: -0.02em;">
                    <i class="fas fa-tags me-2"></i>@Model.TypeName
                </h1>
                <p class="mb-0 text-white-50 mt-1 fw-medium">Sức chứa: <strong class="text-white">@Model.MaxOccupants người</strong> | Giá: <strong class="text-white">@Model.BasePrice.ToString("N0") đ</strong></p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-light fw-bold px-4 py-2" style="border-radius: 12px; border: 1.5px solid rgba(255,255,255,0.4); text-decoration: none;">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light fw-bold px-4 py-2" style="border-radius: 12px; color: #1e293b; text-decoration: none;">
                    <i class="fas fa-edit me-1"></i> Chỉnh sửa loại phòng
                </a>
            </div>
        </div>
    </div>

    <!-- Alert cảnh báo nếu có phòng đang có sinh viên -->
    @if (hasOccupiedRooms)
    {
        <div class="warning-alert shadow-sm">
            <i class="fas fa-exclamation-triangle warning-icon"></i>
            <div>
                <h6 class="fw-bold mb-1">Cảnh báo: Loại phòng này đang có sinh viên cư trú!</h6>
                <p class="mb-2 small">Hiện đang có sinh viên ở tại các phòng thuộc loại này. Không được tự ý tắt hoạt động (Deactivate) hoặc thay đổi cấu hình sức chứa cốt lõi của loại phòng này để tránh lỗi hệ thống.</p>
                <div class="mt-1">
                    <span class="small fw-bold me-1">Các phòng đang ở:</span>
                    @foreach (var r in occupiedRooms)
                    {
                        <a href="/Room/Details/@r.Id" class="room-badge">
                            <i class="fas fa-door-open me-1 small"></i> Phòng @r.RoomNumber (@r.Block?.BlockName)
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- CỘT TRÁI: THÔNG TIN LOẠI PHÒNG -->
        <div class="col-lg-4">
            <div class="card card-custom">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="fas fa-info-circle text-primary me-2"></i>Thông tin chi tiết</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="info-label">Tên loại phòng</div>
                            <div class="info-value">@Model.TypeName</div>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <div class="info-label">Giá thuê hàng tháng</div>
                            <div class="info-value text-indigo fw-extrabold" style="color: #4f46e5; font-size: 1.25rem;">
                                @Model.BasePrice.ToString("N0") đ/tháng
                            </div>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <div class="info-label">Sức chứa tối đa</div>
                            <div class="info-value"><i class="fas fa-user-friends me-1 text-muted"></i>@Model.MaxOccupants Người / phòng</div>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <div class="info-label">Trạng thái kích hoạt</div>
                            <div>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2 fw-bold" style="border-radius: 8px;">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 fw-bold" style="border-radius: 8px;">Tạm ngưng</span>
                                }
                            </div>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <div class="info-label">Mô tả tiện nghi</div>
                            <p class="text-muted small mb-0 fw-medium" style="line-height: 1.6;">
                                @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả chi tiết cho loại phòng này." : Model.Description)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: DANH SÁCH CÁC PHÒNG THUỘC LOẠI NÀY -->
        <div class="col-lg-8">
            <div class="card card-custom">
                <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="fas fa-door-open text-primary me-2"></i>Danh sách phòng thuộc loại này</h5>
                    <span class="badge bg-primary rounded-pill">@Model.Rooms.Count phòng</span>
                </div>
                <div class="card-body p-4">
                    @if (Model.Rooms.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-nowrap">
                                <thead>
                                    <tr class="text-muted fw-bold small">
                                        <th class="ps-3">Số phòng</th>
                                        <th>Tòa nhà</th>
                                        <th>Tầng</th>
                                        <th>Số sinh viên</th>
                                        <th>Trạng thái</th>
                                        <th class="text-end pe-3">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var room in Model.Rooms)
                                    {
                                        var occupiedBedsCount = room.Beds.Count(b => b.Status == BedStatus.Occupied);
                                        var totalBedsCount = room.Beds.Count;
                                        
                                        <tr>
                                            <td class="ps-3 fw-bold">@room.RoomNumber</td>
                                            <td><span class="fw-semibold text-primary">@room.Block?.BlockName</span></td>
                                            <td>Tầng @room.Floor</td>
                                            <td>
                                                <span class="fw-bold">@occupiedBedsCount</span> / @totalBedsCount giường
                                            </td>
                                            <td>
                                                @switch (room.Status)
                                                {
                                                    case RoomStatus.Available:
                                                        <span class="badge bg-success-subtle text-success">Còn trống</span>
                                                        break;
                                                    case RoomStatus.Full:
                                                        <span class="badge bg-warning-subtle text-warning">Đã đầy</span>
                                                        break;
                                                    case RoomStatus.Maintenance:
                                                        <span class="badge bg-danger-subtle text-danger">Bảo trì</span>
                                                        break;
                                                    case RoomStatus.Reserved:
                                                        <span class="badge bg-purple-subtle text-purple" style="color: #6d28d9; background-color: #f3e8ff;">Đặt trước</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary text-white">@room.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <a href="/Room/Details/@room.Id" class="btn btn-sm btn-outline-primary fw-semibold" style="border-radius: 8px;">
                                                    <i class="fas fa-eye me-1"></i>Xem chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-door-closed d-block mb-3 fs-1 text-light"></i>
                            Không có phòng nào thuộc loại này.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
