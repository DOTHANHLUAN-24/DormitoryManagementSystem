@using DormitoryManagement.Domain.Common
@model DormitoryManagement.Domain.Common.PagedResult<DormitoryManagement.Domain.Entities.RoomType>

@{
    ViewData["Title"] = "Thùng rác loại phòng";
    var search = ViewBag.Search as string ?? "";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-danger fw-bold mb-0">
                <i class="fas fa-trash-alt me-2"></i> Thùng rác loại phòng
            </h4>
            <p class="text-muted small mb-0">Quản lý các loại phòng đã xóa tạm thời. Bạn có thể khôi phục hoặc xóa vĩnh viễn khỏi hệ thống.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary shadow-sm" style="border-radius: 10px;">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Thanh tìm kiếm -->
    <form method="get" asp-action="RecycleBin" class="thanh-tim-kiem-sync" style="border: 1px solid #fecaca !important;">
        <div class="row g-3">
            <div class="col-md-10">
                <div class="khung-tim-kiem-sync">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@search" class="input-sync" placeholder="Tìm loại phòng trong thùng rác...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-search-sync" style="background: #ef4444;">
                    Tìm kiếm
                </button>
            </div>
        </div>
    </form>

    <!-- Bảng danh sách loại phòng đã xóa -->
    <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên loại phòng</th>
                        <th>Giá cơ bản</th>
                        <th>Sức chứa</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="opacity-75">
                                <td class="ps-4">
                                    <span class="fw-bold text-secondary text-decoration-line-through">@item.TypeName</span>
                                </td>
                                <td>
                                    <span class="text-muted text-decoration-line-through">@item.BasePrice.ToString("N0") đ</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-muted border">
                                        <i class="fas fa-users me-1"></i>@item.MaxOccupants người
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">@item.Description</small>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã xóa</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button onclick="restoreRoomType('@item.Id', '@item.TypeName')"
                                                class="btn btn-sm btn-outline-success px-3" title="Khôi phục" style="border-radius: 8px;">
                                            <i class="fas fa-undo-alt me-1"></i> Khôi phục
                                        </button>
                                        <button onclick="deletePermanently('@item.Id', '@item.TypeName')"
                                                class="btn btn-sm btn-outline-danger px-2" title="Xóa vĩnh viễn" style="border-radius: 8px;">
                                            <i class="fas fa-eraser"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="py-4">
                                    <i class="fas fa-folder-open fa-3x text-muted mb-3 opacity-25"></i>
                                    <p class="text-muted mb-0">Thùng rác hiện đang trống.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        function getAntiforgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function restoreRoomType(id, name) {
            Swal.fire({
                title: 'Khôi phục loại phòng?',
                text: `Loại phòng "${name}" sẽ hiển thị lại trong danh sách hoạt động.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý khôi phục',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/RoomType/Restore/' + id,
                        type: 'POST',
                        data: { __RequestVerificationToken: getAntiforgeryToken() },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, timer: 1500, showConfirmButton: false })
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function () { Swal.fire('Lỗi', 'Không thể kết nối máy chủ', 'error'); }
                    });
                }
            });
        }

        function deletePermanently(id, name) {
            Swal.fire({
                title: 'CẢNH BÁO NGUY HIỂM!',
                html: "Bạn đang chuẩn bị <b>XÓA VĨNH VIỄN</b> loại phòng <b>" + name + "</b>.<br/>Hành động này <b>KHÔNG THỂ</b> hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-skull-crossbones me-1"></i> Vẫn xóa vĩnh viễn',
                cancelButtonText: 'Quay lại',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Xác nhận lần cuối',
                        text: "Gõ chữ 'XOA' vào ô bên dưới để xác nhận.",
                        input: 'text',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Thực thi xóa',
                        cancelButtonText: 'Hủy',
                        preConfirm: (inputValue) => {
                            if (inputValue !== 'XOA') {
                                Swal.showValidationMessage('Bạn phải gõ đúng chữ XOA');
                            }
                        }
                    }).then((finalResult) => {
                        if (finalResult.isConfirmed) {
                            Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                            $.ajax({
                                url: '/RoomType/DeletePermanently/' + id,
                                type: 'POST',
                                data: { __RequestVerificationToken: getAntiforgeryToken() },
                                success: function (res) {
                                    if (res.success) {
                                        Swal.fire({ icon: 'success', title: 'Đã xóa!', text: res.message, timer: 1500, showConfirmButton: false })
                                            .then(() => location.reload());
                                    } else {
                                        Swal.fire('Lỗi', res.message, 'error');
                                    }
                                },
                                error: function () { Swal.fire('Lỗi', 'Có lỗi xảy ra trong quá trình xóa', 'error'); }
                            });
                        }
                    });
                }
            });
        }
    </script>
}
