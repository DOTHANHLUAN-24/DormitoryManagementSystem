@using DormitoryManagement.Domain.Common
@model PagedResult<DormitoryManagement.Domain.Entities.RoomType>

@{
    ViewData["Title"] = "Loại phòng & Giá cả";
}

@section Styles {
    <style>
        .hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
        }
        .btn-indigo:hover {
            opacity: 0.95;
            transform: scale(1.01);
        }
    </style>
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="mb-5 text-center text-md-start">
        <span class="badge px-3 py-2 mb-2 fw-semibold" style="background-color: #eef2ff; color: #4f46e5; border-radius: 8px;">
            <i class="fas fa-tags me-1"></i> BẢNG GIÁ DỊCH VỤ CƯ TRÚ
        </span>
        <h2 class="fw-bold text-slate-800" style="color: #0f172a; font-size: 2.25rem;">Danh Sách Loại Phòng Ký Túc Xá</h2>
        <p class="text-muted mb-0">Xem thông tin chi tiết về các loại phòng, diện tích sức chứa và đơn giá thuê hàng tháng tại KTX.</p>
    </div>

    <!-- Thanh tìm kiếm -->
    <form method="get" asp-action="List" class="thanh-tim-kiem-sync">
        <div class="row g-3">
            <div class="col-md-10">
                <div class="khung-tim-kiem-sync">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="input-sync" placeholder="Tìm nhanh loại phòng (Ví dụ: Phòng 4 người, Máy lạnh...)">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-search-sync">
                    Tìm kiếm
                </button>
            </div>
        </div>
    </form>

    <!-- Grid of cards -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.Items.Any(x => x.IsActive))
        {
            foreach (var item in Model.Items.Where(x => x.IsActive))
            {
                var iconClass = item.MaxOccupants switch
                {
                    <= 2 => "fa-user-friends",
                    4 => "fa-users",
                    6 => "fa-users-cog",
                    _ => "fa-hotel"
                };

                var themeColor = item.MaxOccupants switch
                {
                    <= 2 => "#10b981",
                    4 => "#4f46e5",
                    6 => "#3b82f6",
                    _ => "#f59e0b"
                };

                <div class="col">
                    <div class="card h-100 border-0 shadow-sm hover-card position-relative overflow-hidden" style="border-radius: 20px; transition: all 0.3s ease; background: #ffffff;">
                        <!-- Top Accent Line -->
                        <div style="height: 6px; background: @themeColor;"></div>
                        
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Header Info -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="icon-wrapper p-3 rounded-4" style="background-color: @(themeColor)15; color: @themeColor;">
                                    <i class="fas @iconClass fa-2x"></i>
                                </div>
                                <span class="badge px-3 py-2" style="background-color: @(themeColor)15; color: @themeColor; font-weight: 700; border-radius: 30px;">
                                    <i class="fas fa-user-check me-1"></i>Tối đa @item.MaxOccupants Người
                                </span>
                            </div>

                            <!-- Name -->
                            <h4 class="card-title fw-bold text-slate-800 mb-2" style="color: #1e293b;">@item.TypeName</h4>

                            <!-- Description -->
                            <p class="card-text text-muted flex-grow-1 mb-4" style="font-size: 0.92rem; line-height: 1.6;">
                                @(!string.IsNullOrEmpty(item.Description) ? item.Description : "Loại phòng tiêu chuẩn được trang bị hệ thống ánh sáng, tủ đồ cá nhân, bàn học và quạt gió. Đảm bảo an ninh và vệ sinh sạch sẽ hàng ngày.")
                            </p>

                            <!-- Divider -->
                            <hr class="text-muted opacity-25 mb-4">

                            <!-- Pricing -->
                            <div class="d-flex align-items-baseline mb-4">
                                <span class="text-muted small fw-semibold me-2">Giá phòng:</span>
                                <h3 class="fw-bold mb-0 text-indigo" style="color: #4f46e5; font-weight: 800; font-size: 1.6rem;">@item.BasePrice.ToString("N0")đ</h3>
                                <span class="text-muted small ms-1">/ tháng</span>
                            </div>

                            <!-- Action -->
                            <a href="/Rooms?RoomTypeId=@item.Id" class="btn btn-indigo text-white w-100 py-3 text-center text-decoration-none" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%); border: none; border-radius: 14px; font-weight: 700; font-size: 0.95rem; transition: all 0.2s;">
                                <i class="fas fa-search me-2"></i>Xem danh sách phòng trống
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="fas fa-box-open d-block mb-3 fa-3x" style="color: #cbd5e1;"></i>
                <h5>Không tìm thấy loại phòng hoạt động nào.</h5>
                <p class="small">Vui lòng thử lại sau.</p>
            </div>
        }
    </div>

    <!-- Phân trang -->
    <div class="card border-0 shadow-sm mt-5" style="border-radius: 16px; overflow: hidden;">
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
