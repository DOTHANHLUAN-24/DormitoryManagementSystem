@{
    ViewData["Title"] = "Thêm Dịch Vụ Mới";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-2">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
        <h2 class="fw-bold text-dark">Thêm Dịch Vụ Mới</h2>
    </div>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-controller="Service" asp-action="Create" method="post">
                        <!-- Tên dịch vụ -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên dịch vụ</label>
                            <input type="text" class="form-control" placeholder="Ví dụ: Tiền điện, Giặt ủi..." required>
                        </div>

                        <div class="row">
                            <!-- Đơn giá -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Đơn giá (VNĐ)</label>
                                <input type="number" class="form-control" placeholder="0" required>
                            </div>
                            <!-- Đơn vị tính -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Đơn vị tính</label>
                                <select class="form-select">
                                    <option value="kWh">kWh</option>
                                    <option value="m3">m³</option>
                                    <option value="Tháng">Tháng</option>
                                    <option value="Lượt">Lượt</option>
                                </select>
                            </div>
                        </div>

                        <!-- Loại dịch vụ -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Loại hình</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="type" id="type1" checked>
                                    <label class="form-check-label" for="type1">Thiết yếu</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="type" id="type2">
                                    <label class="form-check-label" for="type2">Tiện ích</label>
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mô tả chi tiết</label>
                            <textarea class="form-control" rows="3" placeholder="Nhập mô tả ngắn về dịch vụ..."></textarea>
                        </div>

                        <hr>

                        <!-- Nút hành động -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột hướng dẫn bên cạnh (Optional) -->
        <div class="col-md-4">
            <div class="alert alert-info border-0 shadow-sm">
                <h5><i class="fas fa-info-circle me-2"></i> Lưu ý</h5>
                <ul class="small mb-0">
                    <li>Đơn giá dịch vụ được cập nhật theo thông báo mới nhất của Ban quản lý.</li>
                    <li>Đơn vị tính sẽ ảnh hưởng trực tiếp đến cách tính hóa đơn cho sinh viên.</li>
                    <li>Dịch vụ mới sau khi tạo sẽ mặc định ở trạng thái "Đang hoạt động".</li>
                </ul>
            </div>
        </div>
    </div>
</div>