@{
    ViewData["Title"] = "Chỉnh sửa Dịch Vụ";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-2">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
        <div class="d-flex align-items-center">
            <h2 class="fw-bold text-dark mb-0">Chỉnh sửa dịch vụ</h2>
            <span class="badge bg-primary ms-3">ID: #DV-01</span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm border-top border-warning border-4">
                <div class="card-body p-4">
                    <form asp-controller="Service" asp-action="Edit" method="post">
                        <!-- Tên dịch vụ (Dữ liệu mẫu: Điện sinh hoạt) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên dịch vụ</label>
                            <input type="text" class="form-control" value="Điện sinh hoạt" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Đơn giá hiện tại</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" value="3500" required>
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Đơn vị tính</label>
                                <select class="form-select">
                                    <option value="kWh" selected>kWh</option>
                                    <option value="m3">m³</option>
                                    <option value="Tháng">Tháng</option>
                                </select>
                            </div>
                        </div>

                        <!-- Trạng thái hoạt động -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Trạng thái cung cấp</label>
                            <select class="form-select border-info">
                                <option value="true" selected>✅ Đang hoạt động</option>
                                <option value="false">❌ Tạm ngừng cung cấp</option>
                            </select>
                            <div class="form-text text-muted">Khi tạm ngừng, dịch vụ sẽ không thể chọn khi tạo hóa đơn mới.</div>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-outline-danger" onclick="confirmDelete()">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-light">Hủy</a>
                                <button type="submit" class="btn btn-warning px-4 fw-bold">
                                    <i class="fas fa-check me-2"></i>Cập nhật thay đổi
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Log lịch sử thay đổi (Chỉ hiển thị cho Admin) -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">
                    <i class="fas fa-history me-2"></i>Lịch sử cập nhật
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item py-3">
                            <div class="text-muted">10/05/2024 - 14:30</div>
                            <div>Thay đổi đơn giá từ <del>3.200</del> lên <strong>3.500</strong></div>
                            <div class="text-primary">Bởi: Admin_Nguyen</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            if(confirm("Cảnh báo: Việc xóa dịch vụ có thể ảnh hưởng đến các hóa đơn cũ. Bạn có chắc chắn?")) {
                alert("Đã gửi yêu cầu xóa!");
            }
        }
    </script>
}