<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Điều hướng nhanh -->
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card border-0 shadow-lg">
                <!-- Header -->
                <div class="card-header bg-white border-0 pt-4 ps-4">
                    <h4 class="fw-bold text-dark mb-0">Chỉnh sửa dịch vụ</h4>
                    <p class="text-muted small">Cập nhật thông tin chi tiết cho dịch vụ #SVC001</p>
                </div>

                <div class="card-body p-4">
                    <form>
                        <input type="hidden" value="1" />

                        <div class="row">
                            <!-- Tên dịch vụ -->
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold">Tên dịch vụ</label>
                                <input type="text" class="form-control" value="Điện sinh hoạt"
                                       placeholder="Ví dụ: Giặt đồ bằng máy" />
                            </div>

                            <!-- Đơn vị tính -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Đơn vị tính</label>
                                <select class="form-select">
                                    <option value="Số" selected>Số (kWh/m³)</option>
                                    <option value="Tháng">Tháng</option>
                                    <option value="Lần">Lần sử dụng</option>
                                    <option value="Người/Tháng">Người / Tháng</option>
                                </select>
                            </div>

                            <!-- Đơn giá -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Đơn giá hiện tại</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold">VNĐ</span>
                                    <input type="number" class="form-control" value="3500" />
                                </div>
                            </div>

                            <!-- Trạng thái -->
                            <div class="col-md-12 mb-4">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="statusSwitch" checked>
                                        <label class="form-check-label fw-bold" for="statusSwitch">Kích hoạt dịch vụ
                                            này</label>
                                        </div>
                                        <small class="text-muted d-block mt-1 ps-1">
                                            Nếu vô hiệu hóa, dịch vụ sẽ không hiển thị khi sinh viên đăng ký mới.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Khu vực nút bấm -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-3">
                                <a asp-action="Index" class="btn btn-light px-4 border">Hủy bỏ</a>
                                <button type="button" class="btn btn-primary px-5 shadow">
                                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Chân trang hỗ trợ -->
                <div class="text-center mt-4">
                    <p class="text-muted small">Cần hỗ trợ? Liên hệ <span class="text-primary">Quản trị viên hệ thống</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
