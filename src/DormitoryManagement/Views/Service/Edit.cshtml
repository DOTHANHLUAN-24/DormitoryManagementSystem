@model DormitoryManagement.Domain.Entities.Utility
@{
    ViewData["Title"] = "Chỉnh sửa Dịch Vụ - KTX System";
    Layout = "_Layout";

    var routeId = Context.Request.RouteValues["id"];
}

@section Styles {
    <style>
        /* Hệ thống Typography & Tiêu đề dạng Gradient đồng bộ hệ thống */
        .tieu-de-trang { font-size: 28px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #f59e0b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Cấu trúc thẻ Card cao cấp bo góc 20px */
        .khung-chua-form { background: #fff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04); border: none; }
        .card-lich-su { border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04); border: none; overflow: hidden; }

        /* Nút quay lại danh sách chính dạng viền mềm */
        .nut-quay-lai { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.3s; background-color: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
        .nut-quay-lai:hover { transform: translateY(-1px); background-color: #f1f5f9; color: #1e293b; }

        /* Tinh chỉnh Input Form hiện đại */
        .form-label { color: #475569; font-size: 14px; margin-bottom: 6px; }
        .form-control, .form-select { border-radius: 10px; padding: 10px 14px; border: 1px solid #cbd5e1; color: #334155; font-size: 14px; transition: all 0.2s ease-in-out; }
        .form-control:focus, .form-select:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15); color: #0f172a; }
        .input-group-text { border-radius: 0 10px 10px 0; background-color: #f8fafc; border: 1px solid #cbd5e1; color: #64748b; font-weight: 500; }
        .form-control + .input-group-text { border-left: none; }
        .form-control:focus + .input-group-text { border-color: #f59e0b; background-color: #fff7ed; color: #b45309; }

        /* Các nút bấm hành động cuối Form */
        .nut-luu-lai { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; padding: 10px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .nut-luu-lai:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3); color: white; }
        .nut-huy-bo { background-color: #f1f5f9; color: #475569; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.2s; text-decoration: none; }
        .nut-huy-bo:hover { background-color: #e2e8f0; color: #1e293b; }
        .nut-xoa-nhanh { background-color: #fef2f2; color: #ef4444; border: 1px solid #fee2e2; width: 42px; height: 42px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .nut-xoa-nhanh:hover { background-color: #ef4444; color: white; border-color: #ef4444; }

        /* Badge ID và Trạng thái */
        .badge-id { background-color: #f1f5f9; color: #475569; font-weight: 600; font-size: 13px; padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0; }
        
        /* Dòng thời gian lịch sử nhỏ gọn */
        .timeline-item { border-left: 2px solid #e2e8f0; padding-left: 16px; position: relative; }
        .timeline-item::before { content: ''; width: 8px; height: 8px; background-color: #f59e0b; border-radius: 50%; position: absolute; left: -5px; top: 6px; }
    </style>
}

<div class="container-fluid py-2">
    <!-- TIÊU ĐỀ TRANG VÀ ĐIỀU HƯỚNG QUAY LẠI -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center flex-wrap gap-3">
            <h1 class="tieu-de-trang mb-0"><i class="fas fa-edit me-2 text-warning"></i>Chỉnh Sửa Dịch Vụ</h1>
            <span class="badge-id"><i class="fas fa-hashtag me-1"></i>Mã: DV-@Model?.Id</span>
        </div>
        <div>
            <a asp-action="Index" class="nut-quay-lai">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT CHÍNH: FORM CHỈNH SỬA -->
        <div class="col-xl-8 col-lg-7">
            <div class="card khung-chua-form">
                <div class="card-body p-4 sm-p-5">
                    <form asp-controller="Service" asp-action="Edit" asp-route-id="@Model?.Id" method="post" id="form-edit-service">
                        <!-- Hiển thị lỗi tổng hợp của ModelState nếu có -->
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger-subtle rounded-3"></div>
                        
                        <!-- Input ẩn giữ Khóa chính để bảo toàn thực thể -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Hàng 1: Tên dịch vụ tiện ích -->
                        <div class="mb-4">
                            <label asp-for="UtilityName" class="form-label fw-bold">Tên dịch vụ / tiện ích <span class="text-danger">*</span></label>
                            <input asp-for="UtilityName" type="text" class="form-control" placeholder="Ví dụ: Tiền điện sinh hoạt, Giặt là..." autocomplete="off">
                            <span asp-validation-for="UtilityName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Hàng 2: Đơn giá và Đơn vị tính phân bổ 2 bên -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="UnitPrice" class="form-label fw-bold">Đơn giá hiện tại <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="UnitPrice" type="number" class="form-control text-end" min="0" placeholder="0">
                                    <span class="input-group-text">VND</span>
                                </div>
                                <span asp-validation-for="UnitPrice" class="text-danger small d-block mt-1"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Unit" class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                                <select asp-for="Unit" class="form-select">
                                    <option value="kWh">⚡ kWh (Số điện)</option>
                                    <option value="m³">💧 m³ (Khối nước)</option>
                                    <option value="Tháng">📅 Tháng (Cố định)</option>
                                    <option value="Lượt">🔄 Lượt sử dụng</option>
                                    <option value="kg">⚖️ kg (Cân nặng)</option>
                                </select>
                                <span asp-validation-for="Unit" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Hàng 3: Tình trạng cung cấp dịch vụ -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Trạng thái cung cấp dịch vụ</label>
                            <select name="IsActive" class="form-select">
                                <option value="true">🟢 Đang hoạt động ổn định</option>
                                <option value="false">🔴 Tạm ngưng cung cấp (Ẩn khỏi danh mục)</option>
                            </select>
                            <div class="form-text text-muted mt-1" style="font-size: 12px;">
                                <i class="fas fa-info-circle me-1"></i> Khi chuyển sang trạng thái tạm ngưng, hệ thống sẽ ẩn dịch vụ này khỏi danh mục lập hóa đơn mới.
                            </div>
                        </div>

                        <hr class="text-neutral-200 my-4">

                        <!-- KHU VỰC CÁC NÚT ĐIỀU HƯỚNG TÁC VỤ -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <!-- Nút di chuyển nhanh dịch vụ vào thùng rác -->
                            <button type="button" class="nut-xoa-nhanh" onclick="confirmDeleteFromEdit('@Model?.Id', '@Model?.UtilityName')" title="Đưa dịch vụ này vào thùng rác">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                            
                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="nut-huy-bo">Hủy bỏ</a>
                                <button type="submit" class="nut-luu-lai">
                                    <i class="fas fa-save"></i> Cập nhật thay đổi
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Form ẩn kích hoạt tính năng Xóa mềm (Đưa vào thùng rác) -->
                    <form id="delete-form-from-edit" asp-controller="Service" asp-action="Delete" asp-route-id="@Model?.Id" method="post" class="d-none"></form>
                </div>
            </div>
        </div>

        <!-- CỘT PHỤ: LOG LỊCH SỬ THAY ĐỔI -->
        <div class="col-xl-4 col-lg-5">
            <div class="card card-lich-su">
                <div class="card-header bg-light py-3 border-0 fw-bold text-dark d-flex align-items-center">
                    <i class="fas fa-history me-2 text-secondary"></i> Nhật ký thay đổi gần đây
                </div>
                <div class="card-body p-4">
                    <div class="timeline-item mb-3">
                        <div class="text-muted font-monospace mb-1" style="font-size: 12px;">10/05/2024 - 14:30</div>
                        <div class="text-dark fw-medium" style="font-size: 14px;">Điều chỉnh giá bán dịch vụ</div>
                        <p class="text-muted small mb-0 mt-1">Thay đổi đơn giá gốc từ <del class="text-danger">3.200đ</del> lên mức <strong class="text-success">3.500đ</strong> bởi quản trị viên <span class="badge bg-secondary-subtle text-secondary-dark">Admin_Nguyen</span></p>
                    </div>
                    
                    <div class="timeline-item">
                        <div class="text-muted font-monospace mb-1" style="font-size: 12px;">01/01/2024 - 08:00</div>
                        <div class="text-dark fw-medium" style="font-size: 14px;">Khởi tạo dịch vụ ban đầu</div>
                        <p class="text-muted small mb-0 mt-1">Ghi nhận dữ liệu dịch vụ mới lên hệ thống hạ tầng quản lý.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Khởi chạy thư viện kiểm tra dữ liệu Client-side mặc định của ASP.NET Core *@
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Thay thế hàm confirm truyền thống bằng SweetAlert2 giao diện cao cấp
        function confirmDeleteFromEdit(id, name) {
            Swal.fire({
                title: 'Đưa vào Thùng rác?',
                text: `Hành động này sẽ tạm ẩn dịch vụ "${name}" khỏi các danh sách hoạt động chính và chuyển vào mục lưu trữ tạm thời.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý, xóa tạm',
                cancelButtonText: 'Hủy thao tác'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Kích hoạt gửi lệnh Form ẩn để chạy Action Controller xử lý xóa mềm
                    document.getElementById('delete-form-from-edit').submit();
                }
            });
        }
    </script>
}