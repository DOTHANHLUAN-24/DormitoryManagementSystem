@model IEnumerable<DormitoryManagement.Domain.Entities.Utility>
@{
    ViewData["Title"] = "Thùng rác Dịch vụ";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Header & Navigation -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold text-dark"><i class="fas fa-trash-alt me-2 text-danger"></i>Thùng rác Dịch vụ</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Service" asp-action="Index">Dịch vụ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thùng rác</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-controller="Service" asp-action="Index" class="btn btn-light shadow-sm border">
                <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Trash Content Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-muted">Các dịch vụ đã tạm xóa</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Mã</th>
                            <th>Tên dịch vụ</th>
                            <th>Đơn giá</th>
                            <th>Ngày xóa</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Phần này đang dùng Mock Data để bạn xem giao diện *@

                        <tr class="opacity-75">
                            <td class="ps-4 text-secondary">#UTL-8821</td>
                            <td>
                                <div class="text-decoration-line-through fw-bold">Giặt ủi sấy khô</div>
                                <small class="text-muted">Đơn vị: kg</small>
                            </td>
                            <td>15.000 đ</td>
                            <td>20/05/2024</td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm">
                                    <button type="button" class="btn btn-sm btn-outline-success shadow-sm"
                                            title="Khôi phục" onclick="return confirm('Bạn muốn khôi phục dịch vụ này?')">
                                        <i class="fas fa-undo"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1 shadow-sm"
                                            title="Xóa vĩnh viễn"
                                            onclick="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn?')">
                                        <i class="fas fa-trash-alt me-1"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <tr class="opacity-75">
                            <td class="ps-4 text-secondary">#UTL-4412</td>
                            <td>
                                <div class="text-decoration-line-through fw-bold">Thuê xe đạp điện</div>
                                <small class="text-muted">Đơn vị: lượt</small>
                            </td>
                            <td>5.000 đ</td>
                            <td>18/05/2024</td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm">
                                    <button type="button" class="btn btn-sm btn-outline-success shadow-sm"
                                            title="Khôi phục" onclick="return confirm('Bạn muốn khôi phục dịch vụ này?')">
                                        <i class="fas fa-undo"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1 shadow-sm"
                                            title="Xóa vĩnh viễn"
                                            onclick="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn?')">
                                        <i class="fas fa-trash-alt me-1"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @* Khi có dữ liệu thật, bạn sẽ dùng vòng lặp foreach ở đây *@
                        @*
                        @foreach (var item in Model) {
                            ... code tương tự như trên dùng @item.UtilityName ...
                        }
                        *@
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 text-center">
            <p class="mb-0 text-muted small">
                <i class="fas fa-info-circle me-1"></i> Dữ liệu trong thùng rác sẽ bị xóa tự động sau 30 ngày.
            </p>
        </div>
    </div>
</div>
