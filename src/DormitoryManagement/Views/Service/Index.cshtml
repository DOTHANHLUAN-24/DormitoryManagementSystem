@{
    ViewData["Title"] = "Danh sách dịch vụ - KTX System";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* Hệ thống Typography & Tiêu đề */
        .tieu-de-trang { font-size: 28px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Cấu trúc thẻ Card cao cấp */
        .khung-chua-bo-loc { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; }
        .khung-chua-bang { background: #fff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); border: none; overflow: hidden; }

        /* Nhóm nút chức năng phía trên */
        .cum-nut-tren-cung { display: flex; align-items: center; gap: 10px; }
        
        .nut-them-moi { padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.3s; background: linear-gradient(135deg, #ef4444, #f43f5e); color: #fff; border: none; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2); display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
        .nut-them-moi:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(239, 68, 68, 0.3); color: #fff; }
        
        .nut-thung-rac-tren { width: 42px; height: 42px; border-radius: 10px; background-color: #f1f5f9; color: #64748b; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; transition: all 0.3s; border: 1px solid #e2e8f0; text-decoration: none; }
        .nut-thung-rac-tren:hover { background-color: #cbd5e1; color: #1e293b; transform: translateY(-2px); }

        /* Ô tìm kiếm và Bộ lọc nâng cao */
        .input-group-custom { border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; transition: all 0.3s ease; background: #f8fafc; }
        .input-group-custom:focus-within { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); background: #fff; }
        .input-group-custom .input-group-text { background: transparent; border: none; color: #94a3b8; padding-left: 14px; }
        .input-group-custom .form-control, .input-group-custom .form-select { border: none; background: transparent; padding: 9px 12px; font-size: 14px; color: #1e293b; }
        .input-group-custom .form-control:focus, .input-group-custom .form-select:focus { box-shadow: none; background: transparent; }

        .nut-lam-moi { padding: 9px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.2s; color: #64748b; background: #f1f5f9; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
        .nut-lam-moi:hover { background: #e2e8f0; color: #1e293b; }

        /* Tinh chỉnh Bảng dữ liệu */
        .table thead { background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; }
        .table th { font-size: 12px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px 12px; }
        .table td { padding: 16px 12px; font-size: 14px; color: #334155; }
        
        /* Huy hiệu trạng thái hoạt động dịch vụ */
        .badge-status { padding: 6px 12px; border-radius: 30px; font-weight: 600; font-size: 12px; display: inline-flex; align-items: center; gap: 5px; }
        .badge-success-soft { background-color: #ecfdf5; color: #10b981; }
        .badge-warning-soft { background-color: #fef3c7; color: #d97706; }
        .badge-danger-soft { background-color: #fef2f2; color: #ef4444; }

        /* Khung chứa các nút thao tác hàng ngang */
        .cum-hanh-dong { display: flex; align-items: center; justify-content: flex-end; gap: 6px; white-space: nowrap; flex-wrap: nowrap; }

        /* Nút hành động nhỏ gọn trong bảng */
        .nut-hanh-dong { width: 32px; height: 32px; padding: 0; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; border: none; font-size: 13px; text-decoration: none; flex-shrink: 0; cursor: pointer; }
        .nut-duyet { background-color: #ecfdf5; color: #10b981; }
        .nut-duyet:hover { background-color: #10b981; color: #fff; }
        .nut-sua { background-color: #fef3c7; color: #d97706; }
        .nut-sua:hover { background-color: #d97706; color: #fff; }
        .nut-xoa { background-color: #fef2f2; color: #ef4444; }
        .nut-xoa:hover { background-color: #ef4444; color: #fff; }

        /* Định hình thanh phân trang số (Pagination) */
        .pagination .page-item .page-link { color: #64748b; background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 8px 14px; font-weight: 600; font-size: 13px; margin: 0 2px; transition: all 0.2s ease; border-radius: 6px; }
        .pagination .page-item:first-child .page-link { border-radius: 6px; }
        .pagination .page-item:last-child .page-link { border-radius: 6px; }
        .pagination .page-item.active .page-link { background: linear-gradient(135deg, #4f46e5, #6366f1); border-color: #4f46e5; color: #fff; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.15); }
        .pagination .page-item .page-link:hover:not(.active) { background-color: #e2e8f0; color: #1e293b; }
        .pagination .page-item.disabled .page-link { color: #cbd5e1; pointer-events: none; background-color: #f8fafc; border-color: #e2e8f0; }
    </style>
}

<div class="container-fluid py-2">
    <!-- TIÊU ĐỀ TRANG VÀ CỤM NÚT CHỨC NĂNG PHÍA TRÊN -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="tieu-de-trang mb-1">Danh Mục Dịch Vụ KTX</h1>
            <p class="text-muted small mb-0">Hệ thống quản lý, thiết lập danh mục các gói dịch vụ tiện ích cung cấp cho sinh viên nội trú.</p>
        </div>
        <div class="cum-nut-tren-cung">
            <!-- Nút Thùng rác trỏ đến Service/Trash -->
            <a href="/Service/Trash" class="nut-thung-rac-tren shadow-sm" title="Xem danh sách dịch vụ đã xóa tạm">
                <i class="fas fa-trash-alt"></i>
            </a>
            <!-- Nút Thêm mới trỏ đến Service/Create giống form cũ -->
            <a href="/Service/Create" class="nut-them-moi shadow-sm">
                <i class="fas fa-plus-circle"></i> Thêm Gói Dịch Vụ
            </a>
        </div>
    </div>

    <!-- BỘ LỌC TÌM KIẾM ĐỒNG BỘ -->
    <div class="card khung-chua-bo-loc mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Tìm tên dịch vụ, mã dịch vụ, mô tả...">
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="fas fa-stream"></i></span>
                        <select id="statusFilter" class="form-select">
                            <option value="All">-- Tất cả trạng thái --</option>
                            <option value="Hoạt động">Đang hoạt động</option>
                            <option value="Tạm dừng">Tạm dừng cung cấp</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <button class="nut-lam-moi w-100" onclick="resetFilters()">
                        <i class="fas fa-sync-alt"></i> Làm mới bộ lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU HIỂN THỊ -->
    <div class="card khung-chua-bang">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="serviceTable">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 100px;">Mã DV</th>
                            <th style="width: 200px;">Tên dịch vụ</th>
                            <th style="width: 150px;">Đơn giá</th>
                            <th style="width: 130px;">Đơn vị tính</th>
                            <th style="width: 300px;">Mô tả chi tiết</th>
                            <th style="width: 140px;">Ngày cập nhật</th>
                            <th style="width: 130px;">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- Dữ liệu render động qua JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- THANH PHÂN TRANG -->
        <div class="card-footer bg-white border-top py-3">
            <div class="d-flex justify-content-center align-items-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="paginationList">
                        <!-- Đầu số trang tính toán tự động -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Mảng Mock Data gốc quản lý danh mục dịch vụ KTX 2026
        const mockServices = [
            { id: "DV001", name: "Internet Tốc Độ Cao", price: 120000, unit: "Tháng / Phòng", description: "Băng thông ròng 100Mbps, không giới hạn dung lượng thiết bị kết nối.", updatedAt: "2026-05-15T08:30:00", isProcessed: false, status: "Hoạt động" },
            { id: "DV002", name: "Giặt Sấy Tự Động", price: 15000, unit: "Lượt / 7Kg", description: "Hệ thống máy giặt sấy thông minh tại khu dịch vụ tầng G tòa nhà.", updatedAt: "2026-05-16T14:20:00", isProcessed: true, status: "Hoạt động" },
            { id: "DV003", name: "Trông Giữ Xe Máy", price: 90000, unit: "Tháng / Xe", description: "Bãi xe tầng hầm có hệ thống camera giám sát và quẹt thẻ từ nhận diện.", updatedAt: "2026-05-17T09:00:00", isProcessed: false, status: "Hoạt động" },
            { id: "DV004", name: "Phòng Tập Gym & Fitness", price: 150000, unit: "Tháng / Người", description: "Khu phức hợp gym thể hình, đầy đủ trang thiết bị hiện đại khu A1.", updatedAt: "2026-05-17T16:45:00", isProcessed: true, status: "Tạm dừng" },
            { id: "DV005", name: "Nước Bình Tinh Khiết", price: 25000, unit: "Bình 20 Lít", description: "Cung cấp tại chỗ, đổi vỏ bình trực tiếp tại quầy quản lý.", updatedAt: "2026-05-18T11:15:00", status: "Hoạt động" }
        ];

        // Biến kiểm soát bộ lọc và phân trang thực tế giống file mẫu
        let filteredData = [...mockServices];
        let currentPage = 1;
        const pageSize = 3; // Định cấu hình 3 dòng/trang để kích hoạt tính năng phân trang

        document.addEventListener("DOMContentLoaded", function () {
            updateDataView();

            // Lắng nghe bộ lọc sự kiện theo thời gian thực
            document.getElementById("searchInput").addEventListener("input", filterData);
            document.getElementById("statusFilter").addEventListener("change", filterData);
        });

        // Hàm tổng hợp xử lý đồng bộ giao diện
        function updateDataView() {
            displayTableData(currentPage);
            renderPagination();
        }

        function displayTableData(page) {
            const tableBody = document.getElementById("tableBody");
            tableBody.innerHTML = "";

            const startIndex = (page - 1) * pageSize;
            const endIndex = startIndex + pageSize;
            const pageData = filteredData.slice(startIndex, endIndex);

            if (pageData.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted fw-medium"><i class="fas fa-folder-open me-2"></i>Không tìm thấy dữ liệu dịch vụ nào phù hợp.</td></tr>`;
                return;
            }

            pageData.forEach(item => {
                let statusBadge = '';
                if (item.status === 'Hoạt động') {
                    statusBadge = `<span class="badge-status badge-success-soft"><i class="fas fa-check-circle"></i>Hoạt động</span>`;
                } else if (item.status === 'Tạm dừng') {
                    statusBadge = `<span class="badge-status badge-warning-soft"><i class="fas fa-exclamation-circle"></i>Tạm dừng</span>`;
                } else {
                    statusBadge = `<span class="badge-status badge-danger-soft"><i class="fas fa-times-circle"></i>Ngừng cung cấp</span>`;
                }

                let actionButtons = `<div class="cum-hanh-dong">`;
                // Nút chức năng Đảo nhanh trạng thái (giống nút Gavel duyệt bên Vi Phạm)
                if (item.status !== "Ngừng cung cấp") {
                    actionButtons += `
                        <button class="nut-hanh-dong nut-duyet" onclick="toggleServiceStatus('${item.id}')" title="Bật/Tắt nhanh trạng thái">
                            <i class="fas fa-sync-alt"></i>
                        </button>`;
                } else {
                    actionButtons += `<div style="width: 32px; height: 32px; flex-shrink: 0;"></div>`;
                }
                
                // ĐÃ SỬA: Icon chỉnh sửa chuyển hướng chính xác đến Service/Edit
                actionButtons += `
                    <a href="/Service/Edit/${item.id}" class="nut-hanh-dong nut-sua" title="Sửa thông tin dịch vụ">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="nut-hanh-dong nut-xoa" onclick="deleteService('${item.id}')" title="Xóa bỏ đưa vào thùng rác">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>`;

                let row = `<tr>
                    <td class="ps-4 fw-bold text-secondary">${item.id}</td>
                    <td class="fw-semibold text-dark">${item.name}</td>
                    <td class="fw-bold text-primary">${formatCurrency(item.price)}</td>
                    <td><span class="badge bg-light text-dark border font-monospace px-2 py-1">${item.unit}</span></td>
                    <td class="text-wrap small text-muted" style="max-width: 260px;">${item.description}</td>
                    <td class="small text-muted">${formatDateTime(item.updatedAt)}</td>
                    <td>${statusBadge}</td>
                    <td class="pe-4">${actionButtons}</td>
                </tr>`;

                tableBody.insertAdjacentHTML('beforeend', row);
            });
        }

        // Tự động tính toán số trang dựa trên dữ liệu thật sau khi lọc
        function renderPagination() {
            const paginationList = document.getElementById("paginationList");
            paginationList.innerHTML = "";

            const totalPages = Math.ceil(filteredData.length / pageSize) || 1;

            if (currentPage > totalPages) {
                currentPage = totalPages;
            }
            
            let htmlContent = `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="changePage(${currentPage - 1})">Trước</a></li>`;
            
            for (let i = 1; i <= totalPages; i++) {
                htmlContent += `<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link" href="#" onclick="changePage(${i})">${i}</a></li>`;
            }

            htmlContent += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link" href="#" onclick="changePage(${currentPage + 1})">Sau</a></li>`;
            
            paginationList.innerHTML = htmlContent;
        }

        function changePage(pageNumber) {
            const totalPages = Math.ceil(filteredData.length / pageSize) || 1;
            if (pageNumber < 1 || pageNumber > totalPages) return;
            
            currentPage = pageNumber;
            updateDataView();
        }

        // Lọc dữ liệu đa điều kiện
        function filterData() {
            const searchVal = document.getElementById("searchInput").value.toLowerCase().trim();
            const statusVal = document.getElementById("statusFilter").value;

            filteredData = mockServices.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(searchVal) || 
                                      item.id.toLowerCase().includes(searchVal) ||
                                      item.description.toLowerCase().includes(searchVal);
                const matchesStatus = statusVal === "All" || item.status === statusVal;
                return matchesSearch && matchesStatus;
            });

            currentPage = 1;
            updateDataView();
        }

        function resetFilters() {
            document.getElementById("searchInput").value = "";
            document.getElementById("statusFilter").value = "All";
            filteredData = [...mockServices];
            currentPage = 1;
            updateDataView();
        }

        // Đảo nhanh trạng thái hoạt động dịch vụ
        function toggleServiceStatus(id) {
            const service = mockServices.find(s => s.id === id);
            if (!service) return;

            Swal.fire({
                title: 'Thay đổi trạng thái dịch vụ?',
                text: `Hành động này sẽ chuyển trạng thái của dịch vụ "${service.name}" từ [${service.status}] sang [${service.status === 'Hoạt động' ? 'Tạm dừng' : 'Hoạt động'}].`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xác nhận thay đổi',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    service.status = service.status === "Hoạt động" ? "Tạm dừng" : "Hoạt động";
                    service.updatedAt = new Date().toISOString();
                    filterData();

                    Swal.fire({
                        icon: 'success',
                        title: 'Đã cập nhật!',
                        text: `Gói dịch vụ đã được chuyển sang trạng thái: ${service.status}`,
                        confirmButtonColor: '#4f46e5'
                    });
                }
            });
        }

        // Đã chỉnh sửa: Xác nhận và trỏ thẳng về Service/Trash/{id} để xử lý xóa bên backend
        function deleteService(id) {
            const service = mockServices.find(s => s.id === id);
            if (!service) return;

            Swal.fire({
                title: 'Xóa gói dịch vụ này?',
                text: `Hệ thống sẽ ngưng cung cấp và chuyển gói dịch vụ "${service.name}" vào thùng rác hệ thống.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Chuyển hướng sang router backend xử lý xóa tạm đưa vào thùng rác
                    window.location.href = `/Service/Trash/${id}`;
                }
            });
        }

        // Hàm định dạng tiền tệ tệ VNĐ
        function formatCurrency(value) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
        }

        // Định dạng thời gian
        function formatDateTime(dateTimeStr) {
            if (!dateTimeStr) return "";
            const date = new Date(dateTimeStr);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}`;
        }
    </script>
}