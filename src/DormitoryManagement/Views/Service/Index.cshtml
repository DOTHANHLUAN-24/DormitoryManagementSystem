@model IEnumerable<DormitoryManagement.Domain.Entities.Utility>
@{
    ViewData["Title"] = "Danh sách Dịch vụ";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Header & Navigation -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold text-dark"><i class="fas fa-concierge-bell me-2 text-primary"></i>Quản lý Dịch vụ</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dịch vụ</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 text-md-end">
            <!-- Nút Trỏ sang trang THÊM DỊCH VỤ -->
            <a asp-controller="Service" asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus-circle me-2"></i>Thêm dịch vụ mới
            </a>
            <a asp-controller="Service" asp-action="Trash" class="btn btn-outline-secondary shadow-sm ms-2">
                <i class="fas fa-trash-alt me-2"></i>Thùng rác
            </a>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Danh sách chi tiết</h5>
                <div class="input-group style=" width: 250px;">
                    <input type="text" class="form-control" placeholder="Tìm tên dịch vụ...">
                    <button class="btn btn-outline-secondary"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Mã</th>
                            <th>Tên dịch vụ</th>
                            <th>Đơn giá</th>
                            <th>Đơn vị</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dữ liệu mẫu 1 -->
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#DV-01</td>
                            <td>
                                <div>Điện sinh hoạt</div>
                                <small class="text-muted">Định mức nhà nước</small>
                            </td>
                            <td>3.500 đ</td>
                            <td>kWh</td>
                            <td><span class="badge rounded-pill bg-success">Đang cung cấp</span></td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <!-- Nút Trỏ sang trang SỬA DỊCH VỤ (Giả sử Id = 1) -->
                                    <a asp-controller="Service" asp-action="Edit" asp-route-id="1"
                                       class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" title="Xóa dịch vụ"
                                            onclick="confirmDelete('Điện sinh hoạt')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- Dữ liệu mẫu 2 -->
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#DV-02</td>
                            <td>
                                <div>Nước sạch</div>
                                <small class="text-muted">Tính theo m3 tiêu thụ</small>
                            </td>
                            <td>12.000 đ</td>
                            <td>m³</td>
                            <td><span class="badge rounded-pill bg-success">Đang cung cấp</span></td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-controller="Service" asp-action="Edit" asp-route-id="2"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- Dữ liệu mẫu 3 -->
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#DV-03</td>
                            <td>
                                <div>Internet Wifi</div>
                                <small class="text-muted">Trọn gói theo phòng</small>
                            </td>
                            <td>150.000 đ</td>
                            <td>Tháng</td>
                            <td><span class="badge rounded-pill bg-danger">Tạm ngưng</span></td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-controller="Service" asp-action="Edit" asp-route-id="3"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#DV-@item.Id</td>
                                    <td>
                                        <div>@item.UtilityName</div>
                                    </td>
                                    <td>@item.UnitPrice.ToString("N0") đ</td>
                                    <td>@item.Unit</td>
                                    <td><span class="badge rounded-pill bg-success">Đang cung cấp</span></td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-controller="Service" asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" 
                                                  onsubmit="return confirm('Bạn muốn đưa dịch vụ này vào thùng rác?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Không có dịch vụ nào đang hoạt động</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-0 py-3">
            <p class="text-muted small mb-0">Lưu ý: Sinh viên không thể chỉnh sửa đơn giá dịch vụ.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(name) {
            if (confirm(`Bạn có chắc chắn muốn xóa dịch vụ: ${name}?`)) {
                alert("Đã gửi yêu cầu xóa!");
                // Logic xóa thực tế sẽ gọi bằng Ajax hoặc Form tại đây
            }
        }
    </script>
}