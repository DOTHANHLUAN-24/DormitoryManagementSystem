@{
    ViewData["Title"] = "Danh sách khách đến thăm KTX - KTX System";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* Hệ thống Typography & Tiêu đề */
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Nút chức năng chính */
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; border: none; text-decoration: none; }
        .btn-add { background: #4f46e5; color: white !important; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); }
        .btn-add:hover { background: #4338ca; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); }
        
        /* Bộ lọc tìm kiếm */
        .thanh-tim-kiem { background: #fff; border-radius: 16px; padding: 16px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; }
        .input-custom { height: 46px; border-radius: 12px !important; border: 1px solid #e2e8f0 !important; font-size: 14px; color: #1e293b; background-color: #f8fafc; width: 100%; transition: all 0.2s; }
        .input-custom:focus { border-color: #4f46e5 !important; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important; background-color: #fff; }
        .khung-tim-kiem { position: relative; }
        .khung-tim-kiem i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; z-index: 10; }
        .khung-tim-kiem input, .khung-tim-kiem select { padding-left: 40px; }
        
        .btn-search { height: 46px; border-radius: 12px; background: #4f46e5; color: white; border: none; font-weight: 600; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; }
        .btn-search:hover { background: #4338ca; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); color: white; }

        .nut-lam-moi { height: 46px; border-radius: 12px; font-weight: 600; font-size: 14px; transition: all 0.2s; color: #64748b; background: #f1f5f9; border: none; display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; white-space: nowrap; }
        .nut-lam-moi:hover { background: #e2e8f0; color: #1e293b; }

        /* Tinh chỉnh Bảng dữ liệu */
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; overflow: hidden; }
        .table thead { background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; }
        .table th { font-size: 12px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px 12px; }
        .table td { padding: 16px 12px; font-size: 14px; color: #334155; }
        
        /* Định dạng mã số */
        .badge-username { background: #f8fafc; color: #1e293b; padding: 6px 10px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; border: 1px solid #e2e8f0; }

        /* Huy hiệu trạng thái mềm mại */
        .badge-status { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; }
        .badge-success-soft { background-color: #ecfdf5; color: #10b981; }
        .badge-primary-soft { background-color: #eff6ff; color: #3b82f6; }
        .badge-danger-soft { background-color: #fef2f2; color: #ef4444; }
        .badge-warning-soft { background-color: #fff7ed; color: #f97316; }

        /* Khung chứa các nút thao tác */
        .cum-hanh-dong { display: flex; align-items: center; justify-content: flex-end; gap: 6px; white-space: nowrap; flex-wrap: nowrap; }

        /* Nút hành động */
        .nut-hanh-dong { width: 32px; height: 32px; padding: 0; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; border: none; font-size: 13px; text-decoration: none; flex-shrink: 0; }
        .nut-ra-ve { background-color: #ecfdf5; color: #10b981; }
        .nut-ra-ve:hover { background-color: #10b981; color: #fff; }
        .nut-duyet { background-color: #ecfdf5; color: #10b981; }
        .nut-duyet:hover { background-color: #10b981; color: #fff; }
        .nut-tuchoi { background-color: #fef2f2; color: #ef4444; }
        .nut-tuchoi:hover { background-color: #ef4444; color: #fff; }
        .nut-sua { background-color: #fef3c7; color: #d97706; }
        .nut-sua:hover { background-color: #d97706; color: #fff; }
        .nut-xoa { background-color: #fef2f2; color: #ef4444; }
        .nut-xoa:hover { background-color: #ef4444; color: #fff; }

        /* Custom Tab Styling */
        .nav-pills .nav-link {
            border-radius: 12px;
            color: #64748b;
            font-weight: 600;
            padding: 10px 20px;
            transition: all 0.2s;
            border: 1.5px solid transparent;
        }
        .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
            background-color: #eef2ff;
            color: #4f46e5;
            border: 1.5px solid #c7d2fe;
        }
        .nav-pills .nav-link:hover:not(.active) {
            background-color: #f1f5f9;
            color: #334155;
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid py-2">
    <!-- TIÊU ĐỀ TRANG VÀ TIỆN ÍCH THÊM MỚI -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="tieu-de-trang mb-1"><i class="fas fa-address-book me-2"></i>Quản lý khách đến thăm</h1>
            <p class="text-muted small mb-0">Theo dõi, phê duyệt yêu cầu đăng ký khách từ sinh viên và kiểm soát lượt khách ra vào KTX.</p>
        </div>
        <a href="/Visitor/Create" class="btn-custom-header btn-add">
            <i class="fas fa-plus"></i> Ghi nhận khách đến
        </a>
    </div>

    <!-- TABS PHÂN PHÂN LOẠI YÊU CẦU -->
    <ul class="nav nav-pills mb-4" id="visitorTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" onclick="switchTab('All')">Tất cả khách</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('Đang ở trong')">Đang ở trong KTX</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('Đã rời đi')">Đã rời đi</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('Chờ duyệt')">
                Yêu cầu phê duyệt
                <span class="badge bg-danger rounded-pill ms-1" id="pendingBadge" style="display:none; font-size:0.75rem;">0</span>
            </button>
        </li>
    </ul>

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="thanh-tim-kiem">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="khung-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" class="input-custom" placeholder="Tìm theo tên khách, số CCCD/CMND, tên sinh viên...">
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="khung-tim-kiem">
                    <i class="fas fa-filter"></i>
                    <select id="statusFilter" class="input-custom form-select">
                        <option value="All">-- Tất cả trạng thái --</option>
                        <option value="Đang ở trong">Đang ở trong</option>
                        <option value="Đã rời đi">Đã rời đi</option>
                        <option value="Quá giờ">Quá giờ</option>
                        <option value="Chờ duyệt">Chờ duyệt</option>
                        <option value="Từ chối">Từ chối</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <button class="nut-lam-moi" title="Làm mới bộ lọc" onclick="resetFilters()">
                    <i class="fas fa-sync-alt"></i> Làm mới bộ lọc
                </button>
            </div>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU HIỂN THỊ -->
    <div class="card card-custom">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="visitorTable">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 100px;">Mã</th>
                            <th>Khách đến thăm</th>
                            <th>CCCD/CMND</th>
                            <th>Sinh viên tiếp đón</th>
                            <th>Phòng ở</th>
                            <th>Thời gian vào</th>
                            <th>Thời gian ra (Dự kiến)</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Đang tải dữ liệu...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let allVisitors = [];
        let currentTab = 'All';

        // Thiết lập Token bảo vệ Ajax
        $.ajaxSetup({
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            fetchVisitors();

            // Gắn sự kiện tìm kiếm
            document.getElementById("searchInput").addEventListener("input", filterData);
            document.getElementById("statusFilter").addEventListener("change", filterData);
        });

        function fetchVisitors() {
            $.ajax({
                url: '/Visitor/GetList',
                type: 'GET',
                success: function(data) {
                    allVisitors = data;
                    filterData();
                    updatePendingBadge();
                },
                error: function() {
                    $('#tableBody').html('<tr><td colspan="9" class="text-center py-4 text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Lỗi tải dữ liệu từ máy chủ.</td></tr>');
                }
            });
        }

        function switchTab(tabName) {
            currentTab = tabName;
            
            // Cập nhật class active trên nút tab
            const tabButtons = document.querySelectorAll('#visitorTabs .nav-link');
            tabButtons.forEach(btn => {
                if (btn.innerText.includes(tabName === 'All' ? 'Tất cả' : tabName)) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            filterData();
        }

        function updatePendingBadge() {
            const pendingCount = allVisitors.filter(v => v.status === 'Chờ duyệt').length;
            const badge = document.getElementById("pendingBadge");
            if (pendingCount > 0) {
                badge.innerText = pendingCount;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        }

        function displayTableData(data) {
            const tableBody = document.getElementById("tableBody");
            tableBody.innerHTML = "";

            if (data.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-muted fw-medium"><i class="fas fa-folder-open me-2"></i>Không tìm thấy dữ liệu phù hợp.</td></tr>`;
                return;
            }

            data.forEach(visitor => {
                let statusBadge = '';
                if (visitor.status === 'Đã rời đi') {
                    statusBadge = `<span class="badge-status badge-success-soft"><i class="fas fa-check-circle"></i>Đã rời đi</span>`;
                } else if (visitor.status === 'Đang ở trong') {
                    statusBadge = `<span class="badge-status badge-primary-soft"><i class="fas fa-clock"></i>Đang ở trong</span>`;
                } else if (visitor.status === 'Chờ duyệt') {
                    statusBadge = `<span class="badge-status badge-warning-soft"><i class="fas fa-hourglass-half"></i>Chờ duyệt</span>`;
                } else if (visitor.status === 'Từ chối') {
                    statusBadge = `<span class="badge-status badge-danger-soft"><i class="fas fa-times-circle"></i>Từ chối</span>`;
                } else {
                    statusBadge = `<span class="badge-status badge-danger-soft"><i class="fas fa-exclamation-triangle"></i>Quá giờ</span>`;
                }

                let actionButtons = `<div class="cum-hanh-dong">`;
                
                if (visitor.status === 'Chờ duyệt') {
                    // Cụm phê duyệt / từ chối yêu cầu của sinh viên
                    actionButtons += `
                        <button class="nut-hanh-dong nut-duyet" onclick="approveRequest('${visitor.id}')" title="Phê duyệt yêu cầu">
                            <i class="fas fa-check"></i>
                        </button>
                        <button class="nut-hanh-dong nut-tuchoi" onclick="rejectRequest('${visitor.id}')" title="Từ chối yêu cầu">
                            <i class="fas fa-times"></i>
                        </button>`;
                } else {
                    if (visitor.status === 'Đang ở trong' || visitor.status === 'Quá giờ') {
                        actionButtons += `
                            <button class="nut-hanh-dong nut-ra-ve" onclick="checkOutVisitor('${visitor.id}')" title="Xác nhận khách ra về">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>`;
                    } else {
                        actionButtons += `<div style="width: 32px; height: 32px; flex-shrink: 0;"></div>`;
                    }

                    actionButtons += `
                        <a href="/Visitor/Edit/${visitor.id}" class="nut-hanh-dong nut-sua" title="Sửa thông tin">
                            <i class="fas fa-edit"></i>
                        </a>`;
                }
                
                actionButtons += `
                    <button class="nut-hanh-dong nut-xoa" onclick="deleteVisitor('${visitor.id}')" title="Xóa bản ghi">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>`;

                let row = `<tr>
                    <td class="ps-4"><span class="badge-username">${visitor.id}</span></td>
                    <td>
                        <div class="fw-semibold text-dark">${visitor.visitorName}</div>
                        <div class="text-muted small">${visitor.phoneNumber || "---"} (${visitor.relationship || "Khách"})</div>
                    </td>
                    <td><span class="badge bg-light text-dark border font-monospace px-2 py-1" style="font-size: 12px;">${visitor.identityCard}</span></td>
                    <td class="fw-medium">${visitor.studentName}</td>
                    <td><span class="text-primary fw-semibold">${visitor.room}</span></td>
                    <td class="small text-muted">${formatDateTime(visitor.checkIn)}</td>
                    <td class="small text-muted">${formatDateTime(visitor.checkOut)}</td>
                    <td>${statusBadge}</td>
                    <td class="pe-4">${actionButtons}</td>
                </tr>`;

                tableBody.insertAdjacentHTML('beforeend', row);
            });
        }

        function filterData() {
            const searchVal = document.getElementById("searchInput").value.toLowerCase().trim();
            const statusVal = document.getElementById("statusFilter").value;

            const filtered = allVisitors.filter(visitor => {
                const matchesSearch = visitor.visitorName.toLowerCase().includes(searchVal) || 
                                     visitor.identityCard.includes(searchVal) || 
                                     visitor.studentName.toLowerCase().includes(searchVal);
                
                let matchesTab = true;
                if (currentTab === 'Đang ở trong') {
                    matchesTab = visitor.status === 'Đang ở trong' || visitor.status === 'Quá giờ';
                } else if (currentTab === 'Đã rời đi') {
                    matchesTab = visitor.status === 'Đã rời đi';
                } else if (currentTab === 'Chờ duyệt') {
                    matchesTab = visitor.status === 'Chờ duyệt';
                }

                let matchesStatus = true;
                if (statusVal !== "All") {
                    matchesStatus = visitor.status === statusVal;
                }

                return matchesSearch && matchesTab && matchesStatus;
            });

            displayTableData(filtered);
        }

        function resetFilters() {
            document.getElementById("searchInput").value = "";
            document.getElementById("statusFilter").value = "All";
            filterData();
        }

        function approveRequest(id) {
            Swal.fire({
                title: 'Phê duyệt?',
                text: "Bạn có chắc muốn phê duyệt yêu cầu này? Khách sẽ được ghi nhận vào trạng thái 'Đang ở trong KTX'.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Phê duyệt',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Visitor/Approve/' + id,
                        type: 'POST',
                        success: function (res) {
                            Swal.fire('Thành công!', 'Yêu cầu đăng ký đã được phê duyệt.', 'success');
                            fetchVisitors();
                        }
                    });
                }
            });
        }

        function rejectRequest(id) {
            Swal.fire({
                title: 'Từ chối?',
                text: "Xác nhận từ chối lượt khách đến thăm này?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Từ chối',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Visitor/Reject/' + id,
                        type: 'POST',
                        success: function (res) {
                            Swal.fire('Thành công!', 'Đã từ chối lượt khách thăm.', 'success');
                            fetchVisitors();
                        }
                    });
                }
            });
        }

        function checkOutVisitor(id) {
            Swal.fire({
                title: 'Xác nhận ra về',
                text: 'Xác nhận khách đã rời khỏi khu ký túc xá?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Visitor/CheckOut/' + id,
                        type: 'POST',
                        success: function (res) {
                            Swal.fire('Thành công!', 'Khách đã rời đi.', 'success');
                            fetchVisitors();
                        }
                    });
                }
            });
        }

        function deleteVisitor(id) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: 'Bạn có chắc chắn muốn xóa bản ghi khách lưu trú này không?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xóa ngay',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Visitor/Delete/' + id,
                        type: 'POST',
                        success: function (res) {
                            Swal.fire('Đã xóa!', 'Đã xóa bản ghi thành công.', 'success');
                            fetchVisitors();
                        }
                    });
                }
            });
        }

        function formatDateTime(dateTimeStr) {
            if (!dateTimeStr) return "---";
            const date = new Date(dateTimeStr);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} - ${hours}:${minutes}`;
        }
    </script>
}