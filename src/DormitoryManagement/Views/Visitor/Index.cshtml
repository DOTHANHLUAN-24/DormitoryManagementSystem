@{
    ViewData["Title"] = "Danh sách khách đến thăm KTX - KTX System";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* Hệ thống Typography & Tiêu đề */
        .tieu-de-trang { font-size: 28px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Cấu trúc thẻ Card cao cấp */
        .khung-chua-bo-loc { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; }
        .khung-chua-bang { background: #fff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); border: none; overflow: hidden; }

        /* Nút chức năng chính */
        .nut-them-moi { padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.3s; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; border: none; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
        .nut-them-moi:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); color: #fff; }
        
        /* Ô tìm kiếm và Bộ lọc nâng cao */
        .input-group-custom { border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; transition: all 0.3s ease; background: #f8fafc; }
        .input-group-custom:focus-within { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); background: #fff; }
        .input-group-custom .input-group-text { background: transparent; border: none; color: #94a3b8; padding-left: 14px; }
        .input-group-custom .form-control, .input-group-custom .form-select { border: none; background: transparent; padding: 9px 12px; font-size: 14px; color: #1e293b; }
        .input-group-custom .form-control:focus, .input-group-custom .form-select:focus { box-shadow: none; background: transparent; }

        .nut-lam-moi { padding: 9px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.2s; color: #64748b; background: #f1f5f9; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
        .nut-lam-moi:hover { background: #e2e8f0; color: #1e293b; }

        /* Tinh chỉnh Bảng dữ liệu */
        .table thead { background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; }
        .table th { font-size: 12px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px 12px; }
        .table td { padding: 16px 12px; font-size: 14px; color: #334155; }
        
        /* Huy hiệu trạng thái mềm mại */
        .badge-status { padding: 6px 12px; border-radius: 30px; font-weight: 600; font-size: 12px; display: inline-flex; align-items: center; gap: 5px; }
        .badge-success-soft { background-color: #ecfdf5; color: #10b981; }
        .badge-primary-soft { background-color: #eff6ff; color: #3b82f6; }
        .badge-danger-soft { background-color: #fef2f2; color: #ef4444; }

        /* Khung chứa các nút thao tác - Đảm bảo xếp hàng ngang tuyệt đối */
        .cum-hanh-dong { display: flex; align-items: center; justify-content: flex-end; gap: 6px; white-space: nowrap; flex-wrap: nowrap; }

        /* Nút hành động nhỏ gọn */
        .nut-hanh-dong { width: 32px; height: 32px; padding: 0; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; border: none; font-size: 13px; text-decoration: none; flex-shrink: 0; }
        .nut-ra-ve { background-color: #ecfdf5; color: #10b981; }
        .nut-ra-ve:hover { background-color: #10b981; color: #fff; }
        .nut-sua { background-color: #fef3c7; color: #d97706; }
        .nut-sua:hover { background-color: #d97706; color: #fff; }
        .nut-xoa { background-color: #fef2f2; color: #ef4444; }
        .nut-xoa:hover { background-color: #ef4444; color: #fff; }

        /* Định hình lại thanh phân trang số (Pagination) */
        .pagination .page-item .page-link { color: #64748b; background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 8px 14px; font-weight: 600; font-size: 13px; margin: 0 2px; transition: all 0.2s ease; border-radius: 6px; }
        .pagination .page-item:first-child .page-link { border-radius: 6px; }
        .pagination .page-item:last-child .page-link { border-radius: 6px; }
        .pagination .page-item.active .page-link { background: linear-gradient(135deg, #4f46e5, #6366f1); border-color: #4f46e5; color: #fff; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.15); }
        .pagination .page-item .page-link:hover:not(.active) { background-color: #e2e8f0; color: #1e293b; }
    </style>
}

<div class="container-fluid py-2">
    <!-- TIÊU ĐỀ TRANG VÀ TIỆN ÍCH THÊM MỚI -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="tieu-de-trang mb-1">Quản Lý Khách Đến Thăm</h1>
            <p class="text-muted small mb-0">Theo dõi, ghi nhận thông tin đối tác/khách ra vào và kiểm soát thời gian lưu trú tại ký túc xá.</p>
        </div>
        <a href="/Visitor/Create" class="nut-them-moi shadow-sm">
            <i class="fas fa-user-plus"></i> Ghi Nhận Khách Đến
        </a>
    </div>

    <!-- BỘ LỌC TÌM KIẾM ĐỒNG BỘ -->
    <div class="card khung-chua-bo-loc mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo tên khách, số CMND/CCCD...">
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="fas fa-filter"></i></span>
                        <select id="statusFilter" class="form-select">
                            <option value="All">-- Tất cả trạng thái lưu trú --</option>
                            <option value="Đang ở trong">Đang ở trong ký túc xá</option>
                            <option value="Đã rời đi">Đã rời đi hoàn tất</option>
                            <option value="Quá giờ">Quá giờ quy định</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <button class="nut-lam-moi w-100" onclick="resetFilters()">
                        <i class="fas fa-sync-alt"></i> Làm mới bộ lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU HIỂN THỊ -->
    <div class="card khung-chua-bang">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="visitorTable">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 110px;">Mã khách</th>
                            <th style="width: 180px;">Họ tên khách</th>
                            <th style="width: 140px;">Số CCCD/CMND</th>
                            <th style="width: 170px;">Sinh viên được tiếp</th>
                            <th style="width: 110px;">Phòng ở</th>
                            <th style="width: 150px;">Thời gian vào</th>
                            <th style="width: 150px;">Thời gian ra (Dự kiến)</th>
                            <th style="width: 140px;">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- Dữ liệu được kết xuất động bằng JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- THANH PHÂN TRANG THEO SỐ ĐỒNG BỘ MẪU USER -->
        <div class="card-footer bg-white border-top py-3">
            <div class="d-flex justify-content-center align-items-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="paginationList">
                        <!-- Các đầu số trang 1 2 3 được render tự động qua JavaScript -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Mảng dữ liệu ảo Mock Data cho năm 2026
        const mockVisitors = [
            { id: "VIS001", name: "Nguyễn Thành Long", identityCard: "001098001234", studentName: "Nguyễn Văn Anh", room: "P.302-A1", checkIn: "2026-05-18T08:30:00", checkOut: "2026-05-18T11:00:00", isCheckedOut: true, status: "Đã rời đi" },
            { id: "VIS002", name: "Trần Thị Lan", identityCard: "038175004321", studentName: "Trần Thị Bình", room: "P.105-B2", checkIn: "2026-05-18T14:15:00", checkOut: "2026-05-18T17:00:00", isCheckedOut: false, status: "Đang ở trong" },
            { id: "VIS003", name: "Lê Hoàng Nam", identityCard: "024099005678", studentName: "Lê Hoàng Chí", room: "P.404-A2", checkIn: "2026-05-18T09:00:00", checkOut: "2026-05-18T11:30:00", isCheckedOut: false, status: "Quá giờ" },
            { id: "VIS004", name: "Phạm Minh Quang", identityCard: "017095009876", studentName: "Phạm Hồng Duy", room: "P.201-B1", checkIn: "2026-05-17T19:00:00", checkOut: "2026-05-17T21:00:00", isCheckedOut: true, status: "Đã rời đi" },
            { id: "VIS005", name: "Hoàng Ngọc Mai", identityCard: "031197002468", studentName: "Hoàng Đức Em", room: "P.305-A1", checkIn: "2026-05-18T15:00:00", checkOut: "2026-05-18T18:00:00", isCheckedOut: false, status: "Đang ở trong" }
        ];

        document.addEventListener("DOMContentLoaded", function () {
            displayTableData(mockVisitors);
            renderPagination(1); // Mặc định hiển thị trang 1

            // Gắn sự kiện tìm kiếm và lọc dữ liệu trực tiếp dạng Real-time
            document.getElementById("searchInput").addEventListener("input", filterData);
            document.getElementById("statusFilter").addEventListener("change", filterData);
        });

        function displayTableData(data) {
            const tableBody = document.getElementById("tableBody");
            tableBody.innerHTML = "";

            if (data.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-muted fw-medium"><i class="fas fa-folder-open me-2"></i>Không tìm thấy dữ liệu lịch sử khách phù hợp.</td></tr>`;
                return;
            }

            data.forEach(visitor => {
                // Định dạng hiển thị màu sắc theo Badge cao cấp mới
                let statusBadge = '';
                if (visitor.status === 'Đã rời đi') {
                    statusBadge = `<span class="badge-status badge-success-soft"><i class="fas fa-check-circle"></i>Đã rời đi</span>`;
                } else if (visitor.status === 'Đang ở trong') {
                    statusBadge = `<span class="badge-status badge-primary-soft"><i class="fas fa-clock"></i>Đang ở trong</span>`;
                } else {
                    statusBadge = `<span class="badge-status badge-danger-soft"><i class="fas fa-exclamation-triangle"></i>Quá giờ</span>`;
                }

                // Cấu hình cụm nút hành động đảm bảo nằm ngang hàng
                let actionButtons = `<div class="cum-hanh-dong">`;
                if (!visitor.isCheckedOut) {
                    actionButtons += `
                        <button class="nut-hanh-dong nut-ra-ve" onclick="checkOutVisitor('${visitor.id}')" title="Xác nhận khách ra về">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>`;
                } else {
                    // Tạo một khoảng trống giữ chỗ (placeholder) ẩn để hàng nút luôn cân bằng kích thước nếu cần
                    actionButtons += `<div style="width: 32px; height: 32px; flex-shrink: 0;"></div>`;
                }
                
                actionButtons += `
                    <a href="/Visitor/Edit/${visitor.id}" class="nut-hanh-dong nut-sua" title="Sửa thông tin">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button class="nut-hanh-dong nut-xoa" onclick="deleteVisitor('${visitor.id}')" title="Xóa bản ghi lịch sử">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>`;

                let row = `<tr>
                    <td class="ps-4 fw-bold text-secondary">${visitor.id}</td>
                    <td class="fw-semibold text-dark">${visitor.name}</td>
                    <td><span class="badge bg-light text-dark border font-monospace px-2 py-1" style="font-size: 13px;">${visitor.identityCard}</span></td>
                    <td class="fw-medium">${visitor.studentName}</td>
                    <td><span class="text-primary fw-semibold">${visitor.room}</span></td>
                    <td class="small text-muted">${formatDateTime(visitor.checkIn)}</td>
                    <td class="small text-muted">${formatDateTime(visitor.checkOut)}</td>
                    <td>${statusBadge}</td>
                    <td class="pe-4">${actionButtons}</td>
                </tr>`;

                tableBody.insertAdjacentHTML('beforeend', row);
            });
        }

        // Tạo số trang dạng 1 2 3 giống hệt module User mẫu
        function renderPagination(activePage) {
            const paginationList = document.getElementById("paginationList");
            paginationList.innerHTML = "";

            // Thiết kế phân trang tĩnh mô phỏng theo mẫu dữ liệu Mock
            let pages = [1, 2, 3];
            
            let htmlContent = `<li class="page-item ${activePage === 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="changePage(${activePage - 1})">Trước</a></li>`;
            
            pages.forEach(p => {
                htmlContent += `<li class="page-item ${activePage === p ? 'active' : ''}"><a class="page-link" href="#" onclick="changePage(${p})">${p}</a></li>`;
            });

            htmlContent += `<li class="page-item ${activePage === 3 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="changePage(${activePage + 1})">Sau</a></li>`;
            
            paginationList.innerHTML = htmlContent;
        }

        function changePage(pageNumber) {
            if (pageNumber < 1 || pageNumber > 3) return;
            renderPagination(pageNumber);
            // Có thể bổ sung logic cắt mảng dữ liệu phân trang thực tế tại đây nếu cần
        }

        // Tìm kiếm thời gian thực
        function filterData() {
            const searchVal = document.getElementById("searchInput").value.toLowerCase().trim();
            const statusVal = document.getElementById("statusFilter").value;

            const filtered = mockVisitors.filter(visitor => {
                const matchesSearch = visitor.name.toLowerCase().includes(searchVal) || visitor.identityCard.includes(searchVal);
                const matchesStatus = statusVal === "All" || visitor.status === statusVal;
                return matchesSearch && matchesStatus;
            });

            displayTableData(filtered);
        }

        // Khôi phục bộ lọc ban đầu
        function resetFilters() {
            document.getElementById("searchInput").value = "";
            document.getElementById("statusFilter").value = "All";
            displayTableData(mockVisitors);
        }

        // Áp dụng SweetAlert2 cho tính năng cho khách rời đi
        function checkOutVisitor(id) {
            const visitor = mockVisitors.find(v => v.id === id);
            if (!visitor) return;

            Swal.fire({
                title: 'Xác nhận cho khách về?',
                text: `Hệ thống sẽ ghi nhận khách ${visitor.name} rời khỏi khu ký túc xá vào thời điểm hiện tại.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xác nhận rời đi',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    visitor.isCheckedOut = true;
                    visitor.status = "Đã rời đi";
                    visitor.checkOut = new Date().toISOString();
                    
                    displayTableData(mockVisitors);

                    Swal.fire({
                        icon: 'success',
                        title: 'Đã xác nhận!',
                        text: 'Thời gian rời đi của khách đã được lưu trữ.',
                        confirmButtonColor: '#4f46e5'
                    });
                }
            });
        }

        // Áp dụng SweetAlert2 cho tính năng xóa bản ghi khách lưu trú
        function deleteVisitor(id) {
            Swal.fire({
                title: 'Bạn có chắc chắn muốn xóa?',
                text: `Bản ghi của khách mang mã số ${id} sẽ bị xóa vĩnh viễn khỏi lịch sử hệ thống.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã xóa!',
                        text: `Đã xóa thành công lịch sử lượt đến thăm của mã khách: ${id}`,
                        confirmButtonColor: '#4f46e5'
                    });
                }
            });
        }

        // Định dạng hiển thị Ngày/Tháng/Năm - Giờ:Phút chuẩn hóa
        function formatDateTime(dateTimeStr) {
            if (!dateTimeStr) return "";
            const date = new Date(dateTimeStr);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} - ${hours}:${minutes}`;
        }
    </script>
}