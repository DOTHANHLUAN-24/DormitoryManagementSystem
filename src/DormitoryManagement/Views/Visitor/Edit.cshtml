@{
    ViewData["Title"] = "Chỉnh sửa thông tin khách đến thăm - KTX System";
    var visitorId = ViewData["VisitorId"]?.ToString();
}

@section Styles {
    <style>
        /* 1. Header & Tổng thể */
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        /* 2. Nút trên Header */
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; }
        .btn-header-back { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-header-back:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); color: #1e293b !important; background: #f8fafc; }

        /* 3. Card Form */
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; overflow: hidden; }
        
        /* 4. Tiêu đề từng khu vực */
        .section-title { font-size: 16px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px dashed #f1f5f9; }
        .section-icon { width: 38px; height: 38px; border-radius: 10px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; font-size: 16px; }
        .section-icon.green { background: #ecfdf5; color: #10b981; }

        /* 5. Input & Form */
        .form-label { font-weight: 600; color: #475569; font-size: 13px; margin-bottom: 6px; }
        .input-custom { height: 46px; border-radius: 12px !important; border: 1px solid #e2e8f0; font-size: 14px; color: #1e293b; background-color: #f8fafc; transition: all 0.2s; }
        .input-custom:focus { border-color: #4f46e5 !important; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important; background-color: #fff; }

        /* 6. Nút Action */
        .btn-action { height: 46px; border-radius: 12px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 24px; transition: all 0.2s; border: none; }
        .btn-save { background: #4f46e5; color: white !important; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); background: #4338ca; }
        .btn-cancel { background: #fff; color: #ef4444 !important; border: 1px solid #fee2e2; background: #fef2f2; text-decoration: none; }
        .btn-cancel:hover { background: #fee2e2; transform: translateY(-2px); }

        .border-end-md { border-right: 1px solid #f1f5f9; }
        @@media (max-width: 767.98px) { .border-end-md { border-right: none; } }
    </style>
}

<div class="container-fluid">
    <!-- HEADER CÓ NÚT QUAY LẠI -->
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="tieu-de-trang mb-0"><i class="fas fa-address-book me-2"></i>Chỉnh sửa thông tin khách</h1>
            <p class="text-muted small mb-0">Chỉnh sửa chi tiết lượt khách thăm mang mã bản ghi: <span class="badge bg-light text-primary border font-monospace px-2 py-1" style="font-size: 12px;">@visitorId</span></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Visitor" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </header>

    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card card-custom">
                <div class="card-body p-4 p-md-5">
                    <form id="editVisitorForm" onsubmit="saveVisitorData(event)">
                        <input type="hidden" id="visitorId" value="@visitorId" />

                        <div class="row g-5">
                            <!-- CỘT TRÁI: THÔNG TIN KHÁCH -->
                            <div class="col-md-6 border-end-md pe-md-4">
                                <div class="section-title">
                                    <div class="section-icon"><i class="fas fa-user-tag"></i></div>
                                    Thông tin khách đến
                                </div>
                                
                                <div class="mb-4">
                                    <label class="form-label">Tên khách đến thăm <span class="text-danger">*</span></label>
                                    <input type="text" id="visitorName" class="form-control input-custom" required placeholder="Nhập họ tên khách...">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Số CCCD/CMND <span class="text-danger">*</span></label>
                                    <input type="text" id="identityCard" class="form-control input-custom font-monospace" required placeholder="Nhập 12 số CCCD...">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Trạng thái lưu trú</label>
                                    <select id="status" class="form-select input-custom">
                                        <option value="Đang ở trong">Đang ở trong</option>
                                        <option value="Đã rời đi">Đã rời đi</option>
                                        <option value="Quá giờ">Quá giờ quy định</option>
                                    </select>
                                </div>
                            </div>

                            <!-- CỘT PHẢI: THÔNG TIN SINH VIÊN & LƯU TRÚ -->
                            <div class="col-md-6 ps-md-4">
                                <div class="section-title">
                                    <div class="section-icon green"><i class="fas fa-home"></i></div>
                                    Sinh viên & Lưu trú
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Sinh viên được thăm <span class="text-danger">*</span></label>
                                    <input type="text" id="studentName" class="form-control input-custom" required placeholder="Nhập tên sinh viên cần gặp...">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Thuộc phòng <span class="text-danger">*</span></label>
                                    <input type="text" id="room" class="form-control input-custom" required placeholder="Ví dụ: P.302-A1">
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Giờ vào</label>
                                        <input type="datetime-local" id="checkIn" class="form-control input-custom" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Giờ ra (Dự kiến)</label>
                                        <input type="datetime-local" id="checkOut" class="form-control input-custom" required>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- NÚT ĐIỀU KHIỂN DƯỚI FORM -->
                        <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                            <a href="/Visitor" class="btn-action btn-cancel">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn-action btn-save">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Mạng dữ liệu dùng chung bộ Mock Data 2026 đồng bộ với trang Index
        const mockData = [
            { id: "VIS001", name: "Nguyễn Thành Long", identityCard: "001098001234", studentName: "Nguyễn Văn Anh", room: "P.302-A1", checkIn: "2026-05-18T08:30", checkOut: "2026-05-18T11:00", status: "Đã rời đi" },
            { id: "VIS002", name: "Trần Thị Lan", identityCard: "038175004321", studentName: "Trần Thị Bình", room: "P.105-B2", checkIn: "2026-05-18T14:15", checkOut: "2026-05-18T17:00", status: "Đang ở trong" },
            { id: "VIS003", name: "Lê Hoàng Nam", identityCard: "024099005678", studentName: "Lê Hoàng Chí", room: "P.404-A2", checkIn: "2026-05-18T09:00", checkOut: "2026-05-18T11:30", status: "Quá giờ" },
            { id: "VIS004", name: "Phạm Minh Quang", identityCard: "017095009876", studentName: "Phạm Hồng Duy", room: "P.201-B1", checkIn: "2026-05-17T19:00", checkOut: "2026-05-17T21:00", status: "Đã rời đi" },
            { id: "VIS005", name: "Hoàng Ngọc Mai", identityCard: "031197002468", studentName: "Hoàng Đức Em", room: "P.305-A1", checkIn: "2026-05-18T15:00", checkOut: "2026-05-18T18:00", status: "Đang ở trong" }
        ];

        document.addEventListener("DOMContentLoaded", function () {
            const currentId = document.getElementById("visitorId").value;
            const visitor = mockData.find(v => v.id === currentId);

            if (visitor) {
                // Đổ ngược dữ liệu vào các thẻ input tương ứng
                document.getElementById("visitorName").value = visitor.name;
                document.getElementById("identityCard").value = visitor.identityCard;
                document.getElementById("studentName").value = visitor.studentName;
                document.getElementById("room").value = visitor.room;
                document.getElementById("checkIn").value = visitor.checkIn;
                document.getElementById("checkOut").value = visitor.checkOut;
                document.getElementById("status").value = visitor.status;
            } else {
                // Hiển thị thông báo lỗi cao cấp nếu không tìm thấy ID bản ghi
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi tìm kiếm!',
                    text: 'Không tìm thấy dữ liệu khách phù hợp với ID hệ thống cung cấp.',
                    confirmButtonColor: '#4f46e5'
                }).then(() => {
                    window.location.href = "/Visitor";
                });
            }
        });

        // Xử lý sự kiện lưu dữ liệu bằng SweetAlert2 đẩy đẹp mắt
        function saveVisitorData(event) {
            event.preventDefault();

            const name = document.getElementById("visitorName").value;
            const currentId = document.getElementById("visitorId").value;

            Swal.fire({
                icon: 'success',
                title: 'Cập nhật thành công!',
                text: `Thông tin của khách ${name} (Mã: ${currentId}) đã được đồng bộ hóa lên hệ thống KTX.`,
                confirmButtonColor: '#4f46e5',
                timer: 2500,
                timerProgressBar: true
            }).then(() => {
                // Chuyển hướng mượt mà về trang danh sách tổng hợp
                window.location.href = "/Visitor";
            });
        }
    </script>
}