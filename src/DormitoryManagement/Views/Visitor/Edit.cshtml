@{
    ViewData["Title"] = "Chỉnh sửa thông tin khách đến thăm - KTX System";
    var visitorId = ViewData["VisitorId"]?.ToString();
}

@section Styles {
    <style>
        /* Hệ thống tiêu đề */
        .tieu-de-trang { font-size: 28px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Cấu trúc Card cao cấp */
        .khung-chua-form { background: #fff; border-radius: 20px; box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05); border: none; overflow: hidden; }
        .card-header-custom { background: #fff; border-bottom: 1px solid #f1f5f9; padding: 20px 24px; }
        .card-body-custom { padding: 24px; }

        /* Nút quay lại tinh tế */
        .nut-quay-lai { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 13px; transition: all 0.2s; color: #64748b; background: #f1f5f9; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; }
        .nut-quay-lai:hover { background: #e2e8f0; color: #1e293b; transform: translateX(-2px); }

        /* Ô nhập liệu hiện đại */
        .input-group-custom { border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; transition: all 0.3s ease; background: #f8fafc; display: flex; align-items: center; }
        .input-group-custom:focus-within { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); background: #fff; }
        .input-group-custom .input-icon { color: #94a3b8; padding-left: 14px; padding-right: 2px; font-size: 14px; }
        .input-group-custom .form-control, .input-group-custom .form-select { border: none; background: transparent; padding: 10px 12px; font-size: 14px; color: #1e293b; width: 100%; }
        .input-group-custom .form-control:focus, .input-group-custom .form-select:focus { box-shadow: none; background: transparent; outline: none; }

        /* Hệ thống nút bấm chân trang */
        .nut-huy { padding: 10px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.2s; color: #64748b; background: #f1f5f9; border: none; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
        .nut-huy:hover { background: #e2e8f0; color: #1e293b; }

        .nut-luu { padding: 10px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; transition: all 0.3s; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; border: none; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); display: inline-flex; align-items: center; gap: 8px; }
        .nut-luu:hover { transform: translateY(-1px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); color: #fff; }
    </style>
}

<div class="container-fluid py-2">
    <!-- KHU VỰC TIÊU ĐỀ & ĐIỀU HƯỚNG -->
    <div class="mb-4">
        <div class="d-flex mb-2">
            <a href="/Visitor" class="nut-quay-lai">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
        <h1 class="tieu-de-trang mb-1">Cập Nhật Thông Tin Khách</h1>
        <p class="text-muted small mb-0">Chỉnh sửa chi tiết lượt khách thăm mang mã bản ghi: <span class="badge bg-light text-primary border font-monospace px-2 py-1" style="font-size: 13px;">@visitorId</span></p>
    </div>

    <!-- KHUNG CHỨA FORM CHÍNH -->
    <div class="row">
        <div class="col-xl-8 col-lg-10">
            <div class="card khung-chua-form">
                <div class="card-header-custom">
                    <h6 class="m-0 fw-bold text-dark"><i class="fas fa-user-edit text-primary me-2"></i>Thông tin chi tiết lượt truy cập</h6>
                </div>
                <div class="card-body-custom">
                    <form id="editVisitorForm" onsubmit="saveVisitorData(event)">
                        <input type="hidden" id="visitorId" value="@visitorId" />

                        <!-- HÀNG 1: THÔNG TIN KHÁCH -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Tên khách đến thăm</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-user"></i></span>
                                    <input type="text" id="visitorName" class="form-control" required placeholder="Nhập họ tên khách...">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Số CCCD/CMND</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-id-card"></i></span>
                                    <input type="text" id="identityCard" class="form-control font-monospace" required placeholder="Nhập 12 số CCCD...">
                                </div>
                            </div>
                        </div>

                        <!-- HÀNG 2: THÔNG TIN LƯU TRÚ NỘI KHU -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Sinh viên được thăm</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-graduation-cap"></i></span>
                                    <input type="text" id="studentName" class="form-control" required placeholder="Nhập tên sinh viên cần gặp...">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Thuộc phòng</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-door-open"></i></span>
                                    <input type="text" id="room" class="form-control" required placeholder="Ví dụ: P.302-A1">
                                </div>
                            </div>
                        </div>

                        <!-- HÀNG 3: MỐC THỜI GIAN & TRẠNG THÁI -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">Giờ vào</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-sign-in-alt"></i></span>
                                    <input type="datetime-local" id="checkIn" class="form-control" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">Giờ ra (Dự kiến)</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-sign-out-alt"></i></span>
                                    <input type="datetime-local" id="checkOut" class="form-control" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">Trạng thái lưu trú</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="fas fa-info-circle"></i></span>
                                    <select id="status" class="form-select">
                                        <option value="Đang ở trong">Đang ở trong</option>
                                        <option value="Đã rời đi">Đã rời đi</option>
                                        <option value="Quá giờ">Quá giờ quy định</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted my-4" style="opacity: 0.1;">

                        <!-- CỤM NÚT ĐIỀU HƯỚNG CUỐI FORM -->
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Visitor" class="nut-huy">Hủy bỏ</a>
                            <button type="submit" class="nut-luu">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Mạng dữ liệu dùng chung bộ Mock Data 2026 đồng bộ với trang Index
        const mockData = [
            { id: "VIS001", name: "Nguyễn Thành Long", identityCard: "001098001234", studentName: "Nguyễn Văn Anh", room: "P.302-A1", checkIn: "2026-05-18T08:30", checkOut: "2026-05-18T11:00", status: "Đã rời đi" },
            { id: "VIS002", name: "Trần Thị Lan", identityCard: "038175004321", studentName: "Trần Thị Bình", room: "P.105-B2", checkIn: "2026-05-18T14:15", checkOut: "2026-05-18T17:00", status: "Đang ở trong" },
            { id: "VIS003", name: "Lê Hoàng Nam", identityCard: "024099005678", studentName: "Lê Hoàng Chí", room: "P.404-A2", checkIn: "2026-05-18T09:00", checkOut: "2026-05-18T11:30", status: "Quá giờ" },
            { id: "VIS004", name: "Phạm Minh Quang", identityCard: "017095009876", studentName: "Phạm Hồng Duy", room: "P.201-B1", checkIn: "2026-05-17T19:00", checkOut: "2026-05-17T21:00", status: "Đã rời đi" },
            { id: "VIS005", name: "Hoàng Ngọc Mai", identityCard: "031197002468", studentName: "Hoàng Đức Em", room: "P.305-A1", checkIn: "2026-05-18T15:00", checkOut: "2026-05-18T18:00", status: "Đang ở trong" }
        ];

        document.addEventListener("DOMContentLoaded", function () {
            const currentId = document.getElementById("visitorId").value;
            const visitor = mockData.find(v => v.id === currentId);

            if (visitor) {
                // Đổ ngược dữ liệu vào các thẻ input tương ứng
                document.getElementById("visitorName").value = visitor.name;
                document.getElementById("identityCard").value = visitor.identityCard;
                document.getElementById("studentName").value = visitor.studentName;
                document.getElementById("room").value = visitor.room;
                document.getElementById("checkIn").value = visitor.checkIn;
                document.getElementById("checkOut").value = visitor.checkOut;
                document.getElementById("status").value = visitor.status;
            } else {
                // Hiển thị thông báo lỗi cao cấp nếu không tìm thấy ID bản ghi
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi tìm kiếm!',
                    text: 'Không tìm thấy dữ liệu khách phù hợp với ID hệ thống cung cấp.',
                    confirmButtonColor: '#4f46e5'
                }).then(() => {
                    window.location.href = "/Visitor";
                });
            }
        });

        // Xử lý sự kiện lưu dữ liệu bằng SweetAlert2 đẩy đẹp mắt
        function saveVisitorData(event) {
            event.preventDefault();

            const name = document.getElementById("visitorName").value;
            const currentId = document.getElementById("visitorId").value;

            Swal.fire({
                icon: 'success',
                title: 'Cập nhật thành công!',
                text: `Thông tin của khách ${name} (Mã: ${currentId}) đã được đồng bộ hóa lên hệ thống KTX.`,
                confirmButtonColor: '#4f46e5',
                timer: 2500,
                timerProgressBar: true
            }).then(() => {
                // Chuyển hướng mượt mà về trang danh sách tổng hợp
                window.location.href = "/Visitor";
            });
        }
    </script>
}