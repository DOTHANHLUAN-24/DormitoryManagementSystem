@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses
@model PagedResult<UserResponseDto>

@{
    ViewData["Title"] = "Danh sách người dùng bị khóa";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-danger"><i class="fas fa-user-lock me-2"></i> Người dùng đang bị khóa</h4>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @* Thanh tìm kiếm *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="BannedList" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" placeholder="Tìm kiếm người dùng bị khóa...">
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-danger">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    @* Bảng danh sách *@
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Không có người dùng nào bị chặn.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3"><strong>@item.UserName</strong></td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td class="text-end pe-3">
                                    @* Nút mở khóa gọi hàm JS *@
                                    <button onclick="unbanUser('@item.Id', '@item.FullName')" class="btn btn-sm btn-success">
                                        <i class="fas fa-unlock me-1"></i> Mở khóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Phân trang *@
    <div class="mt-4">
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function unbanUser(id, fullName) {
            Swal.fire({
                title: 'Xác nhận mở khóa?',
                text: `Tài khoản "${fullName}" sẽ được phép truy cập lại hệ thống.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý mở khóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Hiển thị loading
                    Swal.fire({
                        title: 'Đang xử lý...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    // Lấy token chuẩn từ input ẩn
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/User/ToggleLock/' + id, // Đảm bảo URL này khớp với Controller
                        type: 'POST',
                        headers: { 
                            // Gửi token qua Header là cách chuẩn nhất cho ASP.NET Core AJAX
                            "RequestVerificationToken": token 
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: response.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại', response.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            console.error(xhr.responseText);
                            Swal.fire('Lỗi', 'Không thể kết nối với máy chủ.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}