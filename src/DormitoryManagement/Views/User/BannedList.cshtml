@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses
@model PagedResult<UserResponseDto>

@{
    ViewData["Title"] = "Danh sách người dùng bị khóa";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; border: none; }
        .btn-header-back { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-header-back:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); color: #1e293b !important; background: #f8fafc; }
        .thanh-tim-kiem { background: #fff; border-radius: 16px; padding: 16px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; }
        .input-custom { height: 46px; border-radius: 12px !important; border: 1px solid #e2e8f0 !important; font-size: 14px; color: #1e293b; background-color: #f8fafc; }
        .input-custom:focus { border-color: #4f46e5 !important; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important; background-color: #fff; }
        .khung-tim-kiem { position: relative; }
        .khung-tim-kiem i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; z-index: 10; }
        .khung-tim-kiem input { padding-left: 40px; }
        .btn-apply { height: 46px; border-radius: 12px; background: #ef4444; color: white; border: none; font-weight: 600; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .btn-apply:hover { background: #dc2626; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2); color: white; }
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; overflow: hidden; }
        .badge-username { background: #f8fafc; color: #1e293b; padding: 6px 10px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 600; border: 1px solid #e2e8f0; }
        .nut-hanh-dong { width: 34px; height: 34px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; border: none; transition: all 0.2s; }
        .nut-khoi-phuc { background: #ecfdf5; color: #10b981; }
        .nut-khoi-phuc:hover { transform: scale(1.1); box-shadow: 0 4px 8px rgba(16, 185, 129, 0.2); }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="tieu-de-trang mb-1"><i class="fas fa-user-lock me-2 text-danger"></i> Người dùng bị khóa</h1>
            <p class="text-muted small mb-0 ms-1 fw-medium">Danh sách các tài khoản đang bị hạn chế truy cập.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </header>

    <form method="get" asp-action="BannedList" class="thanh-tim-kiem-sync">
        <div class="row g-3 align-items-center">
            <div class="col-md-10">
                <div class="khung-tim-kiem-sync">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="input-sync" placeholder="Nhập tên đăng nhập, họ tên hoặc email...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-search-sync" style="background: #ef4444;">
                    <i class="fas fa-filter"></i> Lọc
                </button>
            </div>
        </div>
    </form>

    <div class="card card-custom mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Tên đăng nhập</th>
                        <th class="py-3">Họ và tên</th>
                        <th class="py-3">Email liên hệ</th>
                        <th class="text-end pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-shield-alt fa-3x mb-3 d-block opacity-25 text-success"></i>
                                    <p class="mb-0 fw-medium">Không có người dùng nào đang bị khóa.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 py-3"><span class="badge-username">@item.UserName</span></td>
                                <td><div class="fw-bold text-dark">@item.FullName</div></td>
                                <td><span class="text-muted small">@item.Email</span></td>
                                <td class="text-end pe-4">
                                    <button onclick="unbanUser('@item.Id', '@item.FullName')" class="nut-hanh-dong nut-khoi-phuc" title="Mở khóa tài khoản">
                                        <i class="fas fa-unlock"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        function unbanUser(id, fullName) {
            Swal.fire({
                title: 'Xác nhận mở khóa?',
                html: "Tài khoản <b>" + fullName + "</b> sẽ được phép truy cập lại hệ thống.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981', // Màu xanh lục đồng bộ
                cancelButtonColor: '#64748b',  // Màu xám nhạt
                confirmButtonText: '<i class="fas fa-unlock me-1"></i> Đồng ý mở khóa',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // Hiển thị loading
                    Swal.fire({
                        title: 'Đang xử lý...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    // Lấy token chuẩn từ input ẩn
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/User/ToggleLock/' + id,
                        type: 'POST',
                        headers: { 
                            "RequestVerificationToken": token 
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: response.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error', 
                                    title: 'Thất bại', 
                                    text: response.message,
                                    confirmButtonColor: '#4f46e5'
                                });
                            }
                        },
                        error: function (xhr) {
                            Swal.fire({
                                icon: 'error', 
                                title: 'Lỗi hệ thống', 
                                text: 'Không thể kết nối với máy chủ.',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    });
                }
            });
        }
    </script>
}