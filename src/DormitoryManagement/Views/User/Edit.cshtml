@using DormitoryManagement.Application.Dtos.Requests.Users
@using DormitoryManagement.Domain.Enums
@model UserUpdateDto

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-11"> @* Tăng độ rộng lên một chút để thoáng hơn *@
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>CẬP NHẬT THÔNG TIN NGƯỜI DÙNG
                    </h5>
                    <span class="badge bg-dark px-3 py-2">Account: @Model.UserName</span>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @* Các trường ẩn bắt buộc *@
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserName" />

                        @* Thông báo lỗi tổng quát *@
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger pb-0">
                                <div asp-validation-summary="All" class="small fw-bold"></div>
                            </div>
                        }

                        <div class="row g-4"> @* g-4 giúp tạo khoảng cách đều giữa các cột *@
                            
                            <!-- CỘT TRÁI: HỆ THỐNG & BẢO MẬT -->
                            <div class="col-lg-6 pe-lg-4 border-end">
                                <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                                    <i class="bi bi-gear-fill text-primary me-2"></i>
                                    <h6 class="text-primary mb-0 fw-bold text-uppercase">Thông tin hệ thống</h6>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small text-muted">Tên đăng nhập</label>
                                    <input asp-for="UserName" class="form-control bg-light fw-bold" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Vai trò người dùng <span class="text-danger">*</span></label>
                                    <select asp-for="Role" class="form-select border-primary" asp-items="Html.GetEnumSelectList<UserRole>()">
                                        <option value="">-- Chọn vai trò --</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Địa chỉ Email <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- KHU VỰC ĐỔI MẬT KHẨU -->
                                <div class="card border-0 bg-light">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-danger small mb-3">
                                            <i class="bi bi-shield-lock-fill me-1"></i> THAY ĐỔI MẬT KHẨU
                                        </h6>
                                        <p class="text-muted small mb-3">Để trống nếu bạn không muốn thay đổi mật khẩu.</p>
                                        
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Mật khẩu mới</label>
                                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-0">
                                            <label class="form-label small fw-semibold">Xác nhận mật khẩu mới</label>
                                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- CỘT PHẢI: THÔNG TIN CÁ NHÂN -->
                            <div class="col-lg-6 ps-lg-4">
                                <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                                    <i class="bi bi-person-badge-fill text-primary me-2"></i>
                                    <h6 class="text-primary mb-0 fw-bold text-uppercase">Thông tin cá nhân</h6>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold small">Mã số (MSSV/MNV) <span class="text-danger">*</span></label>
                                        <input asp-for="Code" class="form-control" placeholder="Nhập mã số" />
                                        <span asp-validation-for="Code" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold small">Số điện thoại</label>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="09xx xxx xxx" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Số CCCD/CMND <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-card-id"></i></span>
                                        <input asp-for="IdentityCardNumber" class="form-control" placeholder="Nhập 12 số CCCD" />
                                    </div>
                                    <span asp-validation-for="IdentityCardNumber" class="text-danger small"></span>
                                </div>

                                @* Thêm một hình ảnh minh họa hoặc ghi chú để lấp đầy khoảng trống bên phải *@
                                <div class="mt-4 p-3 bg-blue-light rounded border border-info border-opacity-25" style="background-color: #f0f7ff;">
                                    <small class="text-info fw-bold d-block mb-1"><i class="bi bi-info-circle-fill me-1"></i> Lưu ý:</small>
                                    <ul class="list-unstyled mb-0" style="font-size: 0.8rem;">
                                        <li>- Các trường có dấu <span class="text-danger">*</span> là bắt buộc.</li>
                                        <li>- Mã số người dùng dùng để định danh trong ký túc xá.</li>
                                        <li>- Hãy đảm bảo số điện thoại chính xác để nhận thông báo.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- NÚT ĐIỀU KHIỂN -->
                        <div class="mt-5 pt-3 border-top d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 shadow-sm">
                                <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-5 fw-bold shadow-sm text-dark">
                                <i class="bi bi-check-circle-fill me-1"></i> LƯU THAY ĐỔI
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
    }
    .input-group-text {
        color: #6c757d;
    }
</style>