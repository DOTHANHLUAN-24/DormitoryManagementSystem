@using DormitoryManagement.Application.Dtos.Requests.Users
@using DormitoryManagement.Domain.Enums
@model UserUpdateDto

@{
    ViewData["Title"] = "Cập nhật người dùng";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .badge-account { background: #eef2ff; color: #4f46e5; padding: 4px 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; border: 1px solid #c7d2fe; display: inline-flex; align-items: center; }
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; border: none; }
        .btn-header-back { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-header-back:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); color: #1e293b !important; background: #f8fafc; }
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; overflow: hidden; }
        .section-title { font-size: 16px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px dashed #f1f5f9; }
        .section-icon { width: 38px; height: 38px; border-radius: 10px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; font-size: 16px; }
        .section-icon.green { background: #ecfdf5; color: #10b981; }
        .form-label { font-weight: 600; color: #475569; font-size: 13px; margin-bottom: 6px; }
        .input-custom { height: 46px; border-radius: 12px !important; border: 1px solid #e2e8f0; font-size: 14px; color: #1e293b; background-color: #f8fafc; transition: all 0.2s; }
        .input-custom:focus { border-color: #4f46e5 !important; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important; background-color: #fff; }
        .input-custom[readonly] { background-color: #f1f5f9; color: #64748b; cursor: not-allowed; }
        .input-group-text-custom { background: #f8fafc; border: 1px solid #e2e8f0; border-right: none; border-top-left-radius: 12px; border-bottom-left-radius: 12px; color: #94a3b8; width: 46px; justify-content: center; }
        .input-group .input-custom { border-top-left-radius: 0 !important; border-bottom-left-radius: 0 !important; }
        .input-group:focus-within .input-group-text-custom { border-color: #4f46e5; color: #4f46e5; background: #fff; }
        .password-group .input-custom { border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important; border-right: none; }
        .password-group .btn-toggle { height: 46px; border-top-right-radius: 12px !important; border-bottom-right-radius: 12px !important; border: 1px solid #e2e8f0; border-left: none; background-color: #f8fafc; color: #64748b; width: 46px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .password-group .btn-toggle:hover { color: #4f46e5; background-color: #fff; }
        .password-group:focus-within .input-custom, .password-group:focus-within .btn-toggle { border-color: #4f46e5 !important; background-color: #fff; }
        .password-box { background: #fef2f2; border: 1px dashed #fca5a5; border-radius: 16px; padding: 20px; }
        .note-box { background: #eff6ff; border: 1px dashed #bfdbfe; border-radius: 16px; padding: 16px 20px; color: #1e3a8a; }
        .btn-action { height: 46px; border-radius: 12px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 24px; transition: all 0.2s; border: none; }
        .btn-save { background: #4f46e5; color: white !important; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); background: #4338ca; }
        .btn-cancel { background: #fff; color: #ef4444 !important; border: 1px solid #fee2e2; background: #fef2f2; }
        .btn-cancel:hover { background: #fee2e2; transform: translateY(-2px); }
        @@media (min-width: 768px) {
            .border-end-md { border-right: 1px solid #e2e8f0 !important; }
        }
    </style>
}

<div class="container-fluid">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="tieu-de-trang mb-2"><i class="fas fa-user-edit me-2"></i>Cập nhật thông tin</h1>
            <div class="ms-1">
                <span class="text-muted small fw-medium me-2">Đang thao tác trên tài khoản:</span>
                <span class="badge-account">
                    <i class="fas fa-at me-1 opacity-75"></i>@Model.UserName
                </span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-custom-header btn-header-back text-decoration-none">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </header>

    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card card-custom">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off">
                        @* Các trường ẩn bắt buộc *@
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserName" />

                        @* Thông báo lỗi tổng quát *@
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small border-0 shadow-sm mb-4"></div>

                        <div class="row g-5">
                            <div class="col-md-6 border-end-md pe-md-4">
                                <div class="section-title">
                                    <div class="section-icon"><i class="fas fa-cog"></i></div>
                                    Hệ thống & Bảo mật
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Tên đăng nhập</label>
                                    <input asp-for="UserName" class="form-control input-custom" readonly title="Không thể thay đổi tên đăng nhập" />
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Vai trò hệ thống <span class="text-danger">*</span></label>
                                    <select asp-for="Role" class="form-select input-custom" asp-items="Html.GetEnumSelectList<UserRole>()">
                                        <option value="">-- Chọn vai trò --</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Địa chỉ Email <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text input-group-text-custom"><i class="fas fa-envelope"></i></span>
                                        <input asp-for="Email" class="form-control input-custom" placeholder="example@domain.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="password-box mt-4">
                                    <h6 class="fw-bold text-danger mb-2">
                                        <i class="fas fa-shield-alt me-1"></i> Thay đổi mật khẩu
                                    </h6>
                                    <p class="text-muted small mb-3">Để trống nếu bạn không muốn thay đổi mật khẩu hiện tại.</p>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Mật khẩu mới</label>
                                        <div class="input-group password-group">
                                            <input asp-for="NewPassword" type="password" class="form-control input-custom" id="newPasswordInput" placeholder="Nhập mật khẩu mới..." autocomplete="new-password" />
                                            <button class="btn btn-toggle" type="button" onclick="togglePasswordVisibility('newPasswordInput', 'newPasswordIcon')">
                                                <i class="fas fa-eye" id="newPasswordIcon"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                                    </div>

                                    <div class="mb-0">
                                        <label class="form-label">Xác nhận mật khẩu</label>
                                        <div class="input-group password-group">
                                            <input asp-for="ConfirmPassword" type="password" class="form-control input-custom" id="confirmPasswordInput" placeholder="Nhập lại mật khẩu..." />
                                            <button class="btn btn-toggle" type="button" onclick="togglePasswordVisibility('confirmPasswordInput', 'confirmPasswordIcon')">
                                                <i class="fas fa-eye" id="confirmPasswordIcon"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 ps-md-4">
                                <div class="section-title">
                                    <div class="section-icon green"><i class="fas fa-id-card"></i></div>
                                    Thông tin cá nhân
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control input-custom" placeholder="Nhập họ và tên..." />
                                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label">Mã số (MSSV/MNV) <span class="text-danger">*</span></label>
                                        <input asp-for="Code" class="form-control input-custom" placeholder="Nhập mã số..." />
                                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Số điện thoại</label>
                                        <div class="input-group">
                                            <span class="input-group-text input-group-text-custom"><i class="fas fa-phone-alt"></i></span>
                                            <input asp-for="PhoneNumber" class="form-control input-custom" placeholder="09xx xxx xxx" />
                                        </div>
                                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Số CCCD/CMND <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text input-group-text-custom"><i class="fas fa-address-card"></i></span>
                                        <input asp-for="IdentityCardNumber" class="form-control input-custom" placeholder="Nhập 12 số CCCD" />
                                    </div>
                                    <span asp-validation-for="IdentityCardNumber" class="text-danger small mt-1 d-block"></span>
                                </div>

                                @* Ghi chú *@
                                <div class="note-box mt-4">
                                    <div class="fw-bold mb-2"><i class="fas fa-info-circle me-1"></i> Lưu ý:</div>
                                    <ul class="list-unstyled mb-0 small" style="line-height: 1.8;">
                                        <li>&bull; Các trường có dấu <span class="text-danger">*</span> là bắt buộc nhập.</li>
                                        <li>&bull; Mã số người dùng dùng để định danh trong ký túc xá.</li>
                                        <li>&bull; Hãy đảm bảo số điện thoại chính xác để nhận thông báo từ Ban Quản lý.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn-action btn-cancel text-decoration-none">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn-action btn-save">
                                <i class="fas fa-check"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        // Hàm ẩn/hiện mật khẩu áp dụng cho nhiều input
        function togglePasswordVisibility(inputId, iconId) {
            const passwordField = document.getElementById(inputId);
            const passwordIcon = document.getElementById(iconId);
            if (passwordField && passwordIcon) {
                if (passwordField.type === "password") {
                    passwordField.type = "text";
                    passwordIcon.classList.remove('fa-eye');
                    passwordIcon.classList.add('fa-eye-slash');
                } else {
                    passwordField.type = "password";
                    passwordIcon.classList.remove('fa-eye-slash');
                    passwordIcon.classList.add('fa-eye');
                }
            }
        }
    </script>
}