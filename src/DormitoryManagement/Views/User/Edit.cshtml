@using DormitoryManagement.Application.Dtos.Requests
@using DormitoryManagement.Domain.Enums
@model DormitoryManagement.Application.Dtos.Requests.UserRequestDto

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Cập nhật thông tin người dùng</h5>
                    <span class="badge bg-dark">@Model.UserName</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @* Cần truyền ID để Controller biết đang cập nhật ai *@
                        <input type="hidden" name="id" value="@ViewContext.RouteData.Values["id"]" />

                        @* Hiển thị TẤT CẢ lỗi để biết tại sao không lưu được *@
                        <div asp-validation-summary="All" class="text-danger mb-3 small fw-bold"></div>

                        <div class="row">
                            <!-- CỘT TRÁI: THÔNG TIN HỆ THỐNG -->
                            <div class="col-md-6 border-end">
                                <h6 class="text-primary mb-3 fw-bold border-bottom pb-2">Thông tin hệ thống</h6>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Tên đăng nhập</label>
                                    <input asp-for="UserName" class="form-control bg-light" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-uppercase">Vai trò người dùng <span class="text-danger">*</span></label>
                                    <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<DormitoryManagement.Domain.Enums.UserRole>()">
                                        @* Tag helper sẽ tự động chọn (select) vai trò hiện tại dựa trên Model.Role *@
                                        <option value="">-- Chọn vai trò --</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Email <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                @* Mật khẩu: Trong Edit thường không bắt buộc, nhưng nếu DTO của bạn yêu cầu [Required] Password,
                                    bạn phải để một giá trị ẩn hoặc tạo 1 DTO riêng cho Edit không có password.
                                    Tạm thời để hidden nếu DTO yêu cầu bắt buộc *@
                                <input type="hidden" asp-for="Password" value="DefaultPassword123!" />
                            </div>

                            <!-- CỘT PHẢI: THÔNG TIN CÁ NHÂN -->
                            <div class="col-md-6 ps-md-4">
                                <h6 class="text-primary mb-3 fw-bold border-bottom pb-2">Thông tin cá nhân</h6>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Mã số (MSSV/MNV) <span class="text-danger">*</span></label>
                                    <input asp-for="Code" class="form-control" />
                                    <span asp-validation-for="Code" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Số CCCD/CMND <span class="text-danger">*</span></label>
                                    <input asp-for="IdentityCardNumber" class="form-control" />
                                    <span asp-validation-for="IdentityCardNumber" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Số điện thoại</label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light border btn-sm">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning btn-sm px-4 fw-bold">
                                <i class="bi bi-save me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>