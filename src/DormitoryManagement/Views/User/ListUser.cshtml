@*
    ViewData["Title"] = "Danh sách người dùng";
*@

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý người dùng - KTX</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 p-4 md:p-8">

    <div class="max-w-7xl mx-auto">
        <!-- Header & Breadcrumb -->
        <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Quản lý người dùng</h1>
                <p class="text-sm text-gray-500">Quản lý danh sách sinh viên và nhân viên trong hệ thống</p>
            </div>
            <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg font-medium transition flex items-center justify-center">
                <i class="fas fa-plus mr-2"></i> Thêm người dùng mới
            </button>
        </div>

        <!-- Filters & Search Bar -->
        <div class="bg-white p-4 rounded-t-xl border border-gray-200 shadow-sm flex flex-col lg:flex-row gap-4 items-center justify-between">
            <div class="relative w-full lg:w-96">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:text-sm" placeholder="Tìm tên, email, mã sinh viên...">
            </div>

            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                <select class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2">
                    <option selected>Tất cả vai trò</option>
                    <option value="sv">Sinh viên</option>
                    <option value="ql">Quản lý</option>
                    <option value="kt">Kỹ thuật</option>
                </select>

                <select class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2">
                    <option selected>Trạng thái</option>
                    <option value="active">Đang hoạt động</option>
                    <option value="inactive">Đã khóa</option>
                </select>

                <button class="text-gray-600 hover:text-indigo-600 font-medium text-sm px-3 py-2">
                    <i class="fas fa-filter mr-1"></i> Lọc nâng cao
                </button>
            </div>
        </div>

        <!-- Table Content -->
        <div class="bg-white border-x border-b border-gray-200 rounded-b-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50 text-gray-600 uppercase text-xs font-semibold">
                        <tr>
                            <th class="px-6 py-4">Người dùng</th>
                            <th class="px-6 py-4">Mã số / Vai trò</th>
                            <th class="px-6 py-4">Liên hệ</th>
                            <th class="px-6 py-4">Ngày tham gia</th>
                            <th class="px-6 py-4">Trạng thái</th>
                            <th class="px-6 py-4 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <!-- User Row 1 -->
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <img class="h-10 w-10 rounded-full object-cover border" src="https://ui-avatars.com/api/?name=Nguyen+Van+A&background=random" alt="">
                                    <div class="ml-4">
                                        <div class="text-sm font-bold text-gray-900">Nguyễn Văn A</div>
                                        <div class="text-xs text-gray-500">Phòng: A.302</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900 font-medium">SV2024001</div>
                                <div class="text-xs text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full inline-block mt-1">Sinh viên</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">
                                <div><i class="far fa-envelope mr-1 w-4"></i> anguyen@gmail.com</div>
                                <div class="mt-1"><i class="fas fa-phone-alt mr-1 w-4 text-xs"></i> 0901.234.567</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">20/02/2024</td>
                            <td class="px-6 py-4">
                                <span class="flex items-center text-green-600 text-xs font-semibold">
                                    <span class="h-2 w-2 bg-green-500 rounded-full mr-2"></span> Đang ở
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <button class="text-gray-400 hover:text-indigo-600 transition"><i class="fas fa-eye"></i></button>
                                <button class="text-gray-400 hover:text-blue-600 transition"><i class="fas fa-edit"></i></button>
                                <button class="text-gray-400 hover:text-red-600 transition"><i class="fas fa-trash-alt"></i></button>
                            </td>
                        </tr>

                        <!-- User Row 2 -->
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <img class="h-10 w-10 rounded-full object-cover border" src="https://ui-avatars.com/api/?name=Tran+Thi+B&background=random" alt="">
                                    <div class="ml-4">
                                        <div class="text-sm font-bold text-gray-900">Trần Thị B</div>
                                        <div class="text-xs text-gray-500">Bộ phận quản lý</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900 font-medium">QL-002</div>
                                <div class="text-xs text-purple-600 bg-purple-50 px-2 py-0.5 rounded-full inline-block mt-1">Quản lý</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">
                                <div><i class="far fa-envelope mr-1 w-4"></i> b.tran@ktx.com</div>
                                <div class="mt-1"><i class="fas fa-phone-alt mr-1 w-4 text-xs"></i> 0988.777.666</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">15/01/2023</td>
                            <td class="px-6 py-4">
                                <span class="flex items-center text-blue-600 text-xs font-semibold">
                                    <span class="h-2 w-2 bg-blue-500 rounded-full mr-2"></span> Làm việc
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <button class="text-gray-400 hover:text-indigo-600 transition"><i class="fas fa-eye"></i></button>
                                <button class="text-gray-400 hover:text-blue-600 transition"><i class="fas fa-edit"></i></button>
                                <button class="text-gray-400 hover:text-red-600 transition"><i class="fas fa-trash-alt"></i></button>
                            </td>
                        </tr>

                        <!-- User Row 3 (Inactive) -->
                        <tr class="hover:bg-gray-50 transition bg-gray-50/30">
                            <td class="px-6 py-4 text-gray-400">
                                <div class="flex items-center opacity-70">
                                    <img class="h-10 w-10 rounded-full object-cover border grayscale" src="https://ui-avatars.com/api/?name=Le+Van+C&background=cccccc" alt="">
                                    <div class="ml-4">
                                        <div class="text-sm font-bold">Lê Văn C</div>
                                        <div class="text-xs italic text-red-400">Đã rời KTX</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-400 font-medium">SV2022045</div>
                                <div class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full inline-block mt-1">Sinh viên</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-400">
                                <div>cle@student.com</div>
                                <div class="mt-1">0912.000.111</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-400">10/10/2022</td>
                            <td class="px-6 py-4">
                                <span class="flex items-center text-gray-400 text-xs font-semibold">
                                    <span class="h-2 w-2 bg-gray-300 rounded-full mr-2"></span> Không hoạt động
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <button class="text-gray-400 hover:text-indigo-600 transition"><i class="fas fa-undo"></i> Khôi phục</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="bg-white px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                <div class="text-sm text-gray-500">
                    Hiển thị <span class="font-medium">1</span> đến <span class="font-medium">3</span> trong <span class="font-medium">50</span> người dùng
                </div>
                <div class="flex space-x-1">
                    <button class="px-3 py-1 border border-gray-300 rounded-md text-sm hover:bg-gray-50">Trước</button>
                    <button class="px-3 py-1 bg-indigo-600 text-white rounded-md text-sm">1</button>
                    <button class="px-3 py-1 border border-gray-300 rounded-md text-sm hover:bg-gray-50">2</button>
                    <button class="px-3 py-1 border border-gray-300 rounded-md text-sm hover:bg-gray-50">3</button>
                    <button class="px-3 py-1 border border-gray-300 rounded-md text-sm hover:bg-gray-50">Tiếp</button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
@{
}
