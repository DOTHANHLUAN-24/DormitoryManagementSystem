@model DormitoryManagement.Application.Dtos.Responses.UserResponseDto
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Header & Navigation -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold text-dark"><i class="fas fa-id-card me-2 text-primary"></i>Hồ sơ cá nhân</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Hồ sơ của tôi</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <!-- Nút giả định trỏ tới Action EditProfile để cập nhật -->
            <a asp-controller="User" asp-action="EditProfile" class="btn btn-primary shadow-sm">
                <i class="fas fa-user-edit me-2"></i>Cập nhật thông tin
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Cột Avatar & Thông tin cơ bản -->
        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-4">
                    <div class="mb-3">
                        @if (Model.Role.ToString() == "Admin")
                        {
                            <i class="fas fa-user-shield fa-6x text-danger"></i>
                        }
                        else if (Model.Role.ToString() == "ManagementStaff")
                        {
                            <i class="fas fa-user-tie fa-6x text-primary"></i>
                        }
                        else if (Model.Role.ToString() == "TechnicalStaff")
                        {
                            <i class="fas fa-user-cog fa-6x text-warning"></i>
                        }
                        else
                        {
                            <i class="fas fa-user-graduate fa-6x text-success"></i>
                        }
                    </div>
                    <h4 class="fw-bold mb-1">@Model.FullName</h4>
                    <p class="text-muted mb-3">@Model.UserName</p>
                    <span class="badge bg-info px-3 py-2 rounded-pill mb-3 fs-6">
                        <i class="fas fa-tag me-1"></i>@Model.Role.ToString()
                    </span>
                    <ul class="list-group list-group-flush text-start mt-3">
                        <li class="list-group-item px-0 border-0">
                            <i class="fas fa-envelope text-muted me-2"></i>@Model.Email
                        </li>
                        <li class="list-group-item px-0 border-0">
                            <i class="fas fa-phone text-muted me-2"></i>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)
                        </li>
                        <li class="list-group-item px-0 border-0">
                            <i class="fas fa-id-badge text-muted me-2"></i>Mã: <strong>@Model.Code</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cột Thông tin chi tiết -->
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>Chi tiết tài khoản</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Họ và tên đầy đủ</div>
                        <div class="col-sm-8 fw-semibold">@Model.FullName</div>
                    </div>
                    <hr class="text-muted opacity-25">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Số CCCD / CMND</div>
                        <div class="col-sm-8 fw-semibold">@(string.IsNullOrEmpty(Model.IdentityCardNumber) ? "Chưa cập nhật" : Model.IdentityCardNumber)</div>
                    </div>
                    <hr class="text-muted opacity-25">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Trạng thái hoạt động</div>
                        <div class="col-sm-8">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                <i class="fas @(Model.IsActive ? "fa-check-circle" : "fa-lock") me-1"></i>@(Model.IsActive ? "Đang hoạt động" : "Đã bị khóa")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>