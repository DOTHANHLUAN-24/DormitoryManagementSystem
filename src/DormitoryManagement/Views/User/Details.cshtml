@model DormitoryManagement.Application.Dtos.Responses.UserResponseDto

<div class="container-fluid">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fas fa-chevron-left me-1"></i> Quay lại danh sách
        </a>
        <h4 class="mt-2"><i class="fas fa-info-circle me-2 text-info"></i> Chi tiết người dùng</h4>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4 mb-4">
                <div class="mx-auto bg-light rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                    <i class="fas fa-user fa-3x text-secondary"></i>
                </div>
                <h5 class="mb-1">@Model.FullName</h5>
                <p class="text-muted small">@Model.UserName</p>
                <div class="mt-2">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đang bị khóa</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Thông tin tài khoản</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Email:</div>
                        <div class="col-sm-8 fw-semibold">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Số điện thoại:</div>
                        <div class="col-sm-8 fw-semibold">@Model.PhoneNumber</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Ngày tạo:</div>
                        <div class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-0">
                        <div class="col-sm-4 text-muted">Cập nhật lần cuối:</div>
                        <div class="col-sm-8">@(Model.LastModified?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có cập nhật")</div>
                    </div>
                </div>
                <div class="card-footer bg-white py-3 text-end">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white btn-sm">
                        <i class="fas fa-edit me-1"></i> Chỉnh sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>