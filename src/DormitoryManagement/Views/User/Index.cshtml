@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses
@model PagedResult<DormitoryManagement.Application.Dtos.Responses.UserResponseDto>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; border: none; }
        .btn-add { background: #4f46e5; color: white !important; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); }
        .btn-add:hover { background: #4338ca; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); }
        .btn-trash { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
        .btn-trash:hover { background: #f8fafc; color: #1e293b !important; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .btn-banned { background: white; color: #ef4444 !important; border: 1px solid #e2e8f0; }
        .btn-banned:hover { background: #fef2f2; color: #dc2626 !important; border-color: #fecaca; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(239, 68, 68, 0.1); }
        .thanh-tim-kiem { background: #fff; border-radius: 16px; padding: 16px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; }
        .input-custom { height: 46px; border-radius: 12px !important; border: 1px solid #e2e8f0 !important; font-size: 14px; color: #1e293b; background-color: #f8fafc; width: 100%; transition: all 0.2s; }
        .input-custom:focus { border-color: #4f46e5 !important; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important; background-color: #fff; }
        .khung-tim-kiem { position: relative; }
        .khung-tim-kiem i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; z-index: 10; }
        .khung-tim-kiem input { padding-left: 40px; }
        .btn-search { height: 46px; border-radius: 12px; background: #4f46e5; color: white; border: none; font-weight: 600; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; }
        .btn-search:hover { background: #4338ca; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); color: white; }
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: none; overflow: hidden; }
        .badge-username { background: #f8fafc; color: #1e293b; padding: 6px 10px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 600; border: 1px solid #e2e8f0; }
        .trang-thai-user { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; display: inline-block; }
        .dang-hoat-dong { background: #ecfdf5; color: #10b981; }
        .da-khoa { background: #fef2f2; color: #ef4444; }
        .nut-hanh-dong { width: 34px; height: 34px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; border: none; transition: all 0.2s; }
        .nut-chi-tiet { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }
        .nut-sua { background: #eff6ff; color: #3b82f6; }
        .nut-khoa { background: #fff7ed; color: #f97316; }
        .nut-xoa { background: #fef2f2; color: #ef4444; }
        .nut-hanh-dong:hover { transform: scale(1.1); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
}

@Html.AntiForgeryToken()
<input type="hidden" id="success-message" value="@TempData["Success"]" />
<input type="hidden" id="error-message" value="@TempData["Error"]" />

<div class="container-fluid">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-users-cog me-2"></i>Quản lý người dùng</h1>
        <div class="d-flex gap-2">
            <a asp-action="BannedList" class="btn-custom-header btn-banned text-decoration-none" title="Xem tài khoản bị khóa">
                <i class="fas fa-user-lock"></i> DS Bị khóa
            </a>
            <a asp-action="RecycleBin" class="btn-custom-header btn-trash text-decoration-none">
                <i class="fas fa-trash-restore"></i> Thùng rác
            </a>
            <a asp-action="Create" class="btn-custom-header btn-add text-decoration-none">
                <i class="fas fa-plus"></i> Thêm người dùng
            </a>
        </div>
    </header>

    <form method="get" asp-action="Index" class="thanh-tim-kiem">
        <div class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="khung-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="input-custom" placeholder="Tìm theo tên đăng nhập, email, họ tên...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-search">
                    <i class="fas fa-filter"></i> Tìm kiếm
                </button>
            </div>
        </div>
    </form>

    <div class="card card-custom mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Tên đăng nhập</th>
                        <th class="py-3">Họ và tên</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="text-end pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 py-3"><span class="badge-username">@item.UserName</span></td>
                                <td><div class="fw-bold text-dark">@item.FullName</div></td>
                                <td><span class="text-muted small">@item.Email</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="trang-thai-user dang-hoat-dong"><i class="fas fa-check-circle me-1"></i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="trang-thai-user da-khoa"><i class="fas fa-lock me-1"></i> Đã khóa</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="nut-hanh-dong nut-chi-tiet text-decoration-none" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="nut-hanh-dong nut-sua text-decoration-none" title="Chỉnh sửa"><i class="fas fa-edit"></i></a>
                                        <button type="button" onclick="toggleLock('@item.Id', @(item.IsActive ? "true" : "false"), '@item.UserName')" 
                                                class="nut-hanh-dong nut-khoa" title="@(item.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                            <i class="fas @(item.IsActive ? "fa-user-lock" : "fa-user-check")"></i>
                                        </button>
                                        <button type="button" onclick="deactivateUser('@item.Id', '@item.UserName')" 
                                                class="nut-hanh-dong nut-xoa" title="Xóa vào thùng rác">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-users-slash fa-3x mb-3 d-block opacity-25"></i>
                                    <p class="mb-0 fw-medium">Không tìm thấy người dùng nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PHÂN TRANG -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Hiển thị thông báo TempData từ thẻ ẩn
            var successMsg = document.getElementById('success-message').value;
            var errorMsg = document.getElementById('error-message').value;

            if (successMsg) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: successMsg, timer: 2500, showConfirmButton: false });
            }
            if (errorMsg) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: errorMsg, confirmButtonColor: '#ef4444' });
            }
        });

        function getAntiforgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        // Logic Xóa (Soft Delete)
        function deactivateUser(id, userName) {
            Swal.fire({
                title: 'Đưa vào thùng rác?',
                html: "Tài khoản <b>" + userName + "</b> sẽ bị vô hiệu hóa tạm thời.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-trash me-1"></i> Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

                    $.ajax({
                        url: '/User/Deactivate/' + id,
                        type: 'POST',
                        headers: { "RequestVerificationToken": getAntiforgeryToken() },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({ icon: 'success', title: 'Thành công', text: data.message, timer: 1500, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Không thể xóa', text: data.message, confirmButtonColor: '#4f46e5' });
                            }
                        },
                        error: function () { Swal.fire({ icon: 'error', title: 'Lỗi hệ thống', text: 'Không thể thực hiện thao tác' }); }
                    });
                }
            });
        }

        // Logic Khóa/Mở khóa
        function toggleLock(id, isActive, userName) {
            const title = isActive ? "Khóa tài khoản?" : "Mở khóa tài khoản?";
            const textHTML = isActive 
                ? "Tài khoản <b>" + userName + "</b> sẽ không thể đăng nhập vào hệ thống."
                : "Tài khoản <b>" + userName + "</b> sẽ được cấp quyền truy cập trở lại.";
            const btnColor = isActive ? '#f97316' : '#10b981';
            const btnIcon = isActive ? '<i class="fas fa-lock me-1"></i> Khóa ngay' : '<i class="fas fa-unlock me-1"></i> Mở khóa';

            Swal.fire({
                title: title,
                html: textHTML,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: btnColor,
                cancelButtonColor: '#64748b',
                confirmButtonText: btnIcon,
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

                    $.ajax({
                        url: '/User/ToggleLock/' + id,
                        type: 'POST',
                        headers: { "RequestVerificationToken": getAntiforgeryToken() },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({ icon: 'success', title: 'Thành công', text: data.message, timer: 1500, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Lỗi!', text: data.message, confirmButtonColor: '#4f46e5' });
                            }
                        }
                    });
                }
            });
        }
    </script>
}