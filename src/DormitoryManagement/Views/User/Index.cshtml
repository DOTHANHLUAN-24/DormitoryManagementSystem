@model List<DormitoryManagement.Domain.Entities.User>

@{
    ViewData["Title"] = "Danh sách Người dùng";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-primary mb-0">Danh sách Người dùng</h4>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm người dùng
        </a>
    </div>

    <div class="card">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Họ và Tên</th>
                            <th>Liên hệ</th>
                            <th>CCCD</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int index = (currentPage - 1) * 10;
                        }

                        @foreach (var user in Model)
                        {
                            index++;

                            <tr>
                                <td class="ps-4 fw-medium">@index</td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2 bg-secondary-subtle rounded-circle p-2">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@user.FullName</div>
                                            <small class="text-muted">@user.Code</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div><i class="bi bi-envelope me-1"></i>@user.Email</div>
                                    <div><i class="bi bi-telephone me-1"></i>@user.PhoneNumber</div>
                                </td>

                                <td>@user.IdentityCardNumber</td>

                                <td>
                                    <span class="badge bg-info-subtle text-info border">
                                        @(user.Role == DormitoryManagement.Domain.Enums.UserRole.Admin ? "Admin" :
                                          user.Role == DormitoryManagement.Domain.Enums.UserRole.ManagementStaff ? "Quản lý" :
                                          user.Role == DormitoryManagement.Domain.Enums.UserRole.TechnicalStaff ? "Kỹ thuật" : "Sinh viên")
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                        @(user.IsActive ? "Hoạt động" : "Bị khóa")
                                    </span>
                                </td>

                                <td>@user.CreatedDate.ToString("dd/MM/yyyy")</td>

                                <td class="text-end pe-4">

                                    <a asp-action="Contract" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       data-bs-toggle="tooltip"
                                       title="Hợp đồng">
                                        <i class="fa-solid fa-file-lines"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       data-bs-toggle="tooltip"
                                       title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       data-bs-toggle="tooltip"
                                       title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

        <!-- PAGINATION -->
        <div class="card-footer d-flex justify-content-between align-items-center">

            <small class="text-muted">
                Trang @currentPage / @totalPages
            </small>

            <ul class="pagination pagination-sm mb-0">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">
                        Trước
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">
                        Tiếp
                    </a>
                </li>

            </ul>
        </div>
    </div>
</div>