@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses
@model PagedResult<UserResponseDto>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="fas fa-users me-2 text-primary"></i> Quản lý Người dùng</h4>
        <div>
            <a asp-action="RecycleBin" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-trash-restore me-1"></i> Thùng rác
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm ms-2">
                <i class="fas fa-plus me-1"></i> Thêm sinh viên
            </a>
        </div>
    </div>

    @* Thanh tìm kiếm *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" placeholder="Tìm theo tên, email, SĐT...">
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    @* Bảng *@
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3"><strong>@item.UserName</strong></td>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đang ở</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đang khóa</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-info" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                    <button onclick="deactivateUser('@item.Id')" class="btn btn-sm btn-light text-danger" title="Khóa"><i class="fas fa-user-times"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", Model)
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deactivateUser(id) {
            Swal.fire({
                title: 'Xác nhận khóa?',
                text: "Người dùng này sẽ bị chuyển vào thùng rác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/User/Deactivate/' + id, function (data) {
                        if (data.success) location.reload();
                    });
                }
            })
        }
    </script>
}