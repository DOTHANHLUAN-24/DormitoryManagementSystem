@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses
@model PagedResult<DormitoryManagement.Application.Dtos.Responses.UserResponseDto>

@* Quan trọng: Phải có dòng này để AJAX lấy được Token *@
@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="fas fa-users me-2 text-primary"></i> Quản lý Người dùng</h4>
        <div>
            <a asp-action="RecycleBin" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-trash-restore me-1"></i> Thùng rác
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm ms-2">
                <i class="fas fa-plus me-1"></i> Thêm sinh viên
            </a>
        </div>
    </div>

    @* Thanh tìm kiếm *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" placeholder="Tìm theo tên, email, SĐT...">
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    @* Bảng *@
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3"><strong>@item.UserName</strong></td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="fas fa-check-circle me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="fas fa-lock me-1"></i> Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-info" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning" title="Sửa"><i class="fas fa-edit"></i></a>

                                        @* Nút Khóa/Mở khóa *@
                                        <button type="button" onclick="toggleLock('@item.Id', @(item.IsActive ? "true" : "false"))"
                                                class="btn btn-sm btn-light @(item.IsActive ? "text-danger" : "text-success")"
                                                title="@(item.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                            <i class="fas @(item.IsActive ? "fa-user-lock" : "fa-user-check")"></i>
                                        </button>

                                        @* Nút Xóa (Soft Delete) *@
                                        <button type="button" onclick="deactivateUser('@item.Id')" class="btn btn-sm btn-light text-secondary" title="Xóa vào thùng rác">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", Model)
</div>

@section Scripts {
    @* Đảm bảo có jQuery và SweetAlert2 *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Hàm Xóa vào thùng rác
        function deactivateUser(id) {
            console.log("Đang gọi deactivate cho ID:", id); // Kiểm tra xem hàm có chạy không
            
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Người dùng này sẽ bị chuyển vào thùng rác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Lấy token chống giả mạo
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/User/Deactivate/' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire('Thành công!', data.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi!', data.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            console.error(xhr);
                            Swal.fire('Lỗi!', 'Không thể thực hiện thao tác', 'error');
                        }
                    });
                }
            });
        }

        // Hàm Khóa/Mở khóa
        function toggleLock(id, isActive) {
            console.log("Đang gọi toggleLock cho ID:", id, "Trạng thái hiện tại:", isActive);

            const title = isActive ? "Khóa tài khoản?" : "Mở khóa tài khoản?";
            const text = isActive ? "Người dùng này sẽ không thể đăng nhập!" : "Người dùng này sẽ có thể đăng nhập lại.";

            Swal.fire({
                title: title,
                text: text,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: isActive ? '#d33' : '#28a745',
                confirmButtonText: isActive ? 'Khóa' : 'Mở khóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/User/ToggleLock/' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire('Thành công!', data.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi!', data.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ', 'error');
                        }
                    });
                }
            });
        }
    </script>
}