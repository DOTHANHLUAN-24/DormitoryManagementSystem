<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Người dùng - Dormitory Management</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .status-badge {
            width: 80px;
        }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Danh sách Người dùng</h2>
            <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm người dùng mới</button>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Mã (Code)</th>
                                <th>Họ và Tên</th>
                                <th>Liên hệ</th>
                                <th>CCCD/CMND</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dữ liệu mẫu -->
                            <tr>
                                <td class="ps-4 fw-medium">SV2024001</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2 bg-secondary-subtle rounded-circle p-2">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">Nguyễn Văn A</div>
                                            <small class="text-muted">ID: 550e8400...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1"></i>vana@email.com</div>
                                    <div><i class="bi bi-telephone me-1"></i>0987.654.321</div>
                                </td>
                                <td>123456789012</td>
                                <td><span class="badge bg-info-subtle text-info border">Student</span></td>
                                <td>
                                    <span class="badge bg-success status-badge">Active</span>
                                </td>
                                <td>04/05/2024</td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary" title="Xem hợp đồng"><i class="bi bi-file-earmark-text"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary" title="Chỉnh sửa"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>

                            <tr>
                                <td class="ps-4 fw-medium">NV2024005</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2 bg-secondary-subtle rounded-circle p-2">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">Trần Thị B</div>
                                            <small class="text-muted">ID: 721f9211...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1"></i>thib@email.com</div>
                                    <div><i class="bi bi-telephone me-1"></i>0912.345.678</div>
                                </td>
                                <td>987654321098</td>
                                <td><span class="badge bg-warning-subtle text-warning border">Staff</span></td>
                                <td>
                                    <span class="badge bg-danger status-badge">Inactive</span>
                                </td>
                                <td>01/05/2024</td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary" title="Xem hợp đồng"><i class="bi bi-file-earmark-text"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary" title="Chỉnh sửa"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">Hiển thị 2 trên 50 người dùng</small>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">Tiếp</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>