@{
    ViewData["Title"] = "Xác nhận";
    Layout = "_AuthLayout";
}

@section Styles {
    <style>
        .confirm-container {
            width: 100%;
            max-width: 460px;
            margin: 40px auto;
        }

        .confirm-box {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            padding: 40px;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .confirm-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.3);
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 20px;
            box-shadow: 0 4px 10px rgba(40, 167, 69, 0.1);
        }

        .btn-outline-primary {
            border-color: #006b73;
            color: #006b73;
            border-radius: 12px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline-primary:hover {
            background-color: #006b73;
            border-color: #006b73;
            color: white;
            box-shadow: 0 4px 12px rgba(0, 107, 115, 0.2);
        }
    </style>
}

<div class="confirm-container">
    <div class="confirm-box">
        <div class="icon-circle">
            <i class="fas fa-envelope-open-text"></i>
        </div>
        <h4 class="fw-bold mb-3">Kiểm tra Email</h4>
        <p class="text-muted small mb-4">Nếu email của bạn tồn tại trên hệ thống, chúng tôi đã gửi một liên kết đặt lại mật khẩu. Vui lòng kiểm tra hộp thư (và cả thư rác).</p>
        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary w-100">
            <i class="fas fa-sign-in-alt me-2"></i> Quay lại Đăng nhập
        </a>
    </div>
</div>