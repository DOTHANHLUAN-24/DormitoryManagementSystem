@{
    ViewData["Title"] = "Xác nhận";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card p-4 text-center" style="max-width: 450px; border-radius:15px;">
        <div class="mb-3"><i class="bi bi-envelope-check text-success" style="font-size: 3rem;"></i></div>
        <h4 class="fw-bold">Kiểm tra Email</h4>
        <p class="text-muted">Nếu email của bạn tồn tại trên hệ thống, chúng tôi đã gửi một liên kết đặt lại mật khẩu. Vui lòng kiểm tra hộp thư (và cả thư rác).</p>
        <a href="@Url.Action("Login", "Account" )" class="btn btn-outline-primary">Quay lại Đăng nhập</a>
    </div>
</body>
</html>