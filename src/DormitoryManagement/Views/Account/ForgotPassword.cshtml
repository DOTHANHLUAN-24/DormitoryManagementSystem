@model DormitoryManagement.Application.Dtos.Requests.Authentications.ForgotPasswordRequest
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
}

@section Styles {
    <style>
        .forgot-container {
            width: 100%;
            max-width: 460px;
            margin: 40px auto;
        }

        .forgot-box {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            padding: 40px;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .forgot-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.3);
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: rgba(0, 107, 115, 0.1);
            color: #006b73;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 20px;
            box-shadow: 0 4px 10px rgba(0, 107, 115, 0.1);
        }

        .brand-name {
            color: #006b73;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .form-label {
            font-weight: 600;
            color: #444;
            font-size: 0.9rem;
        }

        .input-group-text {
            background: #f8f9fa;
            border: 1px solid #dcdde1;
            color: #718093;
            border-radius: 10px;
            transition: all 0.3s;
        }

        .form-control {
            border-radius: 10px;
            height: 48px;
            border: 1px solid #dcdde1;
            padding-left: 15px;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: #006b73;
            box-shadow: 0 0 0 0.25rem rgba(0, 107, 115, 0.15);
            background-color: #fff;
        }

        .input-group:focus-within .input-group-text {
            border-color: #006b73;
            color: #006b73;
        }

        .btn-primary {
            background: linear-gradient(135deg, #006b73 0%, #00545b 100%);
            border: none;
            height: 50px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 107, 115, 0.3);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #00545b 0%, #003d42 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 107, 115, 0.4);
        }

        .back-to-login {
            color: #718093;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-weight: 600;
        }

        .back-to-login:hover {
            color: #006b73;
        }
    </style>
}

<div class="forgot-container">
    <div class="forgot-box">
        <div class="text-center mb-4">
            <div class="icon-circle">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h2 class="brand-name mb-2">DMS</h2>
            <h4 class="fw-bold">Quên mật khẩu?</h4>
            <p class="text-muted small">Đừng lo lắng! Nhập email của bạn và chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu.</p>
        </div>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <div class="mb-4">
                <label class="form-label">Email đã đăng ký</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@domain.com" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-4 text-white">
                <i class="fas fa-paper-plane me-2"></i> GỬI YÊU CẦU
            </button>

            <div class="text-center">
                <a href="@Url.Action("Login", "Account")" class="back-to-login">
                    <i class="fas fa-arrow-left"></i> Quay lại trang đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}