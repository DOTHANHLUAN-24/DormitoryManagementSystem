@model DormitoryManagement.Application.Dtos.Requests.Authentications.ForgotPasswordRequest
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null; // Không dùng Layout chung để giao diện giống trang Login
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu - DMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .forgot-box {
            width: 100%;
            max-width: 400px;
            background: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .btn-primary {
            background: #006b73;
            border: none;
            height: 50px;
            border-radius: 8px;
            font-weight: 600;
        }

            .btn-primary:hover {
                background: #00545b;
            }

        .form-control {
            height: 50px;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div class="forgot-box">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: #006b73;">Quên mật khẩu?</h3>
            <p class="text-muted small">Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>
        </div>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <label class="form-label small fw-bold">Email đăng ký</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email của bạn" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">GỬI YÊU CẦU</button>

            <div class="text-center">
                <a href="@Url.Action("Login", "Account")" class="text-decoration-none small text-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                </a>
            </div>
        </form>
    </div>

    @* Client-side validation scripts *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>