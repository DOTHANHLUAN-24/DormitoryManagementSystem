@model DormitoryManagement.Application.Dtos.Requests.Authentications.ResetPasswordRequest
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đặt lại mật khẩu | DMS</title>

    <!-- Bootstrap 5 & Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary-color: #006b73;
            --primary-hover: #00545b;
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        body {
            background: var(--bg-gradient);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            margin: 0;
        }

        .reset-container {
            width: 100%;
            max-width: 450px;
            padding: 15px;
        }

        .reset-box {
            background: #ffffff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: rgba(0, 107, 115, 0.1);
            color: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 20px;
        }

        .brand-name {
            color: var(--primary-color);
            font-weight: 700;
            letter-spacing: -1px;
        }

        .form-label {
            font-weight: 600;
            color: #444;
            font-size: 0.9rem;
        }

        .input-group-text {
            background-color: #f8f9fa;
            border-right: none;
            color: #6c757d;
        }

        .form-control {
            border-left: none;
            height: 50px;
            font-size: 1rem;
            border-radius: 0 8px 8px 0;
        }

            .form-control:focus {
                border-color: #dee2e6;
                box-shadow: none;
            }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control {
            border-color: var(--primary-color);
        }

        .btn-primary {
            background: var(--primary-color);
            border: none;
            height: 50px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                background: var(--primary-hover);
                box-shadow: 0 5px 15px rgba(0, 107, 115, 0.3);
            }

        .toggle-password {
            cursor: pointer;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-left: none;
            display: flex;
            align-items: center;
            padding: 0 15px;
            color: #6c757d;
            border-radius: 0 8px 8px 0;
        }

        .fade-in {
            animation: fadeIn 0.6s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <div class="reset-container">
        <div class="reset-box fade-in">
            <div class="text-center mb-4">
                <div class="icon-circle">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h2 class="brand-name mb-2">DMS</h2>
                <h4 class="fw-bold">Thiết lập mật khẩu mới</h4>
                <p class="text-muted small">Vui lòng nhập mật khẩu mới cực kỳ bảo mật cho tài khoản của bạn.</p>
            </div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" type="password" class="form-control" id="password" placeholder="Nhập mật khẩu mới" required />
                        <span class="toggle-password" onclick="toggleVisibility('password', this)">
                            <i class="bi bi-eye"></i>
                        </span>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-check"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassword" placeholder="Nhập lại mật khẩu" required />
                        <span class="toggle-password" onclick="toggleVisibility('confirmPassword', this)">
                            <i class="bi bi-eye"></i>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">
                    <i class="bi bi-shield-check me-2"></i> CẬP NHẬT MẬT KHẨU
                </button>

                <div class="text-center">
                    <a href="@Url.Action("Login", "Account")" class="text-decoration-none small text-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                    </a>
                </div>
            </form>
        </div>

        <p class="text-center mt-4 text-muted small">
            &copy; @DateTime.Now.Year - Hệ thống Quản lý Ký túc xá (DMS)
        </p>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function toggleVisibility(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = "password";
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
</body>
</html>