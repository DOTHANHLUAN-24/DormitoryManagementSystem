@model DormitoryManagement.Application.Dtos.Requests.Authentications.ResetPasswordRequest
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_AuthLayout";
}

@section Styles {
    <style>
        .reset-container {
            width: 100%;
            max-width: 460px;
            margin: 40px auto;
        }

        .reset-box {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            padding: 40px;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .reset-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.3);
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: rgba(0, 107, 115, 0.1);
            color: #006b73;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 20px;
            box-shadow: 0 4px 10px rgba(0, 107, 115, 0.1);
        }

        .brand-name {
            color: #006b73;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .form-label {
            font-weight: 600;
            color: #444;
            font-size: 0.9rem;
        }

        .input-group-text {
            background: #f8f9fa;
            border: 1px solid #dcdde1;
            color: #718093;
            border-radius: 10px;
            transition: all 0.3s;
        }

        .form-control {
            border-radius: 10px;
            height: 48px;
            border: 1px solid #dcdde1;
            padding-left: 15px;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: #006b73;
            box-shadow: 0 0 0 0.25rem rgba(0, 107, 115, 0.15);
            background-color: #fff;
        }

        .input-group:focus-within .input-group-text {
            border-color: #006b73;
            color: #006b73;
        }

        .btn-primary {
            background: linear-gradient(135deg, #006b73 0%, #00545b 100%);
            border: none;
            height: 50px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 107, 115, 0.3);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #00545b 0%, #003d42 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 107, 115, 0.4);
        }

        .toggle-password {
            cursor: pointer;
            background: #f8f9fa;
            border: 1px solid #dcdde1;
            border-left: none;
            display: flex;
            align-items: center;
            padding: 0 15px;
            color: #718093;
            border-radius: 0 10px 10px 0;
            transition: all 0.3s;
        }

        .input-group:focus-within .toggle-password {
            border-color: #006b73;
            color: #006b73;
        }
    </style>
}

<div class="reset-container">
    <div class="reset-box">
        <div class="text-center mb-4">
            <div class="icon-circle">
                <i class="fas fa-key"></i>
            </div>
            <h2 class="brand-name mb-2">DMS</h2>
            <h4 class="fw-bold">Thiết lập mật khẩu mới</h4>
            <p class="text-muted small">Vui lòng nhập mật khẩu mới cực kỳ bảo mật cho tài khoản của bạn.</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="NewPassword" type="password" class="form-control border-end-0" id="password" placeholder="Nhập mật khẩu mới" required />
                    <span class="toggle-password" onclick="toggleVisibility('password', this)">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Xác nhận mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control border-end-0" id="confirmPassword" placeholder="Nhập lại mật khẩu" required />
                    <span class="toggle-password" onclick="toggleVisibility('confirmPassword', this)">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3 text-white">
                <i class="fas fa-check-circle me-2"></i> CẬP NHẬT MẬT KHẨU
            </button>

            <div class="text-center">
                <a href="@Url.Action("Login", "Account")" class="text-decoration-none small text-secondary fw-semibold">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleVisibility(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = "password";
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
}