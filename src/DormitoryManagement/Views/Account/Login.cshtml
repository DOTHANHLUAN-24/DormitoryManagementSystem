@model DormitoryManagement.Application.Dtos.Requests.LoginRequest

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - DMS</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body { margin: 0; padding: 0; overflow: hidden; font-family: 'Segoe UI', sans-serif; }
        .left-side { height: 100vh; background-image: url('/images/dormitory.jpg'); background-size: cover; background-position: center; position: relative; }
        .left-side::after { content: ""; position: absolute; inset: 0; background: rgba(0,0,0,0.15); }
        .right-side { height: 100vh; background: #fff; display: flex; justify-content: center; align-items: center; }
        .login-box { width: 100%; max-width: 430px; padding: 20px; }
        .logo-title { color: #006b73; font-size: 58px; font-weight: 800; line-height: 1; }
        .logo-sub { color: #f58220; font-weight: 700; letter-spacing: 1px; }
        .description { margin-top: 18px; margin-bottom: 28px; color: #444; font-size: 15px; }
        .nav-tabs .nav-link { color: #006b73; font-weight: 500; border: none; }
        .nav-tabs .nav-link.active { color: #000; font-weight: 700; border-bottom: 3px solid #006b73; }
        .form-control { height: 54px; border-radius: 8px; font-size: 15px; margin-bottom: 15px; }
        .btn-login { height: 52px; background: #006b73; border: none; border-radius: 8px; font-size: 17px; font-weight: 600; }
        .btn-login:hover { background: #00545b; }
        .forgot-link { text-decoration: none; color: #555; font-size: 14px; }
        .bottom-link { margin-top: 45px; text-align: center; }
        .bottom-link a { color: #2b5cff; text-decoration: underline; font-size: 14px; }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <!-- LEFT IMAGE -->
            <div class="col-lg-8 left-side"></div>

            <!-- RIGHT LOGIN -->
            <div class="col-lg-4 right-side">
                <div class="login-box">
                    <div class="text-center mb-4">
                        <div class="logo-title">DMS</div>
                        <div class="logo-sub">DORMITORY MANAGEMENT</div>
                        <div class="description">Đăng nhập để sử dụng hệ thống</div>
                    </div>

                    <!-- TABS SELECTION -->
                    <ul class="nav nav-tabs mb-4" id="loginTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="student-tab" data-bs-toggle="tab" data-bs-target="#student-pane" type="button" role="tab">Sinh viên</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin-pane" type="button" role="tab">Quản trị viên</button>
                        </li>
                    </ul>

                    <!-- HIỂN THỊ LỖI NẾU ĐĂNG NHẬP THẤT BẠI -->
                    <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 14px;"></div>

                    <div class="tab-content" id="loginTabContent">

                        <!-- FORM SINH VIÊN -->
                        <div class="tab-pane fade show active" id="student-pane" role="tabpanel">
                            <form asp-action="Login" asp-controller="Account" method="post">
                                <div class="mb-3">
                                    <input asp-for="Username" class="form-control" placeholder="Mã số sinh viên" required />
                                </div>
                                <div class="mb-3">
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu sinh viên" required />
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="remStudent">
                                        <label class="form-check-label" for="remStudent">Ghi nhớ</label>
                                    </div>
                                    <a href="#" class="forgot-link">Quên mật khẩu?</a>
                                </div>
                                <button type="submit" class="btn btn-login text-white w-100">ĐĂNG NHẬP SINH VIÊN</button>
                            </form>
                        </div>

                        <!-- FORM ADMIN -->
                        <div class="tab-pane fade" id="admin-pane" role="tabpanel">
                            <form asp-action="Login" asp-controller="Account" method="post">
                                <div class="mb-3">
                                    <input asp-for="Username" class="form-control" placeholder="Tên đăng nhập Admin" required />
                                </div>
                                <div class="mb-3">
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu Admin" required />
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="remAdmin">
                                        <label class="form-check-label" for="remAdmin">Ghi nhớ</label>
                                    </div>
                                    <a href="#" class="forgot-link">Quên mật khẩu?</a>
                                </div>
                                <button type="submit" class="btn btn-dark w-100" style="height:52px; border-radius:8px;">ĐĂNG NHẬP QUẢN TRỊ</button>
                            </form>
                        </div>

                    </div>

                    <div class="bottom-link">
                        <a href="#">HỆ THỐNG QUẢN LÝ KÝ TÚC XÁ v1.0</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Script hỗ trợ Validation phía Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>