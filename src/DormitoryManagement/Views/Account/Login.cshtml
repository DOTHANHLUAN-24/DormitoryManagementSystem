@model DormitoryManagement.Application.Dtos.Requests.LoginRequest

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Đăng nhập</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Segoe UI', sans-serif;
        }

        /* LEFT IMAGE */
        .left-side {
            height: 100vh;
            background-image: url('/images/dormitory.jpg');
            background-size: cover;
            background-position: center;
            position: relative;
        }

            .left-side::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(0,0,0,0.15);
            }

        /* RIGHT */
        .right-side {
            height: 100vh;
            background: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-box {
            width: 100%;
            max-width: 430px;
            padding: 20px;
        }

        /* LOGO */
        .logo-title {
            color: #006b73;
            font-size: 58px;
            font-weight: 800;
            line-height: 1;
        }

        .logo-sub {
            color: #f58220;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .description {
            margin-top: 18px;
            margin-bottom: 28px;
            color: #444;
            font-size: 15px;
        }

        /* TABS */
        .nav-tabs .nav-link {
            color: #006b73;
            font-weight: 500;
            border: none;
        }

            .nav-tabs .nav-link.active {
                color: #000;
                font-weight: 700;
                border-bottom: 3px solid #006b73;
            }

        /* INPUT */
        .form-control {
            height: 54px;
            border-radius: 8px;
            font-size: 15px;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #0d6efd;
            }

        /* BUTTON */
        .btn-login {
            height: 52px;
            background: #006b73;
            border: none;
            border-radius: 8px;
            font-size: 17px;
            font-weight: 600;
        }

            .btn-login:hover {
                background: #00545b;
            }

        .forgot-link {
            text-decoration: none;
            color: #555;
            font-size: 14px;
        }

            .forgot-link:hover {
                color: #006b73;
            }

        .bottom-link {
            margin-top: 45px;
            text-align: center;
        }

            .bottom-link a {
                color: #2b5cff;
                text-decoration: underline;
                font-size: 14px;
            }

        @@media(max-width: 992px) {

            .left-side {
                display: none;
            }

            .right-side {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">

            <!-- LEFT IMAGE -->
            <div class="col-lg-8 left-side"></div>

            <!-- RIGHT LOGIN -->
            <div class="col-lg-4 right-side">

                <div class="login-box">

                    <!-- LOGO -->
                    <div class="text-center mb-4">

                        <div class="logo-title">
                            DMS
                        </div>

                        <div class="logo-sub">
                            DORMITORY MANAGEMENT
                        </div>

                        <div class="description">
                            Đăng nhập để sử dụng hệ thống quản lý ký túc xá
                        </div>

                    </div>

                    <!-- BOOTSTRAP 5 TABS -->
                    <ul class="nav nav-tabs mb-4"
                        id="loginTab"
                        role="tablist">

                        <!-- SINH VIÊN -->
                        <li class="nav-item"
                            role="presentation">

                            <button class="nav-link active"
                                    id="student-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#student-tab-pane"
                                    type="button"
                                    role="tab">

                                Sinh viên

                            </button>

                        </li>

                        <!-- ADMIN -->
                        <li class="nav-item"
                            role="presentation">

                            <button class="nav-link"
                                    id="admin-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#admin-tab-pane"
                                    type="button"
                                    role="tab">

                                Admin

                            </button>

                        </li>

                    </ul>

                    <!-- TAB CONTENT -->
                    <div class="tab-content"
                         id="loginTabContent">

                        <!-- ================= SINH VIÊN ================= -->
                        <div class="tab-pane fade show active"
                             id="student-tab-pane"
                             role="tabpanel">

                            <form asp-action="StudentLogin"
                                  method="post">

                                <div asp-validation-summary="All"
                                     class="text-danger mb-3">
                                </div>

                                <!-- ACCOUNT -->
                                <div class="mb-3">

                                    <input type="text"
                                           name="StudentCode"
                                           class="form-control"
                                           placeholder="Mã sinh viên" />

                                </div>

                                <!-- PASSWORD -->
                                <div class="mb-3">

                                    <input type="password"
                                           name="Password"
                                           class="form-control"
                                           placeholder="Mật khẩu" />

                                </div>

                                <!-- OPTIONS -->
                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="rememberStudent">

                                        <label class="form-check-label"
                                               for="rememberStudent">

                                            Nhớ đăng nhập

                                        </label>

                                    </div>

                                    <a href="#"
                                       class="forgot-link">

                                        Quên mật khẩu?

                                    </a>

                                </div>

                                <!-- BUTTON -->
                                <button type="submit"
                                        class="btn btn-login text-white w-100">

                                    Đăng nhập sinh viên

                                </button>

                            </form>

                        </div>

                        <!-- ================= ADMIN ================= -->
                        <div class="tab-pane fade"
                             id="admin-tab-pane"
                             role="tabpanel">

                            <form asp-action="AdminLogin"
                                  method="post">

                                <!-- USERNAME -->
                                <div class="mb-3">

                                    <input type="text"
                                           name="Username"
                                           class="form-control"
                                           placeholder="Tên đăng nhập admin" />

                                </div>

                                <!-- PASSWORD -->
                                <div class="mb-3">

                                    <input type="password"
                                           name="Password"
                                           class="form-control"
                                           placeholder="Mật khẩu admin" />

                                </div>

                                <!-- OPTIONS -->
                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="rememberAdmin">

                                        <label class="form-check-label"
                                               for="rememberAdmin">

                                            Nhớ đăng nhập

                                        </label>

                                    </div>

                                    <a href="#"
                                       class="forgot-link">

                                        Quên mật khẩu?

                                    </a>

                                </div>

                                <!-- BUTTON -->
                                <button type="submit"
                                        class="btn btn-dark w-100"
                                        style="height:52px; border-radius:8px;">

                                    Đăng nhập Admin

                                </button>

                            </form>

                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="bottom-link">

                        <a href="#">
                            QUẢN LÝ TÀI KHOẢN KÝ TÚC XÁ
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>