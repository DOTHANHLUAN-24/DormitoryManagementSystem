@model DormitoryManagement.Application.Dtos.Requests.LoginRequest

<form asp-action="Login" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="Username" placeholder="Tên đăng nhập" class="form-control" />
    <input asp-for="Password" type="password" placeholder="Mật khẩu" class="form-control" />
    <button type="submit">Đăng nhập</button>
</form>