@model DormitoryManagement.Application.Dtos.Requests.LoginRequest

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - DMS</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f8f9fa;
        }

        .left-side {
            height: 100vh;
            background-image: url('/images/dormitory.jpg');
            background-size: cover;
            background-position: center;
            position: relative;
        }

            .left-side::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(0,0,0,0.2);
            }

        .right-side {
            height: 100vh;
            background: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            border-left: 1px solid #ddd;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
            padding: 30px;
        }

        .logo-title {
            color: #006b73;
            font-size: 50px;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 5px;
        }

        .logo-sub {
            color: #f58220;
            font-weight: 700;
            letter-spacing: 1.5px;
            font-size: 14px;
        }

        .description {
            margin-top: 15px;
            margin-bottom: 30px;
            color: #666;
            font-size: 15px;
        }

        /* Tab Styling */
        .nav-tabs {
            border-bottom: 2px solid #eee;
            margin-bottom: 25px;
        }

            .nav-tabs .nav-link {
                color: #777;
                font-weight: 500;
                border: none;
                padding: 10px 20px;
            }

                .nav-tabs .nav-link.active {
                    color: #006b73;
                    font-weight: 700;
                    border-bottom: 3px solid #006b73;
                    background: transparent;
                }

        .form-control {
            height: 50px;
            border-radius: 8px;
            font-size: 15px;
            border: 1px solid #ced4da;
        }

            .form-control:focus {
                border-color: #006b73;
                box-shadow: 0 0 0 0.2rem rgba(0, 107, 115, 0.1);
            }

        .btn-login {
            height: 50px;
            background: #006b73;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-login:hover {
                background: #00545b;
                transform: translateY(-1px);
            }

        .btn-google {
            height: 50px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #fff;
            border: 1px solid #dadce0;
            color: #3c4043;
            transition: 0.2s;
        }

            .btn-google:hover {
                background: #f7f8f8;
                border-color: #d2d2d2;
            }

            .btn-google img {
                width: 20px;
            }

        .forgot-link {
            text-decoration: none;
            color: #006b73;
            font-size: 14px;
            font-weight: 500;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .bottom-link {
            margin-top: 40px;
            text-align: center;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

            .bottom-link a {
                color: #888;
                text-decoration: none;
                font-size: 13px;
            }
    </style>
</head>
<body>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- LEFT IMAGE -->
            <div class="col-lg-8 d-none d-lg-block left-side"></div>

            <!-- RIGHT LOGIN -->
            <div class="col-lg-4 right-side">
                <div class="login-box">
                    <div class="text-center">
                        <div class="logo-title">DMS</div>
                        <div class="logo-sub">DORMITORY MANAGEMENT</div>
                        <div class="description">Chào mừng bạn quay trở lại!</div>
                    </div>

                    <!-- TABS SELECTION -->
                    <ul class="nav nav-tabs justify-content-center" id="loginTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="system-tab" data-bs-toggle="tab" data-bs-target="#system-pane" type="button" role="tab">Hệ thống</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="google-tab" data-bs-toggle="tab" data-bs-target="#google-pane" type="button" role="tab">Google</button>
                        </li>
                    </ul>

                    <!-- THÔNG BÁO LỖI -->
                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <div class="tab-content" id="loginTabContent">

                        <!-- FORM TÀI KHOẢN HỆ THỐNG -->
                        <div class="tab-pane fade show active" id="system-pane" role="tabpanel">
                            <form asp-action="Login" asp-controller="Account" method="post">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Tên đăng nhập / Email</label>
                                    <input asp-for="Username" class="form-control" placeholder="Nhập tài khoản của bạn" required />
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between">
                                        <label class="form-label small fw-bold">Mật khẩu</label>
                                        <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-link">Quên mật khẩu?</a>
                                    </div>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" required />
                                </div>

                                <div class="form-check mb-4">
                                    <input class="form-check-input" type="checkbox" id="rememberMe">
                                    <label class="form-check-label small" for="rememberMe">Duy trì đăng nhập</label>
                                </div>

                                <button type="submit" class="btn btn-login text-white w-100">ĐĂNG NHẬP</button>
                            </form>
                        </div>

                        <!-- FORM GOOGLE -->
                        <div class="tab-pane fade" id="google-pane" role="tabpanel">
                            <div class="text-center py-4">
                                <p class="text-muted small mb-4">Sử dụng tài khoản Google của trường hoặc cá nhân để truy cập nhanh.</p>

                                <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                                    <button type="submit" name="provider" value="Google" class="btn btn-google w-100">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_Logo.svg" alt="Google">
                                        Đăng nhập với Google
                                    </button>
                                </form>

                                <div class="mt-4 p-3 bg-light rounded" style="font-size: 13px; color: #666;">
                                    <i class="bi bi-info-circle me-1"></i> Lưu ý: Email Google phải được đăng ký sẵn trên hệ thống.
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="bottom-link">
                        <a href="#">HỆ THỐNG QUẢN LÝ KÝ TÚC XÁ v1.0.2</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Script hỗ trợ Validation phía Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>