@{
    ViewData["Title"] = "Thành công";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thành công | DMS</title>

    <!-- Bootstrap 5 & Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary-color: #006b73;
            --success-color: #28a745;
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        body {
            background: var(--bg-gradient);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            margin: 0;
        }

        .success-container {
            width: 100%;
            max-width: 450px;
            padding: 15px;
        }

        .success-box {
            background: #ffffff;
            padding: 50px 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            text-align: center;
            animation: slideUp 0.6s ease-out;
        }

        /* Hiệu ứng vòng tròn checkmark */
        .success-checkmark {
            width: 100px;
            height: 100px;
            background: rgba(40, 167, 69, 0.1);
            color: var(--success-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            margin: 0 auto 30px;
            animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .brand-name {
            color: var(--primary-color);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 5px;
        }

        h3 {
            font-weight: 700;
            color: #2d3436;
            margin-bottom: 15px;
        }

        .text-muted {
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 35px;
        }

        .btn-success {
            background-color: var(--primary-color);
            border: none;
            height: 50px;
            border-radius: 10px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 30px;
            transition: all 0.3s;
            color: white;
            text-decoration: none;
            width: 100%;
        }

            .btn-success:hover {
                background-color: #00545b;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 107, 115, 0.3);
                color: white;
            }

        /* Animations */
        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes scaleIn {
            from {
                transform: scale(0);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
</head>
<body>

    <div class="success-container">
        <div class="success-box">
            <div class="success-checkmark">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <h2 class="brand-name">DMS</h2>
            <h3>Thành công!</h3>
            <p class="text-muted">
                Mật khẩu của bạn đã được cập nhật thành công. <br>
                Bây giờ bạn có thể truy cập vào hệ thống bằng mật khẩu mới.
            </p>

            <a href="@Url.Action("Login", "Account")" class="btn btn-success">
                <i class="bi bi-box-arrow-in-right me-2"></i> ĐĂNG NHẬP NGAY
            </a>
        </div>

        <p class="text-center mt-4 text-muted small">
            &copy; @DateTime.Now.Year - Hệ thống Quản lý Ký túc xá (DMS)
        </p>
    </div>

</body>
</html>