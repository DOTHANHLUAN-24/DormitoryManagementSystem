@{
    ViewData["Title"] = "Thành công";
    Layout = "_AuthLayout";
}

@section Styles {
    <style>
        .success-container {
            width: 100%;
            max-width: 460px;
            margin: 40px auto;
        }

        .success-box {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            padding: 50px 40px;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .success-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.3);
        }

        .success-checkmark {
            width: 100px;
            height: 100px;
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            margin: 0 auto 30px;
        }

        .brand-name {
            color: #006b73;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .btn-success {
            background: linear-gradient(135deg, #006b73 0%, #00545b 100%);
            border: none;
            height: 50px;
            border-radius: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 30px;
            transition: all 0.3s;
            color: white;
            text-decoration: none;
            width: 100%;
            box-shadow: 0 4px 15px rgba(0, 107, 115, 0.3);
        }

        .btn-success:hover {
            background: linear-gradient(135deg, #00545b 0%, #003d42 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 107, 115, 0.4);
            color: white;
        }
    </style>
}

<div class="success-container">
    <div class="success-box">
        <div class="success-checkmark">
            <i class="fas fa-check-circle"></i>
        </div>

        <h2 class="brand-name">DMS</h2>
        <h3 class="fw-bold mb-3">Thành công!</h3>
        <p class="text-muted small mb-4">
            Mật khẩu của bạn đã được cập nhật thành công. <br>
            Bây giờ bạn có thể truy cập vào hệ thống bằng mật khẩu mới.
        </p>

        <a href="@Url.Action("Login", "Account")" class="btn btn-success">
            <i class="fas fa-sign-in-alt me-2"></i> ĐĂNG NHẬP NGAY
        </a>
    </div>
</div>