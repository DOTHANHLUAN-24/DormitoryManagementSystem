@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses.Assets
@model PagedResult<AssetResponse>

@{
    ViewData["Title"] = "Thùng rác Tài sản";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #ef4444); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; }
        .btn-header-back { background: white; color: #64748b !important; border: 1px solid #e2e8f0; text-decoration: none; }
        .btn-header-back:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); color: #1e293b !important; background: #f8fafc; }
        .card-custom { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: none; overflow: hidden; }
        .badge-code { background: #fff1f2; color: #be185d; padding: 5px 10px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; border: 1px solid #fecdd3; }
        .nut-hanh-dong { width: 34px; height: 34px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; border: none; transition: all 0.2s; cursor: pointer; }
        .nut-khoi-phuc { background: #ecfdf5; color: #10b981; }
        .nut-xoa-vinh-vien { background: #fef2f2; color: #ef4444; }
        .nut-hanh-dong:hover { transform: scale(1.12); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="tieu-de-trang mb-1"><i class="fas fa-trash-alt me-2 text-danger"></i>Thùng rác Tài sản</h1>
            <p class="text-muted small mb-0 ms-1 fw-medium">Danh sách tài sản đã bị xóa tạm thời — có thể khôi phục hoặc xóa vĩnh viễn.</p>
        </div>
        <a asp-action="Index" class="btn-custom-header btn-header-back">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </header>

    <div class="card card-custom mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Mã tài sản</th>
                        <th class="py-3">Tên tài sản</th>
                        <th class="py-3">Phòng / Tòa</th>
                        <th class="py-3">Giá đền bù</th>
                        <th class="py-3">Ngày xóa</th>
                        <th class="text-end pe-4 py-3">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="opacity-75">
                                <td class="ps-4 py-3"><span class="badge-code text-decoration-line-through">@item.AssetCode</span></td>
                                <td>
                                    <div class="fw-semibold text-dark text-decoration-line-through">@item.AssetName</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <small class="text-muted text-decoration-line-through">@item.Description</small>
                                    }
                                </td>
                                <td>
                                    <div class="text-decoration-line-through">@item.RoomNumber</div>
                                    <small class="text-muted text-decoration-line-through">@item.BlockName</small>
                                </td>
                                <td>
                                    @if (item.ReplacementCost > 0)
                                    {
                                        <span class="fw-bold text-primary text-decoration-line-through">@item.ReplacementCost.ToString("N0") ₫</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small text-decoration-line-through">
                                        <i class="far fa-clock me-1"></i>@(item.LastModified?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button onclick="restoreAsset('@item.Id', '@item.AssetName')" class="nut-hanh-dong nut-khoi-phuc" title="Khôi phục">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button onclick="deleteAssetPermanently('@item.Id', '@item.AssetName')" class="nut-hanh-dong nut-xoa-vinh-vien" title="Xóa vĩnh viễn">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
                                    <p class="mb-0 fw-medium">Thùng rác đang trống.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        function getAntiforgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function restoreAsset(id, assetName) {
            Swal.fire({
                title: 'Khôi phục tài sản?',
                html: 'Tài sản <b>' + assetName + '</b> sẽ quay lại danh sách hoạt động.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-undo me-1"></i> Đồng ý',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    $.ajax({
                        url: '/Asset/Restore/' + id,
                        type: 'POST',
                        headers: { 'RequestVerificationToken': getAntiforgeryToken() },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Thành công!', text: res.message, timer: 1500, showConfirmButton: false })
                                    .then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message });
                            }
                        },
                        error: function () { Swal.fire({ icon: 'error', title: 'Lỗi hệ thống', text: 'Không thể kết nối máy chủ.' }); }
                    });
                }
            });
        }

        function deleteAssetPermanently(id, assetName) {
            Swal.fire({
                title: 'Xóa vĩnh viễn?',
                html: 'Tài sản <b>' + assetName + '</b> sẽ bị xóa hoàn toàn.<br/><span class="text-danger small">Hành động này không thể hoàn tác!</span>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-trash me-1"></i> Xóa vĩnh viễn',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    $.ajax({
                        url: '/Asset/DeletePermanently/' + id,
                        type: 'POST',
                        headers: { 'RequestVerificationToken': getAntiforgeryToken() },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Đã xóa!', text: res.message, timer: 1500, showConfirmButton: false })
                                    .then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message });
                            }
                        },
                        error: function () { Swal.fire({ icon: 'error', title: 'Lỗi hệ thống', text: 'Không thể kết nối máy chủ.' }); }
                    });
                }
            });
        }
    </script>
}
