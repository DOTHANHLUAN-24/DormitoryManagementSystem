@using DormitoryManagement.Application.Dtos.Responses.Assets
@model AssetResponse

@{
    ViewData["Title"] = $"Chi tiết Tài sản - {Model.AssetName}";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 24px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #0ea5e9); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .detail-card { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: none; }
        .detail-header { background: linear-gradient(135deg, #0f172a, #1e40af); border-radius: 20px 20px 0 0; padding: 28px 32px; }
        .asset-code-large { font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; color: #93c5fd; background: rgba(147,197,253,0.1); padding: 6px 14px; border-radius: 8px; border: 1px solid rgba(147,197,253,0.2); display: inline-block; }
        .asset-title { font-size: 1.8rem; font-weight: 800; color: white; margin: 10px 0 4px; }
        .asset-subtitle { color: #94a3b8; font-size: 14px; }
        .info-section { padding: 28px 32px; }
        .info-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; margin-bottom: 4px; }
        .info-value { font-size: 15px; font-weight: 600; color: #1e293b; }
        .info-value.muted { color: #64748b; font-weight: 400; font-size: 14px; }
        .status-pill { padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
        .status-good    { background: #ecfdf5; color: #059669; }
        .status-broken  { background: #fef2f2; color: #dc2626; }
        .status-repair  { background: #fffbeb; color: #d97706; }
        .status-lost    { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }
        .price-highlight { background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 16px; padding: 20px 24px; text-align: center; }
        .price-big { font-size: 2rem; font-weight: 800; color: #1d4ed8; }
        .price-label { font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
        .btn-action { height: 42px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; padding: 0 20px; transition: all 0.2s; text-decoration: none; border: none; }
        .btn-edit { background: #eff6ff; color: #2563eb; }
        .btn-edit:hover { background: #dbeafe; color: #1d4ed8; transform: translateY(-1px); }
        .btn-delete { background: #fef2f2; color: #dc2626; cursor: pointer; }
        .btn-delete:hover { background: #fee2e2; color: #b91c1c; transform: translateY(-1px); }
        .btn-back { background: white; color: #64748b; border: 1px solid #e2e8f0; }
        .btn-back:hover { background: #f8fafc; color: #1e293b; transform: translateY(-1px); }
        .divider { height: 1px; background: #f1f5f9; margin: 0 32px; }
    </style>
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="Index" class="btn-action btn-back">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-box me-2"></i>Chi tiết Tài sản</h1>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="detail-card">
                <!-- Header màu -->
                <div class="detail-header">
                    <span class="asset-code-large">@Model.AssetCode</span>
                    <div class="asset-title">@Model.AssetName</div>
                    <div class="asset-subtitle">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <em>Chưa có mô tả</em>
                        }
                    </div>
                </div>

                <!-- Thông tin chi tiết -->
                <div class="info-section">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-label">Phòng lắp đặt</div>
                            <div class="info-value"><i class="fas fa-door-open me-2 text-muted"></i>@Model.RoomNumber</div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">Tòa nhà</div>
                            <div class="info-value"><i class="fas fa-building me-2 text-muted"></i>@Model.BlockName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">Trạng thái</div>
                            @{
                                var statusClass = Model.Status switch {
                                    "Good" => "status-good",
                                    "Broken" => "status-broken",
                                    "UnderRepair" => "status-repair",
                                    "Lost" => "status-lost",
                                    _ => "status-lost"
                                };
                                var statusIcon = Model.Status switch {
                                    "Good" => "fas fa-check-circle",
                                    "Broken" => "fas fa-times-circle",
                                    "UnderRepair" => "fas fa-tools",
                                    "Lost" => "fas fa-question-circle",
                                    _ => "fas fa-circle"
                                };
                                var statusLabel = Model.Status switch {
                                    "Good" => "Tốt / Hoạt động",
                                    "Broken" => "Hỏng",
                                    "UnderRepair" => "Đang sửa chữa",
                                    "Lost" => "Mất / Thất lạc",
                                    _ => Model.Status
                                };
                            }
                            <span class="status-pill @statusClass">
                                <i class="@statusIcon"></i> @statusLabel
                            </span>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">Trạng thái kích hoạt</div>
                            <div class="info-value">
                                @if (Model.IsActive)
                                {
                                    <span class="text-success"><i class="fas fa-check-circle me-1"></i>Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fas fa-pause-circle me-1"></i>Đã vô hiệu hóa</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">Ngày nhập kho</div>
                            <div class="info-value muted"><i class="fas fa-calendar-plus me-2 text-muted"></i>@Model.CreatedDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">Cập nhật lần cuối</div>
                            <div class="info-value muted"><i class="fas fa-history me-2 text-muted"></i>@(Model.LastModified?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</div>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Nút hành động -->
                <div class="info-section d-flex gap-3">
                    @if (User.IsInRole("Admin") || User.IsInRole("ManagementStaff"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-action btn-edit">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                        <button onclick="softDeleteFromDetail('@Model.Id', '@Model.AssetName')" class="btn-action btn-delete">
                            <i class="fas fa-trash"></i> Đưa vào thùng rác
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Panel phải: Giá đền bù -->
        <div class="col-lg-4">
            <div class="detail-card p-4">
                <h6 class="fw-bold mb-3 text-dark"><i class="fas fa-receipt me-2 text-primary"></i>Giá trị đền bù</h6>
                <div class="price-highlight mb-4">
                    <div class="price-label">Mức bồi thường khi hỏng/mất</div>
                    @if (Model.ReplacementCost > 0)
                    {
                        <div class="price-big">@Model.ReplacementCost.ToString("N0") ₫</div>
                        <small class="text-muted">Áp dụng theo quy định KTX</small>
                    }
                    else
                    {
                        <div class="price-big" style="font-size: 1.2rem; color: #94a3b8;">Chưa cập nhật</div>
                        <small class="text-muted">Liên hệ ban quản lý</small>
                    }
                </div>

                @if (Model.Status == "Broken" || Model.Status == "Lost")
                {
                    <div class="alert alert-danger rounded-3 d-flex gap-2 py-3">
                        <i class="fas fa-exclamation-triangle mt-1"></i>
                        <div>
                            <strong>Tài sản đang bị @(Model.Status == "Broken" ? "hỏng" : "mất")</strong>
                            <p class="mb-0 small">Sinh viên phụ trách cần liên hệ ban quản lý để xử lý.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function getAntiforgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }
        function softDeleteFromDetail(id, assetName) {
            Swal.fire({
                title: 'Đưa vào thùng rác?',
                html: 'Tài sản <b>' + assetName + '</b> sẽ bị vô hiệu hóa tạm thời.',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#ef4444', cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-trash me-1"></i> Đồng ý', cancelButtonText: 'Hủy', reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    $.ajax({
                        url: '/Asset/SoftDelete/' + id, type: 'POST',
                        headers: { 'RequestVerificationToken': getAntiforgeryToken() },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({ icon: 'success', title: 'Thành công', text: data.message, timer: 1500, showConfirmButton: false })
                                    .then(() => window.location.href = '/Asset');
                            } else { Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message }); }
                        }
                    });
                }
            });
        }
    </script>
}
