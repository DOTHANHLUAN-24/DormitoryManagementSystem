@using DormitoryManagement.Application.Dtos.Requests.Assets
@model CreateAssetRequest

@{
    ViewData["Title"] = "Thêm tài sản mới";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 24px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #0ea5e9); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .form-card { border-radius: 20px; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: none; overflow: hidden; }
        .form-card-header { background: linear-gradient(135deg, #f0f9ff, #e0f2fe); padding: 24px 28px; border-bottom: 1px solid #e0f2fe; }
        .form-card-body { padding: 28px; }
        .form-label-custom { font-size: 13px; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em; }
        .form-control-custom, .form-select-custom { border-radius: 12px; border: 1px solid #e2e8f0; height: 46px; font-size: 14px; background: #f8fafc; transition: all 0.2s; }
        .form-control-custom:focus, .form-select-custom:focus { border-color: #0ea5e9; box-shadow: 0 0 0 4px rgba(14,165,233,0.1); background: #fff; }
        textarea.form-control-custom { height: auto; }
        .section-divider { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; margin: 24px 0 16px; display: flex; align-items: center; gap: 10px; }
        .section-divider::before, .section-divider::after { content: ''; flex: 1; height: 1px; background: #f1f5f9; }
        .btn-save { height: 46px; border-radius: 12px; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; border: none; font-weight: 700; padding: 0 28px; transition: all 0.2s; }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(14,165,233,0.35); color: white; }
        .btn-cancel { height: 46px; border-radius: 12px; background: white; color: #64748b; border: 1px solid #e2e8f0; font-weight: 600; padding: 0 24px; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; }
        .btn-cancel:hover { background: #f8fafc; color: #1e293b; transform: translateY(-1px); }
        .price-hint { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 12px; margin-top: 8px; font-size: 12px; color: #0369a1; }
    </style>
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="Index" class="btn-cancel"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-plus-circle me-2"></i>Thêm tài sản mới</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#0ea5e9,#0284c7);display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-box text-white fa-lg"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size:16px;">Điền thông tin tài sản</div>
                            <div class="text-muted small">Tất cả trường có dấu * là bắt buộc</div>
                        </div>
                    </div>
                </div>

                <div class="form-card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4 small"></div>

                        <!-- Thông tin cơ bản -->
                        <div class="section-divider">Thông tin cơ bản</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AssetCode" class="form-label-custom">Mã tài sản *</label>
                                <input asp-for="AssetCode" class="form-control form-control-custom" placeholder="Ví dụ: AC-A101-01" />
                                <span asp-validation-for="AssetCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AssetName" class="form-label-custom">Tên tài sản *</label>
                                <input asp-for="AssetName" class="form-control form-control-custom" placeholder="Ví dụ: Điều hòa Daikin 12000BTU" />
                                <span asp-validation-for="AssetName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label-custom">Mô tả</label>
                                <textarea asp-for="Description" class="form-control form-control-custom" rows="2"
                                          placeholder="Mô tả ngắn về tài sản, đặc điểm nhận dạng..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Vị trí & Trạng thái -->
                        <div class="section-divider">Vị trí & Trạng thái</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="RoomId" class="form-label-custom">Phòng lắp đặt *</label>
                                <select asp-for="RoomId" class="form-select form-select-custom" asp-items="ViewBag.Rooms">
                                    <option value="">-- Chọn phòng --</option>
                                </select>
                                <span asp-validation-for="RoomId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label-custom">Trạng thái *</label>
                                <select asp-for="Status" class="form-select form-select-custom">
                                    <option value="Good">✅ Tốt / Hoạt động bình thường</option>
                                    <option value="Broken">❌ Hỏng</option>
                                    <option value="UnderRepair">🔧 Đang sửa chữa</option>
                                    <option value="Lost">📦 Mất / Thất lạc</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Giá đền bù -->
                        <div class="section-divider">Bảng giá đền bù</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ReplacementCost" class="form-label-custom">Giá trị đền bù (VNĐ)</label>
                                <div class="input-group">
                                    <input asp-for="ReplacementCost" type="number" min="0" step="10000"
                                           class="form-control form-control-custom border-end-0" placeholder="0"
                                           style="border-radius: 12px 0 0 12px;" />
                                    <span class="input-group-text bg-white fw-bold text-muted"
                                          style="border-radius: 0 12px 12px 0; border: 1px solid #e2e8f0; border-left: none;">₫</span>
                                </div>
                                <span asp-validation-for="ReplacementCost" class="text-danger small"></span>
                                <div class="price-hint mt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Mức bồi thường sinh viên phải trả khi làm hỏng hoặc mất tài sản này. Nhập 0 nếu chưa xác định.
                                </div>
                            </div>
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn-cancel">
                                <i class="fas fa-times me-2"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn-save">
                                <i class="fas fa-save me-2"></i>Lưu tài sản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
