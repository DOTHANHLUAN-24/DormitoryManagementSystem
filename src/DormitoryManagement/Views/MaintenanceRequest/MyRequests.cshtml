@model IEnumerable<DormitoryManagement.Application.Dtos.Responses.MaintenanceRequests.MaintenanceRequestResponseDto>

@{
    ViewData["Title"] = "Yêu cầu bảo trì của tôi";
}

@section Styles {
    <style>
        .tieu-de-trang { font-size: 26px; font-weight: 700; background: linear-gradient(135deg, #1e293b, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .btn-custom-header { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; }
        .btn-add { background: #4f46e5; color: white !important; border: none; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); }
        .btn-add:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.1); }

        .trang-thai { padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
        .open { background: #e0f2fe; color: #0284c7; }
        .in-progress { background: #fff7ed; color: #f97316; }
        .resolved { background: #ecfdf5; color: #10b981; }
        .closed { background: #f1f5f9; color: #64748b; }
        
        .priority-high { color: #ef4444; font-weight: bold; }
        .priority-medium { color: #f59e0b; font-weight: bold; }
        .priority-low { color: #10b981; }
    </style>
}

<div class="container-fluid">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang mb-0"><i class="fas fa-tools me-2"></i>Lịch sử yêu cầu sửa chữa</h1>
        <a asp-action="Create" class="btn-custom-header btn-add text-decoration-none">
            <i class="fas fa-plus"></i> Gửi yêu cầu mới
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tiêu đề</th>
                        <th>Phòng</th>
                        <th>Mức độ</th>
                        <th>Trạng thái</th>
                        <th>Ngày gửi</th>
                        <th>Người xử lý</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">@item.RoomNumber</div>
                                    <div class="small text-muted">@item.BlockName</div>
                                </td>
                                <td>
                                    @if (item.Priority == "High" || item.Priority == "Urgent")
                                    {
                                        <span class="priority-high"><i class="fas fa-exclamation-triangle me-1"></i>@item.Priority</span>
                                    }
                                    else if (item.Priority == "Medium")
                                    {
                                        <span class="priority-medium">@item.Priority</span>
                                    }
                                    else
                                    {
                                        <span class="priority-low">@item.Priority</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Open": <span class="trang-thai open">Mới</span> break;
                                        case "InProgress": <span class="trang-thai in-progress">Đang xử lý</span> break;
                                        case "Resolved": <span class="trang-thai resolved">Đã xử lý</span> break;
                                        case "Closed": <span class="trang-thai closed">Đã đóng</span> break;
                                        default: <span class="trang-thai">@item.Status</span> break;
                                    }
                                </td>
                                <td>
                                    <div class="small">@item.CreatedDate.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@item.CreatedDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.HandlerName))
                                    {
                                        <span class="badge bg-secondary">@item.HandlerName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa phân công</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">Bạn chưa có yêu cầu sửa chữa nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
