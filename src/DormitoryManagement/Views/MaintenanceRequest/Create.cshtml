@using DormitoryManagement.Domain.Enums
@model DormitoryManagement.Application.Dtos.Requests.MaintenanceRequests.CreateMaintenanceRequestDto

@{
    ViewData["Title"] = "Báo cáo sự cố sửa chữa";
}

@section Styles {
    <style>
        .tieu-de-trang { 
            font-size: 28px; 
            font-weight: 700; 
            background: linear-gradient(135deg, #1e293b, #4f46e5); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            margin-bottom: 0; 
        }
        
        .form-card { 
            background: #fff; 
            border-radius: 20px; 
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); 
            padding: 30px; 
            border: none; 
        }
        
        .form-control, .form-select { 
            border-radius: 10px; 
            padding: 12px 16px; 
            border: 1px solid #e2e8f0; 
            font-size: 14px; 
            transition: all 0.3s; 
        }
        .form-control:focus, .form-select:focus { 
            border-color: #4f46e5; 
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); 
        }
        
        .input-group-text { 
            border-radius: 10px 0 0 10px; 
            border: 1px solid #e2e8f0; 
            border-right: none; 
            background-color: #f8fafc; 
            color: #64748b; 
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
        }
        .input-group .form-control, .input-group .form-select { 
            border-radius: 0 10px 10px 0; 
        }
        
        .form-label { 
            font-weight: 600; 
            color: #1e293b; 
            margin-bottom: 8px; 
            font-size: 14px; 
        }
        
        .nut-luu { 
            padding: 12px 24px; 
            border-radius: 10px; 
            font-weight: 600; 
            transition: all 0.3s ease; 
            font-size: 15px; 
            display: inline-flex; 
            align-items: center; 
            gap: 8px; 
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); 
            color: #fff !important; 
            border: none; 
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); 
            cursor: pointer;
        }
        .nut-luu:hover { 
            background: #4338ca; 
            transform: translateY(-2px); 
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); 
        }
        
        .nut-huy { 
            padding: 12px 24px; 
            border-radius: 10px; 
            font-weight: 600; 
            transition: all 0.3s ease; 
            font-size: 15px; 
            display: inline-flex; 
            align-items: center; 
            gap: 8px; 
            text-decoration: none; 
            background: #fff; 
            color: #64748b !important; 
            border: 1px solid #e2e8f0; 
        }
        .nut-huy:hover { 
            background: #f8fafc; 
            color: #1e293b !important; 
            border-color: #cbd5e1; 
            transform: translateY(-1px); 
        }

        .nut-quay-lai { 
            padding: 10px 20px; 
            border-radius: 10px; 
            font-weight: 600; 
            transition: all 0.3s ease; 
            font-size: 14px; 
            display: inline-flex; 
            align-items: center; 
            gap: 8px; 
            text-decoration: none; 
            background: #fff; 
            color: #64748b !important; 
            border: 1px solid #e2e8f0; 
        }
        .nut-quay-lai:hover { 
            background: #f8fafc; 
            color: #1e293b !important; 
            border-color: #cbd5e1; 
            transform: translateY(-1px); 
        }

        .priority-option { 
            border: 2px solid #e2e8f0; 
            border-radius: 10px; 
            padding: 10px 14px; 
            cursor: pointer; 
            transition: all 0.2s; 
            display: flex; 
            align-items: center; 
            gap: 10px; 
        }
        .priority-option:hover { 
            border-color: #c7d2fe; 
            background: #f5f3ff; 
        }
        .priority-option.selected { 
            border-color: #4f46e5; 
            background: #eef2ff; 
        }
        .priority-dot { 
            width: 10px; 
            height: 10px; 
            border-radius: 50%; 
            flex-shrink: 0; 
        }
        .dot-low { background: #22c55e; }
        .dot-medium { background: #f59e0b; }
        .dot-high { background: #f97316; }
        .dot-urgent { background: #ef4444; }

        .char-count { font-size: 11px; color: #94a3b8; text-align: right; }
        .info-box { background: #fef9c3; border: 1px solid #fde68a; border-radius: 10px; padding: 10px 14px; font-size: 13px; color: #92400e; display: flex; align-items: flex-start; gap: 8px; }
        .disabled-look { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 16px; font-size: 14px; }
    </style>
}

<div class="container-fluid py-4">
    <!-- Header -->
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="tieu-de-trang">
            <i class="fas fa-plus-circle me-2 text-primary"></i> Báo cáo sự cố sửa chữa
        </h1>
        <div class="d-flex gap-2">
            @if (ViewBag.IsAdminOrStaff == true)
            {
                <a asp-action="Index" class="nut-quay-lai text-decoration-none">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            }
            else
            {
                <a asp-action="MyRequests" class="nut-quay-lai text-decoration-none">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            }
        </div>
    </header>

    <div class="row">
        <!-- Form Column -->
        <div class="col-lg-8">
            <div class="form-card">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-4 mb-4">
                        <!-- Chọn phòng (Admin/Staff) hoặc hiển thị phòng hiện tại (Student) -->
                        <div class="col-md-12">
                            @if (ViewBag.IsAdminOrStaff == true)
                            {
                                <label asp-for="RoomId" class="form-label">Chọn phòng phát sinh sự cố <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-door-open"></i></span>
                                    <select asp-for="RoomId" class="form-select" required>
                                        <option value="">-- Chọn phòng --</option>
                                        @if (ViewBag.Rooms != null)
                                        {
                                            foreach (var room in ViewBag.Rooms)
                                            {
                                                <option value="@room.Id">@room.RoomNumber (@(room.Block?.BlockName ?? "N/A"))</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="RoomId" class="text-danger small mt-1 d-block"></span>
                            }
                            else
                            {
                                <input type="hidden" asp-for="RoomId" />
                                <label class="form-label">Phòng hiện tại của bạn</label>
                                <div class="disabled-look d-flex align-items-center gap-2">
                                    <i class="fas fa-map-marker-alt text-primary opacity-60"></i>
                                    <span class="fw-semibold">@ViewBag.RoomNumber</span>
                                    <span class="text-muted small">(hợp đồng hiện tại của bạn)</span>
                                </div>
                                <div class="info-box mt-2">
                                    <i class="fas fa-info-circle mt-1" style="flex-shrink:0;"></i>
                                    <span>Nếu đây không phải phòng của bạn, vui lòng liên hệ <strong>Ban quản lý</strong> để kiểm tra hợp đồng.</span>
                                </div>
                            }
                        </div>

                        <!-- Tiêu đề sự cố -->
                        <div class="col-md-12">
                            <label asp-for="Title" class="form-label">Tiêu đề sự cố <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-heading"></i></span>
                                <input asp-for="Title" class="form-control" 
                                       placeholder="Ví dụ: Đèn nhấp nháy, điều hòa chảy nước, mất nước..."
                                       maxlength="200" id="titleInput" required />
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span asp-validation-for="Title" class="text-danger small"></span>
                                <span class="char-count" id="titleCount">0/200</span>
                            </div>
                        </div>

                        <!-- Mức độ ưu tiên -->
                        <div class="col-md-12">
                            <label class="form-label">Mức độ ưu tiên <span class="text-danger">*</span></label>
                            <input type="hidden" asp-for="Priority" id="priorityValue" />
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <label class="priority-option w-100" id="opt-Low" onclick="selectPriority('Low')">
                                        <span class="priority-dot dot-low"></span>
                                        <div>
                                            <div class="fw-semibold" style="font-size:13px;">Thấp</div>
                                            <div class="text-muted" style="font-size:10px;">Có thể chờ</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="priority-option w-100 selected" id="opt-Medium" onclick="selectPriority('Medium')">
                                        <span class="priority-dot dot-medium"></span>
                                        <div>
                                            <div class="fw-semibold" style="font-size:13px;">Trung bình</div>
                                            <div class="text-muted" style="font-size:10px;">Nên sửa sớm</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="priority-option w-100" id="opt-High" onclick="selectPriority('High')">
                                        <span class="priority-dot dot-high"></span>
                                        <div>
                                            <div class="fw-semibold" style="font-size:13px;">Cao</div>
                                            <div class="text-muted" style="font-size:10px;">Ảnh hưởng sinh hoạt</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="priority-option w-100" id="opt-Urgent" onclick="selectPriority('Urgent')">
                                        <span class="priority-dot dot-urgent"></span>
                                        <div>
                                            <div class="fw-semibold" style="font-size:13px;">Khẩn cấp</div>
                                            <div class="text-muted" style="font-size:10px;">Nguy hiểm, cháy nổ...</div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Priority" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Mô tả chi tiết -->
                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label">Mô tả chi tiết sự cố <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="5"
                                      maxlength="2000" id="descInput" required
                                      placeholder="Hãy mô tả rõ vị trí sự cố, biểu hiện lỗi, thời điểm xảy ra..."></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <span asp-validation-for="Description" class="text-danger small"></span>
                                <span class="char-count" id="descCount">0/2000</span>
                            </div>
                        </div>

                        <!-- Ghi chú thêm -->
                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label">Ghi chú thêm (nếu có)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-sticky-note"></i></span>
                                <textarea asp-for="Notes" class="form-control" rows="3"
                                          maxlength="500" id="notesInput"
                                          placeholder="Ghi chú thêm về thời gian rảnh có thể sửa chữa, hoặc các lưu ý khác..."></textarea>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                                <span class="char-count" id="notesCount">0/500</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" style="opacity: 0.1;" />

                    <div class="d-flex gap-3 justify-content-end">
                        @if (ViewBag.IsAdminOrStaff == true)
                        {
                            <a asp-action="Index" class="nut-huy">Hủy bỏ</a>
                        }
                        else
                        {
                            <a asp-action="MyRequests" class="nut-huy">Hủy bỏ</a>
                        }
                        <button type="submit" class="nut-luu" id="submitBtn">
                            <i class="fas fa-paper-plane"></i> Gửi yêu cầu
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Info Column -->
        <div class="col-lg-4 d-none d-lg-block">
            <div class="card border-0 shadow-sm rounded-4 bg-primary bg-opacity-10 p-4 h-100">
                <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-info-circle me-2"></i> Hướng dẫn gửi yêu cầu</h5>
                <ul class="text-muted small ps-3 mb-0" style="line-height: 1.8; list-style-type: decimal;">
                    <li><strong>Mô tả chi tiết:</strong> Hãy mô tả chi tiết tình trạng lỗi (ví dụ: mất điện cả phòng, chỉ hỏng một ổ điện cạnh giường A...) để kỹ thuật viên chuẩn bị sẵn linh kiện thay thế.</li>
                    <li><strong>Mức độ ưu tiên:</strong> 
                        <ul>
                            <li><em>Thấp:</em> Các lỗi nhỏ không ảnh hưởng lớn (xước tường, cửa tủ lỏng...).</li>
                            <li><em>Trung bình / Cao:</em> Đèn hỏng, quạt không quay, mất mạng internet...</li>
                            <li><em>Khẩn cấp:</em> Rò rỉ điện, chập cháy, vỡ ống nước lớn ngập phòng...</li>
                        </ul>
                    </li>
                    <li><strong>Thời gian xử lý:</strong> Ban quản lý sẽ tiếp nhận và giao kỹ thuật viên liên hệ kiểm tra trong vòng 24h.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Priority selector
        function selectPriority(val) {
            ['Low','Medium','High','Urgent'].forEach(p => {
                document.getElementById('opt-' + p)?.classList.remove('selected');
            });
            document.getElementById('opt-' + val)?.classList.add('selected');
            document.getElementById('priorityValue').value = val;
        }

        // Initialize priority selection on load
        $(document).ready(function() {
            var modelPriority = '@Model.Priority.ToString()';
            selectPriority(modelPriority || 'Medium');
        });

        // Char counters
        function updateCount(inputId, countId) {
            var el = document.getElementById(inputId);
            var ct = document.getElementById(countId);
            if (!el || !ct) return;
            el.addEventListener('input', () => { ct.textContent = el.value.length + '/' + (el.maxLength || ''); });
            ct.textContent = el.value.length + '/' + (el.maxLength || '');
        }
        updateCount('titleInput', 'titleCount');
        updateCount('descInput', 'descCount');
        updateCount('notesInput', 'notesCount');

        // Loading spinner and disable submit on click
        $(document).ready(function () {
            $('form').submit(function (e) {
                if ($(this).valid()) { 
                    var btn = document.getElementById('submitBtn');
                    setTimeout(function() {
                        btn.disabled = true;
                    }, 0);
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang gửi yêu cầu...';
                }
            });
        });
    </script>
}
