@using DormitoryManagement.Domain.Enums
@model IEnumerable<DormitoryManagement.Domain.Entities.Contract>

@{
    ViewData["Title"] = "Hợp đồng của tôi";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        .my-contracts-container {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            min-height: 100vh;
            padding-bottom: 3rem;
        }

        /* Page Header */
        .tieu-de-trang { 
            font-size: 26px; 
            font-weight: 700; 
            background: linear-gradient(135deg, #1e293b, #4f46e5); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
        }

        .hero-banner {
            background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
            border-radius: 20px;
            padding: 2.5rem 2rem;
            color: #ffffff;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.2);
        }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
            pointer-events: none;
        }

        .hero-title {
            font-weight: 800;
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        .hero-subtitle {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.95rem;
            max-width: 600px;
            font-weight: 400;
        }

        /* Table Card Styling */
        .card-custom {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .card-header-custom {
            background: #ffffff;
            border-bottom: 1px solid #f1f5f9;
            padding: 1.25rem 1.5rem;
        }

        .card-title-custom {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-title-custom i {
            color: #4f46e5;
        }

        /* Table Aesthetics */
        .table-custom th {
            font-weight: 700;
            color: #64748b;
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 14px 16px;
        }

        .table-custom td {
            font-size: 0.9rem;
            color: #334155;
            padding: 16px;
            vertical-align: middle;
        }

        .table-custom tr {
            transition: background-color 0.15s ease;
        }

        .table-custom tr:hover {
            background-color: #f8fafc;
        }

        /* Status Badge Styling */
        .trang-thai { 
            padding: 6px 12px; 
            border-radius: 20px; 
            font-size: 11px; 
            font-weight: 700; 
            text-transform: uppercase; 
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .status-active { background: #ecfdf5; color: #10b981; }
        .status-pending { background: #fff7ed; color: #f97316; }
        .status-expired { background: #f1f5f9; color: #64748b; }
        .status-terminated { background: #fef2f2; color: #ef4444; }

        .ma-badge { 
            background: #f8fafc; 
            color: #1e293b; 
            padding: 6px 10px; 
            border-radius: 8px; 
            font-family: 'JetBrains Mono', monospace; 
            font-size: 13px; 
            font-weight: 600; 
            border: 1px solid #e2e8f0; 
        }

        .room-info-box {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .room-title {
            font-weight: 700;
            color: #0f172a;
        }

        .room-desc {
            font-size: 0.78rem;
            color: #64748b;
        }

        /* Empty State */
        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
        }

        .empty-icon {
            font-size: 3rem;
            color: #cbd5e1;
            margin-bottom: 1.25rem;
        }

        .btn-book-now {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); 
            color: white !important; 
            border: none; 
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); 
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
            margin-top: 1rem;
        }

        .btn-book-now:hover {
            transform: translateY(-2px); 
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3); 
        }
    </style>
}

<div class="my-contracts-container container-fluid p-4">
    <!-- Hero Banner -->
    <div class="hero-banner">
        <h1 class="hero-title">Hợp Đồng Thuê Phòng Của Tôi</h1>
        <p class="hero-subtitle">Tra cứu lịch sử đăng ký, thông tin phòng ở, thời hạn thuê, giá cọc và trạng thái xét duyệt yêu cầu của bạn.</p>
    </div>

    <!-- Contract List Card -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <h5 class="card-title-custom">
                <i class="fas fa-file-contract"></i> Lịch sử hợp đồng thuê phòng
            </h5>
        </div>
        
        <div class="table-responsive">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã Hợp Đồng</th>
                            <th>Phòng / Vị trí</th>
                            <th>Loại Phòng</th>
                            <th class="text-end">Tiền Cọc</th>
                            <th>Thời Hạn Thuê</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Đăng Ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="ma-badge">@item.ContractCode</span>
                                </td>
                                <td>
                                    <div class="room-info-box">
                                        <span class="room-title">
                                            Phòng @(item.Bed?.Room?.RoomNumber ?? "---")
                                        </span>
                                        <span class="room-desc">
                                            Giường @(item.Bed?.BedNumber ?? "---") • Tòa @(item.Bed?.Room?.Block?.BlockName ?? "---")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted fw-semibold">
                                        @(item.Bed?.Room?.RoomType?.TypeName ?? "---")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-indigo" style="color: #4f46e5;">
                                    @item.DepositAmount.ToString("N0") đ
                                </td>
                                <td>
                                    <div class="small">
                                        <div><span class="text-secondary fw-semibold">Từ:</span> @item.StartDate.ToString("dd/MM/yyyy")</div>
                                        <div><span class="text-secondary fw-semibold">Đến:</span> @item.EndDate.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="trang-thai @(item.Status switch {
                                        ContractStatus.Active => "status-active",
                                        ContractStatus.Pending => "status-pending",
                                        ContractStatus.Expired => "status-expired",
                                        ContractStatus.Terminated => "status-terminated",
                                        _ => "status-pending"
                                    })">
                                        @if (item.Status == ContractStatus.Active)
                                        {
                                            <i class="fas fa-check-circle"></i> <span>Đang hoạt động</span>
                                        }
                                        else if (item.Status == ContractStatus.Pending)
                                        {
                                            <i class="fas fa-clock"></i> <span>Chờ duyệt</span>
                                        }
                                        else if (item.Status == ContractStatus.Expired)
                                        {
                                            <i class="fas fa-history"></i> <span>Hết hạn</span>
                                        }
                                        else if (item.Status == ContractStatus.Terminated)
                                        {
                                            <i class="fas fa-ban"></i> <span>Đã chấm dứt</span>
                                        }
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-folder-open empty-icon"></i>
                    <h5 class="fw-bold text-secondary">Bạn chưa đăng ký hợp đồng nào</h5>
                    <p class="text-muted small">Hãy xem danh sách phòng và chọn phòng phù hợp để thực hiện đặt phòng trực tuyến.</p>
                    <a href="/Rooms" class="btn-book-now">
                        <i class="fas fa-door-open"></i> Xem danh sách phòng ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>
