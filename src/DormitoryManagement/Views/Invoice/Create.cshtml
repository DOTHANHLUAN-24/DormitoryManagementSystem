@{
    ViewData["Title"] = "Tạo Hóa Đơn Mới";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-thong-ke xanh-duong"
                             style="width: 48px; height: 48px; background: #eef2ff; color: #4f46e5; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <h3 class="mb-0 fw-bold text-dark">Tạo Hóa Đơn Mới</h3>
                    </div>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary shadow-sm d-flex align-items-center gap-2"
                       style="border-radius: 12px;">
                        <i class="fa-solid fa-house"></i> <span>Trang chủ</span>
                    </a>
                </div>
                <div class="card-body p-4">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Mã hóa đơn</label>
                                <input type="text" class="form-control" style="border-radius: 12px; height: 46px;"
                                       placeholder="Ví dụ: HD202405001" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Chọn hợp đồng / Sinh viên</label>
                                <select class="form-select" style="border-radius: 12px; height: 46px;" required>
                                    <option value="">-- Chọn sinh viên --</option>
                                    <option>SV001 - Nguyễn Văn A (P.101)</option>
                                    <option>SV002 - Trần Thị B (P.102)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Tiêu đề hóa đơn</label>
                                <input type="text" class="form-control" style="border-radius: 12px; height: 46px;"
                                       placeholder="Ví dụ: Hóa đơn tiền phòng và điện nước tháng 05/2024">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Tháng quyết toán</label>
                                <select class="form-select" style="border-radius: 12px; height: 46px;">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == DateTime.Now.Month)">Tháng @i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Năm</label>
                                <input type="number" class="form-control" style="border-radius: 12px; height: 46px;"
                                       value="@DateTime.Now.Year">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Hạn thanh toán</label>
                                <input type="date" class="form-control" style="border-radius: 12px; height: 46px;"
                                       required>
                            </div>

                            <hr class="my-4 text-muted opacity-25">
                            <h6 class="fw-bold mb-3">Chi tiết dịch vụ (Mock)</h6>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Tiền phòng</label>
                                <div class="input-group">
                                    <input type="number" class="form-control"
                                           style="border-top-left-radius: 12px; border-bottom-left-radius: 12px; height: 46px;"
                                           value="1500000">
                                    <span class="input-group-text"
                                          style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;">VNĐ</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Tiền điện/nước</label>
                                <div class="input-group">
                                    <input type="number" class="form-control"
                                           style="border-top-left-radius: 12px; border-bottom-left-radius: 12px; height: 46px;"
                                           placeholder="0">
                                    <span class="input-group-text"
                                          style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;">VNĐ</span>
                                </div>
                            </div>

                            <div class="col-12 mt-5 d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm"
                                        style="border-radius: 12px; height: 46px;">
                                    <i class="fa-solid fa-save me-2"></i> Lưu hóa đơn
                                </button>
                                <a asp-action="Index" class="btn btn-light border px-4 fw-bold"
                                   style="border-radius: 12px; height: 46px; display: flex; align-items: center;">
                                    Hủy bỏ
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>