@model DormitoryManagement.Domain.Entities.Invoice
@using DormitoryManagement.Domain.Enums
@{
    ViewData["Title"] = "Chỉnh Sửa Hóa Đơn";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 48px; height: 48px; background: #fff7ed; color: #f97316; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold text-dark">Chỉnh Sửa Hóa Đơn</h3>
                            <span class="text-muted small">Mã: @Model.InvoiceCode</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Invoice" asp-action="Index"
                           class="btn btn-outline-secondary shadow-sm d-flex align-items-center gap-2"
                           style="border-radius: 12px;">
                            <i class="fa-solid fa-house"></i> <span>Quay lại</span>
                        </a>
                        <span class="badge bg-warning text-dark px-3 py-2"
                              style="border-radius: 10px;">
                            @if (Model.Status == InvoiceStatus.Paid)
                            {
                                <text>Đã thanh toán</text>
                            }
                            else if (Model.Status == InvoiceStatus.Overdue)
                            {
                                <text>Quá hạn</text>
                            }
                            else if (Model.Status == InvoiceStatus.PartiallyPaid)
                            {
                                <text>Thanh toán một phần</text>
                            }
                            else
                            {
                                <text>Chưa thanh toán</text>
                            }
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <!-- Hidden Fields to maintain state -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="InvoiceCode" />
                        <input type="hidden" asp-for="ContractId" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="IsDeleted" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Title" class="form-label fw-bold small text-muted">Tiêu đề hóa đơn</label>
                                <input type="text" asp-for="Title" class="form-control" style="border-radius: 12px; height: 46px;" required>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Sinh viên</label>
                                <input type="text" class="form-control bg-light"
                                       style="border-radius: 12px; height: 46px;" value="@(Model.Contract?.User?.FullName ?? "N/A")" readonly>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-bold small text-muted">Trạng thái thanh toán</label>
                                <select asp-for="Status" class="form-select" style="border-radius: 12px; height: 46px;" required>
                                    <option value="Unpaid">Chưa thanh toán</option>
                                    <option value="Paid">Đã thanh toán</option>
                                    <option value="Overdue">Quá hạn</option>
                                    <option value="PartiallyPaid">Thanh toán một phần</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="BillingMonth" class="form-label fw-bold small text-muted">Tháng quyết toán</label>
                                <select asp-for="BillingMonth" class="form-select" style="border-radius: 12px; height: 46px;" required>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i">Tháng @i</option>
                                    }
                                </select>
                                <span asp-validation-for="BillingMonth" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="BillingYear" class="form-label fw-bold small text-muted">Năm quyết toán</label>
                                <input type="number" asp-for="BillingYear" class="form-control" style="border-radius: 12px; height: 46px;" required>
                                <span asp-validation-for="BillingYear" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DueDate" class="form-label fw-bold small text-muted">Hạn thanh toán</label>
                                <input type="date" asp-for="DueDate" class="form-control" style="border-radius: 12px; height: 46px;" value="@Model.DueDate.ToString("yyyy-MM-dd")" required>
                                <span asp-validation-for="DueDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="TotalAmount" class="form-label fw-bold small text-muted">Tổng số tiền (VNĐ)</label>
                                <input type="number" asp-for="TotalAmount" class="form-control fw-bold text-primary" style="border-radius: 12px; height: 46px;" required>
                                <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-4">
                                <div class="p-3 bg-light" style="border-radius: 15px; border-left: 4px solid #f97316;">
                                    <p class="mb-0 small text-muted">
                                        <i class="fa-solid fa-circle-info me-2"></i>
                                        Việc thay đổi thông tin hóa đơn sẽ trực tiếp cập nhật vào hệ thống nợ của sinh viên và báo cáo thống kê của ký túc xá.
                                    </p>
                                </div>
                            </div>

                            <div class="col-12 mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm"
                                        style="border-radius: 12px; height: 46px;">
                                    <i class="fa-solid fa-check me-2"></i> Cập nhật thay đổi
                                </button>
                                <a asp-action="Index" class="btn btn-light border px-4 fw-bold"
                                   style="border-radius: 12px; height: 46px; display: flex; align-items: center;">
                                    Quay lại
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>