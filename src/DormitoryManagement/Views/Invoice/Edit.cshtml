@{
    ViewData["Title"] = "Chỉnh Sửa Hóa Đơn";
    Layout = "_Layout";

    // MOCK DATA để hiển thị
    var mockInvoice = new
    {
        Code = "HD002",
        Title = "Hóa đơn dịch vụ tháng 05/2024",
        Student = "Trần Thị B",
        Amount = 450000,
        Status = "Chưa thanh toán",
        DueDate = "2024-05-20"
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div
                            style="width: 48px; height: 48px; background: #fff7ed; color: #f97316; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold text-dark">Chỉnh Sửa Hóa Đơn</h3>
                            <span class="text-muted small">Mã: @mockInvoice.Code</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Home" asp-action="Index"
                           class="btn btn-outline-secondary shadow-sm d-flex align-items-center gap-2"
                           style="border-radius: 12px;">
                            <i class="fa-solid fa-house"></i> <span>Trang chủ</span>
                        </a>
                        <span class="badge bg-warning text-dark px-3 py-2"
                              style="border-radius: 10px;">@mockInvoice.Status</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Tiêu đề hóa đơn</label>
                                <input type="text" class="form-control" style="border-radius: 12px; height: 46px;"
                                       value="@mockInvoice.Title">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Sinh viên</label>
                                <input type="text" class="form-control bg-light"
                                       style="border-radius: 12px; height: 46px;" value="@mockInvoice.Student" readonly>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Trạng thái thanh toán</label>
                                <select class="form-select" style="border-radius: 12px; height: 46px;">
                                    <option selected>Chưa thanh toán</option>
                                    <option>Đã thanh toán</option>
                                    <option>Quá hạn</option>
                                    <option>Thanh toán một phần</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Tổng số tiền (VNĐ)</label>
                                <input type="number" class="form-control fw-bold text-primary"
                                       style="border-radius: 12px; height: 46px;" value="@mockInvoice.Amount">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Hạn thanh toán</label>
                                <input type="date" class="form-control" style="border-radius: 12px; height: 46px;"
                                       value="@mockInvoice.DueDate">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Ghi chú chỉnh sửa</label>
                                <textarea class="form-control" rows="3" style="border-radius: 12px;"
                                          placeholder="Lý do điều chỉnh hóa đơn..."></textarea>
                            </div>

                            <div class="col-12 mt-4">
                                <div class="p-3 bg-light" style="border-radius: 15px; border-left: 4px solid #f97316;">
                                    <p class="mb-0 small text-muted">
                                        <i class="fa-solid fa-circle-info me-2"></i>
                                        Việc thay đổi số tiền sẽ ảnh hưởng đến báo cáo doanh thu tháng. Vui lòng kiểm
                                        tra kỹ trước khi lưu.
                                    </p>
                                </div>
                            </div>

                            <div class="col-12 mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm"
                                        style="border-radius: 12px; height: 46px;">
                                    <i class="fa-solid fa-check me-2"></i> Cập nhật thay đổi
                                </button>
                                <a asp-action="Index" class="btn btn-light border px-4 fw-bold"
                                   style="border-radius: 12px; height: 46px; display: flex; align-items: center;">
                                    Quay lại
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>