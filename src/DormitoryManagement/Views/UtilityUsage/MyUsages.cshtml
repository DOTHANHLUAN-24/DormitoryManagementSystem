@using DormitoryManagement.Domain.Enums
@model DormitoryManagement.Domain.Common.PagedResult<DormitoryManagement.Domain.Entities.UtilityUsage>
@{
    ViewData["Title"] = "Chỉ số điện nước phòng";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .tieu-de-trang {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(135deg, #0f6b6d, #14b8a6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .trang-thai-hoa-don {
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .trang-thai-hoa-don.chua-lap {
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #cbd5e1;
        }

        .trang-thai-hoa-don.da-thanh-toan {
            background: #ecfdf5;
            color: #10b981;
            border: 1px solid #a7f3d0;
        }

        .trang-thai-hoa-don.cho-thanh-toan {
            background: #fffbeb;
            color: #d97706;
            border: 1px solid #fde68a;
        }

        .trang-thai-hoa-don.qua-han {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fecaca;
        }

        .trang-thai-hoa-don.thanh-toan-mot-phan {
            background: #eff6ff;
            color: #3b82f6;
            border: 1px solid #bfdbfe;
        }

        .ma-yeu-cau-badge {
            background: #f8fafc;
            color: #475569;
            padding: 6px 10px;
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid #e2e8f0;
        }

        .utility-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            margin-right: 8px;
        }

        .utility-icon.dien {
            background: #fff7ed;
            color: #ea580c;
        }

        .utility-icon.nuoc {
            background: #ecfeff;
            color: #0891b2;
        }

        .info-card-room {
            background: #fff;
            border-radius: 16px;
            padding: 20px;
            border-left: 5px solid #0f6b6d;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 24px;
        }
    </style>
}

<div class="container-fluid">
    <!-- Header -->
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="tieu-de-trang mb-1"><i class="fas fa-plug me-2"></i>Tra cứu chỉ số điện & nước</h1>
            <p class="text-muted small mb-0">Theo dõi chỉ số đồng hồ điện, nước và chi phí tiêu thụ hàng tháng của phòng bạn.</p>
        </div>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 mb-4 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        </div>
    }

    <!-- Thông tin phòng ở hiện tại của sinh viên -->
    <div class="info-card-room">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h5 class="fw-bold text-dark mb-1">
                    <i class="fas fa-door-open me-2 text-muted"></i>
                    Phòng hiện tại: <span class="text-primary">@ViewBag.RoomNumber</span> (Tòa nhà: @ViewBag.BlockName)
                </h5>
                <p class="text-muted small mb-0">Các chỉ số được cập nhật định kỳ bởi ban quản lý ký túc xá vào cuối mỗi kỳ ghi nhận.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill fw-semibold">
                    <i class="fas fa-shield-alt me-1"></i> Dữ liệu chính thức
                </span>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách chỉ số điện nước -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã ghi nhận</th>
                        <th>Dịch vụ tiện ích</th>
                        <th>Kỳ ghi nhận</th>
                        <th class="text-center">Chỉ số cũ -> mới</th>
                        <th class="text-end">Lượng tiêu thụ</th>
                        <th class="text-end">Thành tiền</th>
                        <th>Trạng thái thanh toán</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var isDien = item.Utility?.UtilityName.ToLower().Contains("điện") ?? false;
                            <tr>
                                <td class="ps-4">
                                    <span class="ma-yeu-cau-badge">#UTI-@item.Id.ToString().Substring(0, 8).ToUpper()</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="utility-icon @(isDien ? "dien" : "nuoc")">
                                            <i class="fas @(isDien ? "fa-bolt" : "fa-tint")"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(item.Utility?.UtilityName ?? "N/A")</div>
                                            <div class="small text-muted">Đơn giá: @(item.Utility?.UnitPrice.ToString("N0") ?? "0")đ/@(item.Utility?.Unit ?? "")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">Tháng @item.Month/@item.Year</div>
                                    <div class="small text-muted">Ngày ghi: @item.CreatedDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">@item.PreviousIndex</span>
                                    <i class="fas fa-long-arrow-alt-right mx-2 text-muted"></i>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">@item.CurrentIndex</span>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @item.UsageQuantity.ToString("N1") @(item.Utility?.Unit ?? "")
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    @item.TotalAmount.ToString("N0") đ
                                </td>
                                <td>
                                    @if (item.InvoiceId.HasValue && item.Invoice != null)
                                    {
                                        switch (item.Invoice.Status)
                                        {
                                            case InvoiceStatus.Paid:
                                                <span class="trang-thai-hoa-don da-thanh-toan" title="Mã hóa đơn: @item.Invoice.InvoiceCode">
                                                    <i class="fas fa-check-circle"></i> Đã thanh toán
                                                </span>
                                                break;
                                            case InvoiceStatus.Unpaid:
                                                <span class="trang-thai-hoa-don cho-thanh-toan" title="Mã hóa đơn: @item.Invoice.InvoiceCode">
                                                    <i class="fas fa-clock"></i> Chờ thanh toán
                                                </span>
                                                break;
                                            case InvoiceStatus.Overdue:
                                                <span class="trang-thai-hoa-don qua-han" title="Mã hóa đơn: @item.Invoice.InvoiceCode">
                                                    <i class="fas fa-exclamation-triangle"></i> Quá hạn
                                                </span>
                                                break;
                                            case InvoiceStatus.PartiallyPaid:
                                                <span class="trang-thai-hoa-don thanh-toan-mot-phan" title="Mã hóa đơn: @item.Invoice.InvoiceCode">
                                                    <i class="fas fa-adjust"></i> Trả một phần
                                                </span>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        <span class="trang-thai-hoa-don chua-lap">
                                            <i class="fas fa-minus-circle"></i> Chưa xuất hóa đơn
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-tachometer-alt fa-3x mb-3 text-secondary"></i>
                                <p class="mb-0">Phòng của bạn chưa có dữ liệu ghi nhận số điện, nước nào.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
