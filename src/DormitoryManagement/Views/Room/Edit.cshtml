@{
    ViewData["Title"] = "Cập nhật thông tin phòng";
    Layout = "_Layout"; // Giả định bạn dùng layout chung
}

<div class="container mt-5">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#">Quản lý phòng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cập nhật phòng</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary bg-gradient text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Cập nhật thông tin phòng: <span
                        class="fw-bold">A.102</span>
                    </h5>
                </div>
                <div class="card-body p-5">
                    <form action="#" method="post">
                        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>
                                <strong>Lưu ý:</strong> Vui lòng kiểm tra lại thông tin trước khi lưu.
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Tên/Số phòng -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số phòng <span
                                    class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-door-closed"></i></span>
                                        <input type="text" class="form-control" value="A.102" placeholder="VD: A.101"
                                               required />
                                    </div>
                                </div>

                                <!-- Tầng -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tầng số</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-layers"></i></span>
                                        <input type="number" class="form-control" value="1" min="1" />
                                    </div>
                                </div>

                                <!-- Trạng thái phòng -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Trạng thái hiện tại</label>
                                    <select class="form-select border-primary-subtle">
                                        <option value="Available" selected>🟢 Trống (Available)</option>
                                        <option value="Full">🔴 Đã đầy (Full)</option>
                                        <option value="Maintenance">🟡 Đang bảo trì (Maintenance)</option>
                                        <option value="Reserved">🔵 Đã đặt trước (Reserved)</option>
                                    </select>
                                </div>

                                <!-- Tòa nhà -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Thuộc tòa nhà (Block)</label>
                                    <select class="form-select">
                                        <option value="1" selected>Tòa nhà A - Khu nam</option>
                                        <option value="2">Tòa nhà B - Khu nữ</option>
                                        <option value="3">Tòa nhà C - Khu chất lượng cao</option>
                                    </select>
                                </div>

                                <!-- Loại phòng -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Loại phòng & Tiện ích</label>
                                    <select class="form-select">
                                        <option value="1">Phòng 4 giường - Quạt máy (Cơ bản)</option>
                                        <option value="2" selected>Phòng 6 giường - Điều hòa (Nâng cao)</option>
                                        <option value="3">Phòng 8 giường - Dịch vụ trọn gói</option>
                                    </select>
                                </div>

                                <!-- Ghi chú thêm -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Ghi chú vận hành</label>
                                    <textarea class="form-control" rows="3"
                                              placeholder="Ghi nhận tình trạng hư hỏng hoặc lưu ý đặc biệt..."></textarea>
                                </div>
                            </div>

                            <hr class="my-4">

                            <div class="d-flex justify-content-between align-items-center">
                                <a href="#" class="btn btn-outline-secondary px-4">
                                    <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                                </a>
                                <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }