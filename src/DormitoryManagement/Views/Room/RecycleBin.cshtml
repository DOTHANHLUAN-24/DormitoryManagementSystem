@using DormitoryManagement.Domain.Common
@using DormitoryManagement.Application.Dtos.Responses.Rooms
@using DormitoryManagement.Application.Dtos.Requests.Rooms
@model PagedResult<RoomResponse>

@{
    ViewData["Title"] = "Thùng rác phòng";
    var filter = ViewBag.Filter as RoomFilterRequest ?? new RoomFilterRequest();
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-danger fw-bold mb-0">
                <i class="fas fa-trash-alt me-2"></i> Thùng rác phòng
            </h4>
            <p class="text-muted small mb-0">Quản lý các phòng đã xóa tạm thời. Bạn có thể khôi phục hoặc xóa vĩnh viễn khỏi hệ thống.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary shadow-sm" style="border-radius: 10px;">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Thanh tìm kiếm nhanh -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
        <div class="card-body p-3">
            <form method="get" asp-action="RecycleBin" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control border-start-0" placeholder="Tìm kiếm theo số phòng trong thùng rác...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100" style="border-radius: 8px;">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách phòng đã xóa -->
    <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Số phòng</th>
                        <th>Tòa & Tầng</th>
                        <th>Loại phòng</th>
                        <th>Giá thuê</th>
                        <th>Sức chứa</th>
                        <th class="text-end pe-4">Thao tác</th>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="opacity-75">
                                <td class="ps-4">
                                    <span class="badge bg-secondary px-3 py-2 text-decoration-line-through" style="font-family: 'JetBrains Mono', monospace; font-size: 0.9rem;">
                                        @item.RoomNumber
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-decoration-line-through">@item.BlockName</div>
                                    <div class="small text-muted text-decoration-line-through">Tầng @item.Floor</div>
                                </td>
                                <td>
                                    <span class="text-primary fw-medium text-decoration-line-through">@item.RoomTypeName</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark text-decoration-line-through">@item.BasePrice.ToString("N0")</span> 
                                    <small class="text-muted">đ</small>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        <i class="fas fa-users me-1 text-muted"></i>@item.MaxOccupants
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button onclick="restoreRoom('@item.Id', '@item.RoomNumber')" 
                                                class="btn btn-sm btn-outline-success px-3" title="Khôi phục" style="border-radius: 8px;">
                                            <i class="fas fa-undo-alt me-1"></i> Khôi phục
                                        </button>
                                        <button onclick="deletePermanently('@item.Id', '@item.RoomNumber')" 
                                                class="btn btn-sm btn-outline-danger px-2" title="Xóa vĩnh viễn" style="border-radius: 8px;">
                                            <i class="fas fa-eraser"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="py-4">
                                    <i class="fas fa-folder-open fa-3x text-muted mb-3 opacity-25"></i>
                                    <p class="text-muted mb-0">Thùng rác hiện đang trống.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Phân trang -->
    <div class="mt-4">
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        // Hàm lấy Token chống giả mạo (CSRF)
        function getAntiforgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        // 1. Hàm Khôi phục phòng
        function restoreRoom(id, roomNumber) {
            Swal.fire({
                title: 'Khôi phục phòng?',
                text: "Phòng " + roomNumber + " sẽ hiển thị lại trong danh sách hoạt động.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý khôi phục',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Room/Restore/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: getAntiforgeryToken()
                        },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi', 'Không thể kết nối máy chủ', 'error');
                        }
                    });
                }
            });
        }

        // 2. Hàm Xóa vĩnh viễn
        function deletePermanently(id, roomNumber) {
            Swal.fire({
                title: 'Xác nhận xóa vĩnh viễn?',
                text: "Phòng " + roomNumber + " sẽ bị xóa hoàn toàn. Dữ liệu này không thể khôi phục lại!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xóa vĩnh viễn ngay',
                cancelButtonText: 'Quay lại',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // Hiện loading
                    Swal.fire({
                        title: 'Đang xử lý...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '/Room/DeletePermanently/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: getAntiforgeryToken()
                        },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã xóa!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi', 'Có lỗi xảy ra trong quá trình xóa', 'error');
                        }
                    });
                }
            });
        }
    </script>
}