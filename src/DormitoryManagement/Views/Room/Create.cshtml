@model DormitoryManagement.Application.Dtos.Requests.Rooms.CreateRoomRequest
@using DormitoryManagement.Domain.Enums

@{
    ViewData["Title"] = "Thêm phòng mới";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                <div class="card-header bg-primary bg-gradient text-white py-3" style="border-radius: 20px 20px 0 0;">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Thêm phòng mới
                    </h5>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        @* Hiển thị lỗi tổng quát nếu có *@
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <!-- Số phòng -->
                            <div class="col-md-6">
                                <label asp-for="RoomNumber" class="form-label fw-bold">Số phòng</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-door-open"></i></span>
                                    <input asp-for="RoomNumber" class="form-control" placeholder="Ví dụ: 101, 202..." />
                                </div>
                                <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                            </div>

                            <!-- Tầng -->
                            <div class="col-md-6">
                                <label asp-for="Floor" class="form-label fw-bold">Tầng</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-layer-group"></i></span>
                                    <input asp-for="Floor" class="form-control" type="number" />
                                </div>
                                <span asp-validation-for="Floor" class="text-danger small"></span>
                            </div>

                            <!-- Tòa nhà (Block) -->
                            <div class="col-md-6">
                                <label asp-for="BlockId" class="form-label fw-bold">Tòa nhà</label>
                                <select asp-for="BlockId" asp-items="ViewBag.Blocks" class="form-select">
                                    <option value="">-- Chọn tòa nhà --</option>
                                </select>
                                <span asp-validation-for="BlockId" class="text-danger small"></span>
                            </div>

                            <!-- Loại phòng (RoomType) -->
                            <div class="col-md-6">
                                <label asp-for="RoomTypeId" class="form-label fw-bold">Loại phòng</label>
                                <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypes" class="form-select">
                                    <option value="">-- Chọn loại phòng --</option>
                                </select>
                                <span asp-validation-for="RoomTypeId" class="text-danger small"></span>
                            </div>

                            <!-- Trạng thái -->
                            <div class="col-md-12">
                                <label asp-for="Status" class="form-label fw-bold">Trạng thái ban đầu</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="form-select"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            @* Nút Hủy bỏ quay lại trang danh sách *@
                            <a asp-action="Index" class="btn btn-outline-secondary px-4" style="border-radius: 10px;">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            @* Nút Submit *@
                            <button type="submit" class="btn btn-primary px-5 shadow-sm" style="border-radius: 10px;">
                                <i class="fas fa-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}