@{
    ViewData["Title"] = "Thêm phòng mới";
    Layout = "_Layout";
}
@model DormitoryManagement.Domain.Entities.Room
@using DormitoryManagement.Domain.Enums

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success bg-gradient text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-plus-circle me-2"></i>Thêm phòng mới
                    </h5>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" asp-controller="Room" method="post">
                        <div class="row g-3">
                            <!-- Số phòng (RoomNumber) -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số phòng <span
                                    class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-door-closed"></i></span>
                                        <input asp-for="RoomNumber" type="text" class="form-control" placeholder="VD: P.101"
                                               required />
                                    </div>
                                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                                </div>

                                <!-- Tầng (Floor) -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tầng số</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-layers"></i></span>
                                        <input asp-for="Floor" type="number" class="form-control" placeholder="VD: 1"
                                               min="1" />
                                    </div>
                                    <span asp-validation-for="Floor" class="text-danger"></span>
                                </div>

                                <!-- Trạng thái (Status) -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Trạng thái ban đầu</label>
                                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()"
                                            class="form-select border-primary-subtle">
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>

                                <!-- Tòa nhà (BlockId) -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Thuộc tòa nhà (Block)</label>
                                    <select asp-for="BlockId" asp-items="ViewBag.Blocks" class="form-select">
                                        <option value="">-- Chọn tòa nhà --</option>
                                    </select>
                                    <span asp-validation-for="BlockId" class="text-danger"></span>
                                </div>

                                <!-- Loại phòng (RoomTypeId) -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Loại phòng</label>
                                    <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypes" class="form-select">
                                        <option value="">-- Chọn loại phòng --</option>
                                    </select>
                                    <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                                </div>
                            </div>

                            <hr class="my-4">

                            <div class="d-flex justify-content-between align-items-center">
                                <a href="#" class="btn btn-outline-secondary px-4">
                                    <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                                </a>
                                <button type="submit" class="btn btn-success px-5 shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i> Lưu thông tin
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }