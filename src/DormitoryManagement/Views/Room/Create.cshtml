<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Tạo phòng</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f7fa;
        }
        .card {
            border-radius: 15px;
        }
        .form-title {
            font-weight: 600;
            color: #333;
        }
    </style>
</head>
<body>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-body">
                    <h4 class="form-title text-center mb-4">🏠 Tạo phòng mới</h4>

                    <form>
                        <!-- Mã phòng -->
                        <div class="mb-3">
                            <label class="form-label">Mã phòng</label>
                            <input type="text" class="form-control" placeholder="VD: P101">
                        </div>

                        <!-- Tên phòng -->
                        <div class="mb-3">
                            <label class="form-label">Tên phòng</label>
                            <input type="text" class="form-control" placeholder="VD: Phòng A1">
                        </div>

                        <!-- Sức chứa -->
                        <div class="mb-3">
                            <label class="form-label">Sức chứa</label>
                            <input type="number" class="form-control" placeholder="VD: 6">
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-3">
                            <label class="form-label">Trạng thái</label>
                            <select class="form-select">
                                <option selected>-- Chọn trạng thái --</option>
                                <option value="available">Còn trống</option>
                                <option value="full">Đã đầy</option>
                                <option value="maintenance">Đang bảo trì</option>
                            </select>
                        </div>

                        <!-- Giá phòng -->
                        <div class="mb-3">
                            <label class="form-label">Giá phòng (VNĐ)</label>
                            <input type="number" class="form-control" placeholder="VD: 1500000">
                        </div>

                        <!-- Nút -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                ➕ Tạo phòng
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>