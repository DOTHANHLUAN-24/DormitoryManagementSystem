@using DormitoryManagement.Domain.Enums
@using DormitoryManagement.Domain.Entities
@model DormitoryManagement.Application.Dtos.Responses.Rooms.RoomDetailResponse

@{
    ViewData["Title"] = "Chi tiết phòng " + Model.RoomNumber;
    Layout = "_Layout";
    var activeContracts = ViewBag.ActiveContracts as List<Contract> ?? new List<Contract>();
    var studentsWithoutRoom = ViewBag.StudentsWithoutRoom as List<User> ?? new List<User>();
    var occupiedCount = activeContracts.Count;
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
        ("Quản lý phòng", Url.Action("Index", "Room") ?? ""),
        ($"Chi tiết phòng: {Model.RoomNumber}", "")
    };
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }

        .details-container {
            padding: 2rem 0;
        }

        .page-header-gradient {
            background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
            border-radius: 24px;
            padding: 2.5rem;
            color: white;
            box-shadow: 0 10px 35px rgba(79, 70, 229, 0.15);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .page-header-gradient::before {
            content: '';
            position: absolute;
            top: -20%;
            right: -10%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            filter: blur(50px);
        }

        .breadcrumb-custom .breadcrumb-item a {
            color: rgba(255, 255, 255, 0.8) !important;
            font-weight: 500;
        }
        .breadcrumb-custom .breadcrumb-item.active {
            color: white !important;
            font-weight: 600;
        }

        .card-custom {
            background: white;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
            transition: all 0.3s ease;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .card-custom:hover {
            box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.08);
        }

        .info-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            margin-bottom: 0.25rem;
        }

        .info-value {
            font-size: 1.05rem;
            font-weight: 600;
            color: #1e293b;
        }

        .status-badge-lg {
            padding: 6px 16px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-block;
        }

        .status-available { background-color: #ecfdf5; color: #10b981; }
        .status-full { background-color: #fff7ed; color: #f97316; }
        .status-maintenance { background-color: #fef2f2; color: #ef4444; }
        .status-reserved { background-color: #f3e8ff; color: #7e22ce; }

        .bed-card {
            border: 1.5px dashed #cbd5e1;
            border-radius: 16px;
            padding: 1.5rem;
            background-color: #f8fafc;
            transition: all 0.25s ease;
            position: relative;
            margin-bottom: 1rem;
        }

        .bed-card.occupied {
            border-style: solid;
            border-color: #3b82f6;
            background-color: #fff;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.05);
        }

        .bed-card.maintenance {
            border-style: solid;
            border-color: #ef4444;
            background-color: #fef2f2;
        }

        .bed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .bed-badge {
            background-color: #4f46e5;
            color: white;
            padding: 4px 12px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .btn-assign {
            background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
            color: white !important;
            font-weight: 600;
            border-radius: 10px;
            padding: 6px 14px;
            font-size: 0.85rem;
            border: none;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
            transition: all 0.2s;
        }

        .btn-assign:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        }

        .input-custom {
            height: 44px;
            border-radius: 10px !important;
            border: 1.5px solid #e2e8f0;
            font-weight: 500;
        }
        .input-custom:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="container details-container">
    <!-- Breadcrumb & Header -->
    <div class="page-header-gradient">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="mb-0 fw-extrabold text-white" style="font-size: 2.2rem; letter-spacing: -0.02em;">
                    <i class="fas fa-door-open me-2"></i>Phòng @Model.RoomNumber
                </h1>
                <p class="mb-0 text-white-50 mt-1 fw-medium">Tòa nhà: <strong class="text-white">@Model.BlockName</strong> | Tầng: <strong class="text-white">@Model.Floor</strong></p>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light fw-bold px-4 py-2" style="border-radius: 12px; color: #4f46e5;">
                    <i class="fas fa-edit me-1"></i> Chỉnh sửa phòng
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- CỘT TRÁI: THÔNG TIN CHI TIẾT & TIỆN NGHI -->
        <div class="col-lg-5">
            <!-- Thẻ Thông Tin Phòng -->
            <div class="card card-custom">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="fas fa-info-circle text-primary me-2"></i>Thông tin chung</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="info-label">Số hiệu phòng</div>
                            <div class="info-value">@Model.RoomNumber</div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Trạng thái</div>
                            <div>
                                @switch (Model.Status)
                                {
                                    case "Available": <span class="status-badge-lg status-available">Còn trống</span> break;
                                    case "Full": <span class="status-badge-lg status-full">Đã đầy</span> break;
                                    case "Maintenance": <span class="status-badge-lg status-maintenance">Bảo trì</span> break;
                                    case "Reserved": <span class="status-badge-lg status-reserved">Đã đặt trước</span> break;
                                    default: <span class="status-badge-lg bg-secondary text-white">@Model.Status</span> break;
                                }
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Loại phòng</div>
                            <div class="info-value">@Model.RoomTypeName</div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Sức chứa tối đa</div>
                            <div class="info-value"><i class="fas fa-users me-1 text-muted"></i>@Model.MaxOccupants sinh viên</div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Giá thuê cơ bản</div>
                            <div class="info-value text-indigo fw-bold" style="color: #4f46e5;">@Model.BasePrice.ToString("N0") đ/tháng</div>
                        </div>
                        <div class="col-6">
                            <div class="info-label">Hiện tại đang ở</div>
                            <div class="info-value text-dark fw-bold">@occupiedCount / @Model.Beds.Count giường</div>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <div class="info-label">Ghi chú & Mô tả</div>
                            <p class="text-muted small mb-0 fw-medium" style="line-height: 1.6;">
                                @(string.IsNullOrEmpty(Model.Description) ? "Không có ghi chú nào cho phòng này." : Model.Description)
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ Tài Sản Trong Phòng -->
            <div class="card card-custom">
                <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="fas fa-box text-primary me-2"></i>Thiết bị & Tài sản</h5>
                    <span class="badge bg-secondary rounded-pill">@Model.Assets.Count</span>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (Model.Assets.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-nowrap small">
                                <thead>
                                    <tr class="text-muted fw-bold">
                                        <th>Tên thiết bị</th>
                                        <th>Mã số (Code)</th>
                                        <th>Tình trạng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in Model.Assets)
                                    {
                                        <tr>
                                            <td class="fw-bold">@asset.AssetName</td>
                                            <td><code class="text-secondary fw-semibold">@asset.AssetCode</code></td>
                                            <td>
                                                @if (asset.Status == "Good" || asset.Status == "Normal")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Tốt</span>
                                                }
                                                else if (asset.Status == "Broken")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Hỏng</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">@asset.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="fas fa-box-open d-block mb-2 fs-3 text-light"></i>
                            Chưa ghi nhận trang thiết bị nào trong phòng.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CHI TIẾT GIƯỜNG & SINH VIÊN -->
        <div class="col-lg-7">
            <div class="card card-custom">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="fas fa-bed text-primary me-2"></i>Sơ đồ giường & Sinh viên cư trú</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Beds.Any())
                    {
                        foreach (var bed in Model.Beds)
                        {
                            var contract = activeContracts.FirstOrDefault(c => c.BedId == bed.Id);
                            var isOccupied = contract != null;

                            <div class="bed-card @(isOccupied ? "occupied" : "")">
                                <div class="bed-header">
                                    <span class="bed-badge"><i class="fas fa-bed me-1"></i>Giường @bed.BedNumber</span>
                                    <div>
                                        @if (isOccupied)
                                        {
                                            <span class="badge bg-primary rounded-pill"><i class="fas fa-user-check me-1"></i>Đang sử dụng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill"><i class="fas fa-check me-1"></i>Còn trống</span>
                                            <button type="button" class="btn btn-assign ms-2" onclick="openAssignModal('@bed.Id', '@bed.BedNumber')">
                                                <i class="fas fa-user-plus me-1"></i> Gán sinh viên
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (isOccupied)
                                {
                                    <div class="row g-2 align-items-center mt-2 border-top pt-2">
                                        <div class="col-sm-6">
                                            <div class="small text-muted mb-1"><i class="fas fa-user me-1 text-primary"></i>Sinh viên</div>
                                            <div class="fw-bold text-dark fs-6">@(contract?.User?.FullName ?? "Không rõ")</div>
                                            <div class="small text-secondary fw-semibold">MSSV: @(contract?.User?.Code ?? "Không có")</div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="small text-muted mb-1"><i class="fas fa-id-card me-1 text-primary"></i>Thông tin liên hệ</div>
                                            <div class="small fw-medium">Email: @(contract?.User?.Email ?? "Không có")</div>
                                            <div class="small fw-medium">SĐT: @(contract?.User?.PhoneNumber ?? "Không có")</div>
                                        </div>
                                        <div class="col-12 mt-2 pt-2 border-top d-flex justify-content-between align-items-center text-muted small">
                                            <span>
                                                <i class="fas fa-calendar-alt me-1 text-secondary"></i>
                                                Hợp đồng: @contract?.StartDate.ToString("dd/MM/yyyy") - @contract?.EndDate.ToString("dd/MM/yyyy")
                                            </span>
                                            <a href="/Contract/Approve/@contract?.Id" class="btn btn-link btn-sm text-decoration-none fw-bold p-0" target="_blank">
                                                <i class="fas fa-external-link-alt me-1"></i>Xem hợp đồng
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small py-2">
                                        <i class="fas fa-info-circle me-1"></i>Giường này đang trống. Bạn có thể gán trực tiếp một sinh viên chưa có phòng vào vị trí này.
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-bed d-block mb-3 fs-1 text-light"></i>
                            Không tìm thấy dữ liệu giường trong phòng này.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Gán Sinh Viên Trực Tiếp -->
<div class="modal fade" id="assignStudentModal" tabindex="-1" aria-labelledby="assignStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.15);">
            <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%); border-bottom: none;">
                <h5 class="modal-title fw-bold" id="assignStudentModalLabel"><i class="fas fa-user-plus me-2"></i> Gán Sinh Viên Vào Giường</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="assignForm" onsubmit="submitAssignment(event)">
                    <input type="hidden" id="assignBedId" name="bedId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Phòng & Giường</label>
                        <input type="text" class="form-control input-custom bg-light fw-bold" id="assignBedInfo" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Sinh viên muốn gán <span class="text-danger">*</span></label>
                        <select class="form-select input-custom" id="assignUserId" required>
                            <option value="">-- Chọn sinh viên chưa có phòng --</option>
                            @foreach (var student in studentsWithoutRoom)
                            {
                                <option value="@student.Id">@student.FullName (@student.Code)</option>
                            }
                        </select>
                        <small class="text-muted mt-1 d-block"><i class="fas fa-info-circle me-1"></i>Chỉ hiện sinh viên chưa cư trú tại phòng nào.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Mã hợp đồng <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" class="form-control" style="height: 48px; border-radius: 12px 0 0 12px !important; border: 1.5px solid #e2e8f0; font-size: 0.95rem; font-weight: 500; color: #334155;" id="assignContractCode" required />
                            <button type="button" class="btn btn-outline-secondary" style="border-radius: 0 12px 12px 0 !important; border: 1.5px solid #e2e8f0; border-left: none;" onclick="regenerateAssignContractCode()" title="Tự động sinh mã"><i class="fas fa-sync-alt"></i></button>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Ngày bắt đầu <span class="text-danger">*</span></label>
                            <input type="date" class="form-control input-custom" id="assignStartDate" required />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Ngày kết thúc <span class="text-danger">*</span></label>
                            <input type="date" class="form-control input-custom" id="assignEndDate" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Tiền đặt cọc (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control input-custom" id="assignDepositAmount" value="1000000" min="0" required />
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="button" class="btn btn-secondary w-50" data-bs-dismiss="modal" style="height: 46px; border-radius: 12px; font-weight: 600;">Hủy bỏ</button>
                        <button type="submit" class="btn text-white w-50" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%); border: none; height: 46px; border-radius: 12px; font-weight: 600;">
                            Xác nhận gán
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAssignModal(bedId, bedNumber) {
            const currentYear = new Date().getFullYear();
            const randCode = 'HD-' + currentYear + '-' + Math.floor(1000 + Math.random() * 9000);
            
            // Set values
            $('#assignBedId').val(bedId);
            $('#assignBedInfo').val('Phòng @Model.RoomNumber - Giường ' + bedNumber);
            $('#assignContractCode').val(randCode);
            
            // Dates defaults
            const today = new Date();
            const todayStr = today.toISOString().split('T')[0];
            
            const sixMonthsLater = new Date();
            sixMonthsLater.setMonth(today.getMonth() + 6);
            const endDateStr = sixMonthsLater.toISOString().split('T')[0];
            
            $('#assignStartDate').val(todayStr);
            $('#assignEndDate').val(endDateStr);
            
            // Show modal
            const myModal = new bootstrap.Modal(document.getElementById('assignStudentModal'));
            myModal.show();
        }

        function regenerateAssignContractCode() {
            const currentYear = new Date().getFullYear();
            const randCode = 'HD-' + currentYear + '-' + Math.floor(1000 + Math.random() * 9000);
            $('#assignContractCode').val(randCode);
        }

        function submitAssignment(event) {
            event.preventDefault();

            const bedId = $('#assignBedId').val();
            const userId = $('#assignUserId').val();
            const contractCode = $('#assignContractCode').val();
            const startDate = $('#assignStartDate').val();
            const endDate = $('#assignEndDate').val();
            const depositAmount = $('#assignDepositAmount').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!userId) {
                Swal.fire({ icon: 'error', title: 'Lỗi!', text: 'Vui lòng chọn sinh viên.' });
                return;
            }

            // Close Modal
            const modalEl = document.getElementById('assignStudentModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            Swal.fire({
                title: 'Đang gán sinh viên...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/Room/AssignStudent',
                type: 'POST',
                data: {
                    bedId: bedId,
                    userId: userId,
                    contractCode: contractCode,
                    startDate: startDate,
                    endDate: endDate,
                    depositAmount: depositAmount,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: res.message,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại!',
                            text: res.message,
                            confirmButtonColor: '#4f46e5'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi hệ thống!',
                        text: 'Không thể xử lý yêu cầu gán sinh viên. Vui lòng liên hệ Admin.'
                    });
                }
            });
        }
    </script>
}