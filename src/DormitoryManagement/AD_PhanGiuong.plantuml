@startuml
|Nhân viên|
start
:Mở danh sách đã duyệt (Approved);
:Chọn sinh viên;
|Hệ thống|
:Tải danh sách phòng/giường trống;
if (Không còn giường phù hợp?) then (Có)
  :Hiển thị "Không còn giường trống";
  :Không cho tiếp tục thao tác;
  stop
else (Còn trống)
endif

repeat
  :Hiển thị phòng/giường trống;
  |Nhân viên|
  :Chọn giường;
  :Xác nhận;
  
  |Hệ thống|
  if (Chưa chọn giường?) then (Có)
    :Chặn thao tác xác nhận;
    :Hiển thị "Vui lòng chọn giường";
  else (Đã chọn)
    :Gửi request phân giường;
    :Server kiểm tra;
    
    if (Sinh viên đã có giường?) then (Có)
      :Không cho gán tiếp, Hiển thị lỗi, Ghi log;
      stop
    elseif (Giường đã được gán trước đó?) then (Có)
      :Từ chối gán, không cập nhật DB;
      :Hiển thị "Giường đã được sử dụng", Ghi log;
      :Reload danh sách;
    else (Hợp lệ)
      :Gán giường cho sinh viên;
      :Lưu DB;
      if (Lỗi DB?) then (Có)
        :Rollback transaction;
        :Trả lỗi hệ thống, Hiển thị lỗi, Ghi exception log;
        stop
      else (Thành công)
        :Ghi log, Trả response thành công;
        :Hiển thị thành công;
        stop
      endif
    endif
  endif
repeat while (Phân giường cho sinh viên khác?) is (Có)
@enduml