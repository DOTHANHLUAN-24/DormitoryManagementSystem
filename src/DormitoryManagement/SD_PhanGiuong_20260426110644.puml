@startuml
autonumber
actor "Nhân viên" as nv
participant "Giao diện (Client)" as client
participant "Máy chủ (Server)" as server
database "Cơ sở dữ liệu" as db

nv -> client : Mở danh sách duyệt & Chọn Sinh viên
client -> server : Lấy giường còn trống (GET)
server -> db : Truy vấn (Status = Available)
db --> server : Danh sách giường trống
server --> client : Trả về dữ liệu

alt Không có giường trống
    client --> nv : Hiển thị "Không còn giường trống"
else Có giường
    loop Gán giường cho Sinh viên
        client --> nv : Hiển thị danh sách giường
        nv -> client : Chọn giường & Xác nhận
        
        alt Chưa chọn
            client --> nv : Báo lỗi "Vui lòng chọn"
        else Đã chọn
            client -> server : Gửi yêu cầu gán (POST)
            server -> db : Kiểm tra dữ liệu Sinh viên
            db --> server : Đã có giường?
            
            alt Đã có giường
                server --> client : Lỗi "Sinh viên đã có giường"
                client --> nv : Hiển thị lỗi & Hủy thao tác
            else Chưa có giường
                server -> db : Kiểm tra tình trạng Giường
                db --> server : Tình trạng hiện tại
                
                alt Giường đã bị người khác gán
                    server --> client : Lỗi "Giường đã được sử dụng"
                    client --> nv : Hiển thị lỗi & Reload danh sách
                else Hợp lệ
                    server -> db : Cập nhật gán Sinh viên vào Giường
                    alt Lỗi CSDL
                        db --> server : Exception
                        server -> server : Rollback & Ghi Log
                        server --> client : HTTP 500 Lỗi hệ thống
                        client --> nv : Hiển thị "Có lỗi hệ thống"
                    else Thành công
                        db --> server : Success
                        server -> server : Ghi Audit Log
                        server --> client : HTTP 200 OK
                        client --> nv : Hiển thị thông báo thành công
                    end
                end
            end
        end
    end
end
@enduml